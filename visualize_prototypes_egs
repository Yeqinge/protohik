    )
    parser.add_argument(
        "--num-samples", type=int, default=1000,
        help="最终输入的 egs 样本总数；必须为偶数，正常/异常各取一半",
    )
    parser.add_argument("--seed", type=int, default=42)
    parser.add_argument("--annotate-prototypes", action="store_true")
    return parser.parse_args()


def _tensor_dict(obj: Any) -> Dict[str, Any]:
    """Find the most likely state_dict in common checkpoint layouts."""
    import torch

    if hasattr(obj, "state_dict"):
        obj = obj.state_dict()
    if not isinstance(obj, dict):
        raise TypeError(f"checkpoint 类型不是 dict/module，而是 {type(obj).__name__}")

    for key in ("state_dict", "model_state_dict", "model", "net", "params"):
        value = obj.get(key)
        if hasattr(value, "state_dict"):
            value = value.state_dict()
        if isinstance(value, dict) and any(torch.is_tensor(x) for x in value.values()):
            obj = value
            break
    return {str(k): v for k, v in obj.items() if torch.is_tensor(v)}


def load_checkpoint(path: Path) -> Dict[str, Any]:
    import torch

    # weights_only=False is needed for some older ASV-Subtools checkpoints.
    try:
        value = torch.load(path, map_location="cpu", weights_only=True)
    except Exception:
        LOG.warning("安全 weights_only 加载失败，尝试兼容旧 checkpoint")
        value = torch.load(path, map_location="cpu", weights_only=False)
    tensors = _tensor_dict(value)
    if not tensors:
        raise ValueError("checkpoint 中没有找到张量参数")
    return tensors


def choose_prototypes(tensors: Dict[str, Any], explicit_key: Optional[str]):
    if explicit_key:
        if explicit_key not in tensors:
            matches = [k for k in tensors if k.endswith(explicit_key)]
            if len(matches) != 1:
                raise KeyError(f"找不到唯一参数 {explicit_key!r}；可先使用 --list-keys")
            explicit_key = matches[0]
        candidates = [(explicit_key, tensors[explicit_key])]
    else:
        candidates = [
            (k, v) for k, v in tensors.items()
            if v.ndim >= 2 and any(word in k.lower() for word in PROTOTYPE_WORDS)
        ]
        if not candidates:
            likely = [(k, tuple(v.shape)) for k, v in tensors.items() if v.ndim in (2, 3)]
            raise ValueError(
                "未自动找到名称含 prototype/centroid 的张量。请用 --list-keys 查看，"
                f"再通过 --prototype-key 指定。候选: {likely[-20:]}"
            )
        # A learned parameter is normally preferable to optimizer/statistical buffers.
        candidates.sort(key=lambda item: ("loss" not in item[0].lower(), item[0]))
        if len(candidates) > 1:
            LOG.warning("找到多个 prototype 候选，将使用 %s；其余为 %s", candidates[0][0], [x[0] for x in candidates[1:]])

    key, tensor = candidates[0]
    array = tensor.detach().float().cpu().numpy()
    if array.ndim < 2:
        raise ValueError(f"prototype 张量至少应为二维，实际 {key}: {array.shape}")
    # Handles [classes, dim] and [classes, prototypes_per_class, dim] while
    # retaining the class/within-class identity of every flattened prototype.
    num_classes = int(array.shape[0])
    per_class = int(np.prod(array.shape[1:-1])) if array.ndim > 2 else 1
    class_ids = np.repeat(np.arange(num_classes, dtype=np.int64), per_class)
    within_class_ids = np.tile(np.arange(per_class, dtype=np.int64), num_classes)
    return key, array.reshape(-1, array.shape[-1]), class_ids, within_class_ids


def load_model(
    config_path: Path,
    blueprint_arg: Optional[Path],
    tensors: Dict[str, Any],
    feat_dim: int,
    num_targets: int,
    device: str,
):
    """Rebuild ResNetXvector from total_params.json and load checkpoint weights."""
    import torch

    config = json.loads(config_path.read_text(encoding="utf-8"))
    model_params = dict(config["model_params"])
    model_params["training"] = False
    configured = config.get("trainer_params", {}).get("model_blueprint", "")
    blueprint = blueprint_arg or (Path(configured) if configured else None)
    if blueprint is None:
        raise ValueError("配置中没有 trainer_params.model_blueprint，请通过 --blueprint 指定")
    if not blueprint.is_absolute():
        choices = [config_path.parent / blueprint, Path.cwd() / blueprint]
        blueprint = next((x for x in choices if x.exists()), choices[0])
    if not blueprint.exists():
        raise FileNotFoundError(f"模型 blueprint 不存在: {blueprint}")

    spec = importlib.util.spec_from_file_location("prototype_visualizer_blueprint", blueprint)
    if spec is None or spec.loader is None:
        raise ImportError(f"无法导入 blueprint: {blueprint}")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    model = module.ResNetXvector(feat_dim, num_targets, **model_params)

    # DDP checkpoints commonly prefix every key with "module.".
    # str.removeprefix() requires Python 3.9; keep compatibility with the
    # older Python versions commonly used by ASV-Subtools environments.
    state = {(k[len("module."):] if k.startswith("module.") else k): v
             for k, v in tensors.items()}
    result = model.load_state_dict(state, strict=False)
    if result.missing_keys:
        LOG.warning("加载模型时缺少参数: %s", result.missing_keys)
    if result.unexpected_keys:
        LOG.warning("checkpoint 中有未使用参数: %s", result.unexpected_keys)
    model.to(torch.device(device)).eval()
    return model


def load_raw_egs_feature(row: dict[str, str], base_dir: Path) -> np.ndarray:
    fields = list(row)
    feat_col = _find(fields, FEATURE_NAMES)
    if feat_col is None:
        raise ValueError(f"egs 中找不到特征列；实际列为 {fields}")
    start_col, end_col = _find(fields, START_NAMES), _find(fields, END_NAMES)
    feat = np.squeeze(load_feature(row[feat_col], base_dir)).astype(np.float32, copy=False)
    if feat.ndim != 2:
        raise ValueError(f"原始声学特征必须是二维矩阵，实际 shape={feat.shape}")
    # Standard egs matrices are [frames, feat_dim]. Slice before transposing.
    start = int(float(row[start_col])) if start_col and row.get(start_col, "").strip() else 0
    end = int(float(row[end_col])) if end_col and row.get(end_col, "").strip() else feat.shape[0]
    feat = feat[max(0, start):min(end, feat.shape[0])]
    if feat.size == 0:
        raise ValueError(f"切片后特征为空: start={start}, end={end}")
    return feat


def infer_feat_dim(row: dict[str, str], base_dir: Path, config: dict[str, Any]) -> int:
    configured = config.get("feat_dim") or config.get("model_info", {}).get("feat_dim")
    feat = load_raw_egs_feature(row, base_dir)
    if configured:
        configured = int(configured)
        if configured not in feat.shape:
            raise ValueError(f"配置 feat_dim={configured}，但 egs 特征 shape={feat.shape}")
        return configured
    # Speech features normally have many more frames than coefficients.
    return int(min(feat.shape))


def extract_embeddings(model, rows: list[dict[str, str]], base_dir: Path, feat_dim: int, device: str):
    import torch

    vectors, kept_rows = [], []
    with torch.inference_mode():
        for index, row in enumerate(rows):
            try:
                feat = load_raw_egs_feature(row, base_dir)
                if feat.shape[1] == feat_dim:
                    feat = feat.T
                elif feat.shape[0] != feat_dim:
                    raise ValueError(f"无法找到 feat_dim={feat_dim} 轴，shape={feat.shape}")
                inputs = torch.from_numpy(np.ascontiguousarray(feat)).unsqueeze(0).to(device)
                targets = torch.zeros(1, dtype=torch.long, device=device)
                value = model(inputs, targets)
                if isinstance(value, (tuple, list)):
                    value = value[0]
                vector = value.detach().float().cpu().numpy().reshape(-1)
                if not np.all(np.isfinite(vector)):
                    raise ValueError("embedding 含 NaN/Inf")
                vectors.append(vector)
                kept_rows.append(row)
            except Exception as exc:
                raise RuntimeError(f"第 {index + 1} 个已采样 egs 提取 embedding 失败: {exc}") from exc
    return np.stack(vectors), kept_rows


def reduce_points(all_vectors: np.ndarray, method: str, seed: int) -> np.ndarray:
    if method == "pca":
        return PCA(n_components=2, random_state=seed).fit_transform(all_vectors)
    if len(all_vectors) < 4:
        raise ValueError("t-SNE 至少需要 4 个点")
    perplexity = min(30.0, max(2.0, (len(all_vectors) - 1) / 3.0))
    return TSNE(n_components=2, perplexity=perplexity, init="pca", learning_rate="auto", random_state=seed).fit_transform(all_vectors)


def l2_normalize(vectors: np.ndarray) -> np.ndarray:
    norms = np.linalg.norm(vectors, axis=1, keepdims=True)
    if np.any(norms <= 1e-12):
        LOG.warning("发现 %d 个近零向量，L2 归一化时将保留为零", int(np.sum(norms <= 1e-12)))
    return vectors / np.maximum(norms, 1e-12)


def prototype_predictions(
    data: np.ndarray,
    prototypes: np.ndarray,
    prototype_class_ids: np.ndarray,
    class_labels: list[str],
):
    """Return cosine similarities and max-prototype scores for each class."""
    data_n = l2_normalize(data)
    proto_n = l2_normalize(prototypes)
    similarities = np.matmul(data_n, proto_n.T)
    class_ids = sorted(set(int(x) for x in prototype_class_ids))
    class_scores = np.stack(
        [similarities[:, prototype_class_ids == class_id].max(axis=1) for class_id in class_ids],
        axis=1,
    )
    order = np.argsort(class_scores, axis=1)
    best_columns = order[:, -1]
    best_scores = class_scores[np.arange(len(data)), best_columns]
    second_scores = class_scores[np.arange(len(data)), order[:, -2]] if len(class_ids) > 1 else np.zeros(len(data))
    margins = best_scores - second_scores
    predicted_class_ids = np.asarray([class_ids[int(x)] for x in best_columns])
    predicted_labels = np.asarray([
        class_labels[x] if 0 <= x < len(class_labels) else str(x)
        for x in predicted_class_ids
    ], dtype=object)
    nearest_proto = similarities.argmax(axis=1)
    return similarities, predicted_labels, nearest_proto, best_scores, margins


def select_equal_binary_rows(rows: list[dict[str, str]], total: int, seed: int) -> list[dict[str, str]]:
    """Randomly select exactly total/2 rows from each of two egs labels."""
    if total <= 0 or total % 2:
        raise ValueError(f"--num-samples 必须是正偶数，实际为 {total}")
    if not rows:
        raise ValueError("egs 中没有数据")
    lookup = {name.strip().lower(): name for name in rows[0]}
    label_col = next((lookup[name] for name in LABEL_NAMES if name in lookup), None)
    if label_col is None:
        raise ValueError(f"egs 中找不到标签列；可识别列名为 {LABEL_NAMES}，实际列为 {list(rows[0])}")

    groups: dict[str, list[dict[str, str]]] = {}
    for row in rows:
        label = str(row.get(label_col, "")).strip()
        if label:
            groups.setdefault(label, []).append(row)
    if len(groups) != 2:
        raise ValueError(
            "正/异常等量采样要求 egs 中恰好有两个非空标签，"
            f"实际标签及数量为 {dict((k, len(v)) for k, v in groups.items())}"
        )

    per_class = total // 2
    shortages = {label: len(group) for label, group in groups.items() if len(group) < per_class}
    if shortages:
        raise ValueError(
            f"每类需要 {per_class} 条，但以下类别样本不足: {shortages}；"
            f"--num-samples 最大可设为 {2 * min(map(len, groups.values()))}"
        )
    rng = np.random.default_rng(seed)
    selected: list[dict[str, str]] = []
    for label in sorted(groups, key=str):
        indices = rng.choice(len(groups[label]), size=per_class, replace=False)
        selected.extend(groups[label][int(i)] for i in indices)
    rng.shuffle(selected)
    LOG.info("等量采样完成: %s", {label: per_class for label in groups})
    return selected


def save_plot(
    points: np.ndarray,
    labels: Iterable[str],
    predicted_labels: np.ndarray,
    margins: np.ndarray,
    prototype_labels: list[str],
    n_data: int,
    prototype_key: str,
    output: Path,
    annotate: bool,
) -> None:
    labels = np.asarray([str(x).strip() or "(missing)" for x in labels], dtype=object)
    correct = predicted_labels == labels
    scale = float(np.percentile(margins, 95)) if len(margins) else 0.0
    sizes = 18.0 + 52.0 * np.clip(margins / max(scale, 1e-12), 0.0, 1.0)
    fig, ax = plt.subplots(figsize=(11, 8))
    values = sorted(set(labels), key=str)
    cmap = plt.get_cmap("tab20", max(2, len(values)))
    for index, label in enumerate(values):
        mask = labels == label
        ax.scatter(points[:n_data][mask, 0], points[:n_data][mask, 1], s=sizes[mask], alpha=.55, color=cmap(index), label=f"true={label}")
    wrong = ~correct
    if np.any(wrong):
        ax.scatter(points[:n_data][wrong, 0], points[:n_data][wrong, 1], s=sizes[wrong] + 28, marker="x", c="red", linewidths=1.4, label="wrong prediction", zorder=4)
    proto_points = points[n_data:]
    ax.scatter(proto_points[:, 0], proto_points[:, 1], marker="X", s=190, c="black", edgecolors="white", linewidths=1.2, label="prototype", zorder=5)
    for i, point in enumerate(proto_points):
        ax.annotate(prototype_labels[i], point, xytext=(5, 5), textcoords="offset points", fontsize=9, fontweight="bold")
    accuracy = float(np.mean(correct)) if len(correct) else float("nan")
    ax.set_title(f"egs samples and prototypes\n{prototype_key} | cosine prototype accuracy={accuracy:.2%}\npoint size = classification margin")
    ax.set_xlabel("component 1")
    ax.set_ylabel("component 2")
    ax.grid(alpha=.2)
    # Matplotlib < 3.6 uses the singular ``ncol`` keyword.  ``ncols`` was
    # introduced later, so keep the plotting script compatible with the
    # older version commonly installed in training containers.
    ax.legend(loc="best", fontsize=8, ncol=min(3, max(1, len(values))))
    fig.tight_layout()
    output.parent.mkdir(parents=True, exist_ok=True)
    fig.savefig(output, dpi=180, bbox_inches="tight")
    plt.close(fig)


def main() -> None:
    args = parse_args()
    logging.basicConfig(level=logging.INFO, format="%(levelname)s: %(message)s")
    egs_path = args.egs.expanduser().resolve()
    if not egs_path.is_file():
        raise FileNotFoundError(f"egs 文件不存在: {egs_path}")
    LOG.info("egs 文件: %s", egs_path)
    model_dir = args.model_dir.expanduser().resolve() if args.model_dir else None
    if model_dir is not None and not model_dir.is_dir():
        raise NotADirectoryError(f"模型文件夹不存在: {model_dir}")
    inferred_params = model_dir / f"{model_dir.name}.params" if model_dir else None
    inferred_config = model_dir / "config" / "total_params.json" if model_dir else None
    params_path = args.params_path or inferred_params
    config_path = args.config or inferred_config
    if params_path is None:
        raise ValueError("请通过位置参数或 --params-path 指定模型 .params 文件")
    params_path = params_path.expanduser().resolve()
    if config_path is None:
        raise ValueError("请设置 --model-dir，或通过 --config 指定 total_params.json")
    config_path = config_path.expanduser().resolve()
    if not params_path.is_file():
        raise FileNotFoundError(f"模型参数文件不存在: {params_path}")
    if not config_path.is_file():
        raise FileNotFoundError(f"模型配置文件不存在: {config_path}")
    LOG.info("模型参数: %s", params_path)
    LOG.info("模型配置: %s", config_path)
    tensors = load_checkpoint(params_path)
    if args.list_keys:
        for key, value in tensors.items():
            print(f"{key}\t{tuple(value.shape)}\t{value.dtype}")
        return

    prototype_key, prototypes, prototype_class_ids, prototype_within_ids = choose_prototypes(tensors, args.prototype_key)
    # 必须先读取全部行，才能在两个类别中分别无放回抽取相同数量。
    rows = select_equal_binary_rows(read_egs(egs_path, None), args.num_samples, args.seed)
    config = json.loads(config_path.read_text(encoding="utf-8"))
    feat_dim = args.feat_dim or infer_feat_dim(rows[0], egs_path.parent, config)
    num_targets = args.num_targets or int(tensors[prototype_key].shape[0])
    model = load_model(config_path, args.blueprint, tensors, feat_dim, num_targets, args.device)
    data, rows = extract_embeddings(model, rows, egs_path.parent, feat_dim, args.device)
    fields = list(rows[0])
    id_col = _find(fields, ("utt", "utt-id", "utt_id", "key", "id", "eg-id", "eg_id", "sample", "sample-id"))
    label_col = _find(fields, LABEL_NAMES)
    metadata = [
        {"sample_id": row.get(id_col, str(i)) if id_col else str(i),
         "source_label": row.get(label_col, "") if label_col else ""}
        for i, row in enumerate(rows)
    ]
    if data.shape[1] != prototypes.shape[1]:
        raise ValueError(
            f"空间维度不一致：egs={data.shape}, prototype={prototypes.shape}。"
            "这通常表示 egs 中是原始声学特征，而 prototype 位于模型 embedding 空间；"
            "请先用该模型将 egs 提取为 embedding，再把 embedding 文件写入 egs 的 feat 列。"
        )

    true_labels = np.asarray([str(x["source_label"]).strip() or "(missing)" for x in metadata], dtype=object)
    def label_sort_key(value):
        try:
            return (0, float(value))
        except (TypeError, ValueError):
            return (1, str(value))
    class_labels = list(args.class_labels) if args.class_labels else sorted(set(true_labels.tolist()), key=label_sort_key)
    required_classes = int(np.max(prototype_class_ids)) + 1
    if len(class_labels) < required_classes:
        raise ValueError(
            "prototype 有 {0} 个类别，但只得到 {1} 个类别标签；"
            "请使用 --class-labels 按类别索引指定".format(required_classes, len(class_labels))
        )
    prototype_labels = [
        "class={0} / P{1}".format(
            class_labels[int(class_id)] if int(class_id) < len(class_labels) else int(class_id),
            int(within_id),
        )
        for class_id, within_id in zip(prototype_class_ids, prototype_within_ids)
    ]
    similarities, predicted_labels, nearest_proto, best_scores, margins = prototype_predictions(
        data, prototypes, prototype_class_ids, class_labels,
    )
    correct = predicted_labels == true_labels
    LOG.info(
        "余弦 prototype 分类: accuracy=%.2f%%, mean_margin=%.6f",
        100.0 * float(np.mean(correct)), float(np.mean(margins)),
    )

    all_vectors = np.concatenate((data, prototypes), axis=0)
    if not args.no_l2_normalize:
        all_vectors = l2_normalize(all_vectors)
        LOG.info("降维前已对 embedding 和 prototype 做 L2 归一化")
    points = reduce_points(all_vectors, args.method, args.seed)
    save_plot(
        points, true_labels, predicted_labels, margins, prototype_labels,
        len(data), prototype_key, args.output, args.annotate_prototypes,
    )

    csv_path = args.output.with_suffix(".csv")
    with csv_path.open("w", encoding="utf-8-sig", newline="") as stream:
        similarity_columns = [
            "cosine_class_{0}_prototype_{1}".format(int(class_id), int(within_id))
            for class_id, within_id in zip(prototype_class_ids, prototype_within_ids)
        ]
        columns = [
            "type", "id", "label", "predicted_label", "correct",
            "nearest_prototype", "max_cosine", "margin", "x", "y",
            "prototype_class_id", "prototype_within_class_id",
        ] + similarity_columns
        writer = csv.DictWriter(stream, fieldnames=columns)
        writer.writeheader()
        for i, (item, point) in enumerate(zip(metadata, points[:len(data)])):
            row = {
                "type": "egs", "id": item["sample_id"], "label": true_labels[i],
                "predicted_label": predicted_labels[i], "correct": bool(correct[i]),
                "nearest_prototype": prototype_labels[int(nearest_proto[i])],
                "max_cosine": float(best_scores[i]), "margin": float(margins[i]),
                "x": float(point[0]), "y": float(point[1]),
                "prototype_class_id": "", "prototype_within_class_id": "",
            }
            row.update({name: float(similarities[i, j]) for j, name in enumerate(similarity_columns)})
            writer.writerow(row)
        for i, point in enumerate(points[len(data):]):
            class_id = int(prototype_class_ids[i])
            writer.writerow({
                "type": "prototype", "id": prototype_labels[i],
                "label": class_labels[class_id] if class_id < len(class_labels) else str(class_id),
                "x": float(point[0]), "y": float(point[1]),
                "prototype_class_id": class_id,
                "prototype_within_class_id": int(prototype_within_ids[i]),
            })
    LOG.info("prototype: %s %s; egs: %s", prototype_key, prototypes.shape, data.shape)
    LOG.info("已生成 %s 和 %s", args.output.resolve(), csv_path.resolve())


if __name__ == "__main__":
    main()
