#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""Visualize learned prototype vectors together with vectors referenced by egs.

The checkpoint may be a raw state_dict or a training checkpoint containing one.
Prototype tensors are detected by name, or can be selected with --prototype-key.
Both prototype and egs vectors must belong to the same feature space.

Example (GPU)::

    python visualize_prototypes_egs.py train.egs.csv --model-dir /path/to/260601 \
      --blueprint res_se_p.py \
      --prototype-key loss.prototypes --num-samples 1000 \
      --feat-dim 40 --device cuda:0 --output prototype_egs.png

Example (CPU)::

    python visualize_prototypes_egs.py train.egs.csv --model-dir /path/to/260601 \
      --blueprint res_se_p.py \
      --num-samples 200 --feat-dim 40 --device cpu
"""

from __future__ import annotations

import argparse
import csv
import importlib.util
import json
import logging
from pathlib import Path
from typing import Any, Dict, Iterable, Optional, Tuple

import matplotlib.pyplot as plt
import numpy as np
from sklearn.decomposition import PCA
from sklearn.manifold import TSNE

from kmeans_egs import (
    END_NAMES, FEATURE_NAMES, LABEL_NAMES, START_NAMES, _find, load_feature, read_egs,
)


LOG = logging.getLogger("visualize-prototypes-egs")
PROTOTYPE_WORDS = ("prototype", "prototypes", "protos", "centroid", "centroids")


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="读取 .params 中的 prototype，与 egs 数据点共同降维并可视化。",
        formatter_class=argparse.RawTextHelpFormatter,
        epilog="""
