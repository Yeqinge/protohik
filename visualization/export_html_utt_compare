#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
export_html_utt_compare.py —— 多模型 Utterance 级贡献度对比可视化工具 v1.1

用法（推荐）：只传模型 ID，脚本自动拼路径
  python export_html_utt_compare.py \
    --ids 260612z7 260612z8 260612z9 \
    --output compare.html

  路径自动解析为：
    <BASE_DIR>/<model_id>/contrib
  BASE_DIR 默认为 model_exp/fbank_20k_test5/fiber_train
  可通过 --base 覆盖：
    --base /data/model_exp/fbank_20k_test5/fiber_train

用法（兼容旧版）：完整指定路径
  python export_html_utt_compare.py \
    --models modelA:/path/to/A/contrib modelB:/path/to/B/contrib \
    --output compare.html

contrib目录内需含：
  - contrib_epoch*.npz
  - contrib_summary_with_uttid.csv 或 contrib_summary.csv

可选参数：
  --base   <基础目录>           模型根目录，默认 model_exp/fbank_20k_test5/fiber_train
  --ids    <id1> <id2> ...      模型 ID 列表（自动拼路径，与 --models 二选一）
  --models <name:path> ...      完整路径模式（兼容旧版）
  --egs    <name:path> ...      各模型的 train.egs.csv（可选）
  --meta   <path>               共用 JSON 元信息（可选）
  --output <html文件名>

对比特性：
  - 左侧列表：同一 utterance，并排显示各模型 tag / mean_si / mean_gn
  - 右侧：同坐标系叠加各模型轨迹曲线（grad_norm / align / weight）
  - 颜色差异化区分模型
  - 支持按"某模型 tag"或"模型间 si 差值"排序/过滤
  - 导出包含所有模型列的 CSV
"""

import argparse
import csv
import glob
import os
import re
import sys
import json
import numpy as np
from collections import defaultdict

TAG_MAP   = {"harmful_suspect": 0, "hard": 1, "high_influence": 2, "easy_redundant": 3, "normal": 4}
TAG_NAMES = ["harmful_suspect", "hard", "high_influence", "easy_redundant", "normal"]

# 模型调色板（最多支持 8 个模型）
MODEL_COLORS = [
    "#2563eb",  # blue
    "#dc2626",  # red
    "#16a34a",  # green
    "#ea580c",  # orange
    "#7c3aed",  # purple
    "#0891b2",  # cyan
    "#b45309",  # amber
    "#be185d",  # pink
]
MODEL_COLORS_ALPHA = [
    "rgba(37,99,235,0.12)",
    "rgba(220,38,38,0.12)",
    "rgba(22,163,74,0.12)",
    "rgba(234,88,12,0.12)",
    "rgba(124,58,237,0.12)",
    "rgba(8,145,178,0.12)",
    "rgba(180,83,9,0.12)",
    "rgba(190,24,93,0.12)",
]

def fv(row, key):
    try:    return float(row.get(key, "nan"))
    except: return float("nan")

def strip_chunk_suffix(utt_id):
    return re.sub(r'-\d+$', '', utt_id)

_LABEL_PREFIXES = re.compile(
    r'^(?:abnormal|normal|hard|unknown|noise|fault|'
    r'harmful_suspect|high_influence|easy_redundant)-',
    re.IGNORECASE
)

def strip_label_prefix(utt_id):
    return _LABEL_PREFIXES.sub('', utt_id)

def normalize_uid(raw):
    key = strip_chunk_suffix(raw)
    key = strip_label_prefix(key)
    key = re.sub(r'\.wav$', '', key, flags=re.IGNORECASE)
    key = os.path.basename(key)
    return key


def load_model_data(name, contrib_dir, egs_path=""):
    """加载单个模型的所有数据，返回 dict。"""
    print(f"\n  ── 模型 [{name}] ──")
    print(f"     目录: {os.path.abspath(contrib_dir)}")

    # 1. Summary CSV
    sp = ""
    for nm in ("contrib_summary_with_uttid.csv", "contrib_summary.csv"):
        p = os.path.join(contrib_dir, nm)
        if os.path.exists(p):
            sp = p
            break
    if not sp:
        print(f"  ❌ [{name}] 找不到 summary CSV，跳过")
        return None

    egs_rows = []
    with open(sp, newline="", encoding="utf-8") as f:
        for r in csv.DictReader(f):
            egs_rows.append(r)
    n_egs = len(egs_rows)
    print(f"     egs 样本数: {n_egs}")

    # 2. idx → utt_id 映射
    idx2utt = {}
    if egs_path and os.path.exists(egs_path):
        with open(egs_path, encoding="utf-8") as f:
            first = f.readline()
            delim = "\t" if "\t" in first else " "
        egs_uttid2lineno = {}
        with open(egs_path, encoding="utf-8") as f:
            data_i = 0
            for line in f:
                p = line.strip().split(delim)
                if not p or not p[0]: continue
                if not any(c.isdigit() for c in p[0]): continue
                egs_uttid2lineno[p[0]] = data_i
                data_i += 1
        lineno2uttid = {v: k for k, v in egs_uttid2lineno.items()}
        for i, row in enumerate(egs_rows):
            csv_id = row.get("id", "")
            try:
                lineno = int(csv_id)
                raw = lineno2uttid.get(lineno)
                if raw:
                    idx2utt[i] = raw
            except (ValueError, TypeError):
                pass
    elif egs_rows and "utt_id" in egs_rows[0]:
        idx2utt = {i: r["utt_id"] for i, r in enumerate(egs_rows) if r.get("utt_id")}

    # 3. Epoch 轨迹
    files = sorted(glob.glob(os.path.join(contrib_dir, "contrib_epoch*.npz")))
    print(f"     .npz 文件数: {len(files)}")

    id2idx_egs = {r["id"]: i for i, r in enumerate(egs_rows)}
    epochs = []
    gn_egs = al_egs = wt_egs = None
    has_traj   = len(files) > 0
    has_weight = False

    if has_traj:
        ne = len(files)
        gn_egs = np.full((n_egs, ne), np.nan, dtype=np.float32)
        al_egs = np.full((n_egs, ne), np.nan, dtype=np.float32)
        wt_egs = np.full((n_egs, ne), np.nan, dtype=np.float32)

        for ei, fp in enumerate(files):
            ep = int(os.path.basename(fp)[len("contrib_epoch"):-len(".npz")])
            epochs.append(ep)
            d = np.load(fp, allow_pickle=True)
            ids_str = d["ids"].astype(str)
            idxs = np.array([id2idx_egs.get(s, -1) for s in ids_str], dtype=np.int64)
            m = idxs >= 0
            gn_egs[idxs[m], ei] = d["grad_norm"][m]
            al_egs[idxs[m], ei] = d["align"][m]
            if "focal_weight" in d:
                has_weight = True
                wt_egs[idxs[m], ei] = d["focal_weight"][m]
            if ei == 0 and "utt_ids" in d and len(idx2utt) == 0:
                utt_ids_npz = d["utt_ids"].astype(str)
                for k in range(len(ids_str)):
                    egs_i = idxs[k]
                    if egs_i >= 0:
                        idx2utt[egs_i] = utt_ids_npz[k]
        epochs = sorted(epochs)

    # 4. 聚合到 utterance
    utt2chunks = defaultdict(list)
    for i, row in enumerate(egs_rows):
        raw = idx2utt.get(i, row.get("id", str(i)))
        key = normalize_uid(raw)
        utt2chunks[key].append(i)

    utt_ids_list = sorted(utt2chunks.keys())
    n_utt = len(utt_ids_list)
    print(f"     utterance 数: {n_utt}  (has_traj={has_traj}, has_weight={has_weight})")

    utt_data = {}
    for utt_id in utt_ids_list:
        chunk_idxs = utt2chunks[utt_id]
        nc = len(chunk_idxs)

        def arr(key): return [fv(egs_rows[i], key) for i in chunk_idxs]
        def sm(lst):  v=[x for x in lst if not np.isnan(x)]; return float(np.mean(v)) if v else float("nan")
        def sx(lst):  v=[x for x in lst if not np.isnan(x)]; return float(np.max(v))  if v else float("nan")
        def sd(lst):  v=[x for x in lst if not np.isnan(x)]; return float(np.std(v))  if len(v)>1 else 0.0

        si = arr("self_influence"); gn = arr("mean_grad_norm")
        al = arr("mean_align");     fn = arr("frac_neg_align")
        fo = arr("forget_events");  fc = arr("final_correct")

        tags     = [TAG_MAP.get(egs_rows[i].get("tag", "normal"), 4) for i in chunk_idxs]
        worst_tag = min(tags)

        gn_traj = al_traj = wt_traj = None
        mean_wt = float("nan"); wt_std = 0.0
        if has_traj:
            gn_traj = np.nanmean(gn_egs[chunk_idxs, :], axis=0)
            al_traj = np.nanmean(al_egs[chunk_idxs, :], axis=0)
            if has_weight:
                wt_traj = np.nanmean(wt_egs[chunk_idxs, :], axis=0)
                wt_flat  = wt_egs[chunk_idxs, :].flatten()
                wt_valid = wt_flat[~np.isnan(wt_flat)]
                if len(wt_valid):
                    mean_wt = float(np.mean(wt_valid))
                    wt_std  = float(np.std(wt_valid)) if len(wt_valid) > 1 else 0.0

        utt_data[utt_id] = dict(
            n_chunks=nc,
            mean_si=sm(si), max_si=sx(si),
            mean_gn=sm(gn), max_gn=sx(gn), gn_std=sd(gn),
            mean_al=sm(al), mean_fn=sm(fn),
            mean_fo=sm(fo), mean_fc=sm(fc),
            mean_wt=mean_wt, wt_std=wt_std,
            worst_tag=worst_tag,
            gn_traj=gn_traj, al_traj=al_traj, wt_traj=wt_traj,
        )

    return dict(
        name=name,
        utt_data=utt_data,
        epochs=epochs,
        has_traj=has_traj,
        has_weight=has_weight,
        n_egs=n_egs,
    )


def pack_model_bin(model_info, utt_ids_union, out_prefix):
    """把单个模型数据打包为 .bin，返回参数 dict 供 HTML 使用。"""
    utt_data = model_info["utt_data"]
    epochs   = model_info["epochs"]
    ne       = len(epochs)
    n_u      = len(utt_ids_union)
    has_traj   = model_info["has_traj"] and ne > 0
    has_weight = model_info["has_weight"]

    n_chunks_arr = np.zeros(n_u, dtype=np.int16)
    mean_si_arr  = np.full(n_u, np.nan, dtype=np.float32)
    max_si_arr   = np.full(n_u, np.nan, dtype=np.float32)
    mean_gn_arr  = np.full(n_u, np.nan, dtype=np.float32)
    max_gn_arr   = np.full(n_u, np.nan, dtype=np.float32)
    gn_std_arr   = np.zeros(n_u, dtype=np.float32)
    mean_al_arr  = np.full(n_u, np.nan, dtype=np.float32)
    mean_fn_arr  = np.full(n_u, np.nan, dtype=np.float32)
    mean_wt_arr  = np.full(n_u, np.nan, dtype=np.float32)
    wt_std_arr   = np.zeros(n_u, dtype=np.float32)
    tags_arr     = np.full(n_u, 4, dtype=np.uint8)

    gn_mat = np.full((n_u, ne), np.nan, dtype=np.float32) if has_traj else None
    al_mat = np.full((n_u, ne), np.nan, dtype=np.float32) if has_traj else None
    wt_mat = np.full((n_u, ne), np.nan, dtype=np.float32) if (has_traj and has_weight) else None

    for ui, uid in enumerate(utt_ids_union):
        d = utt_data.get(uid)
        if d is None:
            continue
        n_chunks_arr[ui] = d["n_chunks"]
        mean_si_arr[ui]  = d["mean_si"]
        max_si_arr[ui]   = d["max_si"]
        mean_gn_arr[ui]  = d["mean_gn"]
        max_gn_arr[ui]   = d["max_gn"]
        gn_std_arr[ui]   = d["gn_std"]
        mean_al_arr[ui]  = d["mean_al"]
        mean_fn_arr[ui]  = d["mean_fn"]
        mean_wt_arr[ui]  = d["mean_wt"]
        wt_std_arr[ui]   = d["wt_std"]
        tags_arr[ui]     = d["worst_tag"]
        if has_traj and d.get("gn_traj") is not None:
            t_ne = len(d["gn_traj"])
            gn_mat[ui, :t_ne] = d["gn_traj"][:t_ne]
            al_mat[ui, :t_ne] = d["al_traj"][:t_ne]
            if has_weight and d.get("wt_traj") is not None:
                wt_mat[ui, :t_ne] = d["wt_traj"][:t_ne]

    # 量化
    gn_min = 0.0; gn_scale = 1.0
    wt_min = 0.0; wt_scale = 1.0
    gn_mat_u8 = al_mat_u8 = wt_mat_u8 = None

    if has_traj:
        valid_gn = gn_mat[~np.isnan(gn_mat)]
        if len(valid_gn):
            gn_min   = float(np.nanpercentile(valid_gn, 1))
            gn_scale = max(float(np.nanpercentile(valid_gn, 99)) - gn_min, 1e-9)
        gq = np.clip((gn_mat - gn_min) / gn_scale * 254, 0, 254); gq[np.isnan(gn_mat)] = 255
        aq = np.clip((al_mat + 1.0) / 2.0 * 253, 0, 253);          aq[np.isnan(al_mat)] = 254
        gn_mat_u8 = gq.astype(np.uint8)
        al_mat_u8 = aq.astype(np.uint8)

        if has_weight and wt_mat is not None:
            valid_wt = wt_mat[~np.isnan(wt_mat)]
            if len(valid_wt):
                wt_min   = float(np.nanmin(wt_mat))
                wt_scale = max(float(np.nanpercentile(valid_wt, 99)) - wt_min, 1e-9)
            wq = np.clip((wt_mat - wt_min) / wt_scale * 253, 0, 253); wq[np.isnan(wt_mat)] = 254
            wt_mat_u8 = wq.astype(np.uint8)

    flags = (1 if has_traj else 0) | (2 if has_weight else 0)
    utt_bytes = "\n".join(utt_ids_union).encode("utf-8")
    utt_len   = len(utt_bytes)

    bin_path = out_prefix + ".bin"
    with open(bin_path, "wb") as fb:
        fb.write(np.array([n_u, ne, utt_len, flags], dtype=np.int32).tobytes())
        fb.write(np.array([gn_min, gn_scale], dtype=np.float32).tobytes())
        fb.write(np.array([wt_min, wt_scale], dtype=np.float32).tobytes())
        fb.write(b"\x00" * 48)
        for a in [n_chunks_arr, mean_si_arr, max_si_arr,
                  mean_gn_arr, max_gn_arr, gn_std_arr,
                  mean_al_arr, mean_fn_arr,
                  mean_wt_arr, wt_std_arr,
                  tags_arr]:
            fb.write(a.tobytes())
        fb.write(utt_bytes)
        if has_traj and gn_mat_u8 is not None:
            fb.write(gn_mat_u8.flatten().tobytes())
            fb.write(al_mat_u8.flatten().tobytes())
            if has_weight and wt_mat_u8 is not None:
                fb.write(wt_mat_u8.flatten().tobytes())

    size_mb = os.path.getsize(bin_path) / 1e6
    print(f"     → {os.path.basename(bin_path)}  {size_mb:.2f} MB")
    return dict(
        bin_filename=os.path.basename(bin_path),
        epochs=epochs,
        has_traj=has_traj,
        has_weight=has_weight,
        flags=flags,
    )


def main():
    print("\n" + "="*60)
    print("🚀 [START] 多模型对比分析脚本 v1.1 启动...")
    print("="*60)

    DEFAULT_BASE = "model_exp/fbank_20k_test5/fiber_train"
    CONTRIB_SUB  = "contrib"

    ap = argparse.ArgumentParser(
        description="多模型 Utterance 级贡献度对比 HTML 生成器",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=(
            "示例（推荐）:\n"
            "  %(prog)s --ids 260612z7 260612z8 260612z9\n\n"
            "  路径自动解析为 BASE/ID/contrib\n"
            "  BASE 默认为 model_exp/fbank_20k_test5/fiber_train\n\n"
            "示例（自定义 BASE）:\n"
            "  %(prog)s --ids 260612z7 260612z8 --base /data/models/fiber_train\n\n"
            "示例（完整路径，兼容旧版）:\n"
            "  %(prog)s --models A:/path/to/A/contrib B:/path/to/B/contrib"
        ),
    )
    ap.add_argument("--ids", nargs="+", default=[],
                    metavar="MODEL_ID",
                    help="模型 ID，例如 260612z7 260612z8；自动拼接 BASE/ID/contrib 路径")
    ap.add_argument("--base", default=DEFAULT_BASE,
                    metavar="DIR",
                    help=f"模型根目录（默认: {DEFAULT_BASE}）")
    ap.add_argument("--models", nargs="*", default=[],
                    metavar="NAME:PATH",
                    help="完整路径模式：<名称>:<contrib目录>，与 --ids 可混用")
    ap.add_argument("--egs", default="",
                    metavar="PATH",
                    help="共用 train.egs.csv 路径（所有模型样本名相同时使用）")
    ap.add_argument("--meta", default="", metavar="FILE",
                    help="可选：共用 JSON 元信息文件")
    ap.add_argument("--output", default="compare_utt.html", metavar="FILE",
                    help="输出 HTML 文件名（默认: compare_utt.html）")
    args = ap.parse_args()

    if not args.ids and not args.models:
        ap.error("请至少提供 --ids <模型ID...> 或 --models <名称:路径...> 之一")

    # ── 解析模型列表 ──
    model_specs = {}

    # --ids：自动拼路径，模型名即为 ID
    for model_id in args.ids:
        contrib_path = os.path.join(args.base, model_id, CONTRIB_SUB)
        abs_path = os.path.abspath(contrib_path)
        if not os.path.isdir(abs_path):
            print(f"  ⚠️  [{model_id}] 目录不存在，已跳过: {abs_path}")
            continue
        model_specs[model_id] = abs_path

    # --models：旧格式 name:path，允许与 --ids 混用
    for spec in (args.models or []):
        if ":" not in spec:
            print(f"❌ --models 格式错误: {spec!r}，应为 <名称>:<路径>")
            sys.exit(1)
        name, pth = spec.split(":", 1)
        model_specs[name] = pth

    if not model_specs:
        print(f"❌ 没有可用的模型目录。")
        print(f"   BASE = {os.path.abspath(args.base)}")
        print(f"   请确认 --ids 中的 ID 在该目录下存在 <ID>/contrib/ 子目录")
        sys.exit(1)

    shared_egs = args.egs.strip() if args.egs else ""
    if shared_egs and not os.path.exists(shared_egs):
        print(f"  ⚠️  --egs 文件不存在，已忽略: {shared_egs}")
        shared_egs = ""

    print(f"\n📋 模型列表:")
    for name, pth in model_specs.items():
        print(f"   [{name}]  →  {os.path.abspath(pth)}")

    # ── 0. 加载 meta ──
    meta_map = {}
    if args.meta and os.path.exists(args.meta):
        print(f"\n[0] 加载 JSON 元信息: {args.meta}")
        with open(args.meta, encoding="utf-8") as f:
            jdata = json.load(f)
        items = jdata if isinstance(jdata, list) else jdata.get("datas", jdata.get("data", []))

        # 打印第一条的所有字段名，方便排查 key 映射
        if items:
            print(f"   JSON 字段预览（第一条）: {list(items[0].keys())[:12]}")

        for item in items:
            entry = {k: item.get(k, "") for k in
                     ["file_path","label","detector_id","channel_id","project","duration","time_point"]}

            # 尝试所有可能存放 ID 的字段
            id_val = (item.get("file_path","") or item.get("ID","")
                      or item.get("id","") or item.get("utt_id","")
                      or item.get("wav_path","") or item.get("path",""))
            raw_stem = re.sub(r"\.wav$","", os.path.basename(id_val), flags=re.IGNORECASE)

            # 用 normalize_uid 完全对齐 utt_ids_union 的处理方式
            normed = normalize_uid(raw_stem) if raw_stem else ""

            # 建立所有变体 key
            for k in set(filter(None, [
                raw_stem,
                normed,
                re.sub(r"-\d+$", "", raw_stem),
                re.sub(r"-\d+$", "", normed),
                _LABEL_PREFIXES.sub("", raw_stem),
                _LABEL_PREFIXES.sub("", normed),
            ])):
                meta_map[k] = entry

        print(f"   元信息条目: {len(items)} 条，建立索引 key: {len(meta_map)} 个")
        if items:
            # 打印几个 key 样本方便对比
            sample_keys = list(meta_map.keys())[:5]
            print(f"   meta key 样本: {sample_keys}")

    # ── 1. 逐模型加载 ──
    print("\n[1] 加载各模型数据 ...")
    models_data = {}
    for name, path in model_specs.items():
        result = load_model_data(name, path, shared_egs)
        if result:
            models_data[name] = result

    if not models_data:
        print("❌ 没有成功加载任何模型数据")
        sys.exit(1)

    # ── 2. 求 utterance 并集，按第一个模型的 mean_si 排序 ──
    print("\n[2] 建立 utterance 并集 ...")
    all_uids = set()
    for md in models_data.values():
        all_uids.update(md["utt_data"].keys())

    first_model = list(models_data.values())[0]
    def sort_key(uid):
        d = first_model["utt_data"].get(uid)
        if d and not np.isnan(d["mean_si"]):
            return d["mean_si"]
        return -1e9

    utt_ids_union = sorted(all_uids, key=sort_key, reverse=True)
    n_union = len(utt_ids_union)
    print(f"   总 utterance 数（并集）: {n_union}")

    # 统计各模型覆盖率
    for name, md in models_data.items():
        cov = sum(1 for u in utt_ids_union if u in md["utt_data"])
        print(f"   [{name}] 覆盖: {cov}/{n_union} ({100*cov/max(n_union,1):.1f}%)")

    # ── 3. 打包各模型 .bin ──
    print("\n[3] 打包各模型二进制 ...")
    out_base  = os.path.splitext(args.output)[0]
    model_bin_info = {}  # name -> pack info

    for name, md in models_data.items():
        safe_name = re.sub(r'[^\w\-]', '_', name)
        prefix = f"{out_base}_{safe_name}"
        info = pack_model_bin(md, utt_ids_union, prefix)
        model_bin_info[name] = info

    # ── 4. 导出 meta JSON ──
    hit_meta = sum(1 for uid in utt_ids_union if meta_map.get(uid))
    print(f"\n   meta 命中: {hit_meta}/{len(utt_ids_union)} utterances")
    if hit_meta == 0 and meta_map:
        print(f"   ⚠️  meta 全部未命中，key 对比:")
        print(f"      utt_id 样本: {list(utt_ids_union)[:3]}")
        print(f"      meta key 样本: {list(meta_map.keys())[:3]}")

    meta_out = []
    for uid in utt_ids_union:
        m = (meta_map.get(uid)
             or meta_map.get(re.sub(r"-\d+$", "", uid))
             or meta_map.get(_LABEL_PREFIXES.sub("", uid))
             or meta_map.get(re.sub(r"-\d+$", "", _LABEL_PREFIXES.sub("", uid)))
             or {})
        meta_out.append({
            "file_path":   m.get("file_path",""),
            "label":       m.get("label",""),
            "detector_id": m.get("detector_id",""),
            "channel_id":  m.get("channel_id",""),
            "project":     m.get("project",""),
            "duration":    str(m.get("duration","")),
            "time_point":  m.get("time_point",""),
        })
    meta_json_name = out_base + "_meta.json"
    with open(meta_json_name, "w", encoding="utf-8") as f:
        json.dump(meta_out, f, ensure_ascii=False)
    print(f"\n   ✅ meta JSON → {meta_json_name}")

    # ── 5. 导出 CSV ──
    csv_path = out_base + "_compare_summary.csv"
    model_names = list(models_data.keys())
    base_fields = ["utt_id"]
    for nm in model_names:
        base_fields += [f"{nm}_mean_si", f"{nm}_max_si", f"{nm}_mean_gn",
                        f"{nm}_mean_al", f"{nm}_mean_wt", f"{nm}_tag"]
    with open(csv_path, "w", newline="", encoding="utf-8") as f:
        w = csv.DictWriter(f, fieldnames=base_fields)
        w.writeheader()
        for uid in utt_ids_union:
            row = {"utt_id": uid}
            for nm in model_names:
                d = models_data[nm]["utt_data"].get(uid, {})
                def fmt(v): return "" if (isinstance(v,float) and np.isnan(v)) else round(v,6) if isinstance(v,float) else v
                row[f"{nm}_mean_si"] = fmt(d.get("mean_si", float("nan")))
                row[f"{nm}_max_si"]  = fmt(d.get("max_si",  float("nan")))
                row[f"{nm}_mean_gn"] = fmt(d.get("mean_gn", float("nan")))
                row[f"{nm}_mean_al"] = fmt(d.get("mean_al", float("nan")))
                row[f"{nm}_mean_wt"] = fmt(d.get("mean_wt", float("nan")))
                row[f"{nm}_tag"]     = TAG_NAMES[d.get("worst_tag", 4)] if d else ""
            w.writerow(row)
    print(f"   ✅ CSV → {csv_path}")

    # ── 6. 生成 HTML ──
    print("\n[4] 生成 HTML ...")
    names_list    = list(model_bin_info.keys())
    bin_files     = [model_bin_info[n]["bin_filename"]  for n in names_list]
    epochs_list   = [model_bin_info[n]["epochs"]        for n in names_list]
    has_weight_any = any(model_bin_info[n]["has_weight"] for n in names_list)

    html = make_html(
        model_names=names_list,
        bin_filenames=bin_files,
        meta_filename=os.path.basename(meta_json_name),
        epochs_list=epochs_list,
        n_u=n_union,
        has_weight_any=has_weight_any,
        colors=MODEL_COLORS[:len(names_list)],
        colors_alpha=MODEL_COLORS_ALPHA[:len(names_list)],
    )
    with open(args.output, "w", encoding="utf-8") as f:
        f.write(html)
    print(f"   ✅ HTML → {os.path.abspath(args.output)}")
    print(f"\n{'='*60}")
    print(f"✨ 完成！共 {n_union} utterances，{len(names_list)} 个模型")
    print(f"{'='*60}\n")



# ─────────────────────────────────────────────────────────────────
#  HTML 生成（读取外部模板文件 compare_utt_template.html）
# ─────────────────────────────────────────────────────────────────

def make_html(model_names, bin_filenames, meta_filename,
              epochs_list, n_u, has_weight_any, colors, colors_alpha):

    n_models = len(model_names)
    per_model_cols = " ".join(["64px 76px"] * n_models)
    grid_cols      = "36px 1fr " + per_model_cols

    model_names_js   = json.dumps(model_names)
    bin_filenames_js = json.dumps(bin_filenames)
    epochs_list_js   = json.dumps(epochs_list)
    colors_js        = json.dumps(colors)
    colors_alpha_js  = json.dumps(colors_alpha)

    # 列头 HTML（纯字符串拼接，无 f-string 转义歧义）
    SQ = chr(39)
    th_cells  = '<span class="th" onclick="setSort(' + SQ + 'rank' + SQ + ')" id="th-rank">#<span class="arrow"></span></span>'
    th_cells += '<span class="th" onclick="setSort(' + SQ + 'uid'  + SQ + ')" id="th-uid">utt_id<span class="arrow"></span></span>'
    for i, nm in enumerate(model_names):
        sort_si  = "si_"  + str(i)
        sort_tag = "tag_" + str(i)
        col = colors[i]
        th_cells += (
            '<span class="th th-r model-th" onclick="setSort(' + SQ + sort_si + SQ + ')"'
            ' id="th-si-' + str(i) + '" style="color:' + col + '">'
            '<span class="th-dot" style="background:' + col + '"></span>'
            + nm[:8] + ' si<span class="arrow"></span></span>'
        )
        th_cells += (
            '<span class="th th-c" onclick="setSort(' + SQ + sort_tag + SQ + ')"'
            ' id="th-tag-' + str(i) + '">tag<span class="arrow"></span></span>'
        )

    weight_tab_html = (
        '<div class="tab" data-tab="wt" onclick="switchTab(' + SQ + 'wt' + SQ + ')">weight</div>'
        if has_weight_any else ""
    )
    weight_panel_html = (
        '<div id="tab-wt" class="tab-panel">'
        '<div class="chart-block">'
        '<div class="chart-block-title">weight \u8f68\u8ff9\uff08\u5404\u6a21\u578b\u53e0\u52a0\uff09</div>'
        '<div class="chart-wrap"><canvas id="chartWt"></canvas></div>'
        '</div></div>'
        if has_weight_any else ""
    )

    # 读取同目录下的模板文件
    tmpl_path = os.path.join(os.path.dirname(os.path.abspath(__file__)),
                             "compare_utt_template.html")
    if not os.path.exists(tmpl_path):
        print(f"❌ 找不到模板文件: {tmpl_path}")
        print(f"   请确保 compare_utt_template.html 与本脚本在同一目录")
        sys.exit(1)

    with open(tmpl_path, encoding="utf-8") as f:
        tmpl = f.read()

    subs = {
        "@@grid_cols@@":         grid_cols,
        "@@th_cells@@":          th_cells,
        "@@model_names_js@@":    model_names_js,
        "@@bin_filenames_js@@":  bin_filenames_js,
        "@@meta_filename@@":     meta_filename,
        "@@epochs_list_js@@":    epochs_list_js,
        "@@colors_js@@":         colors_js,
        "@@colors_alpha_js@@":   colors_alpha_js,
        "@@HAS_WEIGHT_JS@@":     "true" if has_weight_any else "false",
        "@@WEIGHT_TAB_HTML@@":   weight_tab_html,
        "@@WEIGHT_PANEL_HTML@@": weight_panel_html,
    }
    for key, val in subs.items():
        tmpl = tmpl.replace(key, val)
    return tmpl


