<script>
const MODEL_NAMES   = {model_names_js};
const BIN_FILES     = {bin_filenames_js};
const EPOCHS_LIST   = {epochs_list_js};
const COLORS        = {colors_js};
const COLORS_ALPHA  = {colors_alpha_js};
const META_URL      = "{meta_filename}";
const N_MODELS      = MODEL_NAMES.length;
const TAG_NAMES     = ["harmful_suspect","hard","high_influence","easy_redundant","normal"];
const HAS_WEIGHT_ANY= {"true" if has_weight_any else "false"};

// 每个模型的数组
const MDL = Array.from({{length:N_MODELS}},()=>({{}}));

const PAGE=100, ROW_H=36;
let filtered=null, pageStart=0, selIdx=-1;
let charts={{}};
let stimer=null;
let sortKey='si_0', sortAsc=false;
let activeTab='gn';
let META=null;

// 差值统计（预计算）
let siRanges=null;  // [p25, p75] of max(si spread) across utterances

// ── 加载所有模型 ──
async function loadAll(){{
  let _N=0;
  for(let mi=0;mi<N_MODELS;mi++){{
    try{{
      const res=await fetch(BIN_FILES[mi]);
      if(!res.ok) throw new Error(`无法读取 ${{BIN_FILES[mi]}}`);
      const buf=await res.arrayBuffer();
      const header=new Int32Array(buf,0,4);
      _N=header[0]; const ne=header[1]; const uttLen=header[2]; const flags=header[3];
      const HAS_TRAJ=(flags&1)===1; const HAS_WTF=(flags&2)===2;
      const mf=new Float32Array(buf,16,4);
      const GN_MIN=mf[0],GN_SC=mf[1],WT_MIN=mf[2],WT_SC=mf[3];
      let o=80;
      const N_CHUNKS=new Int16Array(buf,o,_N);   o+=_N*2;
      const MEAN_SI =new Float32Array(buf,o,_N); o+=_N*4;
      const MAX_SI  =new Float32Array(buf,o,_N); o+=_N*4;
      const MEAN_GN =new Float32Array(buf,o,_N); o+=_N*4;
      const MAX_GN  =new Float32Array(buf,o,_N); o+=_N*4;
      const GN_STD  =new Float32Array(buf,o,_N); o+=_N*4;
      const MEAN_AL =new Float32Array(buf,o,_N); o+=_N*4;
      const MEAN_FN =new Float32Array(buf,o,_N); o+=_N*4;
      const MEAN_WT =new Float32Array(buf,o,_N); o+=_N*4;
      const WT_STD  =new Float32Array(buf,o,_N); o+=_N*4;
      const TAGS    =new Uint8Array(buf,o,_N);   o+=_N*1;
      // UTT_IDS shared from first model
      const uttBytes=new Uint8Array(buf,o,uttLen);
      const UTT_IDS=new TextDecoder("utf-8").decode(uttBytes).split('\\n'); o+=uttLen;
      let GN_U8=null,AL_U8=null,WT_U8=null;
      if(HAS_TRAJ&&ne>0){{
        const ts=_N*ne;
        GN_U8=new Uint8Array(buf,o,ts); o+=ts;
        AL_U8=new Uint8Array(buf,o,ts); o+=ts;
        if(HAS_WTF){{ WT_U8=new Uint8Array(buf,o,ts); }}
      }}
      MDL[mi]={{N:_N,NE:ne,HAS_TRAJ,HAS_WTF,GN_MIN,GN_SC,WT_MIN,WT_SC,
               N_CHUNKS,MEAN_SI,MAX_SI,MEAN_GN,MAX_GN,GN_STD,MEAN_AL,MEAN_FN,
               MEAN_WT,WT_STD,TAGS,UTT_IDS,GN_U8,AL_U8,WT_U8,EPOCHS:EPOCHS_LIST[mi]}};
    }}catch(e){{
      console.error('加载模型失败',mi,e);
      MDL[mi]={{N:0}};
    }}
  }}

  // meta
  try{{
    const mr=await fetch(META_URL);
    if(mr.ok) META=await mr.json();
  }}catch(e){{}}

  // 填充 model-tag-f
  const mtf=document.getElementById('model-tag-f');
  MODEL_NAMES.forEach((nm,i)=>{{
    const o=document.createElement('option'); o.value=i; o.textContent=nm; mtf.appendChild(o);
  }});

  // header pills
  const hb=document.getElementById('hbadges');
  hb.innerHTML='';
  MODEL_NAMES.forEach((nm,i)=>{{
    const p=document.createElement('span'); p.className='model-pill';
    p.innerHTML=`<span class="model-dot" style="background:${{COLORS[i]}}"></span>${{nm}}`;
    hb.appendChild(p);
  }});
