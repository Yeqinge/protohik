}}

function extractTraj(mi,idx,type){{
  const m=MDL[mi]; if(!m.HAS_TRAJ) return {{labels:[],data:[]}};
  const ne=m.NE||0; if(!ne) return {{labels:[],data:[]}};
  let u8, MIN, SC, NULL_VAL;
  if(type==='gn')      {{u8=m.GN_U8; MIN=m.GN_MIN; SC=m.GN_SC; NULL_VAL=255;}}
  else if(type==='al') {{u8=m.AL_U8; MIN=-1; SC=2; NULL_VAL=254;}}
  else if(type==='wt') {{u8=m.WT_U8; MIN=m.WT_MIN; SC=m.WT_SC; NULL_VAL=254;}}
  if(!u8) return {{labels:[],data:[]}};
  const data=[];
  for(let e=0;e<ne;e++){{
    const b=idx*ne+e;
    if(type==='al') data.push(u8[b]===NULL_VAL?null:(u8[b]/253)*2-1);
    else if(type==='gn'){{
      const v=u8[b]===NULL_VAL?null:MIN+(u8[b]/254)*SC;
      data.push(v!=null&&v>0?v:v!=null?MIN:null);
    }}else data.push(u8[b]===NULL_VAL?null:MIN+(u8[b]/253)*SC);
  }}
  return {{labels:getEpochLabels(mi), data}};
}}

