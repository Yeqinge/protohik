function rebuild(){{
  const tagF =parseInt(document.getElementById('tag-f').value);
  const mtagF=parseInt(document.getElementById('model-tag-f').value);
  const diffF =parseInt(document.getElementById('diff-f').value);
  const absentF=parseInt(document.getElementById('absent-f').value);
  const q=document.getElementById('search').value.trim().toLowerCase();
  const N=MDL[0].N||0;
  const arr=[];
  for(let idx=0;idx<N;idx++){{
    // tag filter
    if(tagF>=0){{
      if(mtagF>=0&&mtagF<N_MODELS){{
        if((MDL[mtagF].TAGS?.[idx]??4)!==tagF) continue;
      }}else{{
        let found=false;
        for(let mi=0;mi<N_MODELS;mi++) if((MDL[mi].TAGS?.[idx]??4)===tagF){{found=true;break;}}
        if(!found) continue;
      }}
    }}
    // search
    if(q&&!((MDL[0].UTT_IDS?.[idx]||'').toLowerCase().includes(q))) continue;
    // diff filter
    if(diffF>0&&siRanges){{
      const sp=getSiSpread(idx);
      if(diffF===1&&sp<=siRanges[1]) continue;
      if(diffF===2&&sp>siRanges[0]) continue;
    }}
    // absent filter
    if(absentF>0){{
      const cov=getModelCoverage(idx);
      if(absentF===1&&cov<N_MODELS) continue;
      if(absentF===2&&cov===N_MODELS) continue;
    }}
    arr.push(idx);
  }}
  if(sortKey==='uid'){{
    arr.sort((a,b)=>{{const r=(MDL[0].UTT_IDS?.[a]||'').localeCompare(MDL[0].UTT_IDS?.[b]||'');return sortAsc?r:-r;}});
  }}else{{
    arr.sort((a,b)=>{{
      const va=getVal(sortKey,a),vb=getVal(sortKey,b);
      if(isNaN(va)&&isNaN(vb)) return 0;
      if(isNaN(va)) return 1; if(isNaN(vb)) return -1;
      return sortAsc?(va-vb):(vb-va);
    }});
  }}
  filtered=arr; pageStart=0; renderPage();
}}

function escH(s){{return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}}
function highlight(text,q){{
  if(!q) return escH(text);
  const idx=text.toLowerCase().indexOf(q);
  if(idx<0) return escH(text);
  return escH(text.slice(0,idx))+'<mark>'+escH(text.slice(idx,idx+q.length))+'</mark>'+escH(text.slice(idx+q.length));
}}
function fmt(v,d=3){{return (v==null||isNaN(v))?'—':v.toFixed(d);}}

function renderPage(){{
  const total=filtered.length;
  const pages=Math.max(1,Math.ceil(total/PAGE));
  const page=Math.floor(pageStart/PAGE)+1;
  const slice=filtered.slice(pageStart,pageStart+PAGE);
  const q=document.getElementById('search').value.trim().toLowerCase();
  document.getElementById('pginfo').textContent=`${{page}}/${{pages}} (${{total.toLocaleString()}})`;
  document.getElementById('bp').disabled=pageStart<=0;
  document.getElementById('bn').disabled=pageStart+PAGE>=total;
  const inner=document.getElementById('vinner');
  inner.style.height=(slice.length*ROW_H)+'px'; inner.innerHTML='';

  for(let vi=0;vi<slice.length;vi++){{
    const idx=slice[vi];
    const row=document.createElement('div');
    row.className='srow'+(idx===selIdx?' sel':'');
    row.style.top=(vi*ROW_H)+'px';
    const uid=MDL[0].UTT_IDS?.[idx]||String(idx);

    // find best SI across models
    let maxSi=-Infinity;
    for(let mi=0;mi<N_MODELS;mi++){{
      const v=MDL[mi].MEAN_SI?.[idx]??NaN; if(!isNaN(v)&&v>maxSi) maxSi=v;
    }}

    let cells=`<div class="s-rank">${{idx+1}}</div>`;
    cells+=`<div class="s-uid" title="${{escH(uid)}}">${{highlight(uid,q)}}</div>`;
    for(let mi=0;mi<N_MODELS;mi++){{
      const si=MDL[mi].MEAN_SI?.[idx]??NaN;
      const tag=MDL[mi].TAGS?.[idx]??4;
      const tagName=TAG_NAMES[tag];
      const isBest=(!isNaN(si)&&si===maxSi&&N_MODELS>1);
      const absent=isNaN(si);
      cells+=`<div class="s-si${{isBest?' best':''}}" style="${{isBest?'color:'+COLORS[mi]:absent?'color:var(--mt2)':''}}">${{absent?'—':si.toFixed(3)}}</div>`;
      cells+=`<div class="col-tag"><span class="badge ${{absent?'absent':tagName}}">${{absent?'n/a':tagName.replace(/_/g,' ')}}</span></div>`;
    }}
    row.innerHTML=cells;
    row.addEventListener('click',()=>selectSample(idx,row));
    inner.appendChild(row);
  }}
  document.getElementById('vlist').scrollTop=0;
}}

