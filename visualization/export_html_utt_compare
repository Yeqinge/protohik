    `${{MDL[0].N?.toLocaleString()||'?'}} utterances · ${{N_MODELS}} 模型`;
  document.getElementById('hstatus').style.display='none';

  // 预计算差值范围
  computeSiRanges(MDL[0].N||0);

  filtered=Int32Array.from({{length:MDL[0].N||0}},(_,i)=>i);
  renderPage();

  // legend
  const lb=document.getElementById('legend-bar');
  lb.innerHTML=MODEL_NAMES.map((nm,i)=>
    `<span class="li"><span class="ld" style="background:${{COLORS[i]}}"></span>${{nm}}</span>`
  ).join('');
}}

function computeSiRanges(N){{
  if(N===0||N_MODELS<2){{ siRanges=[0,0]; return; }}
  const spreads=[];
  for(let idx=0;idx<N;idx++){{
    let mn=Infinity,mx=-Infinity;
    for(let mi=0;mi<N_MODELS;mi++){{
      const v=MDL[mi].MEAN_SI?.[idx];
      if(v!=null&&!isNaN(v)){{ mn=Math.min(mn,v); mx=Math.max(mx,v); }}
    }}
    if(mx>mn) spreads.push(mx-mn);
  }}
  spreads.sort((a,b)=>a-b);
  const q=(p)=>spreads[Math.floor(p*spreads.length)]||0;
  siRanges=[q(.25),q(.75)];
}}

function getSiSpread(idx){{
  let mn=Infinity,mx=-Infinity;
  for(let mi=0;mi<N_MODELS;mi++){{
    const v=MDL[mi].MEAN_SI?.[idx];
    if(v!=null&&!isNaN(v)){{ mn=Math.min(mn,v); mx=Math.max(mx,v); }}
  }}
  return mx>mn?mx-mn:0;
}}

function getModelCoverage(idx){{
  let cnt=0;
  for(let mi=0;mi<N_MODELS;mi++){{
    const v=MDL[mi].MEAN_SI?.[idx];
    if(v!=null&&!isNaN(v)) cnt++;
  }}
  return cnt;
}}

function getVal(sk,idx){{
  const m=sk.match(/^(si|tag|gn|al|wt)_(\d+)$/);
  if(m){{
    const mi=parseInt(m[2]);
    if(m[1]==='si')  return MDL[mi].MEAN_SI?.[idx]??NaN;
    if(m[1]==='tag') return MDL[mi].TAGS?.[idx]??4;
    if(m[1]==='gn')  return MDL[mi].MEAN_GN?.[idx]??NaN;
    if(m[1]==='al')  return MDL[mi].MEAN_AL?.[idx]??NaN;
    if(m[1]==='wt')  return MDL[mi].MEAN_WT?.[idx]??NaN;
  }}
  if(sk==='rank') return MDL[0].MEAN_SI?.[idx]??NaN;
  if(sk==='uid')  return MDL[0].UTT_IDS?.[idx]??'';
  return NaN;
}}

function setSort(key){{
