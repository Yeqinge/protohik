  });
  hdr.push('si_spread','coverage');
  const rows=[hdr];
  for(let i=0;i<filtered.length;i++){
    const idx=filtered[i];
    const r=[(MDL[0].UTT_IDS&&MDL[0].UTT_IDS[idx])||idx];
    MODEL_NAMES.forEach(function(_,mi){
      const si=(MDL[mi].MEAN_SI&&MDL[mi].MEAN_SI[idx])??NaN;
      const gn=(MDL[mi].MEAN_GN&&MDL[mi].MEAN_GN[idx])??NaN;
      const al=(MDL[mi].MEAN_AL&&MDL[mi].MEAN_AL[idx])??NaN;
      const tag=TAG_NAMES[(MDL[mi].TAGS&&MDL[mi].TAGS[idx])??4];
      r.push(isNaN(si)?'':si.toFixed(4),isNaN(gn)?'':gn.toFixed(4),
             isNaN(al)?'':al.toFixed(4),tag);
    });
    r.push(getSiSpread(idx).toFixed(4),getModelCoverage(idx));
    rows.push(r);
  }
  const csv=rows.map(function(r){
    return r.map(function(c){return '"'+String(c).replace(/"/g,'""')+'"';}).join(',');
  }).join('\n');
  const a=document.createElement('a');
  a.href='data:text/csv;charset=utf-8,\uFEFF'+encodeURIComponent(csv);
  a.download='compare_export.csv'; a.click();
}

loadAll();
</script>
