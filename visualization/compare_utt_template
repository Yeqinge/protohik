function drawTagDist(curIdx){
  destroyChart('scatter');
  const el=document.getElementById('chartTagDist'); if(!el) return;
  const N=MDL[0].N||0;

  // TAG_NAMES order: harmful_suspect hard high_influence easy_redundant normal
  const TAG_LABELS=['harmful', 'hard', 'high_inf', 'easy_red', 'normal'];
  const TAG_COLORS=['#dc2626','#ea580c','#7c3aed','#16a34a','#9aa3ba'];

  // count tags per model (% of total valid)
  const datasets=MODEL_NAMES.map(function(nm,mi){
    const tv=MDL[mi].TAGS;
    if(!tv) return {label:nm,data:[0,0,0,0,0],backgroundColor:COLORS[mi]+'99',
                    borderColor:COLORS[mi],borderWidth:1.5,borderRadius:3};
    const cnt=[0,0,0,0,0];
    let total=0;
    for(let i=0;i<N;i++){
      const t=tv[i]; if(t>=0&&t<=4){cnt[t]++;total++;}
    }
    return {
      label:nm,
      data:cnt.map(function(c){return total?parseFloat((c/total*100).toFixed(2)):0;}),
      backgroundColor:COLORS[mi]+'99',
      borderColor:COLORS[mi],
      borderWidth:1.5,
      borderRadius:3,
      borderSkipped:false
    };
  });

  // selected utterance: which tag does each model assign?
  // draw as separate dataset with full opacity and thick border
  const selDatasets=MODEL_NAMES.map(function(nm,mi){
    const tv=MDL[mi].TAGS;
    const sv=MDL[mi].MEAN_SI;
    const absent=!tv||!sv||(sv[curIdx]==null)||isNaN(Number(sv[curIdx]));
    const selTag=absent?-1:(tv[curIdx]??-1);
    // bar only at the selected tag bin, 0 elsewhere
    const d=[0,0,0,0,0];
    if(selTag>=0&&selTag<=4) d[selTag]=100; // marker height (shown on secondary axis)
    return {
      label:nm+' \u9009\u4e2d',
      data:d,
      backgroundColor:'transparent',
      borderColor:absent?'transparent':COLORS[mi],
      borderWidth:3,
      borderRadius:4,
      borderSkipped:false,
      yAxisID:'yMark'
    };
  });

  destroyChart('scatter');
  charts.scatter=new Chart(el.getContext('2d'),{
    type:'bar',
    data:{
      labels:TAG_LABELS,
      datasets:datasets.concat(selDatasets)
    },
    options:{
      responsive:true,
      maintainAspectRatio:false,
      animation:{duration:200},
      interaction:{mode:'index',intersect:false},
      plugins:{
        legend:{
          display:true,
          position:'top',
          labels:{
            font:{family:'IBM Plex Mono',size:10},
            color:'#6b7a99',
            boxWidth:10,
            padding:10,
            filter:function(item){
              return item.text.indexOf('\u9009\u4e2d')<0;
            }
          }
        },
        tooltip:{
          backgroundColor:'#fff',
          borderColor:'#dde3ee',
          borderWidth:1,
          titleColor:'#1a2035',
          bodyColor:'#6b7a99',
          titleFont:{family:'IBM Plex Mono',size:11},
          bodyFont:{family:'IBM Plex Mono',size:10},
          callbacks:{
            label:function(c){
              if(c.dataset.label.indexOf('\u9009\u4e2d')>=0) return null;
              return '  '+c.dataset.label+': '+c.parsed.y.toFixed(1)+'%';
            }
          }
        }
      },
      scales:{
        x:{
          grid:{color:'#eef1f7'},
          ticks:{font:{family:'IBM Plex Mono',size:10},color:'#6b7a99'}
        },
        y:{
          type:'linear',
          position:'left',
          beginAtZero:true,
          grid:{color:'#eef1f7'},
          ticks:{
            font:{family:'IBM Plex Mono',size:9},
            color:'#6b7a99',
            callback:function(v){return v+'%';}
          },
          title:{display:true,text:'\u5360\u6bd4 (%)',
                 font:{family:'IBM Plex Mono',size:10},color:'#6b7a99'}
        },
        yMark:{
          type:'linear',
          position:'right',
          min:0,max:100,
          display:false,
          grid:{display:false}
        }
      }
    }
  });
}


function copyPath(el){
  const txt=(el.title||'').replace('\u70b9\u51fb\u590d\u5236: ','');
  if(navigator.clipboard){
    navigator.clipboard.writeText(txt).then(function(){
      const orig=el.textContent; el.textContent='\u2713 \u5df2\u590d\u5236';
      setTimeout(function(){el.textContent=orig;},1200);
    });
  }
}

