  document.getElementById('search').value='';
  document.getElementById('search-clear').style.display='none';
  rebuild();
}

function rebuild(){
  const tagF =parseInt(document.getElementById('tag-f').value);
  const mtagF=parseInt(document.getElementById('model-tag-f').value);
  const diffF =parseInt(document.getElementById('diff-f').value);
  const q=document.getElementById('search').value.trim().toLowerCase();
  const N=MDL[0].N||0;
  const arr=[];
  for(let idx=0;idx<N;idx++){
    if(tagF>=0){
      if(mtagF>=0&&mtagF<N_MODELS){
        if(((MDL[mtagF].TAGS&&MDL[mtagF].TAGS[idx])??4)!==tagF) continue;
      }else{
        let found=false;
        for(let mi=0;mi<N_MODELS;mi++) if(((MDL[mi].TAGS&&MDL[mi].TAGS[idx])??4)===tagF){found=true;break;}
        if(!found) continue;
      }
    }
    if(q&&!((MDL[0].UTT_IDS&&MDL[0].UTT_IDS[idx])||'').toLowerCase().includes(q)) continue;
    if(diffF===1&&tagsAllSame(idx)) continue;       // 仅不一致
    if(diffF===2&&!tagsAllSame(idx)) continue;      // 仅一致
    if(diffF===3&&!hasHarmful(idx)) continue;       // 含harmful
    if(diffF===4&&!hasHighHarmfulConflict(idx)) continue; // 冲突
    arr.push(idx);
  }
  if(sortKey==='uid'){
    arr.sort(function(a,b){
      const r=((MDL[0].UTT_IDS&&MDL[0].UTT_IDS[a])||'').localeCompare((MDL[0].UTT_IDS&&MDL[0].UTT_IDS[b])||'');
      return sortAsc?r:-r;
    });
  }else{
    arr.sort(function(a,b){
      const va=getVal(sortKey,a),vb=getVal(sortKey,b);
      if(isNaN(va)&&isNaN(vb)) return 0;
      if(isNaN(va)) return 1; if(isNaN(vb)) return -1;
      return sortAsc?(va-vb):(vb-va);
    });
  }
  filtered=arr; pageStart=0; renderPage();
}

function escH(s){return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}
function highlight(text,q){
  if(!q) return escH(text);
  const idx=text.toLowerCase().indexOf(q);
  if(idx<0) return escH(text);
  return escH(text.slice(0,idx))+'<mark>'+escH(text.slice(idx,idx+q.length))+'</mark>'+escH(text.slice(idx+q.length));
}
function fmt(v,d){d=d||3;return (v==null||isNaN(v))?'\u2014':v.toFixed(d);}

function renderPage(){
  const total=filtered.length;
  const pages=Math.max(1,Math.ceil(total/PAGE));
  const page=Math.floor(pageStart/PAGE)+1;
  const slice=filtered.slice(pageStart,pageStart+PAGE);
  const q=document.getElementById('search').value.trim().toLowerCase();
  document.getElementById('pginfo').textContent=page+'/'+pages+' ('+total.toLocaleString()+')';
  document.getElementById('bp').disabled=pageStart<=0;
  document.getElementById('bn').disabled=pageStart+PAGE>=total;
  const inner=document.getElementById('vinner');
  inner.style.height=(slice.length*ROW_H)+'px'; inner.innerHTML='';
  for(let vi=0;vi<slice.length;vi++){
    const idx=slice[vi];
    const row=document.createElement('div');
    row.className='srow'+(idx===selIdx?' sel':'');
    row.style.top=(vi*ROW_H)+'px';
    const uid=(MDL[0].UTT_IDS&&MDL[0].UTT_IDS[idx])||String(idx);
    const tagDiff=getTagDiff(idx);
    const allSame=tagsAllSame(idx);
    const isConflict=hasHighHarmfulConflict(idx);
    if(!allSame) row.classList.add('has-diff');
    // align hint in tooltip
    let minAl=Infinity;
    for(let mi=0;mi<N_MODELS;mi++){
      const av=MDL[mi].MEAN_AL&&MDL[mi].MEAN_AL[idx];
      if(av!=null&&!isNaN(av)&&av<minAl) minAl=av;
    }
    const alHint=isFinite(minAl)?' al='+minAl.toFixed(3):'';
    let cells='<div class="s-rank">'+(idx+1)+'</div>';
    cells+='<div class="s-uid" title="'+escH(uid)+alHint+'">'+highlight(uid,q)+'</div>';
    // 每个模型只显示 tag badge，用模型色边框区分
    for(let mi=0;mi<N_MODELS;mi++){
      const tag=(MDL[mi].TAGS&&MDL[mi].TAGS[idx])??4;
      const tagName=TAG_NAMES[tag];
      const absent=(MDL[mi].MEAN_AL==null||MDL[mi].MEAN_AL[idx]==null||isNaN(MDL[mi].MEAN_AL[idx]));
      cells+='<div class="col-tag" style="border-bottom:2px solid '+(absent?'transparent':COLORS[mi])+'">'
        +'<span class="badge '+(absent?'absent':tagName)+'">'+(absent?'n/a':tagName.replace(/_/g,' '))+'</span></div>';
    }
    // tag 差异列
    const diffSymbol=allSame?'\u2714':(isConflict?'\u26d4':'\u2260');
    const diffCls=allSame?'same':'diff';
    cells+='<div class="s-tagdiff '+diffCls+'">'+diffSymbol+'</div>';
    row.innerHTML=cells;
    row.addEventListener('click',(function(i,r){return function(){selectSample(i,r);};})(idx,row));
    inner.appendChild(row);
  }
  document.getElementById('vlist').scrollTop=0;
}

function prevPage(){if(pageStart>0){pageStart=Math.max(0,pageStart-PAGE);renderPage();}}
function nextPage(){if(pageStart+PAGE<filtered.length){pageStart+=PAGE;renderPage();}}


function selectSample(idx,el){
  selIdx=idx;
  document.querySelectorAll('.srow').forEach(function(r){r.classList.remove('sel');});
  el.classList.add('sel');
  const uid=(MDL[0].UTT_IDS&&MDL[0].UTT_IDS[idx])||String(idx);
  document.getElementById('ctitle').textContent=uid;
  const sg=document.getElementById('model-stats'); sg.innerHTML='';
  MODEL_NAMES.forEach(function(nm,mi){
    const m=MDL[mi];
    const si=m.MEAN_SI&&m.MEAN_SI[idx];
    const gn=m.MEAN_GN&&m.MEAN_GN[idx];
    const al=m.MEAN_AL&&m.MEAN_AL[idx];
    const tag=TAG_NAMES[(m.TAGS&&m.TAGS[idx])??4];
    const absent=(si==null||isNaN(si));
    const card=document.createElement('div');
    card.className='mstat-card';
    card.style.borderColor=COLORS[mi]+'66';
    card.innerHTML='<div class="mc-title" style="color:'+COLORS[mi]+'">'+nm+'</div>'+
      (absent?'<div style="font-family:var(--mono);font-size:10px;color:var(--mt2);margin-top:2px;">\u672a\u8986\u76d6\u6b64 utterance</div>':
      '<div class="mc-vals">'+
        '<div class="mc-item"><div class="mc-lbl">mean_si</div><div class="mc-val" style="color:'+COLORS[mi]+'">'+fmt(si,3)+'</div></div>'+
        '<div class="mc-item"><div class="mc-lbl">mean_gn</div><div class="mc-val">'+fmt(gn,4)+'</div></div>'+
        '<div class="mc-item"><div class="mc-lbl">mean_al</div><div class="mc-val" style="color:'+(al!=null&&!isNaN(al)?(al<-0.1?'#dc2626':al>0.1?'#16a34a':'#6b7a99'):'#6b7a99')+'">'+fmt(al,4)+'</div></div>'+
        '<div class="mc-item"><div class="mc-lbl">tag</div><div class="mc-val" style="font-size:10px;font-weight:500">'+tag+'</div></div>'+
      '</div>');
    sg.appendChild(card);
  });
  const mb=document.getElementById('meta-bar');
  const _m=META&&META[idx];
  const _hasAny=_m&&((_m.label||'')+(_m.file_path||'')+(_m.detector_id||'')+
                      (_m.channel_id||'')+(_m.project||'')+(_m.duration||'')+(_m.time_point||'')).trim()!=='';
  if(_hasAny){
    const m=_m;
    const lc=(m.label||'').toLowerCase();
    const bc=lc==='normal'?'normal':(lc==='anomaly'||lc==='abnormal'?'anomaly':'unknown');
    document.getElementById('m-label').innerHTML=m.label?('<span class="meta-badge '+bc+'">'+m.label+'</span>'):'\u2014';
    document.getElementById('m-detector').textContent=m.detector_id||'\u2014';
    document.getElementById('m-channel').textContent=m.channel_id||'\u2014';
    document.getElementById('m-project').textContent=m.project||'\u2014';
    document.getElementById('m-duration').textContent=m.duration?(m.duration+'s'):'\u2014';
    document.getElementById('m-time').textContent=m.time_point||'\u2014';
    const fp=document.getElementById('m-path');
    fp.textContent=m.file_path||'\u2014';
    fp.title='\u70b9\u51fb\u590d\u5236: '+(m.file_path||'');
    mb.classList.add('show');
  }else{ mb.classList.remove('show'); }
  document.getElementById('ph').style.display='none';
  document.querySelectorAll('.tab-panel').forEach(function(p){
    const show=p.id==='tab-'+activeTab;
    p.style.display=show?'flex':'none';
    p.classList.toggle('active',show);
  });
  // Use rAF so the panel is fully visible (with correct dimensions) before Chart.js measures canvas
  requestAnimationFrame(function(){
    requestAnimationFrame(function(){ drawTab(activeTab,idx); });
  });
}

function drawTab(tab,idx){
  if(tab==='gn')      drawGnChart(idx);
  else if(tab==='al') drawAlChart(idx);
  else if(tab==='wt') drawWtChart(idx);
  else if(tab==='scatter') drawTagDist(idx);
}

function switchTab(t){
  activeTab=t;
  document.querySelectorAll('.tab').forEach(function(el){el.classList.toggle('active',el.dataset.tab===t);});
  document.querySelectorAll('.tab-panel').forEach(function(el){
    const show=el.id==='tab-'+t;
    el.classList.toggle('active',show);
    el.style.display=show?'flex':'none';
  });
  if(selIdx>=0){
    // double rAF: first frame shows panel, second frame canvas has correct dimensions
    requestAnimationFrame(function(){
      requestAnimationFrame(function(){ drawTab(t,selIdx); });
    });
  }
}

function getEpochLabels(mi){
  const ep=(MDL[mi].EPOCHS)||[];
  return ep.length?ep.map(function(e){return 'ep'+e;}):
    Array.from({length:MDL[mi].NE||0},function(_,i){return 'ep'+i;});
}

function extractTraj(mi,idx,type){
  const m=MDL[mi]; if(!m.HAS_TRAJ) return {labels:[],data:[]};
  const ne=m.NE||0; if(!ne) return {labels:[],data:[]};
  let u8, MIN, SC, NULL_VAL, DIV;
  if(type==='gn'){u8=m.GN_U8;MIN=m.GN_MIN;SC=m.GN_SC;NULL_VAL=255;DIV=254;}
  else if(type==='al'){u8=m.AL_U8;MIN=-1;SC=2;NULL_VAL=254;DIV=253;}
  else if(type==='wt'){u8=m.WT_U8;MIN=m.WT_MIN;SC=m.WT_SC;NULL_VAL=254;DIV=253;}
  if(!u8) return {labels:[],data:[]};
  const data=[];
  for(let e=0;e<ne;e++){
    const b=idx*ne+e;
    if(u8[b]===NULL_VAL){data.push(null);continue;}
    let v=MIN+(u8[b]/DIV)*SC;
    if(type==='gn'&&v<=0) v=MIN;
    data.push(v);
  }
  return {labels:getEpochLabels(mi),data:data};
}

function allLabels(datasets){
  let best=[];
  datasets.forEach(function(d){if((d._labels||[]).length>best.length) best=d._labels;});
  return best;
}

function makeDatasets(idx,type){
  return MODEL_NAMES.map(function(nm,mi){
    const t=extractTraj(mi,idx,type);
    return {label:nm,data:t.data,_labels:t.labels,
      borderColor:COLORS[mi],backgroundColor:COLORS_ALPHA[mi],
      borderWidth:2,pointRadius:3,pointBackgroundColor:COLORS[mi],
      tension:.3,fill:false,spanGaps:false};
  });
}

function destroyChart(key){if(charts[key]){charts[key].destroy();delete charts[key];}}

function commonOpts(yLog,yMin,yMax){
  return {
    responsive:true,maintainAspectRatio:false,animation:{duration:150},
    interaction:{mode:'index',intersect:false},
    plugins:{legend:{display:false},tooltip:{
      backgroundColor:'#fff',borderColor:'#dde3ee',borderWidth:1,
      titleColor:'#1a2035',bodyColor:'#6b7a99',
      titleFont:{family:'IBM Plex Mono',size:11},bodyFont:{family:'IBM Plex Mono',size:10}
    }},
    scales:{
      x:{grid:{color:'#eef1f7'},ticks:{color:'#6b7a99',font:{family:'IBM Plex Mono',size:10}}},
      y:{type:yLog?'logarithmic':'linear',position:'left',
        min:yMin!=null?yMin:undefined,max:yMax!=null?yMax:undefined,
        grid:{color:'#eef1f7'},
        ticks:{color:'#6b7a99',font:{family:'IBM Plex Mono',size:9},
          callback:yLog?function(v){return v.toExponential(1);}:undefined}}
    }
  };
}

