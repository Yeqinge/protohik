<!DOCTYPE html>
<html lang="zh"><head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Multi-Model Contribution Comparator</title>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<style>
:root{
  --bg:#f4f6fa; --surf:#ffffff; --surf2:#f0f3f8; --surf3:#e8edf5;
  --bdr:#dde3ee; --bdr2:#c8d0e0;
  --tx:#1a2035;  --mt:#6b7a99;  --mt2:#9aa3ba;
  --ac:#2563eb;  --ac2:#1d4ed8; --ac-bg:#eff4ff;
  --harmful:#dc2626; --harmful-bg:#fef2f2;
  --hard:#ea580c;    --hard-bg:#fff7ed;
  --inf:#7c3aed;     --inf-bg:#f5f3ff;
  --easy:#16a34a;    --easy-bg:#f0fdf4;
  --mono:'IBM Plex Mono',monospace; --sans:'Inter',sans-serif;
  --radius:6px;
  --shadow:0 1px 3px rgba(0,0,0,.08),0 1px 2px rgba(0,0,0,.04);
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
html,body{height:100%;background:var(--bg);color:var(--tx);font-family:var(--sans);overflow:hidden;font-size:13px;}
.layout{display:grid;grid-template-columns:620px 1fr;grid-template-rows:52px 1fr;height:100vh;}
.header{grid-column:1/-1;display:flex;align-items:center;padding:0 18px;gap:12px;
  border-bottom:1px solid var(--bdr);background:var(--surf);box-shadow:var(--shadow);z-index:10;}
.htitle{font-family:var(--mono);font-size:13px;font-weight:600;color:var(--ac);letter-spacing:.04em;}
.hmeta{font-size:11px;color:var(--mt);font-family:var(--mono);}
.hbadges{margin-left:auto;display:flex;gap:8px;flex-wrap:wrap;align-items:center;}
.hstatus{font-size:11px;color:var(--ac);font-family:var(--mono);padding:2px 8px;
  border:1px solid var(--bdr2);border-radius:4px;animation:pulse 1.4s infinite;}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}
.model-pill{display:inline-flex;align-items:center;gap:5px;padding:2px 8px;border-radius:4px;
  font-size:10px;font-family:var(--mono);font-weight:500;border:1px solid rgba(0,0,0,.12);background:rgba(0,0,0,.04);}
.model-dot{width:7px;height:7px;border-radius:50%;flex-shrink:0;}
.badge{display:inline-flex;align-items:center;padding:2px 6px;border-radius:4px;
  font-size:9px;font-family:var(--mono);font-weight:500;border:1px solid;white-space:nowrap;}
.badge.harmful_suspect{color:var(--harmful);border-color:#fca5a5;background:var(--harmful-bg);}
.badge.hard{color:var(--hard);border-color:#fdba74;background:var(--hard-bg);}
.badge.high_influence{color:var(--inf);border-color:#c4b5fd;background:var(--inf-bg);}
.badge.easy_redundant{color:var(--easy);border-color:#86efac;background:var(--easy-bg);}
.badge.normal{color:var(--mt);border-color:var(--bdr2);background:var(--surf2);}
.badge.absent{color:var(--mt2);border-color:var(--bdr);background:#f8f8f8;font-style:italic;}
.panel-left{display:flex;flex-direction:column;background:var(--surf);border-right:1px solid var(--bdr);overflow:hidden;}
.controls{padding:10px 12px;border-bottom:1px solid var(--bdr);display:flex;flex-direction:column;gap:7px;background:var(--surf2);}
.search-wrap{position:relative;display:flex;align-items:center;}
.search-wrap svg{position:absolute;left:9px;width:14px;height:14px;color:var(--mt2);pointer-events:none;}
#search{width:100%;padding:7px 32px 7px 30px;background:var(--surf);border:1px solid var(--bdr2);
  color:var(--tx);font-family:var(--mono);font-size:11px;outline:none;border-radius:var(--radius);transition:border-color .15s;}
#search:focus{border-color:var(--ac);box-shadow:0 0 0 3px rgba(37,99,235,.12);}
#search-clear{position:absolute;right:8px;cursor:pointer;background:none;border:none;color:var(--mt2);font-size:14px;line-height:1;padding:2px;display:none;}
#search-clear:hover{color:var(--tx);}
.filter-row{display:flex;gap:6px;flex-wrap:wrap;}
.filter-row select{flex:1;min-width:100px;padding:5px 8px;background:var(--surf);border:1px solid var(--bdr2);
  color:var(--tx);font-family:var(--mono);font-size:11px;outline:none;border-radius:var(--radius);cursor:pointer;}
.filter-row select:focus{border-color:var(--ac);}
.export-btn{padding:5px 12px;background:var(--ac);color:#fff;border:none;border-radius:var(--radius);
  font-family:var(--mono);font-size:10px;font-weight:500;cursor:pointer;transition:background .15s;white-space:nowrap;}
.export-btn:hover{background:var(--ac2);}
.list-header{display:grid;grid-template-columns:@@grid_cols@@;align-items:center;
  padding:0 10px;gap:4px;height:28px;border-bottom:2px solid var(--bdr);background:var(--surf3);
  font-family:var(--mono);font-size:9px;color:var(--mt);text-transform:uppercase;letter-spacing:.05em;user-select:none;overflow:hidden;}
.th{cursor:pointer;display:flex;align-items:center;gap:3px;padding:2px 3px;border-radius:3px;
  transition:background .1s,color .1s;white-space:nowrap;overflow:hidden;}
.th:hover{background:var(--bdr);color:var(--tx);}
.th.active{font-weight:600;}
.th .arrow{font-size:8px;opacity:.7;flex-shrink:0;}
.th-r{justify-content:flex-end;} .th-c{justify-content:center;}
.th-dot{width:6px;height:6px;border-radius:50%;flex-shrink:0;}
.vlist{flex:1;overflow-y:auto;position:relative;}
.vlist::-webkit-scrollbar{width:5px;}
.vlist::-webkit-scrollbar-track{background:var(--surf2);}
.vlist::-webkit-scrollbar-thumb{background:var(--bdr2);border-radius:3px;}
.srow{display:grid;grid-template-columns:@@grid_cols@@;align-items:center;
  padding:0 10px;cursor:pointer;gap:4px;border-bottom:1px solid var(--bdr);
  height:36px;position:absolute;width:100%;transition:background .08s;}
.srow:hover{background:var(--surf2);}
.srow.sel{background:var(--ac-bg);border-left:3px solid var(--ac);padding-left:7px;}
.s-rank{font-family:var(--mono);font-size:10px;color:var(--mt2);}
.s-uid{font-family:var(--mono);font-size:10px;color:var(--tx);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.s-uid mark{background:rgba(37,99,235,.15);color:var(--ac);border-radius:2px;padding:0 1px;}
.col-tag{justify-self:center;}
.s-tagdiff{text-align:center;font-size:11px;font-weight:700;font-family:var(--mono);}
.s-tagdiff.same{color:var(--mt2);}
.s-tagdiff.diff{color:#dc2626;}
.srow.has-diff{background:rgba(220,38,38,0.04);}
.srow.has-diff:hover{background:rgba(220,38,38,0.09);}
.srow.has-diff.sel{background:rgba(220,38,38,0.10);}
.pagination{padding:6px 12px;border-top:1px solid var(--bdr);display:flex;align-items:center;
  gap:8px;font-family:var(--mono);font-size:10px;color:var(--mt);background:var(--surf2);}
.pagination button{padding:3px 10px;background:var(--surf);border:1px solid var(--bdr2);
  color:var(--tx);font-family:var(--mono);font-size:10px;cursor:pointer;border-radius:4px;transition:all .1s;}
.pagination button:disabled{opacity:.35;cursor:default;}
.pagination button:not(:disabled):hover{border-color:var(--ac);color:var(--ac);background:var(--ac-bg);}
.pginfo{flex:1;text-align:center;}
.panel-right{display:flex;flex-direction:column;overflow:hidden;background:var(--bg);}
.chart-hdr{padding:12px 20px 10px;border-bottom:1px solid var(--bdr);background:var(--surf);
  box-shadow:var(--shadow);display:flex;align-items:flex-start;gap:16px;flex-wrap:wrap;}
.chdr-left{display:flex;flex-direction:column;gap:5px;min-width:0;flex:1;}
.ctitle{font-family:var(--mono);font-size:12px;font-weight:600;color:var(--tx);
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.model-stats{display:flex;flex-wrap:wrap;gap:10px;}
.mstat-card{display:flex;flex-direction:column;gap:3px;padding:6px 10px;border-radius:var(--radius);
  border:1px solid;background:rgba(255,255,255,.8);min-width:130px;}
.mc-title{font-family:var(--mono);font-size:9px;text-transform:uppercase;letter-spacing:.05em;font-weight:600;}
.mc-vals{display:flex;gap:10px;}
.mc-item{text-align:right;}
.mc-lbl{font-size:8px;color:var(--mt);font-family:var(--mono);}
.mc-val{font-size:13px;font-family:var(--mono);font-weight:600;}
.tabs{display:flex;gap:0;border-bottom:1px solid var(--bdr);background:var(--surf2);padding:0 16px;}
.tab{padding:7px 14px;font-family:var(--mono);font-size:11px;color:var(--mt);cursor:pointer;
  border-bottom:2px solid transparent;margin-bottom:-1px;transition:all .15s;white-space:nowrap;}
.tab:hover{color:var(--tx);}
.tab.active{color:var(--ac);border-bottom-color:var(--ac);font-weight:600;}
.chart-area{flex:1;padding:10px 16px 8px;display:flex;flex-direction:column;gap:0;overflow:hidden;}
.chart-block{display:flex;flex-direction:column;flex:1;min-height:0;padding:4px 0;}
.chart-block-title{font-family:var(--mono);font-size:9px;color:var(--mt);
  text-transform:uppercase;letter-spacing:.05em;padding:2px 0 4px;}
.chart-wrap{flex:1;position:relative;min-height:0;}
.chart-wrap canvas{position:absolute;inset:0;}
.tab-panel{display:none;flex:1;flex-direction:column;overflow:hidden;}
.tab-panel.active{display:flex;}
.legend-bar{display:flex;gap:14px;padding:6px 0 2px;flex-wrap:wrap;font-family:var(--mono);font-size:10px;}
.li{display:flex;align-items:center;gap:5px;}
.ld{width:16px;height:3px;border-radius:2px;flex-shrink:0;}
.placeholder{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;
  gap:10px;color:var(--mt2);font-family:var(--mono);}
.phi{font-size:40px;opacity:.25;}
.placeholder p{font-size:11px;}
.meta-bar{padding:7px 20px;border-bottom:1px solid var(--bdr);background:var(--surf2);
  display:none;flex-wrap:wrap;gap:5px 16px;font-family:var(--mono);font-size:10px;}
.meta-bar.show{display:flex;}
.meta-kv{display:flex;gap:5px;align-items:baseline;min-width:0;}
.meta-k{color:var(--mt2);text-transform:uppercase;font-size:9px;letter-spacing:.04em;white-space:nowrap;}
.meta-v{color:var(--tx);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:280px;}
.meta-v.fp{color:var(--mt);font-size:9px;max-width:480px;cursor:pointer;}
.meta-v.fp:hover{color:var(--ac);text-decoration:underline;}
.meta-badge{padding:1px 6px;border-radius:3px;font-size:9px;border:1px solid;}
.meta-badge.normal{color:var(--easy);border-color:#86efac;background:var(--easy-bg);}
.meta-badge.anomaly,.meta-badge.abnormal{color:var(--harmful);border-color:#fca5a5;background:var(--harmful-bg);}
.meta-badge.unknown{color:var(--mt);border-color:var(--bdr2);background:var(--surf2);}
</style>
</head><body>
<div class="layout">
  <header class="header">
    <span class="htitle">MULTI-MODEL COMPARATOR</span>
    <span class="hmeta" id="hmeta">正在加载...</span>
    <div class="hbadges" id="hbadges">
      <span class="hstatus" id="hstatus">&#x23F3; LOADING...</span>
    </div>
  </header>

  <div class="panel-left">
    <div class="controls">
      <div class="search-wrap">
        <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd"/></svg>
        <input id="search" placeholder="搜索 utt_id..." autocomplete="off">
        <button id="search-clear" onclick="clearSearch()" title="清除">&#x2715;</button>
      </div>
      <div class="filter-row">
        <select id="tag-f" onchange="rebuild()">
          <option value="-1">全部 Tag（任意模型）</option>
          <option value="0">&#x26A0; harmful_suspect</option>
          <option value="1">&#x25CF; hard</option>
          <option value="2">&#x2191; high_influence</option>
          <option value="3">&#x2193; easy_redundant</option>
          <option value="4">&#xB7; normal</option>
        </select>
        <select id="model-tag-f" onchange="rebuild()">
          <option value="-1">任意模型</option>
        </select>
        <button class="export-btn" onclick="exportCSV()">&#x2B07; CSV</button>
      </div>
      <div class="filter-row">
        <select id="diff-f" onchange="rebuild()">
          <option value="0">全部样本</option>
          <option value="1">&#x2757; 仅 Tag 不一致</option>
          <option value="2">&#x2714; 仅 Tag 一致</option>
          <option value="3">&#x26D4; 含 harmful（任意模型）</option>
          <option value="4">&#x26A0; 模型间 Tag 冲突（高危）</option>
        </select>
      </div>
    </div>

    <div class="list-header">@@th_cells@@</div>

    <div class="vlist" id="vlist"><div id="vinner"></div></div>

    <div class="pagination">
      <button id="bp" onclick="prevPage()" disabled>&#x25C4;</button>
      <span class="pginfo" id="pginfo">&#x2014;</span>
      <button id="bn" onclick="nextPage()" disabled>&#x25BA;</button>
    </div>
  </div>

  <div class="panel-right">
    <div class="chart-hdr" id="chart-hdr">
      <div class="chdr-left">
        <div class="ctitle" id="ctitle">&#x2014; 点击左侧选择一条 utterance &#x2014;</div>
        <div class="legend-bar" id="legend-bar"></div>
      </div>
      <div class="model-stats" id="model-stats"></div>
    </div>

    <div class="meta-bar" id="meta-bar">
      <div class="meta-kv"><span class="meta-k">label</span><span class="meta-v" id="m-label"></span></div>
      <div class="meta-kv"><span class="meta-k">detector</span><span class="meta-v" id="m-detector"></span></div>
      <div class="meta-kv"><span class="meta-k">channel</span><span class="meta-v" id="m-channel"></span></div>
      <div class="meta-kv"><span class="meta-k">project</span><span class="meta-v" id="m-project"></span></div>
      <div class="meta-kv"><span class="meta-k">duration</span><span class="meta-v" id="m-duration"></span></div>
      <div class="meta-kv"><span class="meta-k">time</span><span class="meta-v" id="m-time"></span></div>
      <div class="meta-kv" style="flex-basis:100%"><span class="meta-k">path</span>
        <span class="meta-v fp" id="m-path" onclick="copyPath(this)"></span></div>
    </div>

    <div class="tabs" id="tabs">
      <div class="tab active" data-tab="gn" onclick="switchTab('gn')">grad_norm</div>
      <div class="tab" data-tab="al" onclick="switchTab('al')">align</div>
      @@WEIGHT_TAB_HTML@@
      <div class="tab" data-tab="scatter" onclick="switchTab('scatter')">Tag 对比</div>
    </div>

    <div class="chart-area">
      <div id="ph" class="placeholder">
        <div class="phi">&#x2295;</div>
        <p>选择 utterance 后，此处叠加显示各模型轨迹</p>
      </div>
      <div id="tab-gn" class="tab-panel active">
        <div class="chart-block">
          <div class="chart-block-title">grad_norm 轨迹（各模型叠加&#xB7;对数轴）</div>
          <div class="chart-wrap"><canvas id="chartGn"></canvas></div>
        </div>
      </div>
      <div id="tab-al" class="tab-panel">
        <div class="chart-block">
          <div class="chart-block-title">align 轨迹（各模型叠加）</div>
          <div class="chart-wrap"><canvas id="chartAl"></canvas></div>
        </div>
      </div>
      @@WEIGHT_PANEL_HTML@@
      <div id="tab-scatter" class="tab-panel">
        <div class="chart-block">
          <div class="chart-block-title">Tag 分布对比（分组柱状图）·选中样本高亮显示</div>
          <div class="chart-wrap"><canvas id="chartTagDist"></canvas></div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
const MODEL_NAMES   = @@model_names_js@@;
const BIN_FILES     = @@bin_filenames_js@@;
const EPOCHS_LIST   = @@epochs_list_js@@;
const COLORS        = @@colors_js@@;
const COLORS_ALPHA  = @@colors_alpha_js@@;
const META_URL      = "@@meta_filename@@";
const N_MODELS      = MODEL_NAMES.length;
const TAG_NAMES     = ["harmful_suspect","hard","high_influence","easy_redundant","normal"];
const HAS_WEIGHT_ANY = @@HAS_WEIGHT_JS@@;

const MDL = Array.from({length:N_MODELS},()=>({}));

const PAGE=100, ROW_H=36;
let filtered=null, pageStart=0, selIdx=-1;
let charts={};
let stimer=null;
let sortKey='delta', sortAsc=false;
let activeTab='gn';
let META=null;
let siRanges=null;
let alRanges=null;

async function loadAll(){
  let _N=0;
  for(let mi=0;mi<N_MODELS;mi++){
    try{
      const res=await fetch(BIN_FILES[mi]);
      if(!res.ok) throw new Error('Cannot read '+BIN_FILES[mi]+' — use a local web server');
      const buf=await res.arrayBuffer();
      const header=new Int32Array(buf,0,4);
      _N=header[0]; const ne=header[1]; const uttLen=header[2]; const flags=header[3];
      const HAS_TRAJ=(flags&1)===1; const HAS_WTF=(flags&2)===2;
      const mf=new Float32Array(buf,16,4);
      const GN_MIN=mf[0],GN_SC=mf[1],WT_MIN=mf[2],WT_SC=mf[3];
      let o=80;
      const N_CHUNKS=new Int16Array(buf,o,_N);   o+=_N*2;
      const MEAN_SI =new Float32Array(buf,o,_N); o+=_N*4;
      const MAX_SI  =new Float32Array(buf,o,_N); o+=_N*4;
      const MEAN_GN =new Float32Array(buf,o,_N); o+=_N*4;
      const MAX_GN  =new Float32Array(buf,o,_N); o+=_N*4;
      const GN_STD  =new Float32Array(buf,o,_N); o+=_N*4;
      const MEAN_AL =new Float32Array(buf,o,_N); o+=_N*4;
      const MEAN_FN =new Float32Array(buf,o,_N); o+=_N*4;
      const MEAN_WT =new Float32Array(buf,o,_N); o+=_N*4;
      const WT_STD  =new Float32Array(buf,o,_N); o+=_N*4;
      const TAGS    =new Uint8Array(buf,o,_N);   o+=_N;
      const UTT_IDS =new TextDecoder('utf-8').decode(new Uint8Array(buf,o,uttLen)).split('\n'); o+=uttLen;
      let GN_U8=null,AL_U8=null,WT_U8=null;
      if(HAS_TRAJ&&ne>0){
        const ts=_N*ne;
        GN_U8=new Uint8Array(buf,o,ts); o+=ts;
        AL_U8=new Uint8Array(buf,o,ts); o+=ts;
        if(HAS_WTF){ WT_U8=new Uint8Array(buf,o,ts); }
      }
      MDL[mi]={N:_N,NE:ne,HAS_TRAJ,HAS_WTF,GN_MIN,GN_SC,WT_MIN,WT_SC,
               N_CHUNKS,MEAN_SI,MAX_SI,MEAN_GN,MAX_GN,GN_STD,MEAN_AL,MEAN_FN,
               MEAN_WT,WT_STD,TAGS,UTT_IDS,GN_U8,AL_U8,WT_U8,EPOCHS:EPOCHS_LIST[mi]};
    }catch(e){
      console.error('load model failed',mi,e);
      MDL[mi]={N:0};
    }
  }

  try{
    const mr=await fetch(META_URL);
    if(mr.ok) META=await mr.json();
  }catch(e){}

  const mtf=document.getElementById('model-tag-f');
  MODEL_NAMES.forEach((nm,i)=>{
    const o=document.createElement('option'); o.value=i; o.textContent=nm; mtf.appendChild(o);
  });

  const hb=document.getElementById('hbadges'); hb.innerHTML='';
  MODEL_NAMES.forEach((nm,i)=>{
    const p=document.createElement('span'); p.className='model-pill';
    p.innerHTML='<span class="model-dot" style="background:'+COLORS[i]+'"></span>'+nm;
    hb.appendChild(p);
  });
  document.getElementById('hmeta').textContent=
    (MDL[0].N||0).toLocaleString()+' utterances \xb7 '+N_MODELS+' \u6a21\u578b';
  document.getElementById('hstatus').style.display='none';

  computeSiRanges(MDL[0].N||0);
  computeAlRanges(MDL[0].N||0);
  filtered=Int32Array.from({length:MDL[0].N||0},(_,i)=>i);
  renderPage();

  const lb=document.getElementById('legend-bar'); lb.innerHTML='';
  MODEL_NAMES.forEach((nm,i)=>{
    lb.innerHTML+='<span class="li"><span class="ld" style="background:'+COLORS[i]+'"></span>'+nm+'</span>';
  });
}

function computeSiRanges(N){
  if(N===0||N_MODELS<2){siRanges=[0,0];return;}
  const spreads=[];
  for(let idx=0;idx<N;idx++){
    let mn=Infinity,mx=-Infinity;
    for(let mi=0;mi<N_MODELS;mi++){
      const v=MDL[mi].MEAN_SI&&MDL[mi].MEAN_SI[idx];
      if(v!=null&&!isNaN(v)){mn=Math.min(mn,v);mx=Math.max(mx,v);}
    }
    if(mx>mn) spreads.push(mx-mn);
  }
  spreads.sort((a,b)=>a-b);
  const q=function(p){return spreads[Math.floor(p*spreads.length)]||0;};
  siRanges=[q(.25),q(.75)];
}

function computeAlRanges(N){
  if(N===0||N_MODELS<2){alRanges=[0,0];return;}
  const spreads=[];
  for(let idx=0;idx<N;idx++){
    const sp=getAlSpread(idx);
    if(sp>0) spreads.push(sp);
  }
  spreads.sort(function(a,b){return a-b;});
  const q=function(p){return spreads[Math.floor(p*spreads.length)]||0;};
  alRanges=[q(.25),q(.75)];
}

function getSiSpread(idx){
  let mn=Infinity,mx=-Infinity;
  for(let mi=0;mi<N_MODELS;mi++){
    const v=MDL[mi].MEAN_SI&&MDL[mi].MEAN_SI[idx];
    if(v!=null&&!isNaN(v)){mn=Math.min(mn,v);mx=Math.max(mx,v);}
  }
  return mx>mn?mx-mn:0;
}

function getAlSpread(idx){
  // 两模型 mean_align 的差值（有方向：model0 - model1）
  // 绝对值大说明 align 判断分歧大
  if(N_MODELS<2) return 0;
  const a0=MDL[0].MEAN_AL&&MDL[0].MEAN_AL[idx];
  const a1=MDL[1].MEAN_AL&&MDL[1].MEAN_AL[idx];
  if(a0==null||a1==null||isNaN(a0)||isNaN(a1)) return 0;
  return Math.abs(a0-a1);
}

// tag 差异度：0=完全一致，越大分歧越严重
// 用优先级距离：harmful=0,hard=1,high_inf=2,easy=3,normal=4
const TAG_PRI=[3,2,1,0,4]; // TAG_NAMES顺序对应的优先级值
function getTagDiff(idx){
  if(N_MODELS<2) return 0;
  let mn=99,mx=-99;
  for(let mi=0;mi<N_MODELS;mi++){
    const t=(MDL[mi].TAGS&&MDL[mi].TAGS[idx])??4;
    const p=TAG_PRI[t]; if(p<mn) mn=p; if(p>mx) mx=p;
  }
  return mx-mn;
}
function tagsAllSame(idx){
  if(N_MODELS<2) return true;
  const t0=(MDL[0].TAGS&&MDL[0].TAGS[idx])??4;
  for(let mi=1;mi<N_MODELS;mi++){
    if(((MDL[mi].TAGS&&MDL[mi].TAGS[idx])??4)!==t0) return false;
  }
  return true;
}
function hasHarmful(idx){
  for(let mi=0;mi<N_MODELS;mi++){
    if(((MDL[mi].TAGS&&MDL[mi].TAGS[idx])??4)===0) return true;
  }
  return false;
}
// high_influence ↔ harmful_suspect 冲突
function hasHighHarmfulConflict(idx){
  let hasHI=false,hasHS=false;
  for(let mi=0;mi<N_MODELS;mi++){
    const t=(MDL[mi].TAGS&&MDL[mi].TAGS[idx])??4;
    if(t===0) hasHS=true;
    if(t===2) hasHI=true;
  }
  return hasHI&&hasHS;
}

function getModelCoverage(idx){
  let cnt=0;
  for(let mi=0;mi<N_MODELS;mi++){
    const v=MDL[mi].MEAN_SI&&MDL[mi].MEAN_SI[idx];
    if(v!=null&&!isNaN(v)) cnt++;
  }
  return cnt;
}

function getVal(sk,idx){
  const parts=sk.split('_');
  const mi=parseInt(parts[parts.length-1]);
  const key=parts.slice(0,-1).join('_');
  if(!isNaN(mi)&&mi>=0&&mi<N_MODELS){
    if(key==='si')  return (MDL[mi].MEAN_SI &&MDL[mi].MEAN_SI[idx]) ??NaN;
    if(key==='tag') return (MDL[mi].TAGS    &&MDL[mi].TAGS[idx])    ??4;
    if(key==='gn')  return (MDL[mi].MEAN_GN &&MDL[mi].MEAN_GN[idx]) ??NaN;
    if(key==='al')  return (MDL[mi].MEAN_AL &&MDL[mi].MEAN_AL[idx]) ??NaN;
    if(key==='wt')  return (MDL[mi].MEAN_WT &&MDL[mi].MEAN_WT[idx]) ??NaN;
  }
  if(sk==='delta') return getTagDiff(idx);
  if(sk==='rank') return (MDL[0].MEAN_SI&&MDL[0].MEAN_SI[idx])??NaN;
  if(sk==='uid')  return (MDL[0].UTT_IDS&&MDL[0].UTT_IDS[idx])||'';
  return NaN;
}

function setSort(key){
  const rk=key==='rank'?'delta':key;
  if(sortKey===rk){sortAsc=!sortAsc;}else{sortKey=rk;sortAsc=(key==='uid');}
  document.querySelectorAll('.th').forEach(function(t){
    t.classList.remove('active');
    const a=t.querySelector('.arrow'); if(a) a.textContent='';
  });
  // map delta sort key to element id
  const sortElId = key==='delta' ? 'th-delta' : 'th-'+key.replace(/_/g,'-');
  const el=document.getElementById(sortElId);
  if(el){el.classList.add('active');const ar=el.querySelector('.arrow');if(ar) ar.textContent=sortAsc?' \u2191':' \u2193';}
  rebuild();
}

