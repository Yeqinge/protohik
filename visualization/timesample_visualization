  <script>
    const DATA_FILE = {data_file_json};
    let payload = null;
    let records = [];
    let meta = {{}};
    let groupMeta = {{}};

    const byId = new Map();
    const groups = new Map();
    const groupRanges = new Map();
    const labelColors = ['#c2410c', '#7c3aed', '#be123c', '#0369a1', '#a16207', '#0f766e', '#b45309', '#4338ca'];
    const STATUS_DEFS = [
      ['unparseable', '无法识别编号', '#991b1b'],
      ['missing_mismatch', '有缺失 + 有不一致', '#dc2626'],
      ['present_mismatch', '无缺失 + 有不一致', '#ef4444'],
      ['missing_consistent', '有缺失 + 无不一致', '#d97706'],
      ['present_consistent', '无缺失 + 无不一致', '#15803d'],
    ];
    const STATUS_LABELS = Object.fromEntries(STATUS_DEFS.map(([key, label]) => [key, label]));
    const LIST_PAGE_SIZE = 200;
    let listPageStart = 0;
    let currentFilteredItems = [];

    function buildIndexes() {{
      byId.clear();
      groups.clear();
      groupRanges.clear();
      for (const rec of records) {{
        byId.set(rec.id, rec);
        if (!groups.has(rec.groupKey)) groups.set(rec.groupKey, new Map());
        const segment = Number(rec.segment);
        groups.get(rec.groupKey).set(segment, rec);
        if (Number.isFinite(segment) && segment >= 0) {{
          const range = groupRanges.get(rec.groupKey);
          if (range) {{
            if (segment < range.min) range.min = segment;
            if (segment > range.max) range.max = segment;
          }} else {{
            groupRanges.set(rec.groupKey, {{ min: segment, max: segment }});
          }}
        }}
      }}
    }}

    const els = {{
      reportMeta: document.getElementById('reportMeta'),
      summary: document.getElementById('summary'),
      idSearch: document.getElementById('idSearch'),
      sampleSelect: document.getElementById('sampleSelect'),
      statusFilter: document.getElementById('statusFilter'),
      targetLabelFilter: document.getElementById('targetLabelFilter'),
      sortMode: document.getElementById('sortMode'),
      beforeInput: document.getElementById('beforeInput'),
      afterInput: document.getElementById('afterInput'),
      filterHint: document.getElementById('filterHint'),
      sampleList: document.getElementById('sampleList'),
      listPrevBtn: document.getElementById('listPrevBtn'),
      listNextBtn: document.getElementById('listNextBtn'),
      listPageInfo: document.getElementById('listPageInfo'),
      statusCard: document.getElementById('statusCard'),
      statusTitle: document.getElementById('statusTitle'),
      statusNote: document.getElementById('statusNote'),
      targetTable: document.getElementById('targetTable'),
      groupTable: document.getElementById('groupTable'),
      timeline: document.getElementById('timeline'),
      windowChips: document.getElementById('windowChips'),
      windowRows: document.getElementById('windowRows'),
      detailList: document.getElementById('detailList'),
      parseNotes: document.getElementById('parseNotes'),
      loader: document.getElementById('loader'),
      loadStatus: document.getElementById('loadStatus'),
      app: document.getElementById('app'),
    }};

    function escapeHtml(value) {{
      if (value === null || value === undefined) return '';
      return String(value)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }}

    function valueText(value) {{
      if (value === null || value === undefined) return '';
      if (typeof value === 'object') return JSON.stringify(value, null, 2);
      return String(value);
    }}

    function pill(text, cls) {{
      return `<span class="pill ${{cls}}">${{escapeHtml(text)}}</span>`;
    }}

    function metric(label, value) {{
      return `<div class="metric"><div class="metric-label">${{escapeHtml(label)}}</div><div class="metric-value">${{escapeHtml(value)}}</div></div>`;
    }}

    function kvRows(items) {{
      return items.map(([key, value]) => (
        `<tr><th>${{escapeHtml(key)}}</th><td>${{escapeHtml(valueText(value))}}</td></tr>`
      )).join('');
    }}

    function formatCounts(counts) {{
      const entries = Object.entries(counts || {{}});
      if (!entries.length) return '无';
      return entries.map(([key, value]) => `${{escapeHtml(key)}}: ${{value}}`).join('，');
    }}

    function numberInputValue(input, fallback) {{
      const value = Number.parseInt(input.value, 10);
      return Number.isFinite(value) && value >= 0 ? value : fallback;
    }}

    function currentWindowParams() {{
      return {{
        before: numberInputValue(els.beforeInput, meta.defaultBefore || 5),
        after: numberInputValue(els.afterInput, meta.defaultAfter || 5),
      }};
    }}

    function isNormalLabel(label) {{
      return valueText(label).trim().toLowerCase() === 'normal';
    }}

    function isAbnormalLikeLabel(label) {{
      const text = valueText(label).trim().toLowerCase();
      return text === 'abnormal' || text === 'anomaly' || text === 'alarm' || text.includes('abnormal');
    }}

    function classifyRecord(rec, before, after) {{
      if (Number(rec.segment) < 0 || Number(rec.segmentWidth) === 0) {{
        return {{
          key: 'unparseable',
          text: STATUS_LABELS.unparseable,
          pillClass: 'different',
          severity: 5,
          missing: 0,
          mismatch: 0,
          existing: 0,
          total: 0,
          checkStart: null,
          checkEnd: null,
          groupMin: null,
          groupMax: null,
          observedWeight: 0,
          mismatchWeight: 0,
          missingWeight: 0,
          totalNeighborWeight: 0,
          weightedScore: 1,
          missingWeightRatio: 0,
          normalToAbnormal: 0,
          normalToAbnormalWeight: 0,
        }};
      }}
      const group = groups.get(rec.groupKey) || new Map();
      const range = groupRanges.get(rec.groupKey);
      const groupMin = range ? range.min : Number(rec.segment);
      const groupMax = range ? range.max : Number(rec.segment);
      const requestedStart = Number(rec.segment) - before;
      const requestedEnd = Number(rec.segment) + after;
      const checkStart = Math.max(requestedStart, groupMin);
      const checkEnd = Math.min(requestedEnd, groupMax);
      const targetLabel = valueText(rec.label);
      let missing = 0;
      let mismatch = 0;
      let existing = 0;
      const total = Math.max(0, checkEnd - checkStart + 1);
      let observedWeight = 0;
      let mismatchWeight = 0;
      let missingWeight = 0;
      let totalNeighborWeight = 0;
      let normalToAbnormal = 0;
      let normalToAbnormalWeight = 0;

      for (let segment = checkStart; segment <= checkEnd; segment += 1) {{
        const distance = Math.abs(segment - Number(rec.segment));
        if (distance === 0) {{
          continue;
        }}
        const weight = 1 / (distance + 1);
        totalNeighborWeight += weight;
        const neighbor = group.get(segment);
        if (!neighbor) {{
          missing += 1;
          missingWeight += weight;
          continue;
        }}
        existing += 1;
        observedWeight += weight;
        if (valueText(neighbor.label) !== targetLabel) {{
          mismatch += 1;
          mismatchWeight += weight;
          if (isNormalLabel(targetLabel) && isAbnormalLikeLabel(neighbor.label)) {{
            normalToAbnormal += 1;
            normalToAbnormalWeight += weight;
          }}
        }}
      }}

      let key;
      let text;
      let pillClass;
      let severity;
      if (mismatch > 0 && missing > 0) {{
        key = 'missing_mismatch';
        text = STATUS_LABELS.missing_mismatch;
        pillClass = 'different';
        severity = 4;
      }} else if (mismatch > 0) {{
        key = 'present_mismatch';
        text = STATUS_LABELS.present_mismatch;
        pillClass = 'different';
        severity = 3;
      }} else if (missing > 0) {{
        key = 'missing_consistent';
        text = STATUS_LABELS.missing_consistent;
        pillClass = 'warn';
        severity = 2;
      }} else {{
        key = 'present_consistent';
        text = STATUS_LABELS.present_consistent;
        pillClass = 'same';
        severity = 0;
      }}

      if (normalToAbnormal > 0) {{
        text += ' · normal→abnormal';
        severity += 0.75;
      }}

      return {{
        key,
        text,
        pillClass,
        severity,
        missing,
        mismatch,
        existing,
        total,
        checkStart,
        checkEnd,
        groupMin,
        groupMax,
        observedWeight,
        mismatchWeight,
        missingWeight,
        totalNeighborWeight,
        weightedScore: observedWeight > 0 ? mismatchWeight / observedWeight : 0,
        missingWeightRatio: totalNeighborWeight > 0 ? missingWeight / totalNeighborWeight : 0,
        normalToAbnormal,
        normalToAbnormalWeight,
      }};
    }}

    function statusMatchesFilter(status, filterValue) {{
      if (filterValue === 'all') return true;
      if (status.key === 'unparseable') return filterValue === 'unparseable';
      if (filterValue === 'has_missing' || filterValue === 'any_missing') return status.missing > 0;
      if (filterValue === 'has_mismatch') return status.mismatch > 0;
      if (filterValue === 'all_present') return status.key !== 'unparseable' && status.missing === 0;
      return status.key === filterValue;
    }}

    function targetLabelMatchesFilter(rec, filterValue) {{
      if (filterValue === 'all') return true;
      if (filterValue === 'normal') return isNormalLabel(rec.label);
      if (filterValue === 'abnormal') return isAbnormalLikeLabel(rec.label);
      return true;
    }}

    function collectItemsForExport(options = {{}}) {{
      const query = els.idSearch.value.trim().toLowerCase();
      const statusFilter = options.ignoreStatusFilter ? 'all' : els.statusFilter.value;
      const targetLabelFilter = els.targetLabelFilter.value;
      const {{ before, after }} = currentWindowParams();
      const items = [];
      for (const rec of records) {{
        const fields = [
          rec.id,
          rec.idBase,
          rec.groupKey,
          rec.label,
          rec.filePath,
          rec.detectorId,
          rec.channelId,
          rec.timePoint,
          rec.project,
        ];
        if (query && !fields.some(value => valueText(value).toLowerCase().includes(query))) {{
          continue;
        }}
        if (!targetLabelMatchesFilter(rec, targetLabelFilter)) {{
          continue;
        }}
        const status = classifyRecord(rec, before, after);
        if (!statusMatchesFilter(status, statusFilter)) {{
          continue;
        }}
        items.push({{ rec, status }});
      }}
      return items;
    }}

    function getFilteredRecords(options = {{}}) {{
      const query = els.idSearch.value.trim().toLowerCase();
      const statusFilter = options.ignoreStatusFilter ? 'all' : els.statusFilter.value;
      const targetLabelFilter = els.targetLabelFilter.value;
      const sortMode = els.sortMode.value;
      const {{ before, after }} = currentWindowParams();
      const items = [];

      for (const rec of records) {{
        const fields = [
          rec.id,
          rec.idBase,
          rec.groupKey,
          rec.label,
          rec.filePath,
          rec.detectorId,
          rec.channelId,
          rec.timePoint,
          rec.project,
        ];
        if (query && !fields.some(value => valueText(value).toLowerCase().includes(query))) {{
          continue;
        }}
        if (!targetLabelMatchesFilter(rec, targetLabelFilter)) {{
          continue;
        }}
        const status = classifyRecord(rec, before, after);
        if (!statusMatchesFilter(status, statusFilter)) {{
          continue;
        }}
        items.push({{ rec, status }});
      }}

      items.sort((a, b) => {{
        if (sortMode === 'weighted_desc') {{
          return b.status.weightedScore - a.status.weightedScore ||
            b.status.severity - a.status.severity ||
            b.status.mismatchWeight - a.status.mismatchWeight ||
            b.status.missingWeightRatio - a.status.missingWeightRatio ||
            a.rec.groupKey.localeCompare(b.rec.groupKey) ||
            Number(a.rec.segment) - Number(b.rec.segment);
        }}
        if (sortMode === 'weighted_asc') {{
          return a.status.weightedScore - b.status.weightedScore ||
            a.status.severity - b.status.severity ||
            a.status.missingWeightRatio - b.status.missingWeightRatio ||
            a.rec.groupKey.localeCompare(b.rec.groupKey) ||
            Number(a.rec.segment) - Number(b.rec.segment);
        }}
        if (sortMode === 'severity_asc') {{
          return a.status.severity - b.status.severity ||
            b.status.mismatch - a.status.mismatch ||
            b.status.missing - a.status.missing ||
            a.rec.groupKey.localeCompare(b.rec.groupKey) ||
            Number(a.rec.segment) - Number(b.rec.segment);
        }}
        if (sortMode === 'segment_asc') {{
          return a.rec.groupKey.localeCompare(b.rec.groupKey) ||
            Number(a.rec.segment) - Number(b.rec.segment) ||
            a.status.severity - b.status.severity;
        }}
        if (sortMode === 'id_asc') {{
          return a.rec.id.localeCompare(b.rec.id);
        }}
        return b.status.severity - a.status.severity ||
          b.status.mismatch - a.status.mismatch ||
          b.status.missing - a.status.missing ||
          a.rec.groupKey.localeCompare(b.rec.groupKey) ||
          Number(a.rec.segment) - Number(b.rec.segment);
      }});

      return items;
    }}

    function rebuildSelect(keepId) {{
      const filtered = getFilteredRecords();
      currentFilteredItems = filtered;
      const currentId = keepId || els.sampleSelect.value || (records[0] && records[0].id);
      if (listPageStart >= filtered.length) {{
        listPageStart = Math.max(0, Math.floor((filtered.length - 1) / LIST_PAGE_SIZE) * LIST_PAGE_SIZE);
      }}
      const visible = filtered.slice(listPageStart, listPageStart + LIST_PAGE_SIZE);
      els.sampleSelect.innerHTML = visible.map(item => {{
        const rec = item.rec;
        const label = `${{rec.id}} | label=${{valueText(rec.label)}} | segment=${{rec.segment}}`;
        return `<option value="${{escapeHtml(rec.id)}}">${{escapeHtml(label)}}</option>`;
      }}).join('');

      const selectedExists = visible.some(item => item.rec.id === currentId);
      if (selectedExists) {{
        els.sampleSelect.value = currentId;
      }} else if (visible.length) {{
        els.sampleSelect.value = visible[0].rec.id;
      }} else {{
        els.sampleSelect.value = '';
      }}

      const page = filtered.length ? Math.floor(listPageStart / LIST_PAGE_SIZE) + 1 : 0;
      const pages = Math.max(1, Math.ceil(filtered.length / LIST_PAGE_SIZE));
      els.filterHint.textContent = `匹配 ${{filtered.length}} 条；当前页 ${{visible.length}} 条。`;
      els.listPageInfo.textContent = `${{page}} / ${{pages}} · ${{filtered.length.toLocaleString()}}`;
      els.listPrevBtn.disabled = listPageStart <= 0;
