</style></head><body><main class="page">
<header><h1>样本时间维度状态汇总</h1><div class="meta">源 JSON: {html.escape(str(source_json))}<br>生成时间: {dt.datetime.now().strftime("%Y-%m-%d %H:%M:%S")}<br>窗口: -{before} / +{after}</div></header>
<div class="toolbar">
  <div><label for="datasetFilter">数据集</label><select id="datasetFilter"><option value="all">全部数据集</option>{dataset_options}</select></div>
  <div><label for="statusFilter">状态</label><select id="statusFilter"><option value="all">全部状态</option><option value="has_missing">有缺失</option><option value="has_mismatch">有不一致</option><option value="all_present">无缺失</option></select></div>
  <div class="muted" id="filterNote"></div>
</div>
<div class="summary" id="summary"></div>
<div class="grid"><section class="panel"><h2>缺失/不一致状态矩阵</h2><div id="matrix"></div></section><section class="panel"><h2>状态分类统计</h2><div class="status-hist" id="bars"></div></section></div>
<section class="panel" style="margin-top:14px"><h2>样本明细预览</h2><div class="muted" id="tableNote"></div><div class="table-wrap"><table><thead><tr><th>ID</th><th>数据集</th><th>group</th><th>segment</th><th>label</th><th>状态</th><th>缺失</th><th>不一致</th><th>加权不一致</th></tr></thead><tbody id="rows"></tbody></table></div></section>
</main></body></html>"""
    script = f"""
<script>
const DATA = {data_json};
const STATUS_DEFS = {status_json};
const COLORS = {{unparseable:'#991b1b',missing_mismatch:'#dc2626',present_mismatch:'#ef4444',missing_consistent:'#d97706',present_consistent:'#15803d'}};
const statusSelect = document.getElementById('statusFilter');
for (const st of STATUS_DEFS) {{
  const opt = document.createElement('option');
  opt.value = st.key;
  opt.textContent = st.label;
  statusSelect.appendChild(opt);
}}
function esc(v) {{
  return String(v ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
}}
function matchesStatus(row, key) {{
  if (key === 'all') return true;
  if (key === 'has_missing') return row.missing > 0;
  if (key === 'has_mismatch') return row.mismatch > 0;
  if (key === 'all_present') return row.statusKey !== 'unparseable' && row.missing === 0;
  return row.statusKey === key;
}}
function filtered() {{
  const ds = document.getElementById('datasetFilter').value;
  const st = document.getElementById('statusFilter').value;
  return DATA.filter(row => (ds === 'all' || row.dataset === ds) && matchesStatus(row, st));
}}
function counts(items) {{
  const out = Object.fromEntries(STATUS_DEFS.map(st => [st.key, 0]));
  for (const row of items) out[row.statusKey] = (out[row.statusKey] || 0) + 1;
  return out;
}}
function metric(label, value) {{
  return `<div class="metric"><div class="metric-label">${{esc(label)}}</div><div class="metric-value">${{esc(value)}}</div></div>`;
}}
function render() {{
  const items = filtered();
  const c = counts(items);
  const miss = (c.missing_mismatch || 0) + (c.missing_consistent || 0);
  const mismatch = (c.missing_mismatch || 0) + (c.present_mismatch || 0);
  document.getElementById('summary').innerHTML = [
    metric('样本数', items.length.toLocaleString()),
    metric('有缺失', miss.toLocaleString()),
    metric('有不一致', mismatch.toLocaleString()),
    metric('无缺失无不一致', (c.present_consistent || 0).toLocaleString()),
    metric('无法识别', (c.unparseable || 0).toLocaleString()),
  ].join('');
  document.getElementById('filterNote').textContent = `当前筛选：${{items.length.toLocaleString()}} / ${{DATA.length.toLocaleString()}} 条`;
  const maxCount = Math.max(1, ...Object.values(c));
  document.getElementById('bars').innerHTML = STATUS_DEFS.map(st => {{
    const count = c[st.key] || 0;
    const width = Math.max(2, count / maxCount * 100);
    return `<div class="hist-row"><div class="hist-label">${{esc(st.label)}}</div><div class="hist-track"><div class="hist-bar" style="width:${{width}}%;background:${{COLORS[st.key]}}"></div></div><div class="hist-value">${{count.toLocaleString()}}</div></div>`;
  }}).join('');
  function cell(key, title, note) {{
    const count = c[key] || 0;
    const pct = items.length ? (count / items.length * 100).toFixed(1) + '%' : '0.0%';
    return `<div class="matrix-cell" style="border-left-color:${{COLORS[key]}}"><div><span>${{esc(title)}}</span><strong>${{count.toLocaleString()}}</strong><span>${{pct}}</span></div><small>${{esc(note)}}</small></div>`;
  }}
  document.getElementById('matrix').innerHTML = `
    <div class="matrix">
      <div></div>
      <div class="matrix-head">无缺失</div>
      <div class="matrix-head">有缺失</div>
      <div class="matrix-head matrix-axis">有不一致</div>
      ${{cell('present_mismatch', '无缺失 + 有不一致', '连续片段都存在，但窗口内 label 有冲突')}}
      ${{cell('missing_mismatch', '有缺失 + 有不一致', '同时存在断片和 label 冲突，优先检查')}}
      <div class="matrix-head matrix-axis">无不一致</div>
      ${{cell('present_consistent', '无缺失 + 无不一致', '窗口完整且 label 一致')}}
      ${{cell('missing_consistent', '有缺失 + 无不一致', '已有片段一致，但窗口内部缺 segment')}}
    </div>
    <div class="matrix-extra"><div><strong>无法识别编号</strong><div class="muted">ID 末尾不是可解析数字编号，不参与窗口计算</div></div><strong>${{(c.unparseable || 0).toLocaleString()}}</strong></div>
  `;
  document.getElementById('rows').innerHTML = items.slice(0, 800).map(row => `<tr><td>${{esc(row.id)}}</td><td>${{esc(row.dataset)}}</td><td>${{esc(row.group)}}</td><td>${{esc(row.segment)}}</td><td>${{esc(row.label)}}</td><td>${{esc(row.statusLabel)}}</td><td>${{row.missing}}</td><td>${{row.mismatch}}</td><td>${{Number(row.weighted).toFixed(6)}}</td></tr>`).join('');
  document.getElementById('tableNote').textContent = `显示前 ${{Math.min(800, items.length).toLocaleString()}} 条明细`;
}}
document.getElementById('datasetFilter').addEventListener('change', render);
document.getElementById('statusFilter').addEventListener('change', render);
render();
</script>"""
    doc = doc.replace("</main></body></html>", f"</main>{script}</body></html>")
    out_path.parent.mkdir(parents=True, exist_ok=True)
    out_path.write_text(doc, encoding="utf-8")


def column_name(index: int) -> str:
    name = ""
    n = index + 1
    while n > 0:
        n, rem = divmod(n - 1, 26)
        name = chr(65 + rem) + name
    return name


def worksheet_xml(rows: List[List[Any]]) -> str:
    body = []
    for r_idx, row in enumerate(rows, 1):
        cells = []
        for c_idx, cell in enumerate(row):
            ref = f"{column_name(c_idx)}{r_idx}"
            text = html.escape(value_text(cell), quote=True)
            cells.append(f'<c r="{ref}" t="inlineStr"><is><t>{text}</t></is></c>')
        body.append(f'<row r="{r_idx}">{"".join(cells)}</row>')
    return (
        '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>'
        '<worksheet xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main">'
        f'<sheetData>{"".join(body)}</sheetData></worksheet>'
    )


def safe_sheet_name(name: str, fallback: str) -> str:
    cleaned = re.sub(r'[\\/?*\[\]:]+', " ", name).strip() or fallback
    return cleaned[:31]


def export_status_xlsx(items: List[Dict[str, Any]], out_path: Path, source_json: Path, before: int, after: int) -> None:
    counts = status_counts(items)
    headers = [
        "ID",
        "group_key",
        "segment",
        "label",
        "status_key",
        "status_label",
        "has_missing",
        "has_mismatch",
        "missing_count",
        "mismatch_count",
        "weighted_inconsistency",
        "missing_weight_ratio",
        "before",
        "after",
        "duration",
        "sample_rate",
        "detector_id",
        "unit_id",
        "channel_id",
        "time_point",
        "project",
        "file_path",
    ]

    def item_row(item: Dict[str, Any]) -> List[Any]:
        rec = item["browser"]
        status = item["status"]
        return [
            rec.get("id", ""),
            rec.get("groupKey", ""),
            rec.get("segment", ""),
            rec.get("label", ""),
            status["key"],
            status["label"],
            status["has_missing"],
            status["has_mismatch"],
            status["missing_count"],
            status["mismatch_count"],
            status["weighted_inconsistency"],
            status["missing_weight_ratio"],
            before,
            after,
            rec.get("duration", ""),
            rec.get("sampleRate", ""),
            rec.get("detectorId", ""),
            rec.get("unitId", ""),
            rec.get("channelId", ""),
            rec.get("timePoint", ""),
            rec.get("project", ""),
            rec.get("filePath", ""),
        ]

    sheets: List[Tuple[str, List[List[Any]]]] = [
        (
            "汇总",
            [
                ["source_json", str(source_json)],
                ["generated_at", dt.datetime.now().strftime("%Y-%m-%d %H:%M:%S")],
                ["before", before],
                ["after", after],
                ["record_count", len(items)],
                [],
                ["status_key", "status_label", "count"],
                *[[key, STATUS_LABELS.get(key, key), counts.get(key, 0)] for key, _ in STATUS_DEFS],
            ],
        )
    ]
    for key, label in STATUS_DEFS:
        rows = [headers]
        rows.extend(item_row(item) for item in items if item["status"]["key"] == key)
        sheets.append((label, rows))

    out_path.parent.mkdir(parents=True, exist_ok=True)
    with zipfile.ZipFile(out_path, "w", compression=zipfile.ZIP_DEFLATED) as zf:
        overrides = "".join(
            f'<Override PartName="/xl/worksheets/sheet{i}.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml"/>'
            for i in range(1, len(sheets) + 1)
        )
        workbook_sheets = "".join(
            f'<sheet name="{html.escape(safe_sheet_name(name, f"Sheet{i}"), quote=True)}" sheetId="{i}" r:id="rId{i}"/>'
            for i, (name, _) in enumerate(sheets, 1)
        )
        workbook_rels = "".join(
            f'<Relationship Id="rId{i}" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/worksheet" Target="worksheets/sheet{i}.xml"/>'
            for i in range(1, len(sheets) + 1)
        )
        zf.writestr(
            "[Content_Types].xml",
            '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>'
            '<Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types">'
            '<Default Extension="rels" ContentType="application/vnd.openxmlformats-package.relationships+xml"/>'
            '<Default Extension="xml" ContentType="application/xml"/>'
            '<Override PartName="/xl/workbook.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet.main+xml"/>'
            f"{overrides}</Types>",
        )
        zf.writestr(
            "_rels/.rels",
            '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>'
            '<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships">'
            '<Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument" Target="xl/workbook.xml"/>'
            "</Relationships>",
        )
        zf.writestr(
            "xl/workbook.xml",
            '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>'
            '<workbook xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main" '
            'xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships">'
            f"<sheets>{workbook_sheets}</sheets></workbook>",
        )
        zf.writestr(
            "xl/_rels/workbook.xml.rels",
            '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>'
            '<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships">'
            f"{workbook_rels}</Relationships>",
        )
        for i, (_, rows) in enumerate(sheets, 1):
            zf.writestr(f"xl/worksheets/sheet{i}.xml", worksheet_xml(rows))


def export_source_bat(items: List[Dict[str, Any]], out_path: Path, filter_key: str, filter_label: str) -> None:
    selected = [item for item in items if matches_status_filter(item, filter_key)]
    folder_name = f"sample_context_sources_{safe_filename(filter_key)}_{safe_filename(filter_label)}"
    seen = set()
    lines = [
        "@echo off",
        "setlocal",
        f'set "OUT_DIR=%~dp0{folder_name}"',
        'mkdir "%OUT_DIR%" 2>nul',
        'cd /d "%OUT_DIR%"',
        f"rem Status filter: {filter_key} / {filter_label}",
        "",
    ]
    for item in selected:
        rec = item["browser"]
        src = value_text(rec.get("filePath") or rec.get("id") or "").strip()
        if not src or src in seen:
            continue
        seen.add(src)
        lines.append(f"rem {item['status']['label']} | {rec.get('id', '')}")
        lines.append(f'copy /Y "{src.replace(chr(34), chr(34) + chr(34))}" .')
    lines.extend(["", f"echo Copied {len(seen)} source files for {filter_label} to %CD%", "pause"])
    out_path.parent.mkdir(parents=True, exist_ok=True)
    out_path.write_text("\r\n".join(lines), encoding="utf-8")


def run_extra_exports(args: argparse.Namespace, payload: Dict[str, Any], original_records: List[Record], json_path: Path, output_path: Path) -> None:
    requested = set(args.export or [])
    if not requested:
        return
    if "all" in requested:
        requested.update({"xlsx", "json", "html", "sources"})
    items = build_status_items(payload, original_records, args.before, args.after)
    prefix = args.export_prefix.expanduser().resolve() if args.export_prefix else output_path.with_suffix("")

    if "xlsx" in requested:
        path = Path(str(prefix) + "_status_summary.xlsx")
        print(f"      Export XLSX: {path}")
        export_status_xlsx(items, path, json_path, args.before, args.after)
    if "json" in requested:
        path = Path(str(prefix) + "_status_summary.json")
        print(f"      Export JSON: {path}")
        export_status_json(items, path, json_path, args.before, args.after)
    if "html" in requested:
        path = Path(str(prefix) + "_summary.html")
        print(f"      Export summary HTML: {path}")
        export_summary_html(items, path, json_path, args.before, args.after)
    if "sources" in requested:
        filters = SOURCE_EXPORT_FILTERS if "all" in (args.export or []) else [(args.status_filter, args.status_filter_label or args.status_filter)]
        for filter_key, filter_label in filters:
            path = Path(str(prefix) + f"_copy_sources_{safe_filename(filter_key)}.bat")
            print(f"      Export source BAT: {path}")
            export_source_bat(items, path, filter_key, filter_label)


