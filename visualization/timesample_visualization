from collections import Counter, defaultdict
from pathlib import Path
from typing import Any, Dict, Iterable, List, Optional, Tuple


Record = Dict[str, Any]

KNOWN_AUDIO_EXTENSIONS_RE = re.compile(r"\.(wav|mp3|flac|m4a|ogg|aac)$", re.IGNORECASE)
SEGMENT_SUFFIX_RE = re.compile(r"^(?P<long_id>.+_)(?P<segment>\d+)$")
BIN_MAGIC = b"SCVBIN2\0"
BIN_VERSION = 2
BIN_INT_FIELDS = [
    "index",
    "segment",
    "parsedSegment",
    "segmentWidth",
    "id",
    "idBase",
    "groupKey",
    "label",
    "duration",
    "sampleRate",
    "filePath",
    "detectorId",
    "unitId",
    "channelId",
    "timePoint",
    "project",
    "md5",
    "usedOrNot",
    "trainOrTest",
    "manualOrPseudo",
    "flat",
]
STATUS_DEFS = [
    ("unparseable", "无法识别编号"),
    ("missing_mismatch", "有缺失 + 有不一致"),
    ("present_mismatch", "无缺失 + 有不一致"),
    ("missing_consistent", "有缺失 + 无不一致"),
    ("present_consistent", "无缺失 + 无不一致"),
]
STATUS_LABELS = dict(STATUS_DEFS)
SOURCE_EXPORT_FILTERS = [
    ("unparseable", "无法识别编号"),
    ("missing_mismatch", "有缺失_有不一致"),
    ("present_mismatch", "无缺失_有不一致"),
    ("missing_consistent", "有缺失_无不一致"),
    ("present_consistent", "无缺失_无不一致"),
    ("has_missing", "有缺失"),
    ("has_mismatch", "有不一致"),
    ("all_present", "无缺失"),
]


def load_records(json_path: Path) -> List[Record]:
    with json_path.open("r", encoding="utf-8-sig") as f:
        payload = json.load(f)

    if isinstance(payload, dict):
        records = payload.get("datas")
        if records is None:
            raise ValueError("JSON top-level object does not contain a `datas` field.")
    else:
        records = payload

    if not isinstance(records, list):
        raise ValueError("JSON data must be a list or an object with a list field named `datas`.")

    normalized: List[Record] = []
    for index, item in enumerate(records):
        if not isinstance(item, dict):
            raise ValueError(f"Record #{index} is not an object.")
        normalized.append(item)
    return normalized


def strip_audio_extension(value: str) -> str:
    return KNOWN_AUDIO_EXTENSIONS_RE.sub("", value)


def get_record_id(record: Record) -> str:
    value = record.get("ID") or record.get("id") or record.get("file_name") or record.get("filename")
    if value:
        return str(value)

    file_path = record.get("file_path")
    if file_path:
        return os.path.basename(str(file_path))

    raise ValueError(f"Record is missing ID/file_path: {record!r}")


def parse_id(record_id: str) -> Tuple[str, int, int]:
    """
    Return (long_sample_id, segment_number, segment_width).

    Example:
        D0003_U0046_C03_..._512_215.wav
    becomes:
        ("D0003_U0046_C03_..._512_", 215, 3)
    """
    basename = os.path.basename(record_id)
    stem = strip_audio_extension(basename)
    match = SEGMENT_SUFFIX_RE.match(stem)
    if not match:
        raise ValueError(f"Cannot parse trailing segment number from ID: {record_id}")
    segment_text = match.group("segment")
    return match.group("long_id"), int(segment_text), len(segment_text)


def parse_non_numeric_suffix(record_id: str) -> Tuple[str, str]:
    basename = os.path.basename(record_id)
    stem = strip_audio_extension(basename)
    if "_" not in stem:
        return stem + "_", stem
    prefix, suffix = stem.rsplit("_", 1)
    return prefix + "_", suffix


def parse_segment_id(raw_value: Any, fallback: int) -> int:
    if raw_value is None or raw_value == "":
        return fallback
    try:
        return int(str(raw_value))
    except ValueError:
        return fallback


def flatten_dict(value: Any, prefix: str = "") -> Dict[str, Any]:
    if not isinstance(value, dict):
        return {prefix: value}

    result: Dict[str, Any] = {}
    for key in sorted(value.keys()):
        child_key = f"{prefix}.{key}" if prefix else str(key)
        child = value[key]
        if isinstance(child, dict):
            result.update(flatten_dict(child, child_key))
        else:
            result[child_key] = child
    return result


def safe_value(value: Any) -> Any:
    if value is None:
        return None
    if isinstance(value, (str, int, float, bool)):
        return value
    if isinstance(value, list):
        return [safe_value(item) for item in value]
    if isinstance(value, dict):
        return {str(key): safe_value(child) for key, child in value.items()}
    return str(value)


def make_browser_record(record: Record, index: int) -> Record:
    rid = get_record_id(record)
    segment_token = ""
    parseable_segment = True
    try:
        group_key, parsed_segment, segment_width = parse_id(rid)
        segment = parse_segment_id(record.get("segment_id"), parsed_segment)
        segment_token = str(record.get("segment_id") or str(parsed_segment).zfill(segment_width))
    except ValueError:
        group_key, segment_token = parse_non_numeric_suffix(rid)
        parsed_segment = -1
        segment = -1
        segment_width = 0
        parseable_segment = False

    flattened = flatten_dict(record)
    return {
        "index": index,
        "id": rid,
        "idBase": os.path.basename(rid),
        "groupKey": group_key,
        "segment": segment,
        "parsedSegment": parsed_segment,
        "segmentWidth": segment_width,
        "segmentToken": segment_token,
        "parseableSegment": parseable_segment,
        "label": safe_value(record.get("label", "")),
        "duration": safe_value(record.get("duration", "")),
        "sampleRate": safe_value(record.get("sample_rate", "")),
        "filePath": safe_value(record.get("file_path", "")),
        "detectorId": safe_value(record.get("detector_id", "")),
        "unitId": safe_value(record.get("unit_id", "")),
        "channelId": safe_value(record.get("channel_id", "")),
        "timePoint": safe_value(record.get("time_point", "")),
        "project": safe_value(record.get("project", "")),
        "md5": safe_value(flattened.get("other_information.md5", "")),
        "usedOrNot": safe_value(flattened.get("other_information.tags.used_or_not", "")),
        "trainOrTest": safe_value(flattened.get("other_information.tags.train_or_test", "")),
        "manualOrPseudo": safe_value(flattened.get("other_information.tags.manual_or_pseudo", "")),
        "flat": safe_value(flattened),
    }


def summarize_groups(records: Iterable[Record]) -> Tuple[Dict[str, Counter], int]:
    seen: Dict[Tuple[str, int], str] = {}
    duplicate_count = 0
    group_labels: Dict[str, Counter] = defaultdict(Counter)

    for item in records:
        group_key = str(item["groupKey"])
        segment = int(item["segment"])
        key = (group_key, segment)
        if key in seen:
            duplicate_count += 1
        seen[key] = str(item["id"])
        group_labels[group_key][str(item.get("label", ""))] += 1

    return group_labels, duplicate_count


def build_report_payload(records: List[Record], json_path: Path, before: int, after: int) -> Dict[str, Any]:
    browser_records: List[Record] = []
    parse_errors: List[str] = []

    for index, record in enumerate(records):
        try:
            browser_records.append(make_browser_record(record, index))
        except Exception as exc:
            parse_errors.append(f"#{index}: {exc}")

    if not browser_records:
        raise ValueError("No parseable records were found.")

    group_labels, duplicate_count = summarize_groups(browser_records)
    label_counts = Counter(str(item.get("label", "")) for item in browser_records)
    group_sizes = Counter(str(item["groupKey"]) for item in browser_records)

    return {
        "meta": {
            "sourceJson": str(json_path),
            "generatedAt": dt.datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
            "defaultBefore": before,
            "defaultAfter": after,
            "recordCount": len(browser_records),
            "skippedCount": len(parse_errors),
            "groupCount": len(group_sizes),
            "duplicateSegmentCount": duplicate_count,
            "labelCounts": dict(sorted(label_counts.items())),
            "largestGroups": group_sizes.most_common(10),
            "parseErrors": parse_errors[:200],
        },
        "records": sorted(browser_records, key=lambda item: (str(item["groupKey"]), int(item["segment"]), str(item["id"]))),
        "groups": {
            key: {
                "labelCounts": dict(sorted(counter.items())),
                "size": sum(counter.values()),
            }
            for key, counter in sorted(group_labels.items())
        },
    }


def _align4(value: int) -> int:
    return (value + 3) & ~3


def build_binary_report(payload: Dict[str, Any]) -> Tuple[bytes, Dict[str, int]]:
    """
    Build a true binary data file:

    header:
        8s magic, uint32 version, uint32 record_count, uint32 int_field_count,
        uint32 string_count, uint32 meta_json_len, uint32 string_blob_len
    body:
        meta JSON bytes, 4-byte padding,
        uint32 string offsets, UTF-8 string blob, 4-byte padding,
        int32 record table
    """
    strings: List[bytes] = []
    string_index: Dict[str, int] = {}

    def intern(value: Any) -> int:
        if value is None:
            text = ""
        elif isinstance(value, (dict, list)):
            text = json.dumps(value, ensure_ascii=False, separators=(",", ":"))
        else:
            text = str(value)
        existing = string_index.get(text)
        if existing is not None:
            return existing
        encoded = text.encode("utf-8")
        idx = len(strings)
        strings.append(encoded)
        string_index[text] = idx
        return idx

    intern("")

    rows: List[int] = []
    for rec in payload["records"]:
        rows.extend(
            [
                int(rec.get("index", 0)),
                int(rec.get("segment", 0)),
                int(rec.get("parsedSegment", 0)),
                int(rec.get("segmentWidth", 0)),
                intern(rec.get("id", "")),
                intern(rec.get("idBase", "")),
                intern(rec.get("groupKey", "")),
                intern(rec.get("label", "")),
                intern(rec.get("duration", "")),
                intern(rec.get("sampleRate", "")),
                intern(rec.get("filePath", "")),
                intern(rec.get("detectorId", "")),
                intern(rec.get("unitId", "")),
                intern(rec.get("channelId", "")),
                intern(rec.get("timePoint", "")),
                intern(rec.get("project", "")),
                intern(rec.get("md5", "")),
                intern(rec.get("usedOrNot", "")),
                intern(rec.get("trainOrTest", "")),
                intern(rec.get("manualOrPseudo", "")),
                intern(rec.get("flat", {})),
            ]
        )

    offsets = [0]
    blob_parts: List[bytes] = []
    total = 0
    for encoded in strings:
        blob_parts.append(encoded)
        total += len(encoded)
        offsets.append(total)

    string_blob = b"".join(blob_parts)
    meta_bytes = json.dumps(
        {"meta": payload["meta"], "groups": payload["groups"]},
        ensure_ascii=False,
        separators=(",", ":"),
    ).encode("utf-8")

    header = struct.pack(
        "<8sIIIIII",
        BIN_MAGIC,
        BIN_VERSION,
        len(payload["records"]),
        len(BIN_INT_FIELDS),
        len(strings),
        len(meta_bytes),
        len(string_blob),
    )
    meta_pad = b"\0" * (_align4(len(header) + len(meta_bytes)) - (len(header) + len(meta_bytes)))
    offset_array = array("I", offsets)
    if offset_array.itemsize != 4:
        raise RuntimeError("This platform does not use 4-byte unsigned integers for array('I').")
    if sys.byteorder != "little":
        offset_array.byteswap()
    offsets_bytes = offset_array.tobytes()
    strings_pad = b"\0" * (_align4(len(header) + len(meta_bytes) + len(meta_pad) + len(offsets_bytes) + len(string_blob)) - (len(header) + len(meta_bytes) + len(meta_pad) + len(offsets_bytes) + len(string_blob)))
    row_array = array("i", rows)
    if row_array.itemsize != 4:
        raise RuntimeError("This platform does not use 4-byte signed integers for array('i').")
    if sys.byteorder != "little":
        row_array.byteswap()
    rows_bytes = row_array.tobytes()

    binary = header + meta_bytes + meta_pad + offsets_bytes + string_blob + strings_pad + rows_bytes
    stats = {
        "record_count": len(payload["records"]),
        "string_count": len(strings),
        "string_blob_bytes": len(string_blob),
        "meta_bytes": len(meta_bytes),
        "record_table_bytes": len(rows_bytes),
    }
    return binary, stats


def value_text(value: Any) -> str:
    if value is None:
        return ""
    if isinstance(value, (dict, list)):
        return json.dumps(value, ensure_ascii=False, sort_keys=True)
    return str(value)


def is_normal_label(label: Any) -> bool:
    return value_text(label).strip().lower() == "normal"


def is_abnormal_like_label(label: Any) -> bool:
    text = value_text(label).strip().lower()
    return text in {"abnormal", "anomaly", "alarm"} or "abnormal" in text


def build_segment_groups(records: List[Record]) -> Dict[str, Dict[int, Record]]:
    groups: Dict[str, Dict[int, Record]] = defaultdict(dict)
    for rec in records:
        try:
            groups[str(rec["groupKey"])][int(rec["segment"])] = rec
        except Exception:
            continue
    return groups


def classify_browser_record(rec: Record, groups: Dict[str, Dict[int, Record]], before: int, after: int) -> Dict[str, Any]:
    segment = int(rec.get("segment", -1))
    segment_width = int(rec.get("segmentWidth", 0))
    if segment < 0 or segment_width == 0:
        return {
            "key": "unparseable",
            "label": STATUS_LABELS["unparseable"],
            "has_missing": False,
            "has_mismatch": False,
            "missing_count": 0,
            "mismatch_count": 0,
            "existing_neighbor_count": 0,
            "effective_window_size": 0,
            "requested_before": before,
            "requested_after": after,
            "checked_start_segment": None,
            "checked_end_segment": None,
            "group_min_segment": None,
            "group_max_segment": None,
            "weighted_inconsistency": 1.0,
            "missing_weight_ratio": 0.0,
            "normal_to_abnormal_count": 0,
            "normal_to_abnormal_weight": 0.0,
            "group_key": rec.get("groupKey", ""),
            "segment": rec.get("segmentToken") or rec.get("segment", ""),
        }

    group = groups.get(str(rec["groupKey"]), {})
    segments = sorted(k for k in group.keys() if isinstance(k, int))
    group_min = segments[0] if segments else segment
    group_max = segments[-1] if segments else segment
    check_start = max(segment - before, group_min)
    check_end = min(segment + after, group_max)
    target_label = value_text(rec.get("label", ""))

    missing = 0
    mismatch = 0
    existing = 0
    observed_weight = 0.0
    mismatch_weight = 0.0
    missing_weight = 0.0
    total_neighbor_weight = 0.0
    normal_to_abnormal = 0
    normal_to_abnormal_weight = 0.0

    for seg in range(check_start, check_end + 1):
        distance = abs(seg - segment)
        if distance == 0:
            continue
        weight = 1.0 / (distance + 1)
        total_neighbor_weight += weight
        neighbor = group.get(seg)
        if not neighbor:
            missing += 1
            missing_weight += weight
            continue
        existing += 1
        observed_weight += weight
        if value_text(neighbor.get("label", "")) != target_label:
            mismatch += 1
            mismatch_weight += weight
            if is_normal_label(target_label) and is_abnormal_like_label(neighbor.get("label", "")):
                normal_to_abnormal += 1
                normal_to_abnormal_weight += weight

    if mismatch > 0 and missing > 0:
        key = "missing_mismatch"
    elif mismatch > 0:
        key = "present_mismatch"
    elif missing > 0:
        key = "missing_consistent"
    else:
        key = "present_consistent"

    return {
        "key": key,
        "label": STATUS_LABELS[key],
        "has_missing": missing > 0,
        "has_mismatch": mismatch > 0,
        "missing_count": missing,
        "mismatch_count": mismatch,
        "existing_neighbor_count": existing,
        "effective_window_size": max(0, check_end - check_start + 1),
        "requested_before": before,
        "requested_after": after,
        "checked_start_segment": check_start,
        "checked_end_segment": check_end,
        "group_min_segment": group_min,
        "group_max_segment": group_max,
        "weighted_inconsistency": round(mismatch_weight / observed_weight, 6) if observed_weight > 0 else 0.0,
        "missing_weight_ratio": round(missing_weight / total_neighbor_weight, 6) if total_neighbor_weight > 0 else 0.0,
        "normal_to_abnormal_count": normal_to_abnormal,
        "normal_to_abnormal_weight": round(normal_to_abnormal_weight, 6),
        "group_key": rec.get("groupKey", ""),
        "segment": segment,
    }


def build_status_items(payload: Dict[str, Any], original_records: List[Record], before: int, after: int) -> List[Dict[str, Any]]:
    groups = build_segment_groups(payload["records"])
    items: List[Dict[str, Any]] = []
    for rec in payload["records"]:
        status = classify_browser_record(rec, groups, before, after)
        original = original_records[int(rec["index"])] if int(rec["index"]) < len(original_records) else {}
        items.append({"browser": rec, "original": original, "status": status})
    return items


def status_counts(items: Iterable[Dict[str, Any]]) -> Dict[str, int]:
    counts = {key: 0 for key, _ in STATUS_DEFS}
    for item in items:
        key = str(item["status"]["key"])
        counts[key] = counts.get(key, 0) + 1
    return counts


def matches_status_filter(item: Dict[str, Any], filter_key: str) -> bool:
    status = item["status"]
    if filter_key == "all":
        return True
    if filter_key == "has_missing":
        return bool(status["has_missing"])
    if filter_key == "has_mismatch":
        return bool(status["has_mismatch"])
    if filter_key == "all_present":
        return status["key"] != "unparseable" and not status["has_missing"]
    return status["key"] == filter_key


def safe_filename(value: str) -> str:
    cleaned = re.sub(r'[\\/:*?"<>|\s]+', "_", value.strip())
    cleaned = re.sub(r"_+", "_", cleaned).strip("_")
    return cleaned or "all"


def export_status_json(items: List[Dict[str, Any]], out_path: Path, source_json: Path, before: int, after: int) -> None:
    counts = status_counts(items)
    grouped = {key: [] for key, _ in STATUS_DEFS}
    for item in items:
        row = safe_value(item["original"])
        if not isinstance(row, dict):
            row = {"value": row}
        row = dict(row)
        row["time_context_status"] = item["status"]
        grouped.setdefault(item["status"]["key"], []).append(row)

    output = {
        "summary": {
            "source_json": str(source_json),
            "generated_at": dt.datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
            "before": before,
            "after": after,
            "record_count": len(items),
            "status_counts": counts,
            "status_labels": STATUS_LABELS,
        },
        "groups": {
            key: {
                "label": STATUS_LABELS.get(key, key),
                "count": len(grouped.get(key, [])),
                "datas": grouped.get(key, []),
            }
            for key, _ in STATUS_DEFS
        },
    }
    out_path.parent.mkdir(parents=True, exist_ok=True)
    with out_path.open("w", encoding="utf-8") as f:
        json.dump(output, f, ensure_ascii=False, indent=2)


