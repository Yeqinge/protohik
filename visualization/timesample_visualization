      const largest = (meta.largestGroups || [])
        .map(([key, size]) => `<span class="chip"><span class="mono">${{escapeHtml(key)}}</span>: ${{size}}</span>`)
        .join('');
      const errors = (meta.parseErrors || [])
        .map(item => `<li class="mono">${{escapeHtml(item)}}</li>`)
