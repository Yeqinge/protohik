      }}).join('');
      const largest = (meta.largestGroups || [])
        .map(([key, size]) => `<span class="chip"><span class="mono">${{escapeHtml(key)}}</span>: ${{size}}</span>`)
        .join('');
      const errors = (meta.parseErrors || [])
        .map(item => `<li class="mono">${{escapeHtml(item)}}</li>`)
        .join('');

      els.parseNotes.innerHTML = `
        <h3>当前窗口大小下的全量状态分类样本数</h3>
        <div class="status-hist">${{histHtml}}</div>
        <div class="chip-row">
          <span class="chip">当前统计样本数: ${{items.length.toLocaleString()}}</span>
          <span class="chip">全局 label 分布: ${{escapeHtml(formatCounts(meta.labelCounts))}}</span>
          <span class="chip">重复 group+segment: ${{meta.duplicateSegmentCount}}</span>
        </div>
        <div class="chip-row">${{largest}}</div>
        ${{errors ? `<h3 style="margin-top:14px">跳过的记录</h3><ul>${{errors}}</ul>` : '<p class="muted">没有解析错误。</p>'}}
      `;
    }}

    function renderAll() {{
      const target = selectedRecord();
      if (!target) {{
        els.statusCard.classList.remove('ok', 'warn', 'bad');
        els.statusTitle.textContent = '没有可解析样本';
        els.statusNote.textContent = '当前筛选条件没有匹配项。';
        els.targetTable.innerHTML = '';
        els.groupTable.innerHTML = '';
        els.timeline.innerHTML = '';
        els.windowChips.innerHTML = '';
        els.windowRows.innerHTML = '';
        els.detailList.innerHTML = '<div class="empty">没有可展示的样本。</div>';
        return;
      }}
      const before = numberInputValue(els.beforeInput, meta.defaultBefore);
      const after = numberInputValue(els.afterInput, meta.defaultAfter);
      const targetStatus = classifyRecord(target, before, after);
      if (targetStatus.key === 'unparseable') {{
        const rows = [{{ segment: displaySegment(target), offset: 0, record: target }}];
        els.statusCard.classList.remove('ok', 'warn');
        els.statusCard.classList.add('bad');
        els.statusTitle.textContent = '无法识别小样本编号';
        els.statusNote.textContent = '该样本末尾不是数字编号，已单独归类，不参与前后窗口一致性计算。';
        renderTarget(target, rows, before, after);
        els.timeline.innerHTML = '<div class="empty">该样本没有可计算的前后编号窗口。</div>';
        els.windowChips.innerHTML = `${{pill('无法识别编号', 'different')}}`;
        els.windowRows.innerHTML = `<tr class="different-row"><td>0</td><td>${{escapeHtml(displaySegment(target))}}</td><td>${{pill(target.label, 'different')}}</td><td>${{pill('不参与窗口计算', 'different')}}</td><td class="wide mono">${{escapeHtml(target.id)}}</td><td colspan="6">末尾后缀不是数字编号</td></tr>`;
        renderDetails(target, rows);
        return;
      }}
      const rows = makeWindow(target, before, after);
      renderStatus(target, rows);
      renderTarget(target, rows, before, after);
      renderTimeline(target, rows);
      renderRows(target, rows);
      renderDetails(target, rows);
    }}

    async function decodePayloadFromBuffer(arrayBuffer) {{
      const view = new DataView(arrayBuffer);
      const magic = new TextDecoder('ascii').decode(new Uint8Array(arrayBuffer, 0, 7));
      if (magic !== 'SCVBIN2') {{
        throw new Error('bin 文件格式不匹配，请确认 HTML 和 bin 是由新版脚本同一次生成的。');
      }}

      const version = view.getUint32(8, true);
      const recordCount = view.getUint32(12, true);
      const intFieldCount = view.getUint32(16, true);
      const stringCount = view.getUint32(20, true);
      const metaLen = view.getUint32(24, true);
      const stringBlobLen = view.getUint32(28, true);
      if (version !== 2) {{
        throw new Error(`不支持的 bin 版本：${{version}}`);
      }}
      if (intFieldCount !== 21) {{
        throw new Error(`bin 字段数不匹配：${{intFieldCount}}`);
      }}

      const align4 = (n) => (n + 3) & ~3;
      const utf8 = new TextDecoder('utf-8');
      let offset = 32;
      els.loadStatus.textContent = '正在解析 bin 元信息...';
      const metaText = utf8.decode(new Uint8Array(arrayBuffer, offset, metaLen));
      const container = JSON.parse(metaText);
      offset = align4(offset + metaLen);

      const stringOffsets = new Uint32Array(arrayBuffer, offset, stringCount + 1);
      offset += (stringCount + 1) * 4;
      const stringBytes = new Uint8Array(arrayBuffer, offset, stringBlobLen);
      offset = align4(offset + stringBlobLen);
      const table = new Int32Array(arrayBuffer, offset, recordCount * intFieldCount);

      const stringCache = new Map();
      function readString(idx) {{
        if (idx < 0 || idx >= stringCount) return '';
        if (stringCache.has(idx)) return stringCache.get(idx);
        const start = stringOffsets[idx];
        const end = stringOffsets[idx + 1];
        const value = utf8.decode(stringBytes.subarray(start, end));
        stringCache.set(idx, value);
        return value;
      }}

      els.loadStatus.textContent = `正在还原 ${{recordCount.toLocaleString()}} 条样本索引...`;
      const recordsOut = new Array(recordCount);
      for (let i = 0; i < recordCount; i += 1) {{
        const b = i * intFieldCount;
        const flatIdx = table[b + 20];
        let flatCache = null;
        const rec = {{
          index: table[b + 0],
          segment: table[b + 1],
          parsedSegment: table[b + 2],
          segmentWidth: table[b + 3],
          id: readString(table[b + 4]),
          idBase: readString(table[b + 5]),
          groupKey: readString(table[b + 6]),
          label: readString(table[b + 7]),
          duration: readString(table[b + 8]),
          sampleRate: readString(table[b + 9]),
          filePath: readString(table[b + 10]),
          detectorId: readString(table[b + 11]),
          unitId: readString(table[b + 12]),
          channelId: readString(table[b + 13]),
          timePoint: readString(table[b + 14]),
          project: readString(table[b + 15]),
          md5: readString(table[b + 16]),
          usedOrNot: readString(table[b + 17]),
          trainOrTest: readString(table[b + 18]),
          manualOrPseudo: readString(table[b + 19]),
        }};
        Object.defineProperty(rec, 'flat', {{
          enumerable: true,
          get() {{
            if (flatCache === null) {{
              const raw = readString(flatIdx);
              flatCache = raw ? JSON.parse(raw) : {{}};
            }}
            return flatCache;
          }}
        }});
        recordsOut[i] = rec;
      }}

      return {{
        meta: container.meta || {{}},
        groups: container.groups || {{}},
        records: recordsOut,
      }};
    }}

    async function loadPayloadFromDefaultBin() {{
      els.loadStatus.textContent = `正在读取默认数据文件：${{DATA_FILE}}`;
      els.statusCard.classList.remove('ok', 'warn', 'bad');
      els.statusTitle.textContent = '正在加载数据';
      els.statusNote.textContent = `正在读取默认数据文件：${{DATA_FILE}}`;
      const response = await fetch(DATA_FILE);
      if (!response.ok) {{
        throw new Error(`Cannot read ${{DATA_FILE}}: HTTP ${{response.status}}. 请在输出目录运行 python -m http.server 后通过 http://localhost:8000 打开 HTML。`);
      }}
      const arrayBuffer = await response.arrayBuffer();
      const nextPayload = await decodePayloadFromBuffer(arrayBuffer);
      payload = nextPayload;
      records = payload.records || [];
      meta = payload.meta || {{}};
      groupMeta = payload.groups || {{}};
      buildIndexes();
      els.loader.style.display = 'none';
      els.app.style.display = '';
      renderSummary();
      els.beforeInput.value = meta.defaultBefore || 5;
      els.afterInput.value = meta.defaultAfter || 5;
      rebuildSelect(records[0] && records[0].id);
      renderParseNotes();
      renderAll();
    }}

    async function boot() {{
      try {{
        els.loadStatus.textContent = `正在加载默认数据文件：${{DATA_FILE}}`;
        await loadPayloadFromDefaultBin();
      }} catch (error) {{
        els.loadStatus.textContent = `加载失败：${{error.message}}`;
        els.statusCard.classList.remove('ok', 'warn');
        els.statusCard.classList.add('bad');
        els.statusTitle.textContent = '加载失败';
        els.statusNote.textContent = error.message;
      }}
    }}

    els.idSearch.addEventListener('input', () => {{
      listPageStart = 0;
      const keep = els.sampleSelect.value;
      rebuildSelect(keep);
      renderAll();
    }});
    els.sampleSelect.addEventListener('change', () => {{
      rebuildSelect(els.sampleSelect.value);
      renderAll();
    }});
    els.sampleList.addEventListener('click', (event) => {{
      const row = event.target.closest('.sample-row');
      if (!row) return;
      els.sampleSelect.value = row.dataset.id;
      rebuildSelect(row.dataset.id);
      renderAll();
    }});
    els.statusFilter.addEventListener('change', () => {{
      listPageStart = 0;
      rebuildSelect(els.sampleSelect.value);
      renderAll();
    }});
    els.targetLabelFilter.addEventListener('change', () => {{
      listPageStart = 0;
      rebuildSelect(els.sampleSelect.value);
      renderAll();
    }});
    els.sortMode.addEventListener('change', () => {{
      listPageStart = 0;
      rebuildSelect(els.sampleSelect.value);
      renderAll();
    }});
    els.listPrevBtn.addEventListener('click', () => {{
      listPageStart = Math.max(0, listPageStart - LIST_PAGE_SIZE);
      rebuildSelect('');
      renderAll();
    }});
    els.listNextBtn.addEventListener('click', () => {{
      listPageStart += LIST_PAGE_SIZE;
      rebuildSelect('');
      renderAll();
    }});
    els.beforeInput.addEventListener('input', () => {{
      listPageStart = 0;
      rebuildSelect(els.sampleSelect.value);
      renderAll();
    }});
    els.afterInput.addEventListener('input', () => {{
      listPageStart = 0;
      rebuildSelect(els.sampleSelect.value);
      renderAll();
    }});

    boot();
  </script>
</body>
</html>
"""


def parse_args(argv: Optional[List[str]] = None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Generate an interactive HTML report for checking labels around every sample ID."
    )
    parser.add_argument("--json", required=True, type=Path, help="Path to JSON file. Supports {'datas': [...]} or [...].")
    parser.add_argument("--before", type=int, default=5, help="Default number of previous segments shown in HTML.")
    parser.add_argument("--after", type=int, default=5, help="Default number of following segments shown in HTML.")
    parser.add_argument(
        "--output",
        type=Path,
        default=Path("sample_context_report.html"),
        help="Output HTML path. Default: sample_context_report.html.",
    )
    parser.add_argument(
        "--bin-output",
        type=Path,
        default=None,
        help="Output data bin path. Default: same as HTML with .bin extension.",
    )
    parser.add_argument(
        "--no-compress",
        action="store_true",
        help="Deprecated; kept for compatibility. The new .bin format is an uncompressed typed binary table.",
    )
    parser.add_argument(
        "--export",
        nargs="+",
        choices=["xlsx", "json", "html", "sources", "all"],
        default=[],
        help="Optional extra exports generated by this Python script: xlsx json html sources all.",
    )
    parser.add_argument(
        "--export-prefix",
        type=Path,
        default=None,
        help="Output prefix for extra exports. Default: same as --output without suffix.",
    )
    parser.add_argument(
        "--status-filter",
        choices=[
            "all",
            "unparseable",
            "missing_mismatch",
            "present_mismatch",
            "missing_consistent",
            "present_consistent",
            "has_missing",
            "has_mismatch",
            "all_present",
        ],
        default="all",
        help="Status filter used by --export sources when --export all is not selected.",
    )
    parser.add_argument(
        "--status-filter-label",
        default=None,
        help="Optional human-readable label used in source BAT names/comments.",
    )
    parser.add_argument("--open", action="store_true", help="Open the generated HTML with the default browser.")
    return parser.parse_args(argv)


def main(argv: Optional[List[str]] = None) -> int:
    args = parse_args(argv)
    if args.before < 0 or args.after < 0:
        raise ValueError("--before and --after must be >= 0.")

    json_path = args.json.expanduser().resolve()
    output_path = args.output.expanduser().resolve()
    bin_output_path = args.bin_output.expanduser().resolve() if args.bin_output else output_path.with_suffix(".bin")

    print(f"[1/6] Reading JSON: {json_path}")
    records = load_records(json_path)
    print(f"[2/6] Loaded records: {len(records)}")
    print("[3/6] Building browser data and long-sample index...")
    payload = build_report_payload(records, json_path, args.before, args.after)
    print(f"      Parsed records: {payload['meta']['recordCount']}")
    print(f"      Long-sample groups: {payload['meta']['groupCount']}")
    print(f"      Skipped records: {payload['meta']['skippedCount']}")
    print(f"      Duplicate group+segment entries: {payload['meta']['duplicateSegmentCount']}")

    print("[4/6] Building typed binary data package...")
    payload_bytes, bin_stats = build_binary_report(payload)
    print(f"      String table entries: {bin_stats['string_count']}")
    print(f"      String blob size: {bin_stats['string_blob_bytes'] / 1024 / 1024:.2f} MB")
    print(f"      Record table size: {bin_stats['record_table_bytes'] / 1024 / 1024:.2f} MB")
    try:
        data_file_ref = os.path.relpath(bin_output_path, output_path.parent).replace(os.sep, "/")
    except ValueError:
        data_file_ref = bin_output_path.name
    html_text = html_template(data_file_ref)

    print("[5/6] Writing HTML and default bin data package...")
    output_path.parent.mkdir(parents=True, exist_ok=True)
    bin_output_path.parent.mkdir(parents=True, exist_ok=True)
    output_path.write_text(html_text, encoding="utf-8")
    bin_output_path.write_bytes(payload_bytes)

    if args.export:
        print("      Writing extra exports from Python...")
        run_extra_exports(args, payload, records, json_path, output_path)

    print("[6/6] Done.")
    print(f"Report generated: {output_path}")
    print(f"Data bin generated: {bin_output_path}")
    print(f"Data bin size: {bin_output_path.stat().st_size / 1024 / 1024:.2f} MB")
    print("The HTML loads the generated .bin by default.")
    print("If the browser blocks local file reads, run: python -m http.server 8000")

    if args.open:
        webbrowser.open(output_path.as_uri())

    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except Exception as exc:
        print(f"[ERROR] {exc}", file=sys.stderr)
        raise SystemExit(2)

