#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
Generate an interactive HTML report for checking labels around every audio
segment in a labeling JSON file.

The report lets you search/select any sample ID in the browser. Samples are
grouped into one long sample by treating the ID prefix ending with the final
underscore as the long-sample ID, so fields after channel/time such as 250M,
16KHz and 512 must also match.

Input JSON can be either:
    {"datas": [ ... ]}
or:
    [ ... ]

Example:
    python sample_context_visualizer.py ^
        --json data.json ^
        --before 5 ^
        --after 5 ^
        --output sample_context_report.html

No third-party Python packages are required.
"""

import argparse
from array import array
import datetime as dt
import html
import json
import os
import re
import struct
import sys
import webbrowser
