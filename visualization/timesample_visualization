Record = Dict[str, Any]

KNOWN_AUDIO_EXTENSIONS_RE = re.compile(r"\.(wav|mp3|flac|m4a|ogg|aac)$", re.IGNORECASE)
SEGMENT_SUFFIX_RE = re.compile(r"^(?P<long_id>.+_)(?P<segment>\d+)$")
BIN_MAGIC = b"SCVBIN2\0"
BIN_VERSION = 2
BIN_INT_FIELDS = [
    "index",
    "segment",
    "parsedSegment",
    "segmentWidth",
    "id",
    "idBase",
    "groupKey",
    "label",
    "duration",
    "sampleRate",
    "filePath",
    "detectorId",
    "unitId",
    "channelId",
    "timePoint",
    "project",
    "md5",
    "usedOrNot",
    "trainOrTest",
    "manualOrPseudo",
    "flat",
]


def load_records(json_path: Path) -> List[Record]:
    with json_path.open("r", encoding="utf-8-sig") as f:
        payload = json.load(f)

    if isinstance(payload, dict):
        records = payload.get("datas")
        if records is None:
            raise ValueError("JSON top-level object does not contain a `datas` field.")
    else:
        records = payload

    if not isinstance(records, list):
        raise ValueError("JSON data must be a list or an object with a list field named `datas`.")

    normalized: List[Record] = []
    for index, item in enumerate(records):
        if not isinstance(item, dict):
            raise ValueError(f"Record #{index} is not an object.")
        normalized.append(item)
    return normalized


def strip_audio_extension(value: str) -> str:
    return KNOWN_AUDIO_EXTENSIONS_RE.sub("", value)


def get_record_id(record: Record) -> str:
    value = record.get("ID") or record.get("id") or record.get("file_name") or record.get("filename")
    if value:
        return str(value)

    file_path = record.get("file_path")
    if file_path:
        return os.path.basename(str(file_path))

    raise ValueError(f"Record is missing ID/file_path: {record!r}")


def parse_id(record_id: str) -> Tuple[str, int, int]:
    """
    Return (long_sample_id, segment_number, segment_width).

    Example:
        D0003_U0046_C03_..._512_215.wav
    becomes:
        ("D0003_U0046_C03_..._512_", 215, 3)
    """
    basename = os.path.basename(record_id)
    stem = strip_audio_extension(basename)
    match = SEGMENT_SUFFIX_RE.match(stem)
    if not match:
        raise ValueError(f"Cannot parse trailing segment number from ID: {record_id}")
    segment_text = match.group("segment")
    return match.group("long_id"), int(segment_text), len(segment_text)


def parse_non_numeric_suffix(record_id: str) -> Tuple[str, str]:
    basename = os.path.basename(record_id)
    stem = strip_audio_extension(basename)
    if "_" not in stem:
        return stem + "_", stem
    prefix, suffix = stem.rsplit("_", 1)
    return prefix + "_", suffix


def parse_segment_id(raw_value: Any, fallback: int) -> int:
    if raw_value is None or raw_value == "":
        return fallback
    try:
        return int(str(raw_value))
    except ValueError:
        return fallback


def flatten_dict(value: Any, prefix: str = "") -> Dict[str, Any]:
    if not isinstance(value, dict):
        return {prefix: value}

    result: Dict[str, Any] = {}
    for key in sorted(value.keys()):
        child_key = f"{prefix}.{key}" if prefix else str(key)
        child = value[key]
        if isinstance(child, dict):
            result.update(flatten_dict(child, child_key))
        else:
            result[child_key] = child
    return result


def safe_value(value: Any) -> Any:
    if value is None:
        return None
    if isinstance(value, (str, int, float, bool)):
        return value
    if isinstance(value, list):
        return [safe_value(item) for item in value]
    if isinstance(value, dict):
        return {str(key): safe_value(child) for key, child in value.items()}
    return str(value)


def make_browser_record(record: Record, index: int) -> Record:
    rid = get_record_id(record)
    segment_token = ""
    parseable_segment = True
    try:
        group_key, parsed_segment, segment_width = parse_id(rid)
        segment = parse_segment_id(record.get("segment_id"), parsed_segment)
        segment_token = str(record.get("segment_id") or str(parsed_segment).zfill(segment_width))
    except ValueError:
        group_key, segment_token = parse_non_numeric_suffix(rid)
        parsed_segment = -1
        segment = -1
        segment_width = 0
        parseable_segment = False

    flattened = flatten_dict(record)
    return {
        "index": index,
        "id": rid,
        "idBase": os.path.basename(rid),
        "groupKey": group_key,
        "segment": segment,
        "parsedSegment": parsed_segment,
        "segmentWidth": segment_width,
        "segmentToken": segment_token,
        "parseableSegment": parseable_segment,
        "label": safe_value(record.get("label", "")),
        "duration": safe_value(record.get("duration", "")),
        "sampleRate": safe_value(record.get("sample_rate", "")),
        "filePath": safe_value(record.get("file_path", "")),
        "detectorId": safe_value(record.get("detector_id", "")),
        "unitId": safe_value(record.get("unit_id", "")),
        "channelId": safe_value(record.get("channel_id", "")),
        "timePoint": safe_value(record.get("time_point", "")),
        "project": safe_value(record.get("project", "")),
        "md5": safe_value(flattened.get("other_information.md5", "")),
        "usedOrNot": safe_value(flattened.get("other_information.tags.used_or_not", "")),
        "trainOrTest": safe_value(flattened.get("other_information.tags.train_or_test", "")),
        "manualOrPseudo": safe_value(flattened.get("other_information.tags.manual_or_pseudo", "")),
        "flat": safe_value(flattened),
    }


def summarize_groups(records: Iterable[Record]) -> Tuple[Dict[str, Counter], int]:
    seen: Dict[Tuple[str, int], str] = {}
    duplicate_count = 0
    group_labels: Dict[str, Counter] = defaultdict(Counter)

    for item in records:
        group_key = str(item["groupKey"])
        segment = int(item["segment"])
        key = (group_key, segment)
        if key in seen:
            duplicate_count += 1
        seen[key] = str(item["id"])
        group_labels[group_key][str(item.get("label", ""))] += 1

    return group_labels, duplicate_count


def build_report_payload(records: List[Record], json_path: Path, before: int, after: int) -> Dict[str, Any]:
    browser_records: List[Record] = []
    parse_errors: List[str] = []

    for index, record in enumerate(records):
        try:
            browser_records.append(make_browser_record(record, index))
        except Exception as exc:
            parse_errors.append(f"#{index}: {exc}")

    if not browser_records:
        raise ValueError("No parseable records were found.")

    group_labels, duplicate_count = summarize_groups(browser_records)
    label_counts = Counter(str(item.get("label", "")) for item in browser_records)
    group_sizes = Counter(str(item["groupKey"]) for item in browser_records)

    return {
        "meta": {
            "sourceJson": str(json_path),
            "generatedAt": dt.datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
            "defaultBefore": before,
            "defaultAfter": after,
            "recordCount": len(browser_records),
            "skippedCount": len(parse_errors),
            "groupCount": len(group_sizes),
            "duplicateSegmentCount": duplicate_count,
            "labelCounts": dict(sorted(label_counts.items())),
            "largestGroups": group_sizes.most_common(10),
            "parseErrors": parse_errors[:200],
        },
        "records": sorted(browser_records, key=lambda item: (str(item["groupKey"]), int(item["segment"]), str(item["id"]))),
        "groups": {
            key: {
                "labelCounts": dict(sorted(counter.items())),
                "size": sum(counter.values()),
            }
            for key, counter in sorted(group_labels.items())
        },
    }


def _align4(value: int) -> int:
    return (value + 3) & ~3


def build_binary_report(payload: Dict[str, Any]) -> Tuple[bytes, Dict[str, int]]:
    """
    Build a true binary data file:

    header:
        8s magic, uint32 version, uint32 record_count, uint32 int_field_count,
        uint32 string_count, uint32 meta_json_len, uint32 string_blob_len
    body:
        meta JSON bytes, 4-byte padding,
        uint32 string offsets, UTF-8 string blob, 4-byte padding,
        int32 record table
    """
    strings: List[bytes] = []
    string_index: Dict[str, int] = {}

    def intern(value: Any) -> int:
        if value is None:
            text = ""
        elif isinstance(value, (dict, list)):
            text = json.dumps(value, ensure_ascii=False, separators=(",", ":"))
        else:
            text = str(value)
        existing = string_index.get(text)
        if existing is not None:
            return existing
        encoded = text.encode("utf-8")
        idx = len(strings)
        strings.append(encoded)
        string_index[text] = idx
        return idx

    intern("")

    rows: List[int] = []
    for rec in payload["records"]:
        rows.extend(
            [
                int(rec.get("index", 0)),
                int(rec.get("segment", 0)),
                int(rec.get("parsedSegment", 0)),
                int(rec.get("segmentWidth", 0)),
                intern(rec.get("id", "")),
                intern(rec.get("idBase", "")),
                intern(rec.get("groupKey", "")),
                intern(rec.get("label", "")),
                intern(rec.get("duration", "")),
                intern(rec.get("sampleRate", "")),
                intern(rec.get("filePath", "")),
                intern(rec.get("detectorId", "")),
                intern(rec.get("unitId", "")),
                intern(rec.get("channelId", "")),
                intern(rec.get("timePoint", "")),
                intern(rec.get("project", "")),
                intern(rec.get("md5", "")),
                intern(rec.get("usedOrNot", "")),
                intern(rec.get("trainOrTest", "")),
                intern(rec.get("manualOrPseudo", "")),
                intern(rec.get("flat", {})),
            ]
        )

    offsets = [0]
    blob_parts: List[bytes] = []
    total = 0
    for encoded in strings:
        blob_parts.append(encoded)
        total += len(encoded)
        offsets.append(total)

    string_blob = b"".join(blob_parts)
    meta_bytes = json.dumps(
        {"meta": payload["meta"], "groups": payload["groups"]},
        ensure_ascii=False,
        separators=(",", ":"),
    ).encode("utf-8")

    header = struct.pack(
        "<8sIIIIII",
        BIN_MAGIC,
        BIN_VERSION,
        len(payload["records"]),
        len(BIN_INT_FIELDS),
        len(strings),
        len(meta_bytes),
        len(string_blob),
    )
    meta_pad = b"\0" * (_align4(len(header) + len(meta_bytes)) - (len(header) + len(meta_bytes)))
    offset_array = array("I", offsets)
    if offset_array.itemsize != 4:
        raise RuntimeError("This platform does not use 4-byte unsigned integers for array('I').")
    if sys.byteorder != "little":
        offset_array.byteswap()
    offsets_bytes = offset_array.tobytes()
    strings_pad = b"\0" * (_align4(len(header) + len(meta_bytes) + len(meta_pad) + len(offsets_bytes) + len(string_blob)) - (len(header) + len(meta_bytes) + len(meta_pad) + len(offsets_bytes) + len(string_blob)))
    row_array = array("i", rows)
    if row_array.itemsize != 4:
        raise RuntimeError("This platform does not use 4-byte signed integers for array('i').")
    if sys.byteorder != "little":
        row_array.byteswap()
    rows_bytes = row_array.tobytes()

    binary = header + meta_bytes + meta_pad + offsets_bytes + string_blob + strings_pad + rows_bytes
    stats = {
        "record_count": len(payload["records"]),
        "string_count": len(strings),
        "string_blob_bytes": len(string_blob),
        "meta_bytes": len(meta_bytes),
        "record_table_bytes": len(rows_bytes),
    }
    return binary, stats


