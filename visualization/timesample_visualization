    function exportStatusOrder() {{
      return STATUS_DEFS.map(([key, name]) => [key, name]);
    }}

    function statusSummary(items) {{
      const counts = Object.fromEntries(STATUS_DEFS.map(([key]) => [key, 0]));
      for (const item of items) counts[item.status.key] = (counts[item.status.key] || 0) + 1;
      return counts;
    }}

    function statusPayload(rec, status, before, after) {{
      return {{
        key: status.key,
        label: status.text,
        has_missing: status.missing > 0,
        has_mismatch: status.mismatch > 0,
        missing_count: status.missing,
        mismatch_count: status.mismatch,
        existing_neighbor_count: status.existing,
        effective_window_size: status.total,
        requested_before: before,
        requested_after: after,
        checked_start_segment: status.checkStart,
        checked_end_segment: status.checkEnd,
        group_min_segment: status.groupMin,
        group_max_segment: status.groupMax,
        weighted_inconsistency: Number(status.weightedScore.toFixed(6)),
        missing_weight_ratio: Number(status.missingWeightRatio.toFixed(6)),
        normal_to_abnormal_count: status.normalToAbnormal,
        normal_to_abnormal_weight: Number(status.normalToAbnormalWeight.toFixed(6)),
        group_key: rec.groupKey,
        segment: displaySegment(rec),
      }};
    }}

    function setNestedValue(target, dottedKey, value) {{
      const parts = String(dottedKey).split('.').filter(Boolean);
      if (!parts.length) return;
      let cursor = target;
      for (let i = 0; i < parts.length - 1; i += 1) {{
        const part = parts[i];
        if (!cursor[part] || typeof cursor[part] !== 'object' || Array.isArray(cursor[part])) {{
          cursor[part] = {{}};
        }}
        cursor = cursor[part];
      }}
      cursor[parts[parts.length - 1]] = value;
    }}

    function rebuildOriginalLikeRecord(rec) {{
      const out = {{}};
      const flat = rec.flat || {{}};
      for (const [key, value] of Object.entries(flat)) {{
        setNestedValue(out, key, value);
      }}
      if (!out.ID && !out.id && rec.id) out.ID = rec.id;
      return out;
    }}

    async function exportCurrentCsv() {{
      setExportProgress(8, '正在整理 XLSX 数据...');
      await nextFrame();
      const {{ before, after }} = currentWindowParams();
      const items = getFilteredRecords({{ ignoreStatusFilter: true }});
      const headers = [
        'ID', 'group_key', 'segment', 'label', 'status', 'severity',
        'weighted_inconsistency', 'weighted_mismatch_sum', 'observed_weight_sum',
        'normal_to_abnormal_count', 'normal_to_abnormal_weight',
        'missing_count', 'mismatch_count', 'missing_weight_ratio',
        'before', 'after', 'duration', 'sample_rate', 'detector_id', 'unit_id',
        'channel_id', 'time_point', 'project', 'file_path'
      ];
      const statusOrder = exportStatusOrder();
      const grouped = new Map(statusOrder.map(([key, name]) => [key, {{ name, rows: [headers] }}]));
      for (const item of items) {{
        const rec = item.rec;
        const status = item.status;
        const row = [
          rec.id, rec.groupKey, displaySegment(rec), rec.label, status.text, status.severity,
          status.weightedScore.toFixed(6), status.mismatchWeight.toFixed(6), status.observedWeight.toFixed(6),
          status.normalToAbnormal, status.normalToAbnormalWeight.toFixed(6),
          status.missing, status.mismatch, status.missingWeightRatio.toFixed(6),
          before, after, rec.duration, rec.sampleRate, rec.detectorId, rec.unitId,
          rec.channelId, rec.timePoint, rec.project, rec.filePath
        ];
        if (!grouped.has(status.key)) grouped.set(status.key, {{ name: status.text, rows: [headers] }});
        grouped.get(status.key).rows.push(row);
      }}

      const summaryRows = [['status', 'count']];
      for (const [key, name] of statusOrder) {{
        const entry = grouped.get(key);
        summaryRows.push([name, Math.max(0, (entry ? entry.rows.length : 1) - 1)]);
      }}
      summaryRows.push(['导出总数', items.length]);
      summaryRows.push(['before', before]);
      summaryRows.push(['after', after]);
      summaryRows.push(['搜索关键词', els.idSearch.value.trim()]);
      summaryRows.push(['状态筛选', els.statusFilter.value]);
      summaryRows.push(['目标 label 筛选', els.targetLabelFilter.value]);
      summaryRows.push(['排序方式', els.sortMode.value]);

      const sheets = [{{ name: '汇总', rows: summaryRows }}];
      for (const [key] of statusOrder) {{
        const entry = grouped.get(key);
        if (entry && entry.rows.length > 1) sheets.push({{ name: entry.name, rows: entry.rows }});
      }}

      setExportProgress(72, '正在生成 XLSX 文件...');
      await nextFrame();
      const blob = buildWorkbookBlob(sheets);
      downloadBlob(blob, `sample_context_${{exportStamp()}}.xlsx`);
      setExportProgress(100, `XLSX 已开始下载：${{items.length.toLocaleString()}} 条`);
    }}

    async function exportTaggedJson() {{
      setExportProgress(8, '正在给全量样本写入状态标签...');
      await nextFrame();
      const {{ before, after }} = currentWindowParams();
      const counts = Object.fromEntries(STATUS_DEFS.map(([key]) => [key, 0]));
      const chunks = [];
      let buffer = '';
      const flushLimit = 1024 * 1024;
      for (let i = 0; i < records.length; i += 1) {{
        const rec = records[i];
        const status = classifyRecord(rec, before, after);
        counts[status.key] = (counts[status.key] || 0) + 1;
        const row = rebuildOriginalLikeRecord(rec);
        row.time_context_status = statusPayload(rec, status, before, after);
        const piece = (i === 0 ? '' : ',\n') + JSON.stringify(row);
        if (buffer.length + piece.length > flushLimit) {{
          chunks.push(buffer);
          buffer = '';
        }}
        buffer += piece;
        if (i > 0 && i % 1000 === 0) {{
          setExportProgress(8 + Math.min(68, i / Math.max(records.length, 1) * 68), `正在生成 JSON：${{i.toLocaleString()}} / ${{records.length.toLocaleString()}}`);
          await nextFrame();
        }}
      }}
      if (buffer) chunks.push(buffer);
      const metaOut = {{
        source_json: meta.sourceJson || '',
        generated_at: new Date().toISOString(),
        before,
        after,
        record_count: records.length,
        status_counts: counts,
        status_labels: STATUS_LABELS,
      }};
      setExportProgress(78, '正在生成 JSON 文件...');
      await nextFrame();
      const blobParts = ['{{"meta":', JSON.stringify(metaOut), ',"datas":[\n'].concat(chunks, ['\n]}}']);
      const blob = new Blob(blobParts, {{ type: 'application/json;charset=utf-8' }});
      downloadBlob(blob, `sample_context_tagged_${{exportStamp()}}.json`);
      setExportProgress(100, `JSON 已开始下载：${{records.length.toLocaleString()}} 条`);
    }}

    function buildSummaryScatter(items) {{
      const width = 760;
      const height = 430;
      const pad = 54;
      let maxMissing = 1;
      let maxMismatch = 1;
      for (const item of items) {{
        if (item.status.missing > maxMissing) maxMissing = item.status.missing;
        if (item.status.mismatch > maxMismatch) maxMismatch = item.status.mismatch;
      }}
      const colorByStatus = Object.fromEntries(STATUS_DEFS.map(([key, , color]) => [key, color]));
      const ticks = [0, 0.25, 0.5, 0.75, 1];
      const grid = ticks.map(t => {{
        const x = pad + t * (width - pad * 1.4);
        const y = height - pad - t * (height - pad * 1.35);
        return `<line x1="${{x}}" y1="${{pad * 0.45}}" x2="${{x}}" y2="${{height - pad}}" stroke="#eef1f7"/><line x1="${{pad}}" y1="${{y}}" x2="${{width - pad * 0.4}}" y2="${{y}}" stroke="#eef1f7"/>`;
      }}).join('');
      const points = items.slice(0, 5000).map(item => {{
        const x = pad + (item.status.missing / maxMissing) * (width - pad * 1.4);
        const y = height - pad - (item.status.mismatch / maxMismatch) * (height - pad * 1.35);
        return `<circle cx="${{x.toFixed(2)}}" cy="${{y.toFixed(2)}}" r="3.2" fill="${{colorByStatus[item.status.key] || '#64748b'}}" fill-opacity="0.42"><title>${{escapeHtml(item.rec.id)}} | ${{escapeHtml(item.status.text)}} | missing=${{item.status.missing}} mismatch=${{item.status.mismatch}}</title></circle>`;
      }}).join('');
      return `<svg viewBox="0 0 ${{width}} ${{height}}" role="img" aria-label="missing mismatch scatter">
        <rect width="${{width}}" height="${{height}}" fill="#fff"/>
        ${{grid}}
        <line x1="${{pad}}" y1="${{height - pad}}" x2="${{width - pad * 0.4}}" y2="${{height - pad}}" stroke="#94a3b8"/>
        <line x1="${{pad}}" y1="${{pad * 0.45}}" x2="${{pad}}" y2="${{height - pad}}" stroke="#94a3b8"/>
        ${{points}}
        <text x="${{width / 2}}" y="${{height - 14}}" text-anchor="middle" fill="#475569" font-size="13">missing count</text>
        <text x="18" y="${{height / 2}}" text-anchor="middle" transform="rotate(-90 18 ${{height / 2}})" fill="#475569" font-size="13">mismatch count</text>
        <text x="${{pad}}" y="${{height - pad + 20}}" fill="#64748b" font-size="12">0</text>
        <text x="${{width - pad * 0.7}}" y="${{height - pad + 20}}" fill="#64748b" font-size="12">${{maxMissing}}</text>
        <text x="${{pad - 28}}" y="${{height - pad}}" fill="#64748b" font-size="12">0</text>
        <text x="${{pad - 34}}" y="${{pad * 0.65}}" fill="#64748b" font-size="12">${{maxMismatch}}</text>
      </svg>`;
    }}

    function buildSummaryBars(items) {{
      const counts = statusSummary(items);
      const maxCount = Math.max(1, ...Object.values(counts));
      return STATUS_DEFS.map(([key, label, color]) => {{
        const count = counts[key] || 0;
        const width = Math.max(2, count / maxCount * 100);
        return `<div class="hist-row"><div class="hist-label">${{escapeHtml(label)}}</div><div class="hist-track"><div class="hist-bar" style="width:${{width}}%;background:${{color}}"></div></div><div class="hist-value">${{count.toLocaleString()}}</div></div>`;
      }}).join('');
    }}

