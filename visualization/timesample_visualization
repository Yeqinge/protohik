      <div class="timeline" id="timeline"></div>
      <div class="legend">
        <span class="legend-item"><span class="swatch" style="background:#15803d"></span>与目标 label 一致</span>
        <span class="legend-item"><span class="swatch" style="background:#dc2626"></span>与目标 label 不一致</span>
        <span class="legend-item"><span class="swatch" style="background:#e5e7eb"></span>JSON 中缺失</span>
        <span class="legend-item">黑色描边为目标样本</span>
      </div>
      <div class="chip-row" id="windowChips"></div>
    </section>

    <section>
      <h2>前后样本列表</h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>相对位置</th>
              <th>segment</th>
              <th>label</th>
              <th>检查</th>
              <th>ID</th>
              <th>duration</th>
              <th>sample_rate</th>
              <th>detector_id</th>
              <th>channel_id</th>
              <th>time_point</th>
              <th>file_path</th>
            </tr>
          </thead>
          <tbody id="windowRows"></tbody>
        </table>
      </div>
    </section>

    <section>
      <h2>完整字段详情</h2>
      <div id="detailList"></div>
    </section>

    <section>
      <h2>解析提示</h2>
      <div id="parseNotes"></div>
    </section>
    </div>
    </div>
  </main>

  <script>
    const DATA_FILE = {data_file_json};
    let payload = null;
    let records = [];
    let meta = {{}};
    let groupMeta = {{}};

    const byId = new Map();
    const groups = new Map();
    const labelColors = ['#c2410c', '#7c3aed', '#be123c', '#0369a1', '#a16207', '#0f766e', '#b45309', '#4338ca'];

    function buildIndexes() {{
      byId.clear();
      groups.clear();
      for (const rec of records) {{
        byId.set(rec.id, rec);
        if (!groups.has(rec.groupKey)) groups.set(rec.groupKey, new Map());
        groups.get(rec.groupKey).set(Number(rec.segment), rec);
      }}
    }}

    const els = {{
      reportMeta: document.getElementById('reportMeta'),
      summary: document.getElementById('summary'),
      idSearch: document.getElementById('idSearch'),
      sampleSelect: document.getElementById('sampleSelect'),
      beforeInput: document.getElementById('beforeInput'),
      afterInput: document.getElementById('afterInput'),
      filterHint: document.getElementById('filterHint'),
      sampleList: document.getElementById('sampleList'),
      statusCard: document.getElementById('statusCard'),
      statusTitle: document.getElementById('statusTitle'),
      statusNote: document.getElementById('statusNote'),
      targetTable: document.getElementById('targetTable'),
      groupTable: document.getElementById('groupTable'),
      timeline: document.getElementById('timeline'),
      windowChips: document.getElementById('windowChips'),
      windowRows: document.getElementById('windowRows'),
      detailList: document.getElementById('detailList'),
      parseNotes: document.getElementById('parseNotes'),
      loader: document.getElementById('loader'),
      loadStatus: document.getElementById('loadStatus'),
      app: document.getElementById('app'),
    }};

    function escapeHtml(value) {{
      if (value === null || value === undefined) return '';
      return String(value)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }}

    function valueText(value) {{
      if (value === null || value === undefined) return '';
      if (typeof value === 'object') return JSON.stringify(value, null, 2);
      return String(value);
    }}

    function pill(text, cls) {{
      return `<span class="pill ${{cls}}">${{escapeHtml(text)}}</span>`;
    }}

    function metric(label, value) {{
      return `<div class="metric"><div class="metric-label">${{escapeHtml(label)}}</div><div class="metric-value">${{escapeHtml(value)}}</div></div>`;
    }}

    function kvRows(items) {{
      return items.map(([key, value]) => (
        `<tr><th>${{escapeHtml(key)}}</th><td>${{escapeHtml(valueText(value))}}</td></tr>`
      )).join('');
    }}

    function formatCounts(counts) {{
      const entries = Object.entries(counts || {{}});
      if (!entries.length) return '无';
      return entries.map(([key, value]) => `${{escapeHtml(key)}}: ${{value}}`).join('，');
    }}

    function numberInputValue(input, fallback) {{
      const value = Number.parseInt(input.value, 10);
      return Number.isFinite(value) && value >= 0 ? value : fallback;
    }}

    function getFilteredRecords() {{
      const query = els.idSearch.value.trim().toLowerCase();
      if (!query) return records;
      return records.filter(rec => {{
        const fields = [
          rec.id,
          rec.idBase,
          rec.groupKey,
          rec.label,
          rec.filePath,
          rec.detectorId,
          rec.channelId,
          rec.timePoint,
          rec.project,
        ];
        return fields.some(value => valueText(value).toLowerCase().includes(query));
      }});
    }}

    function rebuildSelect(keepId) {{
      const filtered = getFilteredRecords();
      const currentId = keepId || els.sampleSelect.value || (records[0] && records[0].id);
      const maxOptions = 1500;
      const visible = filtered.slice(0, maxOptions);
      els.sampleSelect.innerHTML = visible.map(rec => {{
        const label = `${{rec.id}} | label=${{valueText(rec.label)}} | segment=${{rec.segment}}`;
        return `<option value="${{escapeHtml(rec.id)}}">${{escapeHtml(label)}}</option>`;
      }}).join('');

      const selectedExists = visible.some(rec => rec.id === currentId);
      if (selectedExists) {{
        els.sampleSelect.value = currentId;
      }} else if (visible.length) {{
        els.sampleSelect.value = visible[0].id;
      }}

      els.filterHint.textContent = `匹配 ${{filtered.length}} 条；列表最多显示 ${{Math.min(filtered.length, maxOptions)}} 条。`;
      renderSampleList(visible);
    }}

    function renderSampleList(visible) {{
      const selectedId = els.sampleSelect.value;
      els.sampleList.innerHTML = visible.map(rec => {{
        const active = rec.id === selectedId ? ' active' : '';
        const labelCls = statusClass(rec.label, selectedRecord().label);
        return `<div class="sample-row${{active}}" data-id="${{escapeHtml(rec.id)}}" title="${{escapeHtml(rec.id)}}">
          <div class="sample-seg">#${{escapeHtml(rec.segment)}}</div>
          <div class="sample-id">${{escapeHtml(rec.id)}}</div>
          <div>${{pill(rec.label, labelCls)}}</div>
        </div>`;
      }}).join('');
    }}

    function selectedRecord() {{
      return byId.get(els.sampleSelect.value) || records[0];
    }}

    function statusClass(label, targetLabel) {{
      return valueText(label) === valueText(targetLabel) ? 'same' : 'different';
    }}

    function makeWindow(target, before, after) {{
      const group = groups.get(target.groupKey) || new Map();
      const rows = [];
      for (let segment = Number(target.segment) - before; segment <= Number(target.segment) + after; segment += 1) {{
        rows.push({{
          segment,
          offset: segment - Number(target.segment),
          record: group.get(segment) || null,
        }});
      }}
      return rows;
    }}

    function renderSummary() {{
      els.reportMeta.innerHTML = [
        `JSON: ${{escapeHtml(meta.sourceJson)}}`,
        `生成时间: ${{escapeHtml(meta.generatedAt)}}`,
      ].join('<br>');

      els.summary.innerHTML = [
        metric('可解析小样本数', meta.recordCount),
        metric('大样本分组数', meta.groupCount),
        metric('全局 label 种类', Object.keys(meta.labelCounts || {{}}).length),
        metric('重复 segment', meta.duplicateSegmentCount),
        metric('跳过记录', meta.skippedCount),
        metric('默认窗口', `-${{meta.defaultBefore}} / +${{meta.defaultAfter}}`),
      ].join('');
    }}

    function renderStatus(target, rows) {{
      const existing = rows.filter(item => item.record);
      const missing = rows.filter(item => !item.record);
      const mismatch = existing.filter(item => valueText(item.record.label) !== valueText(target.label));
      const allExistingSame = mismatch.length === 0;
      const allPresentAndSame = missing.length === 0 && allExistingSame;

      els.statusCard.classList.remove('ok', 'warn', 'bad');
      if (allPresentAndSame) {{
        els.statusCard.classList.add('ok');
        els.statusTitle.textContent = '全部一致';
      }} else if (allExistingSame) {{
        els.statusCard.classList.add('warn');
        els.statusTitle.textContent = '已存在片段一致，但有缺失';
      }} else {{
        els.statusCard.classList.add('bad');
        els.statusTitle.textContent = '发现 label 不一致';
      }}
      els.statusNote.innerHTML = `目标 label: ${{pill(target.label, 'same')}}；窗口内已存在 ${{existing.length}} / ${{rows.length}} 条，不一致 ${{mismatch.length}} 条。`;
    }}

    function renderTarget(target, rows, before, after) {{
      const group = groups.get(target.groupKey) || new Map();
      const segments = Array.from(group.keys()).sort((a, b) => a - b);
      const groupInfo = groupMeta[target.groupKey] || {{}};
      const windowStart = Number(target.segment) - before;
      const windowEnd = Number(target.segment) + after;
      const missingSegments = rows.filter(item => !item.record).map(item => item.segment);

      els.targetTable.innerHTML = kvRows([
        ['ID', target.id],
        ['label', target.label],
        ['segment', target.segment],
        ['duration', target.duration],
        ['sample_rate', target.sampleRate],
        ['detector_id', target.detectorId],
        ['unit_id', target.unitId],
        ['channel_id', target.channelId],
        ['time_point', target.timePoint],
        ['project', target.project],
        ['md5', target.md5],
        ['used_or_not', target.usedOrNot],
        ['train_or_test', target.trainOrTest],
        ['manual_or_pseudo', target.manualOrPseudo],
        ['file_path', target.filePath],
      ]);

      els.groupTable.innerHTML = kvRows([
        ['大样本分组键', target.groupKey],
        ['分组规则', '小样本 ID 去掉最后一段数字编号，保留编号前的末尾下划线作为大样本 ID'],
        ['大样本 segment 范围', segments.length ? `${{segments[0]}} - ${{segments[segments.length - 1]}}` : '无'],
        ['大样本片段数', group.size],
        ['检查窗口', `${{windowStart}} - ${{windowEnd}}`],
        ['缺失 segment', missingSegments.length ? missingSegments.join(', ') : '无'],
        ['大样本 label 分布', formatCounts(groupInfo.labelCounts)],
      ]);
    }}

    function colorForDifferentLabel(label, paletteMap) {{
      const key = valueText(label);
      if (!paletteMap.has(key)) paletteMap.set(key, labelColors[paletteMap.size % labelColors.length]);
      return paletteMap.get(key);
    }}

    function renderTimeline(target, rows) {{
      const width = 100 / Math.max(rows.length, 1);
      const paletteMap = new Map();
      els.timeline.innerHTML = rows.map(item => {{
        const isTarget = item.segment === Number(target.segment);
        if (!item.record) {{
          return `<div class="bar-item missing${{isTarget ? ' target' : ''}}" style="width:${{width}}%;background:#e5e7eb;color:#374151" title="segment ${{item.segment}}: 缺失">
            <div class="bar-seg">${{item.segment}}</div><div class="bar-label">缺失</div><div class="bar-offset">${{item.offset >= 0 ? '+' : ''}}${{item.offset}}</div>
          </div>`;
        }}
        const cls = statusClass(item.record.label, target.label);
        const bg = cls === 'same' ? '#15803d' : colorForDifferentLabel(item.record.label, paletteMap);
        const title = `segment ${{item.segment}}: label=${{valueText(item.record.label)}}, ID=${{item.record.id}}`;
        return `<div class="bar-item ${{cls}}${{isTarget ? ' target' : ''}}" style="width:${{width}}%;background:${{bg}};color:white" title="${{escapeHtml(title)}}">
          <div class="bar-seg">${{item.segment}}</div>
          <div class="bar-label">${{escapeHtml(valueText(item.record.label))}}</div>
          <div class="bar-offset">${{item.offset >= 0 ? '+' : ''}}${{item.offset}}</div>
        </div>`;
      }}).join('');

      const labelCounts = {{}};
      for (const item of rows) {{
        const key = item.record ? valueText(item.record.label) : '缺失';
        labelCounts[key] = (labelCounts[key] || 0) + 1;
      }}
      els.windowChips.innerHTML = Object.entries(labelCounts)
        .map(([key, count]) => `<span class="chip"><b>${{escapeHtml(key)}}</b>: ${{count}}</span>`)
        .join('');
    }}

    function renderRows(target, rows) {{
      els.windowRows.innerHTML = rows.map(item => {{
        const offsetText = `${{item.offset >= 0 ? '+' : ''}}${{item.offset}}`;
        if (!item.record) {{
          return `<tr class="missing-row">
            <td>${{offsetText}}</td>
            <td>${{item.segment}}</td>
            <td>${{pill('缺失', 'missing')}}</td>
            <td colspan="8">该编号的小样本在同一大样本分组中不存在</td>
          </tr>`;
        }}

        const cls = statusClass(item.record.label, target.label);
        const checkText = cls === 'same' ? '一致' : '不一致';
        return `<tr class="${{cls === 'same' ? 'same-row' : 'different-row'}}">
          <td>${{offsetText}}</td>
          <td>${{item.segment}}</td>
          <td>${{pill(item.record.label, cls)}}</td>
          <td>${{pill(checkText, cls)}}</td>
          <td class="wide mono">${{escapeHtml(item.record.id)}}</td>
          <td>${{escapeHtml(valueText(item.record.duration))}}</td>
          <td>${{escapeHtml(valueText(item.record.sampleRate))}}</td>
          <td>${{escapeHtml(valueText(item.record.detectorId))}}</td>
          <td>${{escapeHtml(valueText(item.record.channelId))}}</td>
          <td>${{escapeHtml(valueText(item.record.timePoint))}}</td>
          <td class="wide">${{escapeHtml(valueText(item.record.filePath))}}</td>
        </tr>`;
      }}).join('');
    }}

    function renderDetails(target, rows) {{
      const parts = rows.filter(item => item.record).map(item => {{
        const rec = item.record;
        const cls = statusClass(rec.label, target.label);
        const offsetText = `${{item.offset >= 0 ? '+' : ''}}${{item.offset}}`;
        const flatRows = Object.entries(rec.flat || {{}})
          .sort(([a], [b]) => a.localeCompare(b))
          .map(([key, value]) => `<tr><th>${{escapeHtml(key)}}</th><td><pre>${{escapeHtml(valueText(value))}}</pre></td></tr>`)
          .join('');
        return `<details class="${{cls}}" ${{rec.id === target.id ? 'open' : ''}}>
          <summary>
            <span class="mono">segment ${{rec.segment}}</span>
            <span>${{offsetText}}</span>
            ${{pill(rec.label, cls)}}
            <span class="muted mono">${{escapeHtml(rec.id)}}</span>
          </summary>
          <table class="kv-table"><tbody>${{flatRows}}</tbody></table>
        </details>`;
      }});
      els.detailList.innerHTML = parts.join('') || '<div class="empty">窗口内没有可展示的样本。</div>';
    }}

    function renderParseNotes() {{
      const largest = (meta.largestGroups || [])
        .map(([key, size]) => `<span class="chip"><span class="mono">${{escapeHtml(key)}}</span>: ${{size}}</span>`)
        .join('');
      const errors = (meta.parseErrors || [])
        .map(item => `<li class="mono">${{escapeHtml(item)}}</li>`)
        .join('');

      els.parseNotes.innerHTML = `
        <div class="chip-row">
          <span class="chip">全局 label 分布: ${{escapeHtml(formatCounts(meta.labelCounts))}}</span>
          <span class="chip">重复 group+segment: ${{meta.duplicateSegmentCount}}</span>
        </div>
        <div class="chip-row">${{largest}}</div>
        ${{errors ? `<h3 style="margin-top:14px">跳过的记录</h3><ul>${{errors}}</ul>` : '<p class="muted">没有解析错误。</p>'}}
      `;
    }}

    function renderAll() {{
      const target = selectedRecord();
      if (!target) {{
        els.statusTitle.textContent = '没有可解析样本';
        return;
      }}
      const before = numberInputValue(els.beforeInput, meta.defaultBefore);
      const after = numberInputValue(els.afterInput, meta.defaultAfter);
      const rows = makeWindow(target, before, after);
      renderStatus(target, rows);
      renderTarget(target, rows, before, after);
      renderTimeline(target, rows);
      renderRows(target, rows);
      renderDetails(target, rows);
    }}

    async function decodePayloadFromBuffer(arrayBuffer) {{
      const bytes = new Uint8Array(arrayBuffer);
      const isGzip = bytes.length >= 2 && bytes[0] === 0x1f && bytes[1] === 0x8b;
      let decodedBuffer = arrayBuffer;
      if (isGzip) {{
        if (!('DecompressionStream' in window)) {{
          throw new Error('当前浏览器不支持 gzip bin 解压，请使用新版 Chrome/Edge/Firefox，或用 --no-compress 重新生成未压缩 bin。');
        }}
        els.loadStatus.textContent = '正在解压数据...';
        const stream = new Blob([arrayBuffer]).stream().pipeThrough(new DecompressionStream('gzip'));
        decodedBuffer = await new Response(stream).arrayBuffer();
      }}
      els.loadStatus.textContent = '正在解析 JSON 数据...';
      const text = new TextDecoder('utf-8').decode(decodedBuffer);
      return JSON.parse(text);
    }}

    async function loadPayloadFromDefaultBin() {{
      els.loadStatus.textContent = `正在读取默认数据文件：${{DATA_FILE}}`;
      const response = await fetch(DATA_FILE);
      if (!response.ok) {{
        throw new Error(`Cannot read ${{DATA_FILE}}: HTTP ${{response.status}}. 请在输出目录运行 python -m http.server 后通过 http://localhost:8000 打开 HTML。`);
      }}
      const arrayBuffer = await response.arrayBuffer();
      const nextPayload = await decodePayloadFromBuffer(arrayBuffer);
      payload = nextPayload;
      records = payload.records || [];
      meta = payload.meta || {{}};
      groupMeta = payload.groups || {{}};
      buildIndexes();
      els.loader.style.display = 'none';
      els.app.style.display = '';
      renderSummary();
      els.beforeInput.value = meta.defaultBefore || 5;
      els.afterInput.value = meta.defaultAfter || 5;
      rebuildSelect(records[0] && records[0].id);
      renderParseNotes();
      renderAll();
    }}

    async function boot() {{
      try {{
        els.loadStatus.textContent = `正在加载默认数据文件：${{DATA_FILE}}`;
        await loadPayloadFromDefaultBin();
      }} catch (error) {{
        els.loadStatus.textContent = `加载失败：${{error.message}}`;
      }}
    }}

    els.idSearch.addEventListener('input', () => {{
      const keep = els.sampleSelect.value;
      rebuildSelect(keep);
      renderAll();
    }});
    els.sampleSelect.addEventListener('change', () => {{
      rebuildSelect(els.sampleSelect.value);
      renderAll();
    }});
    els.sampleList.addEventListener('click', (event) => {{
      const row = event.target.closest('.sample-row');
      if (!row) return;
      els.sampleSelect.value = row.dataset.id;
      rebuildSelect(row.dataset.id);
      renderAll();
    }});
    els.beforeInput.addEventListener('input', renderAll);
    els.afterInput.addEventListener('input', renderAll);

    boot();
  </script>
</body>
</html>
"""


def parse_args(argv: Optional[List[str]] = None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Generate an interactive HTML report for checking labels around every sample ID."
    )
    parser.add_argument("--json", required=True, type=Path, help="Path to JSON file. Supports {'datas': [...]} or [...].")
    parser.add_argument("--before", type=int, default=5, help="Default number of previous segments shown in HTML.")
    parser.add_argument("--after", type=int, default=5, help="Default number of following segments shown in HTML.")
    parser.add_argument(
        "--output",
        type=Path,
        default=Path("sample_context_report.html"),
        help="Output HTML path. Default: sample_context_report.html.",
    )
    parser.add_argument(
        "--bin-output",
        type=Path,
        default=None,
        help="Output data bin path. Default: same as HTML with .bin extension.",
    )
    parser.add_argument(
        "--no-compress",
        action="store_true",
        help="Write plain UTF-8 JSON bytes to .bin instead of gzip-compressed bytes.",
    )
    parser.add_argument("--open", action="store_true", help="Open the generated HTML with the default browser.")
    return parser.parse_args(argv)


def main(argv: Optional[List[str]] = None) -> int:
    args = parse_args(argv)
    if args.before < 0 or args.after < 0:
        raise ValueError("--before and --after must be >= 0.")

    json_path = args.json.expanduser().resolve()
    output_path = args.output.expanduser().resolve()
    bin_output_path = args.bin_output.expanduser().resolve() if args.bin_output else output_path.with_suffix(".bin")

    print(f"[1/6] Reading JSON: {json_path}")
    records = load_records(json_path)
    print(f"[2/6] Loaded records: {len(records)}")
    print("[3/6] Building browser data and long-sample index...")
    payload = build_report_payload(records, json_path, args.before, args.after)
    print(f"      Parsed records: {payload['meta']['recordCount']}")
    print(f"      Long-sample groups: {payload['meta']['groupCount']}")
    print(f"      Skipped records: {payload['meta']['skippedCount']}")
    print(f"      Duplicate group+segment entries: {payload['meta']['duplicateSegmentCount']}")

    print("[4/6] Serializing data payload...")
    raw_payload_bytes = json.dumps(payload, ensure_ascii=False, separators=(",", ":")).encode("utf-8")
    compressed = not args.no_compress
    payload_bytes = gzip.compress(raw_payload_bytes, compresslevel=6) if compressed else raw_payload_bytes
    html_text = html_template(bin_output_path.name)

    print("[5/6] Writing HTML and default bin data package...")
    output_path.parent.mkdir(parents=True, exist_ok=True)
    bin_output_path.parent.mkdir(parents=True, exist_ok=True)
    output_path.write_text(html_text, encoding="utf-8")
    bin_output_path.write_bytes(payload_bytes)

    print("[6/6] Done.")
    print(f"Report generated: {output_path}")
    print(f"Data bin generated: {bin_output_path}")
    print(f"Raw data JSON size: {len(raw_payload_bytes) / 1024 / 1024:.2f} MB")
    print(f"Data bin size: {bin_output_path.stat().st_size / 1024 / 1024:.2f} MB")
    print("The HTML loads the generated .bin by default.")
    print("If the browser blocks local file reads, run: python -m http.server 8000")

    if args.open:
        webbrowser.open(output_path.as_uri())

    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except Exception as exc:
        print(f"[ERROR] {exc}", file=sys.stderr)
        raise SystemExit(2)
