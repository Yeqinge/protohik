    function renderParseNotes() {{
      const {{ before, after }} = currentWindowParams();
      const statusCounts = Object.fromEntries(STATUS_DEFS.map(([key]) => [key, 0]));
      const items = records.map(rec => ({{ rec, status: classifyRecord(rec, before, after) }}));
      for (const item of items) {{
