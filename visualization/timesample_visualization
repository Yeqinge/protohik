      els.groupTable.innerHTML = kvRows([
        ['大样本分组键', target.groupKey],
        ['分组规则', '小样本 ID 去掉最后一段数字编号，保留编号前的末尾下划线作为大样本 ID'],
        ['大样本 segment 范围', segments.length ? `${{segments[0]}} - ${{segments[segments.length - 1]}}` : '无'],
        ['大样本片段数', group.size],
        ['检查窗口', `${{windowStart}} - ${{windowEnd}}`],
        ['请求窗口', `${{requestedWindowStart}} - ${{requestedWindowEnd}}`],
        ['缺失 segment', missingSegments.length ? missingSegments.join(', ') : '无'],
        ['大样本 label 分布', formatCounts(groupInfo.labelCounts)],
      ]);
