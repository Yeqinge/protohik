      <div class="two-col">
        <div>
          <h3>目标样本</h3>
          <table class="kv-table"><tbody id="targetTable"></tbody></table>
        </div>
        <div>
          <h3>大样本分组</h3>
          <table class="kv-table"><tbody id="groupTable"></tbody></table>
        </div>
      </div>
    </section>

    <section>
      <h2>可视化时间线</h2>
      <div class="timeline" id="timeline"></div>
      <div class="legend">
        <span class="legend-item"><span class="swatch" style="background:#15803d"></span>与目标 label 一致</span>
        <span class="legend-item"><span class="swatch" style="background:#dc2626"></span>与目标 label 不一致</span>
        <span class="legend-item"><span class="swatch" style="background:#e5e7eb"></span>JSON 中缺失</span>
        <span class="legend-item">黑色描边为目标样本</span>
      </div>
      <div class="chip-row" id="windowChips"></div>
    </section>

    <section>
      <h2>前后样本列表</h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>相对位置</th>
              <th>segment</th>
              <th>label</th>
              <th>检查</th>
              <th>ID</th>
              <th>duration</th>
              <th>sample_rate</th>
              <th>detector_id</th>
              <th>channel_id</th>
              <th>time_point</th>
              <th>file_path</th>
            </tr>
          </thead>
          <tbody id="windowRows"></tbody>
        </table>
      </div>
    </section>

    <section>
