    function renderParseNotes() {{
      const {{ before, after }} = currentWindowParams();
      const statusCounts = Object.fromEntries(STATUS_DEFS.map(([key]) => [key, 0]));
      const canReuseCurrent = !els.idSearch.value.trim() && els.statusFilter.value === 'all' && els.targetLabelFilter.value === 'all' && currentFilteredItems.length;
      const items = canReuseCurrent ? currentFilteredItems : records.map(rec => ({{ rec, status: classifyRecord(rec, before, after) }}));
      for (const item of items) {{
