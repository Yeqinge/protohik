function finite(a){ return (a||[]).filter(x=>Number.isFinite(x)); }
function drawModelChart(m, s, i){
  if(!s) return;
  const c = document.getElementById('c'+i), ctx = c.getContext('2d');
  const W=c.width,H=c.height,pad=34;
  ctx.clearRect(0,0,W,H); ctx.font='12px system-ui'; ctx.strokeStyle='#e5e7eb'; ctx.lineWidth=1;
  for(let k=0;k<5;k++){ const y=pad+(H-2*pad)*k/4; ctx.beginPath(); ctx.moveTo(pad,y); ctx.lineTo(W-pad,y); ctx.stroke(); }
  const series = [
    {name:'loss', arr:s.loss_traj, color:m.color, width:2.4},
    {name:'weight', arr:s.weight_traj, color:'#16a34a', width:2.0},
    {name:'grad', arr:s.grad_traj, color:'#94a3b8', width:1.2},
    {name:'align', arr:s.align_traj, color:'#f59e0b', width:1.2}
  ].filter(x=>finite(x.arr).length);
  const vals = series.flatMap(x=>finite(x.arr));
  let ymin = Math.min(...vals), ymax = Math.max(...vals);
  if(!Number.isFinite(ymin)||!Number.isFinite(ymax)||ymin===ymax){ ymin=0; ymax=1; }
  const span = ymax-ymin; ymin -= span*0.08; ymax += span*0.08;
  function xPos(j,n){ return pad + (W-2*pad) * (n<=1?0:j/(n-1)); }
  function yPos(v){ return H-pad - (v-ymin)/(ymax-ymin)*(H-2*pad); }
  ctx.fillStyle='#64748b'; ctx.fillText(ymax.toFixed(3),4,pad+4); ctx.fillText(ymin.toFixed(3),4,H-pad);
  series.forEach(sr=>{
    const n=sr.arr.length; ctx.strokeStyle=sr.color; ctx.lineWidth=sr.width; ctx.beginPath(); let started=false;
    sr.arr.forEach((v,j)=>{ if(!Number.isFinite(v)){started=false;return;} const x=xPos(j,n), y=yPos(v); if(!started){ctx.moveTo(x,y); started=true;} else ctx.lineTo(x,y); });
    ctx.stroke();
  });
  let lx=pad; series.forEach(sr=>{ ctx.fillStyle=sr.color; ctx.fillRect(lx,10,10,10); ctx.fillStyle='#334155'; ctx.fillText(sr.name,lx+14,19); lx+=70; });
  ctx.fillStyle='#64748b'; ctx.fillText('epoch', W-pad-34, H-8);
}
