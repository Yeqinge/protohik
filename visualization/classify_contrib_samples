#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
Classify real samples from multiple contrib directories and export CSV + HTML.

The script reads contrib_epoch*.npz files, maps per-egs ids back to egs rows,
groups rows such as sample_001/sample_002 to the same real sample name, then
aggregates metrics across chunks and models.

Examples:
  python classify_contrib_samples.py \
    --models m1:/path/to/m1/contrib m2:/path/to/m2/contrib \
    --egs /path/to/train.egs.csv \
    --json /path/to/audio_info.json \
    --output sample_classes.html

  python classify_contrib_samples.py \
    --contribs /path/to/m1/contrib /path/to/m2/contrib \
    --egs /path/to/train.egs.csv
"""

import argparse
import csv
import glob
import html
import json
import math
import os
import re
import sys
import time
from collections import defaultdict

import numpy as np


MODEL_COLORS = [
    "#2563eb", "#dc2626", "#16a34a", "#ea580c",
    "#7c3aed", "#0891b2", "#b45309", "#be185d",
    "#4f46e5", "#0f766e", "#a21caf", "#475569",
]

CATEGORIES = [
    "suspicious_noisy",
    "boundary_ambiguous",
    "hard_learnable",
    "clean_easy",
    "influential",
    "unknown",
]

CATEGORY_LABELS = {
    "suspicious_noisy": "疑似错标/坏样本",
    "boundary_ambiguous": "边界/混淆样本",
    "hard_learnable": "困难但可学",
    "clean_easy": "干净易学",
    "influential": "高影响样本",
    "unknown": "采集不足",
}

LABEL_PREFIXES = re.compile(
    r"^(?:abnormal|normal|hard|unknown|noise|fault|"
    r"harmful_suspect|high_influence|easy_redundant)[-_]",
    re.IGNORECASE,
)


def finite_mean(values):
    arr = np.asarray(values, dtype=np.float64)
    arr = arr[np.isfinite(arr)]
    return float(arr.mean()) if arr.size else float("nan")


def finite_max(values):
    arr = np.asarray(values, dtype=np.float64)
    arr = arr[np.isfinite(arr)]
    return float(arr.max()) if arr.size else float("nan")


def finite_last(values):
    arr = np.asarray(values, dtype=np.float64)
    idx = np.where(np.isfinite(arr))[0]
    return float(arr[idx[-1]]) if idx.size else float("nan")


def percentile_rank(values, higher_is_more=True):
    arr = np.asarray(values, dtype=np.float64)
    out = np.full(arr.shape, np.nan, dtype=np.float64)
    valid = np.isfinite(arr)
    if valid.sum() == 0:
        return out
    vals = arr[valid]
    order = np.argsort(vals)
    ranks = np.empty(vals.shape, dtype=np.float64)
    if len(vals) == 1:
        ranks[order] = 1.0
    else:
        ranks[order] = np.linspace(0.0, 1.0, len(vals))
    if not higher_is_more:
        ranks = 1.0 - ranks
    out[valid] = ranks
    return out


def parse_model_specs(args):
    specs = []
    for spec in args.models or []:
        if ":" not in spec:
            raise SystemExit(f"--models item must be NAME:PATH, got: {spec}")
        name, path = spec.split(":", 1)
        specs.append((name, path))
    for path in args.contribs or []:
        norm = os.path.normpath(path)
        parent = os.path.basename(os.path.dirname(norm))
        base = os.path.basename(norm)
        name = parent if base.lower() == "contrib" and parent else base
        specs.append((name, path))
    if not specs:
        raise SystemExit("Please provide --models NAME:PATH ... or --contribs PATH ...")
    return specs


def sniff_delimiter(line):
    if "\t" in line:
        return "\t"
    if "," in line:
        return ","
    return None


def split_egs_line(line, delim):
    line = line.strip()
    if not line:
        return []
    return line.split(delim) if delim else line.split()


def looks_like_header(parts):
    if not parts:
        return False
    joined = " ".join(p.lower() for p in parts[:4])
    return any(k in joined for k in ("utt", "id", "ark", "path", "label", "feat"))


def normalize_sample_name(raw, json_names=None):
    if raw is None:
        return ""
    name = str(raw).strip().strip('"').strip("'")
    if not name:
        return ""
    name = name.replace("\\", "/")
    name = os.path.basename(name)
    name = re.sub(r"\.(wav|flac|mp3|ogg|ark|npy|npz)$", "", name, flags=re.IGNORECASE)
    name = LABEL_PREFIXES.sub("", name)

    json_name_set = json_names if isinstance(json_names, set) else set(json_names or [])
    if json_name_set and name in json_name_set:
        return name

    # Common egs/chunk suffixes: sample_001, sample-001, sample_chunk001.
    chunk_stripped = re.sub(r"([_-])(?:chunk|seg)?\d{1,6}$", "", name, flags=re.IGNORECASE)
    if json_name_set and chunk_stripped in json_name_set:
        return chunk_stripped
    return chunk_stripped


def load_json_name_map(path):
    if not path:
        return {}, set()
    if not os.path.exists(path):
        print(f"[warn] JSON file not found, ignored: {path}")
        return {}, set()

    t0 = time.time()
    print(f"[json] reading {path} ...", flush=True)
    with open(path, encoding="utf-8") as f:
        data = json.load(f)
    print(f"[json] parsed JSON in {time.time() - t0:.1f}s", flush=True)

    items = data if isinstance(data, list) else data.get("datas", data.get("data", data.get("items", [])))
    meta = {}
    names = set()
    for item in items:
        if not isinstance(item, dict):
            continue
        raw = (
            item.get("sample_name") or item.get("name") or item.get("utt_id")
            or item.get("id") or item.get("ID") or item.get("file_path")
            or item.get("wav_path") or item.get("path") or ""
        )
        name = normalize_sample_name(raw)
        if not name:
            continue
        names.add(name)
        meta[name] = {
            "json_label": item.get("label", ""),
            "file_path": item.get("file_path", item.get("wav_path", item.get("path", ""))),
            "detector_id": item.get("detector_id", ""),
            "channel_id": item.get("channel_id", ""),
            "project": item.get("project", ""),
            "duration": item.get("duration", ""),
            "time_point": item.get("time_point", ""),
        }
    print(f"[json] loaded {len(items)} records, {len(names)} normalized names ({time.time() - t0:.1f}s)", flush=True)
    return meta, names


def load_egs_map(path, json_names=None):
    if not path:
        return {}
    if not os.path.exists(path):
        print(f"[warn] egs file not found, ignored: {path}")
        return {}

    t0 = time.time()
    print(f"[egs] reading {path} ...", flush=True)
    with open(path, encoding="utf-8") as f:
        first = f.readline()
    delim = sniff_delimiter(first)
    first_parts = split_egs_line(first, delim)
    has_header = looks_like_header(first_parts)

    mapping = {}
    data_idx = 0
    file_idx = 0

    def add_line(idx, line):
        nonlocal data_idx
        parts = split_egs_line(line, delim)
        if not parts:
            return
        raw_name = parts[0]
        sample = normalize_sample_name(raw_name, json_names=json_names)
        if not sample:
            return
        # contrib ids may be file line numbers, or data row numbers after header.
        mapping[str(idx)] = sample
        mapping[str(data_idx)] = sample
        data_idx += 1
        if data_idx % 500000 == 0:
            print(f"[egs] processed {data_idx} rows ({time.time() - t0:.1f}s)", flush=True)

    if first and not has_header:
        add_line(file_idx, first)

    with open(path, encoding="utf-8") as f:
        if first:
            f.readline()
        for file_idx, line in enumerate(f, start=1):
            add_line(file_idx, line)

    print(f"[egs] loaded {data_idx} data rows from {path} (header={has_header}, {time.time() - t0:.1f}s)", flush=True)
    return mapping


def model_specific_egs(common_map, model_egs_specs, model_name, json_names):
    if model_name in model_egs_specs:
        return load_egs_map(model_egs_specs[model_name], json_names=json_names)
    return common_map


def parse_model_egs_specs(values):
    out = {}
    for spec in values or []:
        if ":" not in spec:
            raise SystemExit(f"--model-egs item must be NAME:PATH, got: {spec}")
        name, path = spec.split(":", 1)
        out[name] = path
    return out


def load_contrib_model(name, contrib_dir, id_to_sample):
    t0 = time.time()
    files = sorted(glob.glob(os.path.join(contrib_dir, "contrib_epoch*.npz")))
    if not files:
        print(f"[warn] no contrib_epoch*.npz in {contrib_dir}, skip {name}")
        return None

    all_ids = []
    id_seen = set()
    epochs = []
    print(f"[model] {name}: scanning {len(files)} epoch files for ids", flush=True)
    for fi, fp in enumerate(files, start=1):
        m = re.search(r"contrib_epoch(\d+)\.npz$", os.path.basename(fp))
        epochs.append(int(m.group(1)) if m else len(epochs))
        d = np.load(fp, allow_pickle=True)
        for sid in d["ids"].astype(str):
            if sid not in id_seen:
                id_seen.add(sid)
                all_ids.append(sid)
        if fi == 1 or fi % 5 == 0 or fi == len(files):
            print(
                f"[model] {name}: scanned {fi}/{len(files)} files, "
                f"unique egs ids={len(all_ids)}",
                flush=True,
            )

    n = len(all_ids)
    ne = len(files)
    id2row = {sid: i for i, sid in enumerate(all_ids)}
    gn = np.full((n, ne), np.nan, dtype=np.float32)
    al = np.full((n, ne), np.nan, dtype=np.float32)
    loss = np.full((n, ne), np.nan, dtype=np.float32)
    wt = np.full((n, ne), np.nan, dtype=np.float32)
    correct = np.full((n, ne), -1, dtype=np.int8)
    target = np.full((n, ne), -1, dtype=np.int64)
    pred = np.full((n, ne), -1, dtype=np.int64)
    has_weight = False

    id_to_utt_from_npz = {}
    print(f"[model] {name}: filling epoch matrices ({n} egs ids x {ne} epochs)", flush=True)
    for ei, fp in enumerate(files):
        d = np.load(fp, allow_pickle=True)
        ids = d["ids"].astype(str)
        rows = np.array([id2row[s] for s in ids], dtype=np.int64)
        if "grad_norm" in d:
            gn[rows, ei] = d["grad_norm"]
        if "align" in d:
            al[rows, ei] = d["align"]
        if "loss" in d:
            loss[rows, ei] = d["loss"]
        if "focal_weight" in d:
            values = d["focal_weight"]
            if np.isfinite(values).any():
                has_weight = True
            wt[rows, ei] = values
        if "correct" in d:
            correct[rows, ei] = d["correct"]
        if "target" in d:
            target[rows, ei] = d["target"]
        if "pred" in d:
            pred[rows, ei] = d["pred"]
        if "utt_ids" in d:
            for sid, uid in zip(ids, d["utt_ids"].astype(str)):
                id_to_utt_from_npz.setdefault(sid, uid)
        if ei == 0 or (ei + 1) % 5 == 0 or ei + 1 == len(files):
            print(
                f"[model] {name}: loaded epoch matrix {ei + 1}/{len(files)}",
                flush=True,
            )

    sample_to_rows = defaultdict(list)
    print(f"[model] {name}: grouping egs ids to real samples", flush=True)
    for i, sid in enumerate(all_ids):
        raw = id_to_sample.get(sid)
        if not raw:
            raw = id_to_utt_from_npz.get(sid, sid)
            raw = normalize_sample_name(raw)
        sample_to_rows[raw].append(i)

    sample_data = {}
    total_samples = len(sample_to_rows)
    for si, (sample, rows) in enumerate(sample_to_rows.items(), start=1):
        idx = np.asarray(rows, dtype=np.int64)
        gn_traj = np.nanmean(gn[idx, :], axis=0)
        al_traj = np.nanmean(al[idx, :], axis=0)
        loss_traj = np.nanmean(loss[idx, :], axis=0)
        wt_traj = np.nanmean(wt[idx, :], axis=0) if has_weight else np.full(ne, np.nan, dtype=np.float32)

        # A sample is correct in an epoch when the mean correctness across chunks is >= 0.5.
        co_float = np.where(correct[idx, :] >= 0, correct[idx, :].astype(np.float32), np.nan)
        correct_rate_traj = np.nanmean(co_float, axis=0)
        correct_binary = np.where(np.isfinite(correct_rate_traj), correct_rate_traj >= 0.5, False)
        valid_correct = np.isfinite(correct_rate_traj)
        final_correct = int(correct_binary[np.where(valid_correct)[0][-1]]) if valid_correct.any() else -1
        forget_events = 0
        valid_idx = np.where(valid_correct)[0]
        if len(valid_idx) > 1:
            seq = correct_binary[valid_idx]
            forget_events = int(((seq[:-1] == 1) & (seq[1:] == 0)).sum())

        with np.errstate(all="ignore"):
            frac_neg_align = float(np.nanmean(al[idx, :] < 0)) if np.isfinite(al[idx, :]).any() else float("nan")
            mean_gn = float(np.nanmean(gn_traj))
            self_influence = float(np.nansum(np.nanmean(gn[idx, :], axis=0) ** 2))

        sample_data[sample] = {
            "sample_name": sample,
            "n_egs": int(len(rows)),
            "n_epochs": int(np.isfinite(loss_traj).sum()),
            "mean_loss": finite_mean(loss_traj),
            "last_loss": finite_last(loss_traj),
            "mean_weight": finite_mean(wt_traj),
            "last_weight": finite_last(wt_traj),
            "mean_grad_norm": mean_gn,
            "self_influence": self_influence,
            "mean_align": finite_mean(al_traj),
            "frac_neg_align": frac_neg_align,
            "forget_events": forget_events,
            "final_correct": final_correct,
            "correct_rate": finite_mean(correct_rate_traj),
            "loss_traj": [None if not np.isfinite(x) else round(float(x), 6) for x in loss_traj],
            "weight_traj": [None if not np.isfinite(x) else round(float(x), 6) for x in wt_traj],
            "grad_traj": [None if not np.isfinite(x) else round(float(x), 6) for x in gn_traj],
            "align_traj": [None if not np.isfinite(x) else round(float(x), 6) for x in al_traj],
        }
        if si == 1 or si % 20000 == 0 or si == total_samples:
            print(
                f"[model] {name}: aggregated {si}/{total_samples} real samples",
                flush=True,
            )

    print(
        f"[model] {name}: epochs={ne}, egs={n}, samples={len(sample_data)}, "
        f"weight={'yes' if has_weight else 'no'}, {time.time() - t0:.1f}s"
    )
    return {
        "name": name,
        "path": contrib_dir,
        "epochs": epochs,
        "has_weight": has_weight,
        "sample_data": sample_data,
    }


def add_model_percentiles(model):
    data = list(model["sample_data"].values())
    if not data:
        return
    loss_pct = percentile_rank([d["mean_loss"] for d in data], True)
    last_loss_pct = percentile_rank([d["last_loss"] for d in data], True)
    forget_pct = percentile_rank([d["forget_events"] for d in data], True)
    neg_align_pct = percentile_rank([d["frac_neg_align"] for d in data], True)
    influence_pct = percentile_rank([d["self_influence"] for d in data], True)
    weight_low_pct = percentile_rank([d["mean_weight"] for d in data], False)

    for i, d in enumerate(data):
        d["loss_pct"] = float(loss_pct[i]) if np.isfinite(loss_pct[i]) else float("nan")
        d["last_loss_pct"] = float(last_loss_pct[i]) if np.isfinite(last_loss_pct[i]) else float("nan")
        d["forget_pct"] = float(forget_pct[i]) if np.isfinite(forget_pct[i]) else float("nan")
        d["neg_align_pct"] = float(neg_align_pct[i]) if np.isfinite(neg_align_pct[i]) else float("nan")
        d["influence_pct"] = float(influence_pct[i]) if np.isfinite(influence_pct[i]) else float("nan")
        d["weight_low_pct"] = float(weight_low_pct[i]) if np.isfinite(weight_low_pct[i]) else float("nan")

        wrong = 1.0 if d["final_correct"] == 0 else 0.0 if d["final_correct"] == 1 else float("nan")
        parts = [
            (0.40, d["loss_pct"]),
            (0.25, wrong),
            (0.20, d["neg_align_pct"]),
            (0.15, d["forget_pct"]),
        ]
        if model["has_weight"] and np.isfinite(d["weight_low_pct"]):
            parts = [
                (0.35, d["loss_pct"]),
                (0.25, wrong),
                (0.20, d["neg_align_pct"]),
                (0.15, d["forget_pct"]),
                (0.05, d["weight_low_pct"]),
            ]
        total = sum(w for w, v in parts if np.isfinite(v))
        d["model_suspicious_score"] = (
            sum(w * v for w, v in parts if np.isfinite(v)) / total if total else float("nan")
        )


def classify_samples(models, min_model_coverage=0.5):
    for model in models:
        add_model_percentiles(model)

    names = sorted({s for m in models for s in m["sample_data"].keys()})
    n_models = len(models)
    rows = []
    for sample in names:
        present = [m for m in models if sample in m["sample_data"]]
        coverage = len(present) / max(n_models, 1)
        if not present or coverage < min_model_coverage:
            category = "unknown"
            reason = "model coverage too low"
        else:
            wrong_vals = []
            high_loss_vals = []
            unstable_vals = []
            conflict_vals = []
            low_weight_vals = []
            influence_vals = []
            scores = []
            for m in present:
                d = m["sample_data"][sample]
                if d["final_correct"] in (0, 1):
                    wrong_vals.append(1.0 if d["final_correct"] == 0 else 0.0)
                high_loss_vals.append(1.0 if d.get("loss_pct", 0.0) >= 0.90 else 0.0)
                unstable_vals.append(1.0 if (d.get("forget_pct", 0.0) >= 0.80 or d["forget_events"] >= 2) else 0.0)
                conflict_vals.append(1.0 if (d["frac_neg_align"] >= 0.50 or d.get("neg_align_pct", 0.0) >= 0.80) else 0.0)
                if m["has_weight"] and np.isfinite(d.get("weight_low_pct", float("nan"))):
                    low_weight_vals.append(1.0 if d["weight_low_pct"] >= 0.80 else 0.0)
                influence_vals.append(1.0 if d.get("influence_pct", 0.0) >= 0.90 else 0.0)
                if np.isfinite(d.get("model_suspicious_score", float("nan"))):
                    scores.append(d["model_suspicious_score"])

            wrong_rate = finite_mean(wrong_vals)
            high_loss_rate = finite_mean(high_loss_vals)
            unstable_rate = finite_mean(unstable_vals)
            conflict_rate = finite_mean(conflict_vals)
            low_weight_rate = finite_mean(low_weight_vals)
            influence_rate = finite_mean(influence_vals)
            score = finite_mean(scores)

            # Weight is supporting evidence only; models without weight do not hurt the decision.
            if wrong_rate >= 0.60 and high_loss_rate >= 0.50 and conflict_rate >= 0.40:
                category = "suspicious_noisy"
                reason = "many models wrong, high-loss, and gradient-conflicting"
            elif (np.isfinite(low_weight_rate) and low_weight_rate >= 0.60 and wrong_rate >= 0.40 and high_loss_rate >= 0.40):
                category = "suspicious_noisy"
                reason = "low weight agrees with wrong/high-loss evidence"
            elif (0.30 <= wrong_rate <= 0.70) or unstable_rate >= 0.50:
                category = "boundary_ambiguous"
                reason = "models disagree or sample is frequently forgotten"
            elif high_loss_rate >= 0.50 and wrong_rate < 0.30:
                category = "hard_learnable"
                reason = "high loss but most models eventually get it right"
            elif wrong_rate <= 0.20 and high_loss_rate <= 0.20 and conflict_rate <= 0.20 and unstable_rate <= 0.20:
                category = "clean_easy"
                reason = "most models agree it is easy and stable"
            elif influence_rate >= 0.50:
                category = "influential"
                reason = "high self-influence in multiple models"
            elif score >= 0.75:
                category = "suspicious_noisy"
                reason = "high aggregate suspicious score"
            elif score >= 0.55:
                category = "boundary_ambiguous"
                reason = "medium aggregate suspicious score"
            else:
                category = "clean_easy"
                reason = "low aggregate suspicious score"

        row = {
            "sample_name": sample,
            "category": category,
            "category_label": CATEGORY_LABELS[category],
            "reason": reason,
            "model_coverage": coverage,
        }
        present_data = [m["sample_data"][sample] for m in present]
        row.update({
            "models_present": len(present),
            "wrong_rate": finite_mean([1.0 if d["final_correct"] == 0 else 0.0 for d in present_data if d["final_correct"] in (0, 1)]),
            "high_loss_rate": finite_mean([1.0 if d.get("loss_pct", 0.0) >= 0.90 else 0.0 for d in present_data]),
            "unstable_rate": finite_mean([1.0 if (d.get("forget_pct", 0.0) >= 0.80 or d["forget_events"] >= 2) else 0.0 for d in present_data]),
            "conflict_rate": finite_mean([1.0 if (d["frac_neg_align"] >= 0.50 or d.get("neg_align_pct", 0.0) >= 0.80) else 0.0 for d in present_data]),
            "low_weight_rate": finite_mean([
                1.0 if d.get("weight_low_pct", float("nan")) >= 0.80 else 0.0
                for m in present for d in [m["sample_data"][sample]]
                if m["has_weight"] and np.isfinite(d.get("weight_low_pct", float("nan")))
            ]),
            "mean_suspicious_score": finite_mean([d.get("model_suspicious_score", float("nan")) for d in present_data]),
            "mean_loss_pct": finite_mean([d.get("loss_pct", float("nan")) for d in present_data]),
            "mean_neg_align_pct": finite_mean([d.get("neg_align_pct", float("nan")) for d in present_data]),
            "mean_influence_pct": finite_mean([d.get("influence_pct", float("nan")) for d in present_data]),
            "mean_n_egs": finite_mean([d["n_egs"] for d in present_data]),
        })
        rows.append(row)

    priority = {c: i for i, c in enumerate(CATEGORIES)}
    rows.sort(key=lambda r: (priority.get(r["category"], 99), -safe_num(r["mean_suspicious_score"]), r["sample_name"]))
    return rows


def safe_num(v, default=-1e9):
    return float(v) if isinstance(v, (int, float)) and np.isfinite(v) else default


def fmt(v):
    if isinstance(v, (int, np.integer)):
        return str(int(v))
    if isinstance(v, (float, np.floating)):
        if not np.isfinite(v):
            return ""
        return f"{float(v):.6f}"
    return "" if v is None else str(v)


def json_safe(value):
    """Convert numpy values and non-finite floats to strict JSON values."""
    if isinstance(value, dict):
        return {str(k): json_safe(v) for k, v in value.items()}
    if isinstance(value, (list, tuple)):
        return [json_safe(v) for v in value]
    if isinstance(value, np.ndarray):
        return json_safe(value.tolist())
    if isinstance(value, (np.integer,)):
        return int(value)
    if isinstance(value, (np.floating, float)):
        return float(value) if np.isfinite(value) else None
    return value


def export_csv(path, rows, models, meta):
    fields = [
        "sample_name", "category", "category_label", "reason",
        "models_present", "model_coverage", "wrong_rate", "high_loss_rate",
        "unstable_rate", "conflict_rate", "low_weight_rate",
        "mean_suspicious_score", "mean_loss_pct", "mean_neg_align_pct",
        "mean_influence_pct", "mean_n_egs",
        "json_label", "file_path", "detector_id", "channel_id", "project", "duration", "time_point",
    ]
    for m in models:
        name = m["name"]
        fields += [
            f"{name}_n_egs", f"{name}_mean_loss", f"{name}_loss_pct",
            f"{name}_last_loss", f"{name}_final_correct",
            f"{name}_forget_events", f"{name}_frac_neg_align",
            f"{name}_mean_align", f"{name}_self_influence",
            f"{name}_influence_pct", f"{name}_mean_weight",
            f"{name}_weight_low_pct", f"{name}_score",
        ]

    with open(path, "w", newline="", encoding="utf-8-sig") as f:
        writer = csv.DictWriter(f, fieldnames=fields)
        writer.writeheader()
        for row in rows:
            out = {k: row.get(k, "") for k in fields}
            out.update(meta.get(row["sample_name"], {}))
            for m in models:
                d = m["sample_data"].get(row["sample_name"], {})
                name = m["name"]
                out[f"{name}_n_egs"] = d.get("n_egs", "")
                out[f"{name}_mean_loss"] = d.get("mean_loss", "")
                out[f"{name}_loss_pct"] = d.get("loss_pct", "")
                out[f"{name}_last_loss"] = d.get("last_loss", "")
                out[f"{name}_final_correct"] = d.get("final_correct", "")
                out[f"{name}_forget_events"] = d.get("forget_events", "")
                out[f"{name}_frac_neg_align"] = d.get("frac_neg_align", "")
                out[f"{name}_mean_align"] = d.get("mean_align", "")
                out[f"{name}_self_influence"] = d.get("self_influence", "")
                out[f"{name}_influence_pct"] = d.get("influence_pct", "")
                out[f"{name}_mean_weight"] = d.get("mean_weight", "")
                out[f"{name}_weight_low_pct"] = d.get("weight_low_pct", "")
                out[f"{name}_score"] = d.get("model_suspicious_score", "")
            writer.writerow({k: fmt(out.get(k, "")) for k in fields})


def export_html_data(out_html, rows, models, meta, shard_size=1000):
    t0 = time.time()
    base = os.path.splitext(out_html)[0]
    data_dir = base + "_data"
    os.makedirs(data_dir, exist_ok=True)
    print(f"[html-data] writing external data under {data_dir}", flush=True)

    model_payload = [
        {
            "name": m["name"],
            "epochs": m["epochs"],
            "has_weight": m["has_weight"],
            "color": MODEL_COLORS[mi % len(MODEL_COLORS)],
        }
        for mi, m in enumerate(models)
    ]

    table_rows = []
    for idx, r in enumerate(rows):
        m = meta.get(r["sample_name"], {})
        shard_id = idx // max(shard_size, 1)
        table_rows.append({
            **r,
            "json_label": m.get("json_label", ""),
            "file_path": m.get("file_path", ""),
            "shard": shard_id,
        })

    summary_payload = {
        "rows": table_rows,
        "models": model_payload,
        "categories": CATEGORY_LABELS,
        "shard_size": shard_size,
    }

    counts = defaultdict(int)
    for r in rows:
        counts[r["category"]] += 1
    counts_html = "".join(
        f'<button class="chip" data-cat="{html.escape(cat)}" onclick="setCategory(\'{html.escape(cat)}\')">'
        f"{html.escape(CATEGORY_LABELS[cat])}<b>{counts[cat]}</b></button>"
        for cat in CATEGORIES
    )

    summary_name = os.path.basename(base) + "_summary.json"
    summary_path = os.path.join(data_dir, summary_name)
    print(f"[html-data] writing summary: {summary_path}", flush=True)
    with open(summary_path, "w", encoding="utf-8") as f:
        json.dump(json_safe(summary_payload), f, ensure_ascii=False,
                  separators=(",", ":"), allow_nan=False)

    total_shards = int(math.ceil(len(rows) / max(shard_size, 1)))
    for shard_id in range(total_shards):
        start = shard_id * shard_size
        end = min(start + shard_size, len(rows))
        shard = {}
        for r in rows[start:end]:
            sample = r["sample_name"]
            per_model = {}
            for m in models:
                d = m["sample_data"].get(sample)
                if not d:
                    continue
                per_model[m["name"]] = {
                    "n_egs": d["n_egs"],
                    "mean_loss": d["mean_loss"],
                    "loss_pct": d.get("loss_pct"),
                    "final_correct": d["final_correct"],
                    "forget_events": d["forget_events"],
                    "frac_neg_align": d["frac_neg_align"],
                    "mean_align": d["mean_align"],
                    "mean_weight": d["mean_weight"],
                    "weight_low_pct": d.get("weight_low_pct"),
                    "score": d.get("model_suspicious_score"),
                    "loss_traj": d["loss_traj"],
                    "weight_traj": d["weight_traj"],
                    "grad_traj": d["grad_traj"],
                    "align_traj": d["align_traj"],
                }
            shard[sample] = per_model

        shard_name = f"detail_shard_{shard_id:04d}.json"
        shard_path = os.path.join(data_dir, shard_name)
        with open(shard_path, "w", encoding="utf-8") as f:
            json.dump(json_safe(shard), f, ensure_ascii=False,
                      separators=(",", ":"), allow_nan=False)
        if shard_id == 0 or (shard_id + 1) % 10 == 0 or shard_id + 1 == total_shards:
            size_mb = os.path.getsize(shard_path) / 1e6
            print(
                f"[html-data] shard {shard_id + 1}/{total_shards}: "
                f"samples={end - start}, size={size_mb:.1f} MB",
                flush=True,
            )

    template_path = os.path.join(
        os.path.dirname(os.path.abspath(__file__)),
        "classify_contrib_template.html",
    )
    if os.path.exists(template_path):
        print(f"[html-data] using template: {template_path}", flush=True)
        with open(template_path, encoding="utf-8") as f:
            template = f.read()
    else:
        raise FileNotFoundError(
            f"HTML template not found: {template_path}. "
            "Keep classify_contrib_template.html beside this script."
        )
    doc = template.replace("__SUMMARY_URL__", json.dumps(os.path.join(os.path.basename(data_dir), summary_name).replace("\\", "/")))
    doc = doc.replace("__COUNTS__", counts_html)
    with open(out_html, "w", encoding="utf-8") as f:
        f.write(doc)
    print(f"[html-data] html shell wrote {out_html} ({time.time() - t0:.1f}s)", flush=True)


