def run_extra_exports(args, rows, models, meta, out_html, json_layout=None):
    requested = set(args.export or [])
    if not requested:
        return []
    if "all" in requested:
        requested.update({"xlsx", "json", "html", "sources", "category_csv"})
    export_dir = args.export_dir or os.path.splitext(out_html)[0] + "_exports"
    os.makedirs(export_dir, exist_ok=True)
    stem = os.path.basename(os.path.splitext(out_html)[0])
    outputs = []
    if "json" in requested:
        selected = getattr(args, "export_category", ["all"]) or ["all"]
        selected = CATEGORIES if "all" in selected else list(dict.fromkeys(selected))
        suffix = "" if selected == CATEGORIES else "_" + safe_filename("+".join(selected))
        path = os.path.join(export_dir, stem + f"_classification{suffix}.json")
        export_original_json(path, rows, models, meta, json_layout, selected)
        outputs.append(path)
    if "xlsx" in requested:
        path = os.path.join(export_dir, stem + "_classification.xlsx"); export_classification_xlsx(path, rows, models, meta); outputs.append(path)
    if "html" in requested:
        path = os.path.join(export_dir, stem + "_summary.html"); export_summary_html(path, rows, models, meta); outputs.append(path)
    if "category_csv" in requested:
        directory = os.path.join(export_dir, "category_csv"); os.makedirs(directory, exist_ok=True); export_category_csvs(directory, rows, models, meta); outputs.append(directory)
    if "sources" in requested:
        directory = os.path.join(export_dir, "sources"); os.makedirs(directory, exist_ok=True); export_source_lists(directory, rows, models, meta, args.source_script_formats); outputs.append(directory)
    return outputs


def export_html_data(out_html, rows, models, meta, shard_size=1000):
    t0 = time.time()
    base = os.path.splitext(out_html)[0]
    bin_path = base + "_data.bin"
    print(f"[html-data] writing one binary file: {bin_path}", flush=True)

    model_payload = [
        {
            "name": m["name"],
            "epochs": m["epochs"],
            "has_weight": m["has_weight"],
            "color": MODEL_COLORS[mi % len(MODEL_COLORS)],
        }
        for mi, m in enumerate(models)
    ]
    row_strings = []
    for r in rows:
        sample_meta = find_meta_entry(meta, r["sample_name"])
        row_strings.append([
            r["sample_name"], r.get("reason", ""),
            sample_meta.get("json_label", ""), sample_meta.get("file_path", ""),
        ])
    manifest = {
        "n": len(rows),
        "models": model_payload,
        "categories": CATEGORY_LABELS,
        "category_order": CATEGORIES,
        "row_strings": row_strings,
    }
    manifest_blob = json.dumps(
        json_safe(manifest), ensure_ascii=False, separators=(",", ":"), allow_nan=False
    ).encode("utf-8")
    category_to_code = {name: i for i, name in enumerate(CATEGORIES)}

    def row_f32(key):
        return np.asarray([
            float(r.get(key)) if isinstance(r.get(key), (int, float, np.integer, np.floating)) else np.nan
            for r in rows
        ], dtype="<f4")

    def model_f32(model, key):
        return np.asarray([
            model["sample_data"].get(r["sample_name"], {}).get(key, np.nan)
            for r in rows
        ], dtype="<f4")

    def quantized_trajectory(model, key):
        ne = len(model["epochs"])
        values = np.full((len(rows), ne), np.nan, dtype=np.float32)
        for i, r in enumerate(rows):
            traj = model["sample_data"].get(r["sample_name"], {}).get(key, [])
            if traj:
                take = min(ne, len(traj))
                values[i, :take] = np.asarray([
                    np.nan if v is None else v for v in traj[:take]
                ], dtype=np.float32)
        valid = np.isfinite(values)
        if valid.any():
            lo, hi = float(values[valid].min()), float(values[valid].max())
            if hi <= lo:
                hi = lo + 1.0
        else:
            lo, hi = 0.0, 1.0
        out = np.full(values.shape, 255, dtype=np.uint8)
        out[valid] = np.clip(np.rint((values[valid] - lo) / (hi - lo) * 254.0), 0, 254).astype(np.uint8)
        return lo, hi, out

    with open(bin_path, "wb") as f:
        f.write(struct.pack("<8sII", b"CCLSALL1", 1, len(manifest_blob)))
        f.write(manifest_blob)
        f.write(b"\0" * ((-f.tell()) % 4))

        def append_aligned(payload):
            f.write(payload)
            pad = (-f.tell()) % 4
            if pad:
                f.write(b"\0" * pad)

        append_aligned(np.asarray([
            category_to_code.get(r["category"], len(CATEGORIES) - 1) for r in rows
        ], dtype=np.uint8).tobytes())
        append_aligned(np.asarray([r.get("models_present", 0) for r in rows], dtype="<u2").tobytes())
        for key in ("mean_suspicious_score", "wrong_rate", "high_loss_rate", "conflict_rate", "model_coverage"):
            append_aligned(row_f32(key).tobytes())

        static_keys = (
            "mean_loss", "loss_pct", "frac_neg_align", "mean_align",
            "mean_weight", "weight_low_pct", "model_suspicious_score",
        )
        trajectory_keys = ("loss_traj", "weight_traj", "grad_traj", "align_traj")
        for mi, model in enumerate(models, start=1):
            print(f"[html-data] packing model {mi}/{len(models)}: {model['name']}", flush=True)
            present = np.asarray([
                r["sample_name"] in model["sample_data"] for r in rows
            ], dtype=np.uint8)
            append_aligned(present.tobytes())
            append_aligned(np.asarray([
                model["sample_data"].get(r["sample_name"], {}).get("n_egs", 0) for r in rows
            ], dtype="<u2").tobytes())
            append_aligned(np.asarray([
                model["sample_data"].get(r["sample_name"], {}).get("final_correct", -1) for r in rows
            ], dtype=np.int8).tobytes())
            append_aligned(np.asarray([
                model["sample_data"].get(r["sample_name"], {}).get("forget_events", 0) for r in rows
            ], dtype="<u2").tobytes())
            for key in static_keys:
                append_aligned(model_f32(model, key).tobytes())

            for key in trajectory_keys:
                lo, hi, packed = quantized_trajectory(model, key)
                append_aligned(np.asarray([lo, hi], dtype="<f4").tobytes())
                append_aligned(packed.tobytes())

    print(f"[html-data] binary size={os.path.getsize(bin_path) / 1e6:.1f} MB", flush=True)

    template_path = os.path.join(
        os.path.dirname(os.path.abspath(__file__)),
        "classify_contrib_template.html",
    )
    if os.path.exists(template_path):
        print(f"[html-data] using template: {template_path}", flush=True)
        with open(template_path, encoding="utf-8") as f:
            template = f.read()
    else:
        raise FileNotFoundError(
            f"HTML template not found: {template_path}. "
            "Keep classify_contrib_template.html beside this script."
        )
    doc = template.replace("__DATA_URL__", json.dumps(os.path.basename(bin_path).replace("\\", "/")))
    with open(out_html, "w", encoding="utf-8") as f:
        f.write(doc)
    print(f"[html-data] html + one bin wrote in {time.time() - t0:.1f}s", flush=True)


