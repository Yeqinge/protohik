def finite_mean(values):
    arr = np.asarray(values, dtype=np.float64)
    arr = arr[np.isfinite(arr)]
    return float(arr.mean()) if arr.size else float("nan")


def finite_max(values):
    arr = np.asarray(values, dtype=np.float64)
    arr = arr[np.isfinite(arr)]
    return float(arr.max()) if arr.size else float("nan")


def finite_last(values):
    arr = np.asarray(values, dtype=np.float64)
    idx = np.where(np.isfinite(arr))[0]
    return float(arr[idx[-1]]) if idx.size else float("nan")


def percentile_rank(values, higher_is_more=True):
    arr = np.asarray(values, dtype=np.float64)
    out = np.full(arr.shape, np.nan, dtype=np.float64)
    valid = np.isfinite(arr)
    if valid.sum() == 0:
        return out
    vals = arr[valid]
    order = np.argsort(vals)
    ranks = np.empty(vals.shape, dtype=np.float64)
    if len(vals) == 1:
        ranks[order] = 1.0
    else:
        ranks[order] = np.linspace(0.0, 1.0, len(vals))
    if not higher_is_more:
        ranks = 1.0 - ranks
    out[valid] = ranks
    return out


def parse_model_specs(args):
    specs = []
    for spec in args.models or []:
        if ":" not in spec:
            raise SystemExit(f"--models item must be NAME:PATH, got: {spec}")
        name, path = spec.split(":", 1)
        specs.append((name, path))
    for path in args.contribs or []:
        norm = os.path.normpath(path)
        parent = os.path.basename(os.path.dirname(norm))
        base = os.path.basename(norm)
        name = parent if base.lower() == "contrib" and parent else base
        specs.append((name, path))
    if not specs:
        raise SystemExit("Please provide --models NAME:PATH ... or --contribs PATH ...")
    return specs


def sniff_delimiter(line):
    if "\t" in line:
        return "\t"
    if "," in line:
        return ","
    return None


def split_egs_line(line, delim):
    line = line.strip()
    if not line:
        return []
    if delim:
        return next(csv.reader([line], delimiter=delim))
    return line.split()


def looks_like_header(parts):
    if not parts:
        return False
    # Only accept actual column names.  The old substring test treated a first
    # data row containing e.g. "/path/a.ark" as a header and silently shifted
    # every following egs id by one.
    header_names = {
        "sample_name", "sample", "utt_id", "utt", "utterance_id",
        "wav_id", "audio_id", "file_name", "filename", "wav_path",
        "file_path", "path", "ark", "feat", "feature", "feature_path",
        "id", "label", "class_label", "class-label", "target",
    }
    normalized = [str(part).strip().strip('"').strip("'").lower() for part in parts]
    return any(part in header_names for part in normalized)


def choose_egs_name_column(header_parts):
    if not header_parts:
        return 0
    normalized = [str(p).strip().lower() for p in header_parts]
    exact_priority = [
        "sample_name", "sample", "utt_id", "utt", "utterance_id",
        "wav_id", "audio_id", "file_name", "filename",
        "wav_path", "file_path", "path", "ark", "feat", "feature_path",
        "id",
    ]
    normalized_priority = [p.lower() for p in exact_priority]
    for wanted in normalized_priority:
        for idx, name in enumerate(normalized):
            if name == wanted:
                return idx
    for idx, name in enumerate(normalized):
        if any(token in name for token in ("utt", "sample", "wav", "audio", "file", "path")):
            return idx
    return 0


def json_sample_name(raw):
    """Normalize one JSON record name without aggregating real samples."""
    if raw is None:
        return ""
    name = str(raw).strip().strip('"').strip("'")
    if not name:
        return ""
    name = name.replace("\\", "/")
    name = os.path.basename(name)
    return re.sub(r"\.(wav|mp3|flac|m4a|ogg|aac)$", "", name, flags=re.IGNORECASE)


def egs_chunk_candidates(stem):
    """Yield an exact egs name followed by progressively de-chunked names."""
    candidates = [stem]
    current = stem
    for _ in range(4):
        stripped = re.sub(
            r"(?:[_-](?:chunk|seg)?\d{1,6})$", "", current,
            flags=re.IGNORECASE,
        )
        if stripped == current or not stripped:
            break
        candidates.append(stripped)
        current = stripped
    return candidates


def normalize_sample_name(raw, json_names=None):
    if raw is None:
        return ""
    text = str(raw).strip().strip('"').strip("'")
    if not text:
        return ""
    json_name_set = json_names if isinstance(json_names, set) else set(json_names or [])
    basename = os.path.basename(text.replace("\\", "/"))
    stem = re.sub(
        r"\.(wav|mp3|flac|m4a|ogg|aac|ark|npy|npz)$", "", basename,
        flags=re.IGNORECASE,
    )

    candidates = egs_chunk_candidates(stem)
    if json_name_set:
        # Exact JSON names always win. Only egs names that are not exact are
        # allowed to lose one or more explicit chunk suffixes.
        for candidate in candidates:
            if candidate in json_name_set:
                return candidate
        return stem
    return candidates[1] if len(candidates) > 1 else stem


def sample_name_candidates(raw):
    if raw is None:
        return []
    text = str(raw).strip()
    if not text:
        return []
    candidates = []
    values = [text, text.replace("\\", "/"), os.path.basename(text.replace("\\", "/"))]
    for value in values:
        stem = re.sub(
            r"\.(wav|mp3|flac|m4a|ogg|aac|ark|npy|npz)$", "", value,
            flags=re.IGNORECASE,
        )
        for candidate in (value, stem, *egs_chunk_candidates(stem)):
            candidate = str(candidate).strip().strip('"').strip("'")
            if candidate and candidate not in candidates:
                candidates.append(candidate)
    return candidates


def find_meta_entry(meta, sample):
    if not isinstance(meta, dict):
        return {}
    for candidate in sample_name_candidates(sample):
        if candidate in meta:
            return meta[candidate]
    normalized = json_sample_name(sample)
    return meta.get(normalized, {})


def get_json_record_id(item):
    """Mirror sample_context_visualizer.get_record_id without raising."""
    value = item.get("ID") or item.get("id") or item.get("file_name") or item.get("filename")
    if value:
        return str(value)
    file_path = item.get("file_path")
    if file_path:
        return os.path.basename(str(file_path))
    return ""


def load_json_name_map(path):
    if not path:
        return {}, set(), {"kind": "none"}
    if not os.path.exists(path):
        print(f"[warn] JSON file not found, ignored: {path}")
        return {}, set(), {"kind": "none"}

    t0 = time.time()
    print(f"[json] reading {path} ...", flush=True)
    with open(path, encoding="utf-8") as f:
        data = json.load(f)
    print(f"[json] parsed JSON in {time.time() - t0:.1f}s", flush=True)

    data_key = None
    if isinstance(data, list):
        items = data
        json_layout = {"kind": "list", "source_json": os.path.abspath(path)}
    else:
        for candidate in ("datas", "data", "items"):
            if isinstance(data.get(candidate), list):
                data_key = candidate
                break
        items = data.get(data_key, []) if data_key else []
        json_layout = {
            "kind": "dict",
            "data_key": data_key or "datas",
            "source_json": os.path.abspath(path),
            "extra": {k: v for k, v in data.items() if k != data_key},
        }
    meta = {}
    names = set()
    valid_record_count = 0
    duplicate_names = []
    for item in items:
        if not isinstance(item, dict):
            continue
        # Keep exactly the same id precedence as sample_context_visualizer so
        # the two scripts produce the same group universe and keys.
        raw = get_json_record_id(item)
        name = json_sample_name(raw)
        if not name:
            continue
        valid_record_count += 1
        if name in names and len(duplicate_names) < 10:
            duplicate_names.append(name)
        names.add(name)
        entry = meta.setdefault(name, {})
        next_meta = {
            "json_label": item.get("label", ""),
            "file_path": item.get("file_path", item.get("wav_path", item.get("path", ""))),
            "detector_id": item.get("detector_id", ""),
            "channel_id": item.get("channel_id", ""),
            "project": item.get("project", ""),
            "duration": item.get("duration", ""),
            "time_point": item.get("time_point", ""),
        }
        for key, value in next_meta.items():
            text = "" if value is None else str(value).strip()
            if not text:
                continue
            current = entry.get(key, "")
            if not str(current).strip():
                entry[key] = value
            elif key == "project":
                parts = [p.strip() for p in str(current).split(" | ") if p.strip()]
                if text not in parts:
                    parts.append(text)
                    entry[key] = " | ".join(parts)
        entry.setdefault("_original_records", []).append(item)
    print(
        f"[json] loaded {len(items)} records, {valid_record_count} valid sample ids, "
        f"{len(names)} unique real samples ({time.time() - t0:.1f}s)",
        flush=True,
    )
    json_layout["record_count"] = len(items)
    json_layout["valid_record_count"] = valid_record_count
    json_layout["sample_count"] = len(names)
    json_layout["duplicate_name_count"] = valid_record_count - len(names)
    json_layout["duplicate_name_examples"] = duplicate_names
    return meta, names, json_layout


def load_egs_map(path, json_names=None):
    if not path:
        return {"zero_based": {}, "physical_line": {}, "row_count": 0, "has_header": False}
    if not os.path.exists(path):
        print(f"[warn] egs file not found, ignored: {path}")
        return {"zero_based": {}, "physical_line": {}, "row_count": 0, "has_header": False}

    t0 = time.time()
    print(f"[egs] reading {path} ...", flush=True)
    with open(path, encoding="utf-8") as f:
        first = f.readline()
    delim = sniff_delimiter(first)
    first_parts = split_egs_line(first, delim)
    has_header = looks_like_header(first_parts)
    name_col = choose_egs_name_column(first_parts) if has_header else 0
    if has_header:
        header_name = first_parts[name_col] if name_col < len(first_parts) else ""
        print(f"[egs] header detected, sample column #{name_col}: {header_name}", flush=True)

    zero_based = {}
    physical_line = {}
    data_idx = 0
    json_name_set = json_names if isinstance(json_names, set) else set(json_names or [])

    def pick_raw_name(parts):
        if has_header and name_col < len(parts):
            return parts[name_col]
        if json_name_set:
            for part in parts:
                normalized = normalize_sample_name(part, json_names=json_name_set)
                if normalized in json_name_set:
                    return part
        return parts[0]

    def add_line(line_number, line):
        nonlocal data_idx
        parts = split_egs_line(line, delim)
        if not parts:
            return
        raw_name = pick_raw_name(parts)
        sample = normalize_sample_name(raw_name, json_names=json_names)
        if not sample:
            return
        # Keep the two id spaces separate.  Putting them in one dict causes
        # unavoidable collisions (e.g. key "2" means two different rows).
        zero_based[str(data_idx)] = sample
        physical_line[str(line_number)] = sample
        data_idx += 1
        if data_idx % 500000 == 0:
            print(f"[egs] processed {data_idx} rows ({time.time() - t0:.1f}s)", flush=True)

    with open(path, encoding="utf-8") as f:
        for line_number, line in enumerate(f, start=1):
            if line_number == 1 and has_header:
                continue
            add_line(line_number, line)

    print(f"[egs] loaded {data_idx} data rows from {path} (header={has_header}, {time.time() - t0:.1f}s)", flush=True)
    return {
        "zero_based": zero_based,
        "physical_line": physical_line,
        "row_count": data_idx,
        "has_header": has_header,
    }


def model_specific_egs(common_map, model_egs_specs, model_name, json_names):
    if model_name in model_egs_specs:
        return load_egs_map(model_egs_specs[model_name], json_names=json_names)
    return common_map


def parse_model_egs_specs(values):
    out = {}
    for spec in values or []:
        if ":" not in spec:
            raise SystemExit(f"--model-egs item must be NAME:PATH, got: {spec}")
        name, path = spec.split(":", 1)
        out[name] = path
    return out


def choose_egs_id_map(egs_maps, all_ids, id_to_utt, mode="auto"):
    """Choose one non-overlapping egs id space for a contrib model."""
    zero = egs_maps.get("zero_based", {}) if isinstance(egs_maps, dict) else {}
    physical = egs_maps.get("physical_line", {}) if isinstance(egs_maps, dict) else {}
    if mode == "zero_based":
        return zero, mode
    if mode == "physical_line":
        return physical, mode

    def quality(mapping):
        coverage = sum(1 for sid in all_ids if sid in mapping)
        utt_matches = 0
        utt_compared = 0
        for sid in all_ids:
            utt = id_to_utt.get(sid)
            if sid not in mapping or not utt or str(utt) == str(sid):
                continue
            utt_compared += 1
            if normalize_sample_name(utt) == mapping[sid]:
                utt_matches += 1
        return utt_matches, utt_compared, coverage

    zero_q = quality(zero)
    physical_q = quality(physical)
    if zero_q[1] or physical_q[1]:
        def utt_score(q):
            return (q[0] / q[1] if q[1] else -1.0, q[0], q[2])
        selected = "physical_line" if utt_score(physical_q) > utt_score(zero_q) else "zero_based"
    elif "0" in all_ids and "0" in zero:
        selected = "zero_based"
    elif physical_q[2] > zero_q[2]:
        selected = "physical_line"
    else:
        # Dataset/sample ids used by the tracker are normally zero-based.
        selected = "zero_based"
    print(
        f"[egs] id mode auto: selected={selected}; "
        f"zero(matches/checked/coverage)={zero_q}, physical={physical_q}",
        flush=True,
    )
    return (physical if selected == "physical_line" else zero), selected


def load_contrib_model(name, contrib_dir, egs_maps, egs_id_mode="auto"):
    t0 = time.time()
    files = sorted(glob.glob(os.path.join(contrib_dir, "contrib_epoch*.npz")))
    if not files:
        print(f"[warn] no contrib_epoch*.npz in {contrib_dir}, skip {name}")
        return None

    all_ids = []
    id_seen = set()
    epochs = []
    print(f"[model] {name}: scanning {len(files)} epoch files for ids", flush=True)
    for fi, fp in enumerate(files, start=1):
        m = re.search(r"contrib_epoch(\d+)\.npz$", os.path.basename(fp))
        epochs.append(int(m.group(1)) if m else len(epochs))
        d = np.load(fp, allow_pickle=True)
        for sid in d["ids"].astype(str):
            if sid not in id_seen:
                id_seen.add(sid)
                all_ids.append(sid)
        if fi == 1 or fi % 5 == 0 or fi == len(files):
            print(
                f"[model] {name}: scanned {fi}/{len(files)} files, "
                f"unique egs ids={len(all_ids)}",
                flush=True,
            )

    n = len(all_ids)
    ne = len(files)
    id2row = {sid: i for i, sid in enumerate(all_ids)}
    gn = np.full((n, ne), np.nan, dtype=np.float32)
    al = np.full((n, ne), np.nan, dtype=np.float32)
    loss = np.full((n, ne), np.nan, dtype=np.float32)
    wt = np.full((n, ne), np.nan, dtype=np.float32)
    correct = np.full((n, ne), -1, dtype=np.int8)
    target = np.full((n, ne), -1, dtype=np.int64)
    pred = np.full((n, ne), -1, dtype=np.int64)
    has_weight = False

    id_to_utt_from_npz = {}
    print(f"[model] {name}: filling epoch matrices ({n} egs ids x {ne} epochs)", flush=True)
    for ei, fp in enumerate(files):
        d = np.load(fp, allow_pickle=True)
        ids = d["ids"].astype(str)
        rows = np.array([id2row[s] for s in ids], dtype=np.int64)
        if "grad_norm" in d:
            gn[rows, ei] = d["grad_norm"]
        if "align" in d:
            al[rows, ei] = d["align"]
        if "loss" in d:
            loss[rows, ei] = d["loss"]
        if "focal_weight" in d:
            values = d["focal_weight"]
            if np.isfinite(values).any():
                has_weight = True
            wt[rows, ei] = values
        if "correct" in d:
            correct[rows, ei] = d["correct"]
        if "target" in d:
            target[rows, ei] = d["target"]
        if "pred" in d:
            pred[rows, ei] = d["pred"]
        if "utt_ids" in d:
            for sid, uid in zip(ids, d["utt_ids"].astype(str)):
                id_to_utt_from_npz.setdefault(sid, uid)
        if ei == 0 or (ei + 1) % 5 == 0 or ei + 1 == len(files):
            print(
                f"[model] {name}: loaded epoch matrix {ei + 1}/{len(files)}",
                flush=True,
            )

    sample_to_rows = defaultdict(list)
    id_to_sample, selected_id_mode = choose_egs_id_map(
        egs_maps, all_ids, id_to_utt_from_npz, mode=egs_id_mode
    )
    print(f"[model] {name}: grouping egs ids to real samples", flush=True)
    for i, sid in enumerate(all_ids):
        raw = id_to_sample.get(sid)
        if not raw:
            raw = id_to_utt_from_npz.get(sid, sid)
            raw = normalize_sample_name(raw)
        sample_to_rows[raw].append(i)

    sample_data = {}
    total_samples = len(sample_to_rows)
    for si, (sample, rows) in enumerate(sample_to_rows.items(), start=1):
        idx = np.asarray(rows, dtype=np.int64)
        gn_traj = np.nanmean(gn[idx, :], axis=0)
        al_traj = np.nanmean(al[idx, :], axis=0)
        loss_traj = np.nanmean(loss[idx, :], axis=0)
        wt_traj = np.nanmean(wt[idx, :], axis=0) if has_weight else np.full(ne, np.nan, dtype=np.float32)

        # A sample is correct in an epoch when the mean correctness across chunks is >= 0.5.
        co_float = np.where(correct[idx, :] >= 0, correct[idx, :].astype(np.float32), np.nan)
        correct_rate_traj = np.nanmean(co_float, axis=0)
        correct_binary = np.where(np.isfinite(correct_rate_traj), correct_rate_traj >= 0.5, False)
        valid_correct = np.isfinite(correct_rate_traj)
        final_correct = int(correct_binary[np.where(valid_correct)[0][-1]]) if valid_correct.any() else -1
        forget_events = 0
        valid_idx = np.where(valid_correct)[0]
        if len(valid_idx) > 1:
            seq = correct_binary[valid_idx]
            forget_events = int(((seq[:-1] == 1) & (seq[1:] == 0)).sum())

        with np.errstate(all="ignore"):
            frac_neg_align = float(np.nanmean(al[idx, :] < 0)) if np.isfinite(al[idx, :]).any() else float("nan")
            mean_gn = float(np.nanmean(gn_traj))
            self_influence = float(np.nansum(np.nanmean(gn[idx, :], axis=0) ** 2))

        sample_data[sample] = {
            "sample_name": sample,
            "n_egs": int(len(rows)),
            "n_epochs": int(np.isfinite(loss_traj).sum()),
            "mean_loss": finite_mean(loss_traj),
            "last_loss": finite_last(loss_traj),
            "mean_weight": finite_mean(wt_traj),
            "last_weight": finite_last(wt_traj),
            "mean_grad_norm": mean_gn,
            "self_influence": self_influence,
            "mean_align": finite_mean(al_traj),
            "frac_neg_align": frac_neg_align,
            "forget_events": forget_events,
            "final_correct": final_correct,
            "correct_rate": finite_mean(correct_rate_traj),
            "loss_traj": [None if not np.isfinite(x) else round(float(x), 6) for x in loss_traj],
            "weight_traj": [None if not np.isfinite(x) else round(float(x), 6) for x in wt_traj],
            "grad_traj": [None if not np.isfinite(x) else round(float(x), 6) for x in gn_traj],
            "align_traj": [None if not np.isfinite(x) else round(float(x), 6) for x in al_traj],
        }
        if si == 1 or si % 20000 == 0 or si == total_samples:
            print(
                f"[model] {name}: aggregated {si}/{total_samples} real samples",
                flush=True,
            )

    print(
        f"[model] {name}: epochs={ne}, egs={n}, samples={len(sample_data)}, "
        f"weight={'yes' if has_weight else 'no'}, {time.time() - t0:.1f}s"
    )
    return {
        "name": name,
        "path": contrib_dir,
        "epochs": epochs,
        "has_weight": has_weight,
        "egs_id_mode": selected_id_mode,
        "sample_data": sample_data,
    }


def add_model_percentiles(model):
    data = list(model["sample_data"].values())
    if not data:
        return
    loss_pct = percentile_rank([d["mean_loss"] for d in data], True)
    last_loss_pct = percentile_rank([d["last_loss"] for d in data], True)
    forget_pct = percentile_rank([d["forget_events"] for d in data], True)
    neg_align_pct = percentile_rank([d["frac_neg_align"] for d in data], True)
    influence_pct = percentile_rank([d["self_influence"] for d in data], True)
    weight_low_pct = percentile_rank([d["mean_weight"] for d in data], False)

    for i, d in enumerate(data):
        d["loss_pct"] = float(loss_pct[i]) if np.isfinite(loss_pct[i]) else float("nan")
        d["last_loss_pct"] = float(last_loss_pct[i]) if np.isfinite(last_loss_pct[i]) else float("nan")
        d["forget_pct"] = float(forget_pct[i]) if np.isfinite(forget_pct[i]) else float("nan")
        d["neg_align_pct"] = float(neg_align_pct[i]) if np.isfinite(neg_align_pct[i]) else float("nan")
        d["influence_pct"] = float(influence_pct[i]) if np.isfinite(influence_pct[i]) else float("nan")
        d["weight_low_pct"] = float(weight_low_pct[i]) if np.isfinite(weight_low_pct[i]) else float("nan")

        wrong = 1.0 if d["final_correct"] == 0 else 0.0 if d["final_correct"] == 1 else float("nan")
        parts = [
            (0.40, d["loss_pct"]),
            (0.25, wrong),
            (0.20, d["neg_align_pct"]),
            (0.15, d["forget_pct"]),
        ]
        if model["has_weight"] and np.isfinite(d["weight_low_pct"]):
            parts = [
                (0.35, d["loss_pct"]),
                (0.25, wrong),
                (0.20, d["neg_align_pct"]),
                (0.15, d["forget_pct"]),
                (0.05, d["weight_low_pct"]),
            ]
        total = sum(w for w, v in parts if np.isfinite(v))
        d["model_suspicious_score"] = (
            sum(w * v for w, v in parts if np.isfinite(v)) / total if total else float("nan")
        )


def classify_samples(models, min_model_coverage=0.5, sample_universe=None):
    for model in models:
        add_model_percentiles(model)

    model_names = {s for m in models for s in m["sample_data"].keys()}
    # When JSON is supplied, use its complete real-sample universe without
    # grouping JSON names. Samples absent from every contrib model remain
    # ``unknown`` instead of disappearing from the final count.
    universe = set(sample_universe or ())
    names = sorted(universe if universe else model_names)
    model_only = model_names - universe if universe else set()
    if model_only:
        examples = ", ".join(sorted(model_only)[:5])
        print(
            f"[align] warning: {len(model_only)} contrib sample(s) do not match JSON "
            f"and are excluded; examples: {examples}",
            flush=True,
        )
    n_models = len(models)
    rows = []
    for sample in names:
        present = [m for m in models if sample in m["sample_data"]]
        coverage = len(present) / max(n_models, 1)
        if not present or coverage < min_model_coverage:
            category = "unknown"
            reason = "model coverage too low"
        else:
            wrong_vals = []
            high_loss_vals = []
            unstable_vals = []
            conflict_vals = []
            low_weight_vals = []
            influence_vals = []
            scores = []
            for m in present:
                d = m["sample_data"][sample]
                if d["final_correct"] in (0, 1):
                    wrong_vals.append(1.0 if d["final_correct"] == 0 else 0.0)
                high_loss_vals.append(1.0 if d.get("loss_pct", 0.0) >= 0.90 else 0.0)
                unstable_vals.append(1.0 if (d.get("forget_pct", 0.0) >= 0.80 or d["forget_events"] >= 2) else 0.0)
                conflict_vals.append(1.0 if (d["frac_neg_align"] >= 0.50 or d.get("neg_align_pct", 0.0) >= 0.80) else 0.0)
                if m["has_weight"] and np.isfinite(d.get("weight_low_pct", float("nan"))):
                    low_weight_vals.append(1.0 if d["weight_low_pct"] >= 0.80 else 0.0)
                influence_vals.append(1.0 if d.get("influence_pct", 0.0) >= 0.90 else 0.0)
                if np.isfinite(d.get("model_suspicious_score", float("nan"))):
                    scores.append(d["model_suspicious_score"])

            wrong_rate = finite_mean(wrong_vals)
            high_loss_rate = finite_mean(high_loss_vals)
            unstable_rate = finite_mean(unstable_vals)
            conflict_rate = finite_mean(conflict_vals)
            low_weight_rate = finite_mean(low_weight_vals)
            influence_rate = finite_mean(influence_vals)
            score = finite_mean(scores)

            # Weight is supporting evidence only; models without weight do not hurt the decision.
            if wrong_rate >= 0.60 and high_loss_rate >= 0.50 and conflict_rate >= 0.40:
                category = "suspicious_noisy"
                reason = "many models wrong, high-loss, and gradient-conflicting"
            elif (np.isfinite(low_weight_rate) and low_weight_rate >= 0.60 and wrong_rate >= 0.40 and high_loss_rate >= 0.40):
                category = "suspicious_noisy"
                reason = "low weight agrees with wrong/high-loss evidence"
            elif (0.30 <= wrong_rate <= 0.70) or unstable_rate >= 0.50:
                category = "boundary_ambiguous"
                reason = "models disagree or sample is frequently forgotten"
            elif high_loss_rate >= 0.50 and wrong_rate < 0.30:
                category = "hard_learnable"
                reason = "high loss but most models eventually get it right"
            elif wrong_rate <= 0.20 and high_loss_rate <= 0.20 and conflict_rate <= 0.20 and unstable_rate <= 0.20:
                category = "clean_easy"
                reason = "most models agree it is easy and stable"
            elif influence_rate >= 0.50:
                category = "influential"
                reason = "high self-influence in multiple models"
            elif score >= 0.75:
                category = "suspicious_noisy"
                reason = "high aggregate suspicious score"
            elif score >= 0.55:
                category = "boundary_ambiguous"
                reason = "medium aggregate suspicious score"
            else:
                category = "clean_easy"
                reason = "low aggregate suspicious score"

        row = {
            "sample_name": sample,
            "category": category,
            "category_label": CATEGORY_LABELS[category],
            "reason": reason,
            "model_coverage": coverage,
        }
        present_data = [m["sample_data"][sample] for m in present]
        row.update({
            "models_present": len(present),
            "wrong_rate": finite_mean([1.0 if d["final_correct"] == 0 else 0.0 for d in present_data if d["final_correct"] in (0, 1)]),
            "high_loss_rate": finite_mean([1.0 if d.get("loss_pct", 0.0) >= 0.90 else 0.0 for d in present_data]),
            "unstable_rate": finite_mean([1.0 if (d.get("forget_pct", 0.0) >= 0.80 or d["forget_events"] >= 2) else 0.0 for d in present_data]),
            "conflict_rate": finite_mean([1.0 if (d["frac_neg_align"] >= 0.50 or d.get("neg_align_pct", 0.0) >= 0.80) else 0.0 for d in present_data]),
            "low_weight_rate": finite_mean([
                1.0 if d.get("weight_low_pct", float("nan")) >= 0.80 else 0.0
                for m in present for d in [m["sample_data"][sample]]
                if m["has_weight"] and np.isfinite(d.get("weight_low_pct", float("nan")))
            ]),
            "mean_suspicious_score": finite_mean([d.get("model_suspicious_score", float("nan")) for d in present_data]),
            "mean_loss_pct": finite_mean([d.get("loss_pct", float("nan")) for d in present_data]),
            "mean_neg_align_pct": finite_mean([d.get("neg_align_pct", float("nan")) for d in present_data]),
            "mean_influence_pct": finite_mean([d.get("influence_pct", float("nan")) for d in present_data]),
            "mean_n_egs": finite_mean([d["n_egs"] for d in present_data]),
        })
        rows.append(row)

    priority = {c: i for i, c in enumerate(CATEGORIES)}
    rows.sort(key=lambda r: (priority.get(r["category"], 99), -safe_num(r["mean_suspicious_score"]), r["sample_name"]))
    return rows


def safe_num(v, default=-1e9):
    return float(v) if isinstance(v, (int, float)) and np.isfinite(v) else default


def fmt(v):
    if isinstance(v, (int, np.integer)):
        return str(int(v))
    if isinstance(v, (float, np.floating)):
        if not np.isfinite(v):
            return ""
        return f"{float(v):.6f}"
    return "" if v is None else str(v)


def json_safe(value):
    """Convert numpy values and non-finite floats to strict JSON values."""
    if isinstance(value, dict):
        return {str(k): json_safe(v) for k, v in value.items()}
    if isinstance(value, (list, tuple)):
        return [json_safe(v) for v in value]
    if isinstance(value, np.ndarray):
        return json_safe(value.tolist())
    if isinstance(value, (np.integer,)):
        return int(value)
    if isinstance(value, (np.floating, float)):
        return float(value) if np.isfinite(value) else None
    return value


def first_original_value(meta_entry, *keys):
    for original in meta_entry.get("_original_records", []) if isinstance(meta_entry, dict) else []:
        if not isinstance(original, dict):
            continue
        for key in keys:
            value = original.get(key)
            if value is not None and str(value).strip():
                return value
    return ""


def export_csv(path, rows, models, meta):
    fields = [
        "sample_name", "category", "category_label", "reason",
        "models_present", "model_coverage", "wrong_rate", "high_loss_rate",
        "unstable_rate", "conflict_rate", "low_weight_rate",
        "mean_suspicious_score", "mean_loss_pct", "mean_neg_align_pct",
        "mean_influence_pct", "mean_n_egs",
        "json_label", "file_path", "detector_id", "channel_id", "project", "duration", "time_point",
    ]
    for m in models:
        name = m["name"]
        fields += [
            f"{name}_n_egs", f"{name}_mean_loss", f"{name}_loss_pct",
            f"{name}_last_loss", f"{name}_final_correct",
            f"{name}_forget_events", f"{name}_frac_neg_align",
            f"{name}_mean_align", f"{name}_self_influence",
            f"{name}_influence_pct", f"{name}_mean_weight",
            f"{name}_weight_low_pct", f"{name}_score",
        ]

    with open(path, "w", newline="", encoding="utf-8-sig") as f:
        writer = csv.DictWriter(f, fieldnames=fields)
        writer.writeheader()
        for row in rows:
            out = {k: row.get(k, "") for k in fields}
            out.update(find_meta_entry(meta, row["sample_name"]))
            for m in models:
                d = m["sample_data"].get(row["sample_name"], {})
                name = m["name"]
                out[f"{name}_n_egs"] = d.get("n_egs", "")
                out[f"{name}_mean_loss"] = d.get("mean_loss", "")
                out[f"{name}_loss_pct"] = d.get("loss_pct", "")
                out[f"{name}_last_loss"] = d.get("last_loss", "")
                out[f"{name}_final_correct"] = d.get("final_correct", "")
                out[f"{name}_forget_events"] = d.get("forget_events", "")
                out[f"{name}_frac_neg_align"] = d.get("frac_neg_align", "")
                out[f"{name}_mean_align"] = d.get("mean_align", "")
                out[f"{name}_self_influence"] = d.get("self_influence", "")
                out[f"{name}_influence_pct"] = d.get("influence_pct", "")
                out[f"{name}_mean_weight"] = d.get("mean_weight", "")
                out[f"{name}_weight_low_pct"] = d.get("weight_low_pct", "")
                out[f"{name}_score"] = d.get("model_suspicious_score", "")
            writer.writerow({k: fmt(out.get(k, "")) for k in fields})


def safe_filename(value):
    cleaned = re.sub(r'[\\/:*?"<>|\s]+', "_", str(value).strip())
    return re.sub(r"_+", "_", cleaned).strip("_") or "all"


def build_export_record(row, models, meta):
    """Build one export row; callers can stream it without retaining all rows."""
    sample = row["sample_name"]
    out = dict(row)
    sample_meta = find_meta_entry(meta, sample)
    out.update({k: v for k, v in sample_meta.items() if not k.startswith("_")})
    if not str(out.get("project", "")).strip():
        out["project"] = first_original_value(sample_meta, "project")
    if not str(out.get("file_path", "")).strip():
        out["file_path"] = first_original_value(sample_meta, "file_path", "wav_path", "path")
    for model in models:
        name = model["name"]
        d = model["sample_data"].get(sample, {})
        for key in (
            "n_egs", "mean_loss", "loss_pct", "last_loss", "final_correct",
            "forget_events", "frac_neg_align", "mean_align", "self_influence",
            "influence_pct", "mean_weight", "weight_low_pct",
        ):
            out[f"{name}_{key}"] = d.get(key, "")
        out[f"{name}_score"] = d.get("model_suspicious_score", "")
    return json_safe(out)


def iter_export_records(rows, models, meta, category=None):
    for row in rows:
        if category is None or row.get("category") == category:
            yield build_export_record(row, models, meta)


def export_original_json(path, rows, models, meta, json_layout, selected_categories=None):
    selected = list(selected_categories or CATEGORIES)
    selected_set = set(selected)
    filtered_rows = [r for r in rows if r.get("category") in selected_set]
    metadata_fields = {
        "json_label", "file_path", "detector_id", "channel_id", "project",
        "duration", "time_point",
    }
    counts = {cat: 0 for cat in CATEGORIES}
    for row in filtered_rows:
        originals = find_meta_entry(meta, row["sample_name"]).get("_original_records") or [None]
        counts[row.get("category", "unknown")] += len(originals)
    sample_counts = {
        cat: sum(1 for r in filtered_rows if r.get("category") == cat)
        for cat in CATEGORIES
    }
    layout = json_layout or {"kind": "none"}
    payload = {
        "summary": {
            "source_json": layout.get("source_json", ""),
            "generated_at": dt.datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
            "category_filter": "all" if selected == CATEGORIES else "+".join(selected),
            "record_count": sum(counts.values()),
            "category_counts": counts,
            "category_labels": CATEGORY_LABELS,
            "sample_count": len(filtered_rows),
            "category_sample_counts": sample_counts,
            "note": "Each item in groups[*].datas keeps the original JSON fields and adds contrib_classification.",
        },
    }
    # Stream category data directly to disk.  The previous implementation held
    # the complete enriched record list and another grouped copy at once.
    with open(path, "w", encoding="utf-8") as f:
        f.write('{"summary":')
        json.dump(payload["summary"], f, ensure_ascii=False, separators=(",", ":"), allow_nan=False)
        f.write(',"groups":{')
        for cat_index, cat in enumerate(CATEGORIES):
            if cat_index:
                f.write(",")
            json.dump(cat, f, ensure_ascii=False)
            f.write(':{"label":')
            json.dump(CATEGORY_LABELS.get(cat, cat), f, ensure_ascii=False)
            f.write(',"count":%d,"datas":[' % counts.get(cat, 0))
            first_item = True
            for row in filtered_rows:
                if row.get("category") != cat:
                    continue
                record = build_export_record(row, models, meta)
                classification = {
                    k: v for k, v in record.items()
                    if k not in metadata_fields and not str(k).startswith("_")
                }
                originals = find_meta_entry(meta, row["sample_name"]).get("_original_records") or [{"ID": row["sample_name"]}]
                for original in originals:
                    item = dict(json_safe(original)) if isinstance(original, dict) else {"value": json_safe(original)}
                    item["contrib_classification"] = classification
                    if not first_item:
                        f.write(",")
                    json.dump(item, f, ensure_ascii=False, separators=(",", ":"), allow_nan=False)
                    first_item = False
            f.write("]}")
        f.write("}}")


def _xlsx_col(index):
    name = ""
    n = index + 1
    while n:
        n, rem = divmod(n - 1, 26)
        name = chr(65 + rem) + name
    return name


def _xlsx_text(value):
    text_value = "" if value is None else str(value)
    return re.sub(r"[\x00-\x08\x0b\x0c\x0e-\x1f]", "", text_value)


def _write_xlsx_sheet(zf, member, rows):
    prefix = (
        '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>'
        '<worksheet xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main">'
        '<sheetData>'
    ).encode("utf-8")
    with zf.open(member, "w", force_zip64=True) as stream:
        stream.write(prefix)
        for ri, row in enumerate(rows, 1):
            cells = []
            for ci, value in enumerate(row):
                ref = f"{_xlsx_col(ci)}{ri}"
                escaped = html.escape(_xlsx_text(value), quote=True)
                cells.append(f'<c r="{ref}" t="inlineStr"><is><t>{escaped}</t></is></c>')
            stream.write(f'<row r="{ri}">{"".join(cells)}</row>'.encode("utf-8"))
        stream.write(b"</sheetData></worksheet>")


def _xlsx_sheet_name(value, fallback):
    cleaned = re.sub(r'[\\/?*\[\]:]+', " ", str(value)).strip() or fallback
    return cleaned[:31]


def export_classification_xlsx(path, rows, models, meta):
    all_fields_set = set()
