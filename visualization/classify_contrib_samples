def main():
    t_all = time.time()
    ap = argparse.ArgumentParser(description="Classify samples from multiple contrib directories.")
    ap.add_argument("--models", nargs="*", default=[], metavar="NAME:CONTRIB_DIR")
    ap.add_argument("--contribs", nargs="*", default=[], metavar="CONTRIB_DIR")
    ap.add_argument("--egs", default="", help="Shared egs/train csv file. First row may be a header.")
    ap.add_argument("--model-egs", nargs="*", default=[], metavar="NAME:EGS_PATH", help="Per-model egs file override.")
    ap.add_argument(
        "--egs-id-mode", default="auto",
        choices=["auto", "zero_based", "physical_line"],
        help="How numeric contrib ids address egs rows. Auto prefers NPZ utt-id matches, then zero-based ids.",
    )
    ap.add_argument("--json", default="", help="Optional JSON metadata with real sample names.")
    ap.add_argument("--output", default="contrib_sample_classification.html")
    ap.add_argument("--csv", default="", help="Output CSV path. Defaults to OUTPUT basename + .csv.")
    ap.add_argument(
        "--export-only", action="store_true",
        help="Skip the main CSV/HTML/BIN products and generate only --export products.",
    )
    ap.add_argument(
        "--export", nargs="+", default=[],
        choices=["xlsx", "json", "html", "sources", "category_csv", "all"],
        help="Optional extra products. Use --export all to generate every product.",
    )
    ap.add_argument(
        "--export-dir", default="",
        help="Extra product directory. Default: OUTPUT basename + _exports.",
    )
    ap.add_argument(
        "--export-category", nargs="+", default=["all"],
        choices=["all"] + CATEGORIES,
        help="Categories included in the extra JSON export. Default: all.",
    )
    ap.add_argument(
        "--source-script-formats", nargs="+", default=["sh"],
        choices=["txt", "sh", "bat"],
        help="Formats generated by --export sources. Default: sh.",
    )
    ap.add_argument("--min-model-coverage", type=float, default=0.5)
    ap.add_argument("--shard-size", type=int, default=1000, help=argparse.SUPPRESS)
    args = ap.parse_args()
    if args.export_only and not args.export:
        ap.error("--export-only requires --export")

    print("=" * 72, flush=True)
    print("[start] contrib sample classification", flush=True)
    print(f"[args] output={args.output}", flush=True)
    print(f"[args] min_model_coverage={args.min_model_coverage}", flush=True)

    specs = parse_model_specs(args)
    model_egs_specs = parse_model_egs_specs(args.model_egs)
    print(f"[args] models={len(specs)}", flush=True)
    for name, path in specs:
        print(f"  - {name}: {os.path.abspath(path)}", flush=True)

    print("[stage 1/7] loading JSON metadata and egs map", flush=True)
    meta, json_names, json_layout = load_json_name_map(args.json)
    if args.json and not json_names:
        raise SystemExit(
            "JSON contains no valid sample IDs. Expected ID/id/"
            "file_name/filename or file_path."
        )
    if args.json and json_layout.get("valid_record_count") != json_layout.get("record_count"):
        raise SystemExit(
            f"JSON has {json_layout.get('record_count', 0)} records but only "
            f"{json_layout.get('valid_record_count', 0)} valid sample IDs; refusing "
            "to silently drop real samples."
        )
    if args.json and json_layout.get("duplicate_name_count", 0):
        raise SystemExit(
            f"JSON has {json_layout['duplicate_name_count']} duplicate normalized real "
            f"sample name(s), examples={json_layout.get('duplicate_name_examples', [])}. "
            "Real sample names must be unique."
        )
    common_egs_map = load_egs_map(args.egs, json_names=json_names)

    print("[stage 2/7] loading contrib npz files", flush=True)
    models = []
    for idx, (name, path) in enumerate(specs, start=1):
        print(f"[model {idx}/{len(specs)}] begin {name}", flush=True)
        egs_map = model_specific_egs(common_egs_map, model_egs_specs, name, json_names)
        model = load_contrib_model(name, path, egs_map, egs_id_mode=args.egs_id_mode)
        if model:
            models.append(model)
        print(f"[model {idx}/{len(specs)}] done {name}", flush=True)
    if not models:
        raise SystemExit("No valid contrib model data loaded.")

    print("[stage 3/7] classifying aligned real samples", flush=True)
    t0 = time.time()
    rows = classify_samples(
        models,
        min_model_coverage=args.min_model_coverage,
        sample_universe=json_names,
    )
    print(f"[classify] {len(rows)} samples, {time.time() - t0:.1f}s")
    if json_names:
        model_groups = {sample for model in models for sample in model["sample_data"]}
        print(
            f"[align] JSON parity: JSON real samples={json_layout.get('record_count', 0)}, "
            f"unique names={len(json_names)}, classify rows={len(rows)}, "
            f"match={'yes' if len(rows) == json_layout.get('record_count', 0) else 'NO'}",
            flush=True,
        )
        print(
            f"[align] contrib coverage: matched_groups={len(json_names & model_groups)}, "
            f"missing_from_all_models={len(json_names - model_groups)}, "
            f"excluded_non_json_groups={len(model_groups - json_names)}",
            flush=True,
        )
    out_html = args.output
    out_csv = args.csv or os.path.splitext(out_html)[0] + ".csv"

    if args.export_only:
        print("[stage 4/7] skipped main CSV (--export-only)", flush=True)
        print("[stage 5/7] skipped main HTML/BIN (--export-only)", flush=True)
    else:
        print("[stage 4/7] writing CSV summary", flush=True)
        t0 = time.time()
        export_csv(out_csv, rows, models, meta)
        print(f"[csv] wrote {out_csv}, {time.time() - t0:.1f}s")

        print("[stage 5/7] writing HTML and one combined BIN file", flush=True)
        t0 = time.time()
        export_html_data(out_html, rows, models, meta, shard_size=args.shard_size)
        print(f"[html] wrote HTML + BIN for {out_html}, {time.time() - t0:.1f}s")

    print("[stage 6/7] writing optional extra products", flush=True)
    t0 = time.time()
    extra_outputs = run_extra_exports(args, rows, models, meta, out_html, json_layout)
    if extra_outputs:
        for path in extra_outputs:
            print(f"[export] {os.path.abspath(path)}", flush=True)
        print(f"[export] completed in {time.time() - t0:.1f}s", flush=True)
    else:
        print("[export] skipped; use --export all or select product types", flush=True)

    print("[stage 7/7] finished", flush=True)
    print("[done] samples:", len(rows))
    for cat in CATEGORIES:
        print(f"  {cat}: {sum(1 for r in rows if r['category'] == cat)}")
    if not args.export_only:
        print("[done] csv :", os.path.abspath(out_csv))
        print("[done] html:", os.path.abspath(out_html))
    else:
        print("[done] main CSV/HTML/BIN: skipped (--export-only)")
    print(f"[done] total: {time.time() - t_all:.1f}s")


if __name__ == "__main__":
    main()
