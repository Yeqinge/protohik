            "forget_events", "frac_neg_align", "mean_align", "self_influence",
            "influence_pct", "mean_weight", "weight_low_pct", "score",
        ):
            all_fields_set.add(f"{name}_{key}")
    all_fields = sorted(all_fields_set)
    preferred = [
        "sample_name", "category", "category_label", "reason", "models_present",
        "model_coverage", "wrong_rate", "high_loss_rate", "unstable_rate",
        "conflict_rate", "low_weight_rate", "mean_suspicious_score",
        "json_label", "file_path",
