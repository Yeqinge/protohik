# -*- coding: utf-8 -*-
"""
sample_tracker.py
逐样本贡献的「存储 + 聚合」。被 contrib_hook.py 调用，按 epoch 落盘，
训练结束聚成「一个样本一行」的 CSV。

逐 epoch 记录（每个样本每个 epoch 一条；缺的字段记为 NaN/未知）：
  grad_norm : ||dL/dX_i||   —— 真实的逐样本梯度范数（对损失模块输入的梯度）= 贡献大小/难易
  align     : cos(dL/dX_i, Σ_j dL/dX_j) —— 与本 batch 共识方向是否一致（负=有害嫌疑）
  loss      : 该样本的代理交叉熵（仅当能自动定位分类头时才有）
  correct   : 是否预测正确（同上，可选）

聚合（summarize -> CSV，一行一个样本）：
  mean_grad_norm / early_grad_norm / self_influence(Σ grad_norm^2) /
  mean_align / frac_neg_align / mean_loss / last_loss / forget_events /
  final_correct / tag（按全体样本分位数给的启发式标签）
"""

import os
import glob
import csv
import numpy as np


class SampleContributionTracker:
    def __init__(self, save_dir):
        self.save_dir = save_dir
        os.makedirs(save_dir, exist_ok=True)
        self._epoch = 0
        self._buf = {}

    def set_epoch(self, epoch):
        self._epoch = int(epoch)
        self._buf = {}

    def _ent(self, sid):
        return self._buf.setdefault(sid, {
            "gn": 0.0, "gn_n": 0, "al": 0.0, "al_n": 0,
            "loss": 0.0, "loss_n": 0, "correct": -1,
        })

    def update_grad(self, ids, grad_norm, align):
        """梯度路径：grad_norm/align 为长度 B 的 numpy 数组。"""
        for i, sid in enumerate(ids):
            e = self._ent(str(sid))
            e["gn"] += float(grad_norm[i]); e["gn_n"] += 1
            e["al"] += float(align[i]);     e["al_n"] += 1

    def update_pred(self, ids, loss, correct):
        """可选预测路径：loss/correct 为长度 B 的 numpy 数组。"""
        for i, sid in enumerate(ids):
            e = self._ent(str(sid))
            e["loss"] += float(loss[i]); e["loss_n"] += 1
            e["correct"] = int(bool(correct[i]))

    def save_epoch(self):
        ids = list(self._buf.keys())
        if not ids:
            return
        def col(f):
            return np.array([f(self._buf[i]) for i in ids], dtype=np.float32)
        np.savez(
            os.path.join(self.save_dir, f"contrib_epoch{self._epoch:03d}.npz"),
            ids=np.array(ids),
            grad_norm=col(lambda e: e["gn"] / e["gn_n"] if e["gn_n"] else np.nan),
            align=col(lambda e: e["al"] / e["al_n"] if e["al_n"] else np.nan),
            loss=col(lambda e: e["loss"] / e["loss_n"] if e["loss_n"] else np.nan),
            correct=np.array([self._buf[i]["correct"] for i in ids], dtype=np.int8),
        )

    # ---------- 训练结束后离线聚合 ----------
    @staticmethod
    def summarize(save_dir, out_csv):
        files = sorted(glob.glob(os.path.join(save_dir, "contrib_epoch*.npz")))
        if not files:
            raise FileNotFoundError(f"在 {save_dir} 没找到 contrib_epoch*.npz")

        traj = {}  # sid -> list[(epoch, gn, al, loss, correct)]
        for f in files:
            ep = int(os.path.basename(f)[len("contrib_epoch"):-len(".npz")])
            d = np.load(f, allow_pickle=True)
            for k in range(len(d["ids"])):
                sid = str(d["ids"][k])
                traj.setdefault(sid, []).append(
                    (ep, float(d["grad_norm"][k]), float(d["align"][k]),
                     float(d["loss"][k]), int(d["correct"][k])))

        rows = []
        for sid, recs in traj.items():
            recs.sort(key=lambda x: x[0])
            gn = np.array([r[1] for r in recs]); al = np.array([r[2] for r in recs])
            ls = np.array([r[3] for r in recs]); co = [r[4] for r in recs]
            co_known = [c for c in co if c in (0, 1)]

            forget = sum(1 for a, b in zip(co[:-1], co[1:])
                         if a == 1 and b == 0)
            row = {
                "id": sid,
                "n_epochs": len(recs),
                "mean_grad_norm": _nanmean(gn),
                "early_grad_norm": float(gn[0]) if len(gn) else np.nan,
                "self_influence": float(np.nansum(gn ** 2)),
                "mean_align": _nanmean(al),
                "frac_neg_align": _frac(al < 0, al),
                "mean_loss": _nanmean(ls),
                "last_loss": float(ls[-1]) if len(ls) else np.nan,
                "forget_events": int(forget),
                "final_correct": (co_known[-1] if co_known else -1),
            }
            rows.append(row)

        # 用全体样本的分位数定阈值，比绝对阈值稳
        inf = np.array([r["self_influence"] for r in rows])
        alm = np.array([r["mean_align"] for r in rows])
        hi_inf = np.nanpercentile(inf, 90) if len(inf) else np.inf
        lo_aln = np.nanpercentile(alm, 10) if np.any(~np.isnan(alm)) else -np.inf
        for r in rows:
            r["tag"] = SampleContributionTracker._tag(r, hi_inf, lo_aln)

        rows.sort(key=lambda r: r["self_influence"], reverse=True)
        fields = ["id", "tag", "n_epochs", "mean_grad_norm", "early_grad_norm",
                  "self_influence", "mean_align", "frac_neg_align",
                  "mean_loss", "last_loss", "forget_events", "final_correct"]
        with open(out_csv, "w", newline="") as fh:
            w = csv.DictWriter(fh, fieldnames=fields)
            w.writeheader()
            for r in rows:
                w.writerow({k: r[k] for k in fields})
        print(f"[contrib] 已写出 {len(rows)} 个样本 -> {out_csv}")
        return out_csv

    @staticmethod
    def _tag(r, hi_inf, lo_aln):
        ma = r["mean_align"]
        # 方向常与共识相反（且末期没学会，若已知）-> 有害/可能标错
        if not np.isnan(ma) and ma < 0 and ma <= lo_aln:
            if r["final_correct"] == 0 or r["final_correct"] == -1:
                return "harmful_suspect"
        if r["forget_events"] >= 2 or r["final_correct"] == 0:
            return "hard"
        if r["self_influence"] >= hi_inf:
            return "high_influence"      # 模型从中学得最多（多为关键难样本）
        if (not np.isnan(r["mean_loss"]) and r["mean_loss"] < 1e-2
                and r["forget_events"] == 0):
            return "easy_redundant"
        return "normal"


def _nanmean(a):
    a = a[~np.isnan(a)]
    return float(a.mean()) if a.size else np.nan


def _frac(mask, ref):
    valid = ~np.isnan(ref)
    n = int(valid.sum())
    return float((mask & valid).sum() / n) if n else np.nan
