class GMMPrototypeLoss(TopVirtualLoss):
    def init(
            self,
            input_dim,
            num_targets,
            temperature=0.1,
            confidence_alpha=1.5):
        
        # =====================================================
        # Prototype
        # =====================================================
        self.prototypes = nn.Parameter(torch.randn(num_targets, input_dim))
        nn.init.xavier_uniform_(self.prototypes)

        self.temperature = temperature
        self.loss_function = nn.CrossEntropyLoss(reduction='none')
        
        # =====================================================
        # GMM 参数
        # =====================================================
        self.confidence_alpha = confidence_alpha
        self.gmm = None
        self.clean_mean = None
        self.noisy_mean = None
        
        # ====================== 与外部 trainer 对齐 ======================
        self.current_epoch = 0          # 由 trainer 外部通过 step() 赋值
        self._last_printed_epoch = -1
        self.epoch_losses = []

        # ====================== 供 contrib_hook 采集 ======================
        self.per_sample_loss = None
        self.confidence = None
        self.weight = None
        self._last_focal_weight = None

    # =====================================================
    # Forward
    # =====================================================
    def forward(self, inputs, targets):
        assert len(inputs.shape) == 3 and inputs.shape[2] == 1
        features = torch.squeeze(inputs, dim=2)

        # Normalize
        features_norm = F.normalize(features, dim=1)
        prototypes_norm = F.normalize(self.prototypes, dim=1)

        # Prototype logits
        logits = torch.mm(features_norm, prototypes_norm.t()) / self.temperature
        self.posterior = logits.unsqueeze(2).detach()

        # Per-sample loss
        per_sample_loss = self.loss_function(logits, targets)
        
        # 保存给 contrib_hook
        self.per_sample_loss = per_sample_loss.detach()

        # 保存用于本 epoch GMM 拟合
        self.epoch_losses.append(per_sample_loss.detach().cpu())

        # =====================================================
        # GMM Confidence Weighting
        # =====================================================
        if self.gmm is not None:
            loss_np = per_sample_loss.detach().cpu().numpy().reshape(-1, 1)
            probs = self.gmm.predict_proba(loss_np)
            clean_idx = np.argmin(self.gmm.means_.flatten())
            
            confidence = torch.tensor(
                probs[:, clean_idx],
                dtype=torch.float32,
                device=per_sample_loss.device
            )
            
            weight = confidence ** self.confidence_alpha
            weight = weight / (weight.mean() + 1e-8)

            # 保存给 contrib_hook
            self.confidence = confidence
            self.weight = weight
            self._last_focal_weight = weight

            final_loss = (weight * per_sample_loss).mean()
            conf_mean = confidence.mean().item()
        else:
            final_loss = per_sample_loss.mean()
            self.confidence = None
            self.weight = None
            self._last_focal_weight = None
            conf_mean = 1.0

        # =====================================================
        # Log
        # =====================================================
        self._maybe_print(final_loss, conf_mean)
        
        return final_loss

    def _maybe_print(self, final_loss, conf_mean):
        """避免同一 epoch 重复打印"""
        if self.current_epoch == self._last_printed_epoch:
            return
        self._last_printed_epoch = self.current_epoch
        print(
            f"[ProtoLoss] Epoch={self.current_epoch} "
            f"| Loss={final_loss.item():.4f} "
            f"| Conf={conf_mean:.4f}"
        )

    # =====================================================
    # Epoch End（由 trainer 调用）
    # =====================================================
    def step(self, *args, **kwargs):
        """外部 trainer 每个 epoch 结束时调用"""
        # current_epoch 应该在 trainer 中被更新，这里也可以接受外部传入
        if 'epoch' in kwargs:
            self.current_epoch = kwargs['epoch']
        else:
            self.current_epoch += 1

        if len(self.epoch_losses) == 0:
            return

        all_losses = torch.cat(self.epoch_losses, dim=0)
        losses_np = all_losses.numpy().reshape(-1, 1)

        try:
            gmm = GaussianMixture(
                n_components=2,
                covariance_type='full',
                random_state=42,
                max_iter=200
            )
            gmm.fit(losses_np)
            
            means = gmm.means_.flatten()
            clean_idx = np.argmin(means)
            
            self.clean_mean = means[clean_idx]
            self.noisy_mean = means[1 - clean_idx]
            self.gmm = gmm

            probs = gmm.predict_proba(losses_np)
            clean_prob = probs[:, clean_idx]

            print(
                f"\n[GMM Update] Epoch={self.current_epoch}\n"
                f"Clean Mean = {self.clean_mean:.4f}\n"
                f"Noisy Mean = {self.noisy_mean:.4f}\n"
                f"Mean Confidence = {clean_prob.mean():.4f}\n"
            )
        except Exception as e:
            print(f"GMM Failed: {e}")

        # 清空缓存
        self.epoch_losses = []
