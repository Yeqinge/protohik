LOSS_REGISTRY: dict = {}

def _build_loss_registry():
    """延迟注册，避免模块顶层循环导入。"""
    if LOSS_REGISTRY:
        return  # 已注册，跳过
    LOSS_REGISTRY.update({
        "softmax":        SoftmaxLoss,
        "margin":         MarginSoftmaxLoss,
        "oc":             OCSoftmaxLoss,
        "proto":          PrototypeLoss,
        "proto1":         PrototypeLoss1,
        "proto_enhanced": PrototypeLossEnhanced,
        "proto_multi":    PrototypeLossMulti,
        "proto_uni":      PrototypeLossUni,
    })


