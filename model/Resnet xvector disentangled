        print(f"{'='*55}")
        # ── 训练接口（与原版完全相同）──
        out  = model(inputs, targets)
        loss = model.get_loss(out, targets)
        print(f"  forward 输出 shape : {out.shape}")
        print(f"  get_loss 输出      : {loss.item():.4f}  (Tensor, 标量)")
        # ── 推理接口 ──
        model.eval()
        with torch.no_grad():
            emb = model.extract_embedding(inputs[:1])
        print(f"  extract_embedding  : {emb.shape}")
