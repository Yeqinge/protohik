class OrthogonalLoss(nn.Module):
    """正交性约束：令 z_spk 与 z_nui 的余弦相关性趋近 0。"""
    def forward(self, z_spk, z_nui):
        # 统一到 2D [B, D]
        if z_spk.dim() == 3:
            z_spk = z_spk.squeeze(-1)
        if z_nui.dim() == 3:
            z_nui = z_nui.squeeze(-1)
        # 维度不同时取最小维度做截断对齐
        d = min(z_spk.shape[1], z_nui.shape[1])
        z_s = F.normalize(z_spk[:, :d], dim=1)
        z_n = F.normalize(z_nui[:, :d], dim=1)
        return (z_s * z_n).sum(dim=1).pow(2).mean()


class GradientReversalLayer(torch.autograd.Function):
    """梯度反转层：前向不变，反向梯度乘以 -alpha。"""
    @staticmethod
    def forward(ctx, x, alpha):
        ctx.alpha = alpha
        return x.clone()

    @staticmethod
    def backward(ctx, grad):
        return -ctx.alpha * grad, None


class AdversarialClassifier(nn.Module):
    """对抗分类器：通过 GRL 阻止子空间学到不该学的信息。"""
    def __init__(self, in_dim, num_classes, hidden_dim=256):
        super().__init__()
        self.net = nn.Sequential(
            nn.Linear(in_dim, hidden_dim),
            nn.ReLU(inplace=True),
            nn.Linear(hidden_dim, num_classes),
        )

    def forward(self, x, alpha=1.0):
        if x.dim() == 3:
            x = x.squeeze(-1)
        x = GradientReversalLayer.apply(x, alpha)
        return self.net(x)


class CLUBEstimator(nn.Module):
    """
    CLUB 互信息上界估计器（Cheng et al., 2020）。
    最小化 z_spk 与 z_nui 之间的互信息。
    """
    def __init__(self, x_dim, y_dim, hidden_dim=256):
        super().__init__()
        self.mu_net = nn.Sequential(
            nn.Linear(x_dim, hidden_dim), nn.ReLU(inplace=True),
            nn.Linear(hidden_dim, y_dim),
        )
        self.lv_net = nn.Sequential(
            nn.Linear(x_dim, hidden_dim), nn.ReLU(inplace=True),
            nn.Linear(hidden_dim, y_dim), nn.Tanh(),  # 限制范围
        )

    def forward(self, x, y):
        if x.dim() == 3:
            x = x.squeeze(-1)
        if y.dim() == 3:
            y = y.squeeze(-1)
        mu  = self.mu_net(x)
        lv  = self.lv_net(x)
        pos = -0.5 * (((y - mu) ** 2) / lv.exp() + lv).sum(1)
        neg = -0.5 * (((y[torch.randperm(y.size(0))] - mu) ** 2) / lv.exp() + lv).sum(1)
        return (pos - neg).mean()


class DisentangledEncoder(nn.Module):
    """
    VAE 风格解耦编码器（use_vae=True 时替换双头 FC）。
    训练时对潜变量重参数化采样；推理时直接使用均值。
    """
    def __init__(self, in_dim, spk_dim, nui_dim):
        super().__init__()
        self.spk_mu  = nn.Linear(in_dim, spk_dim)
        self.spk_lv  = nn.Linear(in_dim, spk_dim)
        self.nui_mu  = nn.Linear(in_dim, nui_dim)
        self.nui_lv  = nn.Linear(in_dim, nui_dim)

    @staticmethod
    def _reparam(mu, lv):
        return mu + torch.randn_like(mu) * (0.5 * lv).exp()

    @staticmethod
    def _kl(mu, lv):
        return -0.5 * (1 + lv - mu.pow(2) - lv.exp()).sum(1).mean()

    def forward(self, x, training=True):
        if x.dim() == 3:
            x = x.squeeze(-1)
        sm, sl = self.spk_mu(x), self.spk_lv(x)
        nm, nl = self.nui_mu(x), self.nui_lv(x)
        z_spk = self._reparam(sm, sl) if training else sm
        z_nui = self._reparam(nm, nl) if training else nm
        return z_spk, z_nui, self._kl(sm, sl), self._kl(nm, nl)


class AttentiveStatsPool(nn.Module):
    """
    注意力统计池化：输出均值与加权标准差的拼接，维度翻倍。
    输入 [B, C, T] → 输出 [B, 2C]
    """
    def __init__(self, in_dim, bottleneck_dim=128):
        super().__init__()
        self.attn = nn.Sequential(
            nn.Conv1d(in_dim, bottleneck_dim, 1),
            nn.Tanh(),
            nn.Conv1d(bottleneck_dim, in_dim, 1),
            nn.Softmax(dim=2),
        )

    def forward(self, x):
        w  = self.attn(x)
        mu = (x * w).sum(2)
        sg = ((w * (x - mu.unsqueeze(2)).pow(2)).sum(2).clamp(min=1e-5)).sqrt()
        return torch.cat([mu, sg], dim=1)


