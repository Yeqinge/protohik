#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
compare_models.py

把多个模型在【同一条样本】上的表现并排放在一起，用来回答：
  - 哪些样本模型判得不好？
  - 这些样本换别的模型有救吗？
  - 到底是数据问题还是模型问题？

诊断逻辑（按每条样本所有模型的对错）：
  all_correct : 所有模型都判对
  all_wrong   : 所有模型都判错      -> 偏【数据问题】(标注/录音/难样本, 换模型也救不回来)
  disagree    : 模型之间有分歧       -> 偏【模型问题】(有模型学会了, 说明信息是可学的)

输出:
  1) xlsx : 每个数据集一个 sheet + summary, all_wrong 标红 / disagree 标黄
  2) html : 单文件离线看板(暗色), 可搜索/筛选/排序, 浏览器直接打开

依赖: pandas, openpyxl   (没有就 pip install pandas openpyxl)
用法: 改 CONFIG 区, 然后  python3 compare_models.py
      也可用环境变量覆盖, 例:
      CMP_MODELS=26051101,26051102 CMP_THRESHOLD=0.6 python3 compare_models.py
"""

import os
import sys
import json
import html
import pandas as pd
from openpyxl.styles import PatternFill, Font

# ===================== CONFIG =====================
BASE = os.environ.get("CMP_BASE",
    "Archive/FiberArchive/codes/ModelTraining/"
    "subtools-resnet-v1.0.0/model_exp/fbank_20k_test5/fiber_train")
EPOCH = int(os.environ.get("CMP_EPOCH", "10"))

# 要对比的模型(train_conf)。留空则自动扫描 BASE 下所有模型目录。
MODELS = [m for m in os.environ.get("CMP_MODELS", "").split(",") if m] or []
# 例: MODELS = ["26051101", "26051102", "26051103"]

# 要对比的数据集(训练/测试都可放)。留空则自动用第一个模型下的全部数据集。
DATASETS = [d for d in os.environ.get("CMP_DATASETS", "").split(",") if d] or []
# 例: DATASETS = ["gujinggongjiu_fa_test_20k_sweeper", "qdhnc_fa_test_20k"]

# 判 abnormal 的阈值。CSV 自带预测用 0.5；想用 0.6 改这里。
THRESHOLD = float(os.environ.get("CMP_THRESHOLD", "0.5"))

OUTPUT_XLSX = os.environ.get("CMP_OUT_XLSX", "model_comparison.xlsx")
OUTPUT_HTML = os.environ.get("CMP_OUT_HTML", "model_comparison.html")
# ==================================================


def detailed_csv_path(model, dataset):
    return os.path.join(BASE, model, f"near_epoch_{EPOCH}",
                        dataset, "score", "eval_results", "detailed_results.csv")


def auto_discover():
    global MODELS, DATASETS
    if not MODELS:
        if not os.path.isdir(BASE):
            sys.exit(f"[错误] BASE 不存在: {BASE}")
        MODELS = sorted(d for d in os.listdir(BASE)
                        if os.path.isdir(os.path.join(BASE, d)))
        print(f"[auto] 模型: {MODELS}")
    if not DATASETS:
        ne = os.path.join(BASE, MODELS[0], f"near_epoch_{EPOCH}")
        if not os.path.isdir(ne):
            sys.exit(f"[错误] 找不到 {ne}, 检查 EPOCH / 模型名")
        DATASETS = sorted(d for d in os.listdir(ne)
                          if os.path.isfile(detailed_csv_path(MODELS[0], d)))
        print(f"[auto] 数据集: {DATASETS}")


def load_one(model, dataset):
    path = detailed_csv_path(model, dataset)
    if not os.path.isfile(path):
        print(f"[skip] 找不到: {path}")
        return None
    df = pd.read_csv(path)
    df = df.rename(columns={
        "Filename": "filename", "Score": "score",
        "True Label": "true_label", "Detector ID": "detector"})
    missing = {"filename", "score", "true_label"} - set(df.columns)
    if missing:
        print(f"[skip] {path} 缺列 {missing}, 实际列={list(df.columns)}")
        return None
    if "detector" not in df.columns:
        df["detector"] = ""
    df["pred"] = df["score"].apply(lambda s: "abnormal" if s >= THRESHOLD else "normal")
    df["correct"] = (df["pred"].str.lower() == df["true_label"].str.lower())
    return df[["filename", "detector", "true_label", "score", "pred", "correct"]]


def build_dataset(dataset):
    merged, present = None, []
    for model in MODELS:
        df = load_one(model, dataset)
        if df is None:
            continue
        present.append(model)
        sub = df.rename(columns={
            "score": f"{model}__score", "pred": f"{model}__pred",
            "correct": f"{model}__correct"})
        if merged is None:
            merged = sub
        else:
            merged = merged.merge(sub.drop(columns=["true_label"]),
                                  on=["filename", "detector"], how="outer")
    if merged is None:
        return None, present

    cc = [f"{m}__correct" for m in present]

    def diagnose(row):
        vals = [row[c] for c in cc if pd.notna(row[c])]
        if not vals:
            return "no_data"
        if all(vals):
            return "all_correct"
        if not any(vals):
            return "all_wrong"
        return "disagree"

    merged["diagnosis"] = merged.apply(diagnose, axis=1)
    order = {"all_wrong": 0, "disagree": 1, "all_correct": 2, "no_data": 3}
    merged["_o"] = merged["diagnosis"].map(order)
    merged = merged.sort_values(["_o", "detector", "filename"]).drop(columns="_o")
    front = ["filename", "detector", "true_label", "diagnosis"]
    rest = [c for c in merged.columns if c not in front]
    return merged[front + rest], present


# ---------------- xlsx ----------------
def safe_sheet_name(name, used):
    name = name[:31]
    base, i = name, 1
    while name in used:
        sfx = f"_{i}"
        name = base[:31 - len(sfx)] + sfx
        i += 1
    used.add(name)
    return name


def write_xlsx(built, summary_rows):
    RED = PatternFill("solid", fgColor="FFC7CE")
    YEL = PatternFill("solid", fgColor="FFEB9C")
    HEAD = PatternFill("solid", fgColor="305496")
    HFONT = Font(color="FFFFFF", bold=True)
    used = set()
    with pd.ExcelWriter(OUTPUT_XLSX, engine="openpyxl") as w:
        for dataset, (df, present) in built.items():
            sheet = safe_sheet_name(dataset, used)
            df.to_excel(w, sheet_name=sheet, index=False)
            ws = w.sheets[sheet]
            dcol = list(df.columns).index("diagnosis") + 1
            for r in range(2, len(df) + 2):
                v = ws.cell(row=r, column=dcol).value
                fill = RED if v == "all_wrong" else (YEL if v == "disagree" else None)
                if fill:
                    for c in range(1, len(df.columns) + 1):
                        ws.cell(row=r, column=c).fill = fill
            for c in range(1, len(df.columns) + 1):
                ws.cell(row=1, column=c).fill = HEAD
                ws.cell(row=1, column=c).font = HFONT
        sm = pd.DataFrame(summary_rows)
        sm.to_excel(w, sheet_name="summary", index=False)
        ws = w.sheets["summary"]
        for c in range(1, len(sm.columns) + 1):
            ws.cell(row=1, column=c).fill = HEAD
            ws.cell(row=1, column=c).font = HFONT
    print(f"[done] xlsx -> {OUTPUT_XLSX}")


