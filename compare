def write_html(built, summary_rows):
    datasets = {}
    for name, (df, present) in built.items():
        recs = []
        for _, row in df.iterrows():
            rec = {
                "filename": str(row["filename"]),
                "detector": "" if pd.isna(row["detector"]) else str(row["detector"]),
                "true_label": str(row["true_label"]),
                "diagnosis": str(row["diagnosis"]),
            }
            for m in MODELS:
                sc = row.get(f"{m}__score")
                pr = row.get(f"{m}__pred")
                co = row.get(f"{m}__correct")
                rec[f"{m}__score"] = None if pd.isna(sc) else round(float(sc), 6)
                rec[f"{m}__pred"] = None if pd.isna(pr) else str(pr)
                rec[f"{m}__correct"] = None if pd.isna(co) else bool(co)
            recs.append(rec)
        datasets[name] = {"rows": recs}

    data = {
        "epoch": EPOCH, "threshold": THRESHOLD, "models": MODELS,
        "summary": summary_rows, "datasets": datasets,
    }
    payload = json.dumps(data, ensure_ascii=False)
    out = HTML_TEMPLATE.replace("/*__DATA__*/", payload)
    with open(OUTPUT_HTML, "w", encoding="utf-8") as f:
        f.write(out)
    print(f"[done] html -> {OUTPUT_HTML}")


def main():
    auto_discover()
    built, summary_rows = {}, []
    for dataset in DATASETS:
        df, present = build_dataset(dataset)
        if df is None:
            continue
        built[dataset] = (df, present)
        row = {"dataset": dataset, "n_samples": int(len(df))}
        for m in MODELS:
            cc = f"{m}__correct"
            if cc in df:
                acc = df[cc].mean(skipna=True)
                row[f"{m}_acc"] = None if pd.isna(acc) else round(float(acc), 4)
            else:
                row[f"{m}_acc"] = None
        row["all_wrong"] = int((df["diagnosis"] == "all_wrong").sum())
        row["disagree"] = int((df["diagnosis"] == "disagree").sum())
        summary_rows.append(row)

    if not built:
        sys.exit("[错误] 没读到任何 detailed_results.csv, 检查 BASE / EPOCH / 名称")

    write_xlsx(built, summary_rows)
    write_html(built, summary_rows)
