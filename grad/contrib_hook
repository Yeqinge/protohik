# -*- coding: utf-8 -*-
"""
contrib_hook.py
Per-sample contribution tracing for loss modules such as GMMPrototypeLoss.
"""
import inspect
import os
import hashlib
from collections import deque

import torch
import torch.nn.functional as F

from sample_tracker import SampleContributionTracker

_ACTIVE = None


def _to_2d(t):
    if t.dim() == 2:
        return t
    if t.dim() == 3:
        return t.mean(dim=-1) if t.shape[-1] > 1 else t[..., 0]
    return t.reshape(t.shape[0], -1)


def _hash_ids(feats):
    feats = feats.detach().to("cpu").contiguous()
    return [
        hashlib.blake2b(feats[i].numpy().tobytes(), digest_size=8).hexdigest()
        for i in range(feats.shape[0])
    ]


def _split_targets(batch):
    if isinstance(batch, dict):
        for k in ("label", "labels", "target", "targets", "y"):
            if k in batch:
                return batch[k], batch.get("feat", batch.get("feats"))
        return None, None
    if isinstance(batch, (list, tuple)):
        feats = batch[0]
        return (batch[1] if len(batch) > 1 else None), feats
    return None, batch


def _find_loss_module(model):
    for name, mod in model.named_modules():
        if "GMMPrototypeLoss" in type(mod).__name__:
            return name, mod

    keys = ("loss", "softmax", "margin", "proto", "aam", "arc", "gmm")
    for name, mod in model.named_modules():
        mod_name = type(mod).__name__.lower()
        if any(k in mod_name for k in keys):
            return name, mod
    return None, None


def _get_dataloader_with_sampler(loader, max_depth=10):
    current = loader
    visited = set()
    depth = 0

    while depth < max_depth:
        if id(current) in visited:
            break
        visited.add(id(current))

        if getattr(current, "batch_sampler", None) is not None:
            return current

        for attr in (
            "loader", "_loader", "dataloader", "_dataloader", "dl", "_dl",
            "train_loader", "train_dataloader", "data_loader", "inner_loader",
        ):
            inner = getattr(current, attr, None)
            if inner is not None and inner is not current:
                current = inner
                break
        else:
            break
        depth += 1

    if getattr(current, "batch_sampler", None) is not None:
        return current
    return None


def _iter_tensors(obj):
    if torch.is_tensor(obj):
        yield obj
    elif isinstance(obj, dict):
        for v in obj.values():
            yield from _iter_tensors(v)
    elif isinstance(obj, (list, tuple)):
        for v in obj:
            yield from _iter_tensors(v)


def _as_1d_long(targets):
    if targets is None:
        return None
    if not torch.is_tensor(targets):
        try:
            targets = torch.as_tensor(targets)
        except Exception:
            return None
    return targets.detach().view(-1).long()


def _detach_numpy(t):
    if t is None:
        return None
    if torch.is_tensor(t):
        return t.detach().cpu().numpy()
    return t


def _is_batch_vector(t, batch_size):
    return (
        torch.is_tensor(t)
        and t.dim() >= 1
        and t.shape[0] == batch_size
        and t.numel() >= batch_size
    )


def _find_vector(source, batch_size, names=()):
    for name in names:
        candidate = getattr(source, name, None)
        if _is_batch_vector(candidate, batch_size):
            return candidate.reshape(batch_size, -1).mean(dim=1)
    return None


def _find_extra_metrics(module, batch_size):
    """Read opt-in diagnostic vectors exposed by evidence/prototype losses."""
    aliases = {
        "uncertainty": ("uncertainty", "_last_uncertainty"),
        "dirichlet_strength": ("dirichlet_strength", "strength"),
        "total_evidence": ("total_evidence",),
        "target_evidence": ("target_evidence",),
        "target_probability": ("target_probability", "target_prob"),
        "target_distance": ("target_distance",),
        "distance_margin": ("distance_margin",),
        "classification_loss": ("classification_loss",),
        "focal_component": ("focal_component",),
        "uncertainty_sample_weight": ("uncertainty_sample_weight",),
        "sample_weight": ("sample_weight",),
    }
    found = {}
    for key, names in aliases.items():
        value = _find_vector(module, batch_size, names=names)
        if value is not None:
            found[key] = _detach_numpy(value)
    return found


def _find_logits(module, args, output, batch_size, num_targets):
    attr_names = (
        "logits", "score", "scores", "output", "outputs", "pred", "preds",
        "prediction", "predictions", "_last_logits", "last_logits",
        "_last_scores", "last_scores", "posterior", "_last_posterior",
        "cosine", "cos_theta",
    )
    for name in attr_names:
        candidate = getattr(module, name, None)
        if torch.is_tensor(candidate) and candidate.dim() >= 2 and candidate.shape[0] == batch_size:
            candidate_2d = _to_2d(candidate)
            if num_targets is None or candidate_2d.shape[1] == num_targets:
                return candidate_2d

    for t in list(_iter_tensors(output)) + list(_iter_tensors(args)):
        if t.dim() >= 2 and t.shape[0] == batch_size:
            t2 = _to_2d(t)
            if num_targets is None or t2.shape[1] == num_targets:
                return t2

    get_posterior = getattr(module, "get_posterior", None)
    if callable(get_posterior):
        try:
            posterior = get_posterior()
            if torch.is_tensor(posterior) and posterior.dim() >= 2 and posterior.shape[0] == batch_size:
                posterior = _to_2d(posterior)
                if num_targets is None or posterior.shape[1] == num_targets:
                    return posterior
        except Exception:
            pass
    return None


def _find_per_sample_loss(module, args, output, batch_size, targets, logits):
    loss = _find_vector(
        module,
        batch_size,
        names=(
            "weighted_per_sample_loss", "_weighted_per_sample_loss",
            "per_sample_loss", "_per_sample_loss", "sample_loss", "sample_losses",
            "loss_per_sample",
            "losses", "_last_loss", "_last_losses",
            "ce_loss", "ce_losses", "_last_ce_loss", "nll", "nll_loss",
        ),
    )
    if loss is not None:
        return loss

    for t in _iter_tensors(output):
        if _is_batch_vector(t, batch_size):
            return t.reshape(batch_size, -1).mean(dim=1)

    target_vec = _as_1d_long(targets)
    if logits is not None and target_vec is not None and target_vec.numel() == batch_size:
        try:
            logits_f = logits.float()
            if logits_f.min().item() >= 0 and torch.allclose(
                logits_f.sum(dim=1),
                torch.ones(batch_size, device=logits_f.device),
                rtol=1e-3,
                atol=1e-4,
            ):
                idx = target_vec.to(logits_f.device).view(-1, 1)
                return -torch.log(torch.gather(logits_f.clamp_min(1e-12), 1, idx).squeeze(1))
            return F.cross_entropy(logits_f, target_vec.to(logits.device), reduction="none")
        except Exception:
            return None
    return None


def _safe_call(obj, method_names, *args):
    for name in method_names:
        method = getattr(obj, name, None)
        if method is None:
            continue
        try:
            method(*args)
            return True
        except TypeError:
            # Some trackers accept fewer arguments; trim from the right.
            try:
                sig = inspect.signature(method)
                max_args = len([
                    p for p in sig.parameters.values()
                    if p.kind in (p.POSITIONAL_ONLY, p.POSITIONAL_OR_KEYWORD)
                    and p.default is p.empty
                ])
                method(*args[:max_args])
                return True
            except Exception:
                continue
        except Exception:
            continue
    return False


class _RecordingBatchSampler:
    def __init__(self, bs, sink):
        self._bs = bs
        self._sink = sink

    def __iter__(self):
        for idxs in self._bs:
            self._sink.append(list(idxs))
            yield idxs

    def __len__(self):
        return len(self._bs)

    def __getattr__(self, item):
        return getattr(self._bs, item)


class _Instrumenter:
    def __init__(self, model, num_targets, save_dir, id_source, egs_file=None):
        self.model = model
        self.num_targets = num_targets
        self.tracker = SampleContributionTracker(save_dir, egs_file=egs_file)
        self.save_dir = save_dir
        self.id_source = id_source
        self._stash = None
        self._idx_queue = deque()
        self._hooks = []
        self.real_ids = False
        self._warned_missing_loss = False
        self._warned_missing_pred = False
        self._batches_seen = 0
        self._loss_batches = 0
        self._pred_batches = 0
        self._weight_batches = 0
        self._grad_batches = 0
        self._heartbeat_interval = int(os.environ.get("CONTRIB_PRINT_EVERY", "200"))

    def resolve_ids(self, idxs):
        src = self.id_source
        if src is None:
            return [str(i) for i in idxs]
        if callable(src):
            return [str(src(i)) for i in idxs]
        return [str(src[i]) for i in idxs]

    def stash(self, ids, targets):
        self._stash = (ids, targets)

    def _loss_pre_hook(self, module, args):
        if not self.model.training or self._stash is None:
            return
        X = None
        for a in args:
            if torch.is_tensor(a) and a.is_floating_point() and a.dim() >= 2 and a.requires_grad:
                X = a
                break
        if X is None:
            return

        ids = list(self._stash[0])
        holder = {}

        def _grad_cb(grad):
            try:
                g = grad.detach().reshape(grad.shape[0], -1).float()
                gn = g.norm(dim=1)
                al = F.cosine_similarity(g, g.sum(0, keepdim=True).expand_as(g), dim=1)
                if len(ids) == gn.shape[0]:
                    self.tracker.update_grad(ids, gn.cpu().numpy(), al.cpu().numpy())
                    self._grad_batches += 1
            finally:
                if "h" in holder:
                    holder["h"].remove()

        holder["h"] = X.register_hook(_grad_cb)

    def _loss_post_hook(self, module, args, output):
        if not self.model.training or self._stash is None:
            return

        ids = list(self._stash[0] or [])
        targets = self._stash[1]
        if not ids:
            return
        batch_size = len(ids)

        logits = _find_logits(module, args, output, batch_size, self.num_targets)
        per_sample_loss = _find_per_sample_loss(module, args, output, batch_size, targets, logits)
        self._batches_seen += 1

        if per_sample_loss is not None:
            loss_np = _detach_numpy(per_sample_loss)
            updated = _safe_call(
                self.tracker,
                ("update_loss", "update_losses", "update_sample_loss"),
                ids,
                loss_np,
                targets,
            )
            if not updated and not self._warned_missing_loss:
                print("[contrib] warning: tracker has no loss update method")
                self._warned_missing_loss = True
            elif updated:
                self._loss_batches += 1
        elif not self._warned_missing_loss:
            print("[contrib] warning: cannot find per-sample loss; loss will stay NaN")
            self._warned_missing_loss = True

        if logits is not None:
            pred_payload = _detach_numpy(logits)
            updated = _safe_call(
                self.tracker,
                ("update_logits", "update_pred", "update_preds", "update_prediction", "update_predictions"),
                ids,
                pred_payload,
                targets,
            )
            if not updated and not self._warned_missing_pred:
                print("[contrib] warning: tracker has no prediction update method")
                self._warned_missing_pred = True
            elif updated:
                self._pred_batches += 1
        elif not self._warned_missing_pred:
            print("[contrib] warning: cannot find logits/predictions; forget/final will not update")
            self._warned_missing_pred = True

        weight = _find_vector(
            module,
            batch_size,
            names=(
                "_last_focal_weight", "focal_weight", "sample_weight",
                "sample_weights", "weight", "weights", "confidence",
                "conf", "_last_confidence",
            ),
        )
        if weight is not None:
            _safe_call(
                self.tracker,
                ("update_weight", "update_weights", "update_confidence"),
                ids,
                _detach_numpy(weight),
            )
            self._weight_batches += 1

        metrics = _find_extra_metrics(module, batch_size)
        if metrics:
            _safe_call(self.tracker, ("update_metrics",), ids, metrics)

        if self._should_print_progress():
            print(
                "[contrib] collecting: "
                f"batches={self._batches_seen}, "
                f"loss={self._loss_batches}, pred={self._pred_batches}, "
                f"grad={self._grad_batches}, weight={self._weight_batches}, "
                f"batch_size={batch_size}"
            )

    def _should_print_progress(self):
        if self._batches_seen == 1:
            return True
        return self._heartbeat_interval > 0 and self._batches_seen % self._heartbeat_interval == 0

    def attach_model(self):
        lname, lmod = _find_loss_module(self.model)
        if lmod is None:
            print("[contrib] warning: loss module not found")
            return

        self._hooks.append(lmod.register_forward_pre_hook(self._loss_pre_hook))
        self._hooks.append(lmod.register_forward_hook(self._loss_post_hook))
        print(f"[contrib] attached loss module: {lname} ({type(lmod).__name__})")

    def attach_real_ids(self, loader):
        dl = _get_dataloader_with_sampler(loader)
        if dl is None:
            print("[contrib] warning: valid DataLoader not found; fallback to feature hashes")
            return False

        wrapped = _RecordingBatchSampler(dl.batch_sampler, self._idx_queue)
        try:
            object.__setattr__(dl, "batch_sampler", wrapped)
        except Exception:
            dl.__dict__["batch_sampler"] = wrapped

        if "_index_sampler" in dl.__dict__:
            dl.__dict__["_index_sampler"] = wrapped

        self.real_ids = True
        print("[contrib] real sample ids enabled")
        return True

    def finalize(self, out_csv=None):
        self.tracker.save_epoch()
        for h in self._hooks:
            h.remove()
        out_csv = out_csv or os.path.join(self.save_dir, "contrib_summary.csv")
        return SampleContributionTracker.summarize(self.save_dir, out_csv)


class _LoaderWrapper:
    def __init__(self, loader, inst, start_epoch):
        self._loader = loader
        self._inst = inst
        self._epoch = start_epoch
        self._started = False

    def __iter__(self):
        if self._started:
            self._inst.tracker.save_epoch()
            self._epoch += 1
        self._started = True
        self._inst.tracker.set_epoch(self._epoch)
        self._inst._idx_queue.clear()

        for batch in self._loader:
            targets, feats = _split_targets(batch)
            if self._inst.real_ids and self._inst._idx_queue:
                ids = self._inst.resolve_ids(self._inst._idx_queue.popleft())
            else:
                ids = _hash_ids(feats) if feats is not None else None
            self._inst.stash(ids, targets)
            yield batch

    def __len__(self):
        return len(self._loader)

    def __getattr__(self, item):
        return getattr(self._loader, item)


def instrument(
    model,
    bunch,
    num_targets,
    save_dir,
    loader_attr="train_loader",
    start_epoch=0,
    real_ids=True,
    id_source=None,
    egs_file=None,
):
    global _ACTIVE
    rank = int(os.environ.get("RANK", os.environ.get("LOCAL_RANK", 0)))
    if "RANK" in os.environ:
        save_dir = os.path.join(save_dir, f"rank{rank}")

    inst = _Instrumenter(model, num_targets, save_dir, id_source, egs_file=egs_file)
    _ACTIVE = inst
    inst.attach_model()

    loader = None
    real_loader_attr = loader_attr
    for attr in (loader_attr, "train_loader", "train_dataloader", "loader", "dataloader"):
        loader = getattr(bunch, attr, None)
        if loader is not None:
            real_loader_attr = attr
            break

    if loader is not None:
        if real_ids:
            inst.attach_real_ids(loader)
        setattr(bunch, real_loader_attr, _LoaderWrapper(loader, inst, start_epoch))
        print(f"[contrib] wrapped loader: {real_loader_attr} -> {save_dir}")
    else:
        print("[contrib] warning: loader not found; only gradient information may be recorded")

    return inst
