import numpy as np, glob
target_id = "309172"
files = sorted(glob.glob("contrib/contrib_epoch*.npz"))
gn_egs_row = []
for fp in files:
    d = np.load(fp)
    ids = d["ids"].astype(str)
    if target_id in list(ids):
        pos = list(ids).index(target_id)
        gn_egs_row.append(d["grad_norm"][pos])
    else:
        gn_egs_row.append(float("nan"))
print("gn_egs[309172, :] =", gn_egs_row)



