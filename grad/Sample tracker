# -*- coding: utf-8 -*-
"""
sample_tracker.py
逐样本贡献的「存储 + 聚合」。被 contrib_hook.py 调用。
summarize 已改为 numpy 向量化，73 万样本 × 10 epoch 几秒内完成。
"""

import os
import glob
import csv
import numpy as np


class SampleContributionTracker:
    def __init__(self, save_dir, egs_file=None):
        self.save_dir = save_dir
        os.makedirs(save_dir, exist_ok=True)
        self._epoch = 0
        self._buf = {}
        self._id2utt = {}          # str(sample_idx) -> utt_id
        if egs_file:
            self._load_egs(egs_file)

    def _load_egs(self, path):
        if not os.path.exists(path):
            print(f"[contrib] 警告: egs 文件不存在: {path}")
            return
        with open(path) as f:
            first = f.readline()
            delim = "\t" if "\t" in first else " "
        with open(path) as f:
            for i, line in enumerate(f):
                parts = line.strip().split(delim)
                if parts:
                    self._id2utt[str(i)] = parts[0]
        print(f"[contrib] egs 已加载: {len(self._id2utt)} 条 utt-id")

    def _get_utt(self, sid):
        """sample id -> utt_id，找不到时原样返回 sid。"""
        return self._id2utt.get(str(sid), str(sid))

    def set_epoch(self, epoch):
        self._epoch = int(epoch)
        self._buf = {}

    def _ent(self, sid):
        return self._buf.setdefault(sid, {
            "gn": 0.0, "gn_n": 0, "al": 0.0, "al_n": 0,
            "loss": 0.0, "loss_n": 0, "correct": -1,
            "fw": 0.0, "fw_n": 0,   # focal_weight（无 focal 分支时不更新，存 nan）
        })

    def update_grad(self, ids, grad_norm, align):
        for i, sid in enumerate(ids):
            e = self._ent(str(sid))
            e["gn"] += float(grad_norm[i]); e["gn_n"] += 1
            e["al"] += float(align[i]);     e["al_n"] += 1

    def update_pred(self, ids, loss, correct):
        for i, sid in enumerate(ids):
            e = self._ent(str(sid))
            e["loss"] += float(loss[i]); e["loss_n"] += 1
            e["correct"] = int(bool(correct[i]))

    # 新增：由 contrib_hook._loss_post_hook 调用
    def update_weight(self, ids, weights):
        for i, sid in enumerate(ids):
            e = self._ent(str(sid))
            e["fw"] += float(weights[i]); e["fw_n"] += 1

    def save_epoch(self):
        ids = list(self._buf.keys())
        if not ids:
            return
        def col(f):
            return np.array([f(self._buf[i]) for i in ids], dtype=np.float32)
        np.savez(
            os.path.join(self.save_dir, f"contrib_epoch{self._epoch:03d}.npz"),
            ids=np.array(ids),
            utt_ids=np.array([self._get_utt(i) for i in ids]),
            grad_norm=col(lambda e: e["gn"] / e["gn_n"] if e["gn_n"] else np.nan),
            align=col(lambda e: e["al"] / e["al_n"] if e["al_n"] else np.nan),
            loss=col(lambda e: e["loss"] / e["loss_n"] if e["loss_n"] else np.nan),
            correct=np.array([self._buf[i]["correct"] for i in ids], dtype=np.int8),
            focal_weight=col(lambda e: e["fw"] / e["fw_n"] if e["fw_n"] else np.nan),  # 新增
        )
        print(f"[contrib] epoch {self._epoch} 已保存 ({len(ids)} 样本)")

    # ==================== 向量化 summarize ====================
    @staticmethod
    def summarize(save_dir, out_csv, egs_file=None):
        files = sorted(glob.glob(os.path.join(save_dir, "contrib_epoch*.npz")))
        if not files:
            raise FileNotFoundError(f"在 {save_dir} 没找到 contrib_epoch*.npz")
        n_epochs = len(files)
        print(f"[contrib] 读取 {n_epochs} 个 epoch ...")

        # ---- 第一步：收集所有 id 并建立 id->行号 映射 ----
        d0 = np.load(files[0], allow_pickle=True)
        all_ids = list(d0["ids"].astype(str))
        id2idx  = {sid: i for i, sid in enumerate(all_ids)}

        # ---- utt_id 映射（三路来源，优先级从高到低）----
        utt_id_map = {}
        if egs_file and os.path.exists(egs_file):
            with open(egs_file) as f:
                first = f.readline()
                delim = "\t" if "\t" in first else " "
            with open(egs_file) as f:
                for i, line in enumerate(f):
                    parts = line.strip().split(delim)
                    if parts:
                        utt_id_map[str(i)] = parts[0]
            print(f"[contrib] egs 已加载: {len(utt_id_map)} 条 utt-id")
        elif "utt_ids" in d0:
            for sid, uid in zip(d0["ids"].astype(str), d0["utt_ids"].astype(str)):
                utt_id_map[sid] = uid
            print(f"[contrib] utt_id 来自 npz: {len(utt_id_map)} 条")

        for f in files[1:]:
            d = np.load(f, allow_pickle=True)
            for sid in d["ids"].astype(str):
                if sid not in id2idx:
                    id2idx[sid] = len(all_ids)
                    all_ids.append(sid)

        n_samples = len(all_ids)
        print(f"[contrib] 共 {n_samples} 个样本，开始向量化聚合 ...")

        # ---- 第二步：分配矩阵，填入数据 ----
        gn = np.full((n_samples, n_epochs), np.nan, dtype=np.float32)
        al = np.full((n_samples, n_epochs), np.nan, dtype=np.float32)
        ls = np.full((n_samples, n_epochs), np.nan, dtype=np.float32)
        co = np.full((n_samples, n_epochs), -1,      dtype=np.int8)
        fw = np.full((n_samples, n_epochs), np.nan, dtype=np.float32)  # 新增

        for ei, f in enumerate(files):
            d = np.load(f, allow_pickle=True)
            ids_str = d["ids"].astype(str)
            try:
                idxs = ids_str.astype(np.int64)
                if idxs.max() >= n_samples or idxs.min() < 0:
                    raise ValueError
            except (ValueError, OverflowError):
                idxs = np.array([id2idx[s] for s in ids_str], dtype=np.int64)
            gn[idxs, ei] = d["grad_norm"]
            al[idxs, ei] = d["align"]
            ls[idxs, ei] = d["loss"]
            co[idxs, ei] = d["correct"]
            if "focal_weight" in d:                  # 新增；旧 npz 没有此字段时静默跳过
                fw[idxs, ei] = d["focal_weight"]
            print(f"  epoch {ei}: {len(ids_str)} 样本已加载")

        # ---- 第三步：全量向量化计算 ----
        print("[contrib] 计算统计量 ...")
        with np.errstate(all="ignore"):
            mean_gn    = np.nanmean(gn, axis=1)
            early_gn   = gn[:, 0]
            self_inf   = np.nansum(gn ** 2, axis=1)
            mean_al    = np.nanmean(al, axis=1)
            mean_ls    = np.nanmean(ls, axis=1)
            last_ls    = ls[:, -1]
            n_ep_valid = np.sum(~np.isnan(gn), axis=1)
            mean_fw    = np.nanmean(fw, axis=1)      # 新增
            last_fw    = fw[:, -1]                   # 新增

            # frac_neg_align
            valid_al = ~np.isnan(al)
            neg_al   = (al < 0) & valid_al
            n_val_al = valid_al.sum(axis=1).astype(np.float32)
            frac_neg = np.where(n_val_al > 0, neg_al.sum(axis=1) / n_val_al, np.nan)

            # forget events
            forget = np.zeros(n_samples, dtype=np.int32)
            if n_epochs > 1:
                forget = ((co[:, :-1] == 1) & (co[:, 1:] == 0)).sum(axis=1)
            final_co = co[:, -1]

        # ---- 第四步：按全体分位数打标签 ----
        print("[contrib] 打标签 ...")
        hi_inf = np.nanpercentile(self_inf, 90)
        valid_ma = mean_al[~np.isnan(mean_al)]
        lo_aln = np.nanpercentile(valid_ma, 10) if len(valid_ma) else -np.inf

        tags = np.full(n_samples, 4, dtype=np.int8)  # 4=normal
        easy_mask = (~np.isnan(mean_ls)) & (mean_ls < 1e-2) & (forget == 0)
        tags[easy_mask] = 0                            # easy_redundant
        tags[self_inf >= hi_inf] = 1                   # high_influence
        tags[(forget >= 2) | (final_co == 0)] = 2      # hard
        harmful = (~np.isnan(mean_al)) & (mean_al < 0) & (mean_al <= lo_aln) & \
                  ((final_co == 0) | (final_co == -1))
        tags[harmful] = 3                              # harmful_suspect

        tag_names = {0: "easy_redundant", 1: "high_influence",
                     2: "hard", 3: "harmful_suspect", 4: "normal"}

        # ---- 第五步：按 self_influence 降序写 CSV ----
        print("[contrib] 写 CSV ...")
        order = np.argsort(-self_inf)

        has_utt = bool(utt_id_map)
        fields = ["id", "utt_id", "tag", "n_epochs", "mean_grad_norm", "early_grad_norm",
                  "self_influence", "mean_align", "frac_neg_align",
                  "mean_loss", "last_loss", "forget_events", "final_correct",
                  "mean_focal_weight", "last_focal_weight"]   # 新增两列
        with open(out_csv, "w", newline="") as fh:
            w = csv.writer(fh)
            w.writerow(fields)
            for i in order:
                sid = all_ids[i]
                w.writerow([
                    sid,
                    utt_id_map.get(sid, sid) if has_utt else sid,
                    tag_names[int(tags[i])],
                    int(n_ep_valid[i]),
                    f"{mean_gn[i]:.6f}",
                    f"{early_gn[i]:.6f}",
                    f"{self_inf[i]:.4f}",
                    f"{mean_al[i]:.6f}",
                    f"{frac_neg[i]:.4f}",
                    f"{mean_ls[i]:.6f}",
                    f"{last_ls[i]:.6f}",
                    int(forget[i]),
                    int(final_co[i]),
                    f"{mean_fw[i]:.6f}",   # 新增
                    f"{last_fw[i]:.6f}",   # 新增
                ])
        print(f"[contrib] 已写出 {n_samples} 个样本 -> {out_csv}")
        return out_csv
