# -*- coding: utf-8 -*-
"""
sample_tracker.py
逐样本贡献存储 + 聚合（不排序，按原始顺序）
"""
import os
import glob
import csv
import numpy as np


class SampleContributionTracker:
    def __init__(self, save_dir, egs_file=None):
        self.save_dir = save_dir
        os.makedirs(save_dir, exist_ok=True)
        self._epoch = 0
        self._buf = {}
        self._id2utt = {}
        if egs_file:
            self._load_egs(egs_file)

    def _load_egs(self, path):
        if not os.path.exists(path):
            print(f"[contrib] 警告: egs 文件不存在: {path}")
            return
        with open(path) as f:
            first = f.readline()
            delim = "\t" if "\t" in first else " "
        with open(path) as f:
            for i, line in enumerate(f):
                parts = line.strip().split(delim)
                if parts:
                    self._id2utt[str(i)] = parts[0]
        print(f"[contrib] egs 已加载: {len(self._id2utt)} 条 utt-id")

    def _get_utt(self, sid):
        return self._id2utt.get(str(sid), str(sid))

    def set_epoch(self, epoch):
        self._epoch = int(epoch)
        self._buf = {}

    def _ent(self, sid):
        return self._buf.setdefault(sid, {
            "gn": 0.0, "gn_n": 0, "al": 0.0, "al_n": 0,
            "loss": 0.0, "loss_n": 0, "correct": -1,
            "fw": 0.0, "fw_n": 0,
        })

    def update_grad(self, ids, grad_norm, align):
        for i, sid in enumerate(ids):
            e = self._ent(str(sid))
            e["gn"] += float(grad_norm[i])
            e["gn_n"] += 1
            e["al"] += float(align[i])
            e["al_n"] += 1

    def update_pred(self, ids, loss, targets):
        """更新 loss 和 correct"""
        for i, sid in enumerate(ids):
            e = self._ent(str(sid))
            e["loss"] += float(loss[i])
            e["loss_n"] += 1
            if targets is not None:
                e["correct"] = int(targets[i].item() if torch.is_tensor(targets[i]) else targets[i])

    def update_weight(self, ids, weights):
        """confidence / focal weight"""
        for i, sid in enumerate(ids):
            e = self._ent(str(sid))
            e["fw"] += float(weights[i])
            e["fw_n"] += 1

    def save_epoch(self):
        if not self._buf:
            return
        ids = list(self._buf.keys())
        def col(f):
            return np.array([f(self._buf[i]) for i in ids], dtype=np.float32)

        np.savez(
            os.path.join(self.save_dir, f"contrib_epoch{self._epoch:03d}.npz"),
            ids=np.array(ids),
            utt_ids=np.array([self._get_utt(i) for i in ids]),
            grad_norm=col(lambda e: e["gn"] / e["gn_n"] if e["gn_n"] else np.nan),
            align=col(lambda e: e["al"] / e["al_n"] if e["al_n"] else np.nan),
            loss=col(lambda e: e["loss"] / e["loss_n"] if e["loss_n"] else np.nan),
            correct=np.array([self._buf[i]["correct"] for i in ids], dtype=np.int8),
            focal_weight=col(lambda e: e["fw"] / e["fw_n"] if e["fw_n"] else np.nan),
        )
        print(f"[contrib] epoch {self._epoch} 已保存 ({len(ids)} 样本)")

    @staticmethod
    def summarize(save_dir, out_csv, egs_file=None):
        files = sorted(glob.glob(os.path.join(save_dir, "contrib_epoch*.npz")))
        if not files:
            raise FileNotFoundError(f"在 {save_dir} 没找到 contrib_epoch*.npz")

        print(f"[contrib] 读取 {len(files)} 个 epoch ...")
        d0 = np.load(files[0], allow_pickle=True)
        all_ids = list(d0["ids"].astype(str))
        id2idx = {sid: i for i, sid in enumerate(all_ids)}

        # utt_id 处理
        utt_id_map = {}
        if egs_file and os.path.exists(egs_file):
            # ... (同之前逻辑)
            with open(egs_file) as f:
                first = f.readline()
                delim = "\t" if "\t" in first else " "
            with open(egs_file) as f:
                for i, line in enumerate(f):
                    parts = line.strip().split(delim)
                    if parts:
                        utt_id_map[str(i)] = parts[0]

        # 收集所有 id（保持出现顺序）
        for f in files[1:]:
            d = np.load(f, allow_pickle=True)
            for sid in d["ids"].astype(str):
                if sid not in id2idx:
                    id2idx[sid] = len(all_ids)
                    all_ids.append(sid)

        n_samples = len(all_ids)
        print(f"[contrib] 共 {n_samples} 个样本，开始聚合...")

        n_epochs = len(files)
        gn = np.full((n_samples, n_epochs), np.nan, dtype=np.float32)
        al = np.full((n_samples, n_epochs), np.nan, dtype=np.float32)
        ls = np.full((n_samples, n_epochs), np.nan, dtype=np.float32)
        co = np.full((n_samples, n_epochs), -1, dtype=np.int8)
        fw = np.full((n_samples, n_epochs), np.nan, dtype=np.float32)

        for ei, f in enumerate(files):
            d = np.load(f, allow_pickle=True)
            ids_str = d["ids"].astype(str)
            idxs = np.array([id2idx[s] for s in ids_str], dtype=np.int64)
            gn[idxs, ei] = d["grad_norm"]
            al[idxs, ei] = d["align"]
            ls[idxs, ei] = d["loss"]
            co[idxs, ei] = d["correct"]
            if "focal_weight" in d:
                fw[idxs, ei] = d["focal_weight"]

        # 计算统计量
        with np.errstate(all="ignore"):
            mean_gn = np.nanmean(gn, axis=1)
            early_gn = gn[:, 0] if n_epochs > 0 else np.nan
            self_inf = np.nansum(gn ** 2, axis=1)
            mean_al = np.nanmean(al, axis=1)
            mean_ls = np.nanmean(ls, axis=1)
            last_ls = ls[:, -1] if n_epochs > 0 else np.nan
            mean_fw = np.nanmean(fw, axis=1)
            last_fw = fw[:, -1] if n_epochs > 0 else np.nan

            valid_al = ~np.isnan(al)
            neg_al = (al < 0) & valid_al
            n_val_al = valid_al.sum(axis=1).astype(np.float32)
            frac_neg = np.where(n_val_al > 0, neg_al.sum(axis=1) / n_val_al, np.nan)

            forget = np.zeros(n_samples, dtype=np.int32)
            if n_epochs > 1:
                forget = ((co[:, :-1] == 1) & (co[:, 1:] == 0)).sum(axis=1)
            final_co = co[:, -1] if n_epochs > 0 else co[:, 0]

        # 写 CSV —— **不排序，按 all_ids 原始顺序**
        print("[contrib] 写 CSV (按原始样本顺序)...")
        has_utt = bool(utt_id_map)
        fields = ["id", "utt_id", "n_epochs", "mean_grad_norm", "early_grad_norm",
                  "self_influence", "mean_align", "frac_neg_align",
                  "mean_loss", "last_loss", "forget_events", "final_correct",
                  "mean_focal_weight", "last_focal_weight"]

        with open(out_csv, "w", newline="") as fh:
            w = csv.writer(fh)
            w.writerow(fields)
            for i in range(n_samples):          # ← 不排序
                sid = all_ids[i]
                w.writerow([
                    sid,
                    utt_id_map.get(sid, sid) if has_utt else sid,
                    int(np.sum(~np.isnan(gn[i]))),
                    f"{mean_gn[i]:.6f}",
                    f"{early_gn[i]:.6f}",
                    f"{self_inf[i]:.4f}",
                    f"{mean_al[i]:.6f}",
                    f"{frac_neg[i]:.4f}",
                    f"{mean_ls[i]:.6f}",
                    f"{last_ls[i]:.6f}",
                    int(forget[i]),
                    int(final_co[i]),
                    f"{mean_fw[i]:.6f}",
                    f"{last_fw[i]:.6f}",
                ])

        print(f"[contrib] 已写出 {n_samples} 个样本 -> {out_csv}")
        return out_csv
