def zscore_mask(values, thr=2.8):
    arr = np.asarray(values, float)
    return np.abs((arr - arr.mean()) / (arr.std() + 1e-9)) > thr

# ═══════════════════════════════════════════════════════════════════════════════
# Figure → base64
# ═══════════════════════════════════════════════════════════════════════════════

def fig_to_b64(fig, dpi=150):
    buf = io.BytesIO()
    fig.savefig(buf, format="png", dpi=dpi, bbox_inches="tight", facecolor=C_FIG)
    buf.seek(0)
    b64 = base64.b64encode(buf.read()).decode()
    plt.close(fig)
    return b64

def _ax(ax, title, xlabel="", ylabel="", grid=True):
    ax.set_title(title, fontsize=11, pad=8, fontweight="bold", color=C_TITLE)
    if xlabel: ax.set_xlabel(xlabel, fontsize=9, color=C_SUB, labelpad=4)
    if ylabel: ax.set_ylabel(ylabel, fontsize=9, color=C_SUB, labelpad=4)
    if grid:   ax.grid(True, alpha=0.45, linestyle="--", linewidth=0.5)
    ax.tick_params(labelsize=8.5)

