      <p class="hero-desc">Click any dataset card below to explore its detailed feature analysis, speaker statistics, and outlier detection.</p>
    </div>
  </div>

  <div class="stats-strip" id="global-stats-strip"><!-- filled by JS --></div>

  <div id="overview-page-inner" style="max-width:1400px;margin:0 auto;padding:2rem 2rem 4rem">

    <!-- Dataset cards -->
    <div class="section">
      <div class="section-header">
        <div class="section-title">Datasets</div>
        <div class="section-tag">click to explore</div>
      </div>
      <div class="ds-grid" id="ds-card-grid"><!-- filled by JS --></div>
    </div>

    <!-- Comparison charts -->
    <div class="section">
      <div class="section-header">
        <div class="section-title">Cross-Dataset Comparison</div>
        <div class="section-tag">aggregated metrics</div>
      </div>
      __CMP_CHARTS__
    </div>

  </div>
</div>

<!-- ══════════════ DETAIL PAGE ══════════════ -->
<div id="detail-page">
  <div class="detail-hero" id="detail-hero">
    <div class="detail-hero-tag">Dataset Detail</div>
    <h2 id="detail-title">—</h2>
    <div class="detail-hero-sub" id="detail-path">—</div>
  </div>
  <div class="detail-stats" id="detail-stats-strip"><!-- filled by JS --></div>
  <div style="max-width:1400px;margin:0 auto;padding:2rem 2rem 4rem" id="detail-inner">
    <!-- swapped by JS -->
  </div>
</div>

<footer>Generated by <span>visualize_dataset.py</span> · Kaldi Multi-Dataset Visualization</footer>

<script>
// ── Data ─────────────────────────────────────────────────────────────────────
const ALL_STATS   = __ALL_STATS_JSON__;
const DETAIL_HTML = __DETAIL_HTML_JSON__;
const DS_COLORS   = ["#3b82f6","#ef4444","#10b981","#f59e0b","#8b5cf6",
                     "#06b6d4","#ec4899","#84cc16","#f97316","#6366f1"];

// ── Outlier table state per dataset ──────────────────────────────────────────
const tblState = ALL_STATS.map(s => ({
  data: s.outliers || [], filtered: s.outliers || [],
  sortCol: null, sortDir: 1, page: 0
}));
const PAGE_SIZE = 15;

function fmt(n){ return (n==null)?'—':n.toLocaleString(); }
function pct(a,b){ return b?((a/b)*100).toFixed(1)+'%':'—'; }

// ── Overview stat strip ───────────────────────────────────────────────────────
function buildGlobalStats(){
  const strip = document.getElementById('global-stats-strip');
  const totalUtts = ALL_STATS.reduce((s,d)=>s+d.total_utts,0);
  const totalSpks = ALL_STATS.reduce((s,d)=>s+d.n_speakers,0);
  const nDatasets = ALL_STATS.length;
  strip.innerHTML = `
    <div class="stat-card d"><div class="stat-label">Datasets</div>
      <div class="stat-value">${nDatasets}</div></div>
    <div class="stat-card g"><div class="stat-label">Total Utterances</div>
      <div class="stat-value">${fmt(totalUtts)}</div></div>
    <div class="stat-card n"><div class="stat-label">Total Normal</div>
      <div class="stat-value">${fmt(ALL_STATS.reduce((s,d)=>s+d.n_normal,0))}</div></div>
    <div class="stat-card a"><div class="stat-label">Total Abnormal</div>
      <div class="stat-value">${fmt(ALL_STATS.reduce((s,d)=>s+d.n_abnormal,0))}</div></div>
    <div class="stat-card s"><div class="stat-label">Total Speakers</div>
      <div class="stat-value">${fmt(totalSpks)}</div></div>
  `;
}

// ── Dataset cards ─────────────────────────────────────────────────────────────
function buildDsCards(){
  const grid = document.getElementById('ds-card-grid');
  grid.innerHTML = ALL_STATS.map((s,i)=>{
    const color  = DS_COLORS[i%DS_COLORS.length];
    const ratio  = s.total_utts ? s.n_abnormal/s.total_utts : 0;
    const ratioPct = (ratio*100).toFixed(1);
    const hasFeats = s.feats_loaded > 0;
    return `<div class="ds-card fade-up" style="animation-delay:${i*0.05}s"
                 onclick="showDetail(${i})">
  <div class="ds-card-accent" style="background:${color}"></div>
  <div class="ds-card-body">
    <div class="ds-name">${s.label}</div>
    <div class="ds-path">${s.data_dir}</div>
    <div class="ds-ratio-bar"><div class="ds-ratio-fill" style="width:${Math.min(ratio*100,100)}%;background:${color}"></div></div>
    <div class="ds-ratio-label"><span>Normal ${pct(s.n_normal,s.total_utts)}</span><span>Abnormal ${ratioPct}%</span></div>
    <div class="ds-metrics" style="margin-top:.9rem">
      <div class="ds-metric">
        <div class="ds-metric-label">Utterances</div>
        <div class="ds-metric-val">${fmt(s.total_utts)}</div>
      </div>
      <div class="ds-metric">
        <div class="ds-metric-label">Speakers</div>
        <div class="ds-metric-val">${fmt(s.n_speakers)}</div>
      </div>
      <div class="ds-metric">
        <div class="ds-metric-label">FBank Dim</div>
        <div class="ds-metric-val">${s.fbank_dim ?? '—'}</div>
      </div>
      <div class="ds-metric">
        <div class="ds-metric-label">Outliers</div>
        <div class="ds-metric-val">${fmt(s.outliers.length)}</div>
      </div>
    </div>
  </div>
  <div class="ds-card-footer">
    <span>${hasFeats ? 'Features available' : 'No features'}</span>
    <span>Explore →</span>
  </div>
</div>`;
  }).join('');
}

// ── Navigation ────────────────────────────────────────────────────────────────
function showOverview(){
  document.getElementById('overview-page').style.display = '';
  document.getElementById('detail-page').style.display   = 'none';
  document.getElementById('back-btn').style.display      = 'none';
}

function showDetail(idx){
  const s = ALL_STATS[idx];
  const color = DS_COLORS[idx % DS_COLORS.length];

  document.getElementById('overview-page').style.display = 'none';
  document.getElementById('detail-page').style.display   = '';
  document.getElementById('back-btn').style.display      = 'flex';

  document.getElementById('detail-hero').style.background =
    `linear-gradient(90deg,#0f172a,${color}33,#1e293b)`;
  document.getElementById('detail-title').textContent = s.label;
  document.getElementById('detail-path').textContent  = s.data_dir;

  // detail stat strip
  const strip = document.getElementById('detail-stats-strip');
  strip.innerHTML = `
    <div class="stat-card g"><div class="stat-label">Total Utterances</div>
      <div class="stat-value">${fmt(s.total_utts)}</div></div>
    <div class="stat-card n"><div class="stat-label">Normal</div>
      <div class="stat-value">${fmt(s.n_normal)}</div>
      <div class="stat-sub">${pct(s.n_normal,s.total_utts)}</div></div>
    <div class="stat-card a"><div class="stat-label">Abnormal</div>
      <div class="stat-value">${fmt(s.n_abnormal)}</div>
      <div class="stat-sub">${pct(s.n_abnormal,s.total_utts)}</div></div>
    <div class="stat-card s"><div class="stat-label">Speakers</div>
      <div class="stat-value">${fmt(s.n_speakers)}</div>
      <div class="stat-sub">${s.mean_utts_per_spk ? 'avg '+s.mean_utts_per_spk.toFixed(1)+' utts/spk' : ''}</div></div>
    <div class="stat-card f"><div class="stat-label">FBank Dim</div>
      <div class="stat-value">${s.fbank_dim ?? '—'}</div>
      <div class="stat-sub">${fmt(s.feats_loaded)} utts loaded</div></div>
    <div class="stat-card d"><div class="stat-label">Outliers</div>
      <div class="stat-value">${fmt(s.outliers.length)}</div>
      <div class="stat-sub">Z-score &gt; 2.8</div></div>
  `;

  document.getElementById('detail-inner').innerHTML = DETAIL_HTML[idx];
  renderTbl(idx);
  window.scrollTo({top:0, behavior:'smooth'});
}

// ── Outlier table logic ───────────────────────────────────────────────────────
function renderTbl(idx){
  const st = tblState[idx];
  const tbody = document.getElementById(`otbody-${idx}`);
  const info  = document.getElementById(`oinfo-${idx}`);
  if(!tbody) return;
  const start = st.page * PAGE_SIZE;
  const slice = st.filtered.slice(start, start + PAGE_SIZE);
  tbody.innerHTML = slice.map(r=>`<tr>
    <td style="font-family:var(--mono);font-size:.71rem">${r.utt_id}</td>
    <td><span class="badge ${r.label==='normal'?'badge-n':'badge-a'}">${r.label}</span></td>
    <td style="font-family:var(--mono)">${r.energy.toFixed(4)}</td>
    <td><span class="badge badge-o">${r.reason}</span></td>
  </tr>`).join('');
  info.textContent = st.filtered.length === 0 ? 'No results'
    : `${start+1}–${Math.min(start+PAGE_SIZE,st.filtered.length)} of ${st.filtered.length}`;
  document.querySelectorAll(`#otbody-${idx}`).forEach(()=>{});
  // update button states
  const prev = document.querySelector(`[onclick="prevPage(${idx})"]`);
  const next = document.querySelector(`[onclick="nextPage(${idx})"]`);
  if(prev) prev.disabled = st.page === 0;
  if(next) next.disabled = start + PAGE_SIZE >= st.filtered.length;
}

function sortTbl(idx, col){
  const st = tblState[idx];
  if(st.sortCol === col) st.sortDir *= -1; else { st.sortCol = col; st.sortDir = 1; }
  st.filtered.sort((a,b)=>{
    let va=a[col], vb=b[col];
    return typeof va==='string' ? va.localeCompare(vb)*st.sortDir : (va-vb)*st.sortDir;
  });
  st.page = 0; renderTbl(idx);
}

function filterTbl(idx, q){
  const st = tblState[idx]; q = q.toLowerCase();
  st.filtered = st.data.filter(r=>
    r.utt_id.toLowerCase().includes(q)||r.label.includes(q)||r.reason.toLowerCase().includes(q));
  if(st.sortCol) st.filtered.sort((a,b)=>{
    let va=a[st.sortCol],vb=b[st.sortCol];
    return typeof va==='string'?va.localeCompare(vb)*st.sortDir:(va-vb)*st.sortDir;
  });
  st.page = 0; renderTbl(idx);
}

function prevPage(idx){ tblState[idx].page--; renderTbl(idx); }
function nextPage(idx){ tblState[idx].page++; renderTbl(idx); }

// ── Init ──────────────────────────────────────────────────────────────────────
buildGlobalStats();
buildDsCards();
</script>
</body>
</html>
"""

# ═══════════════════════════════════════════════════════════════════════════════
# HTML card helper
# ═══════════════════════════════════════════════════════════════════════════════

def cmp_card(title, b64, badge=""):
    if b64 is None: return ""
    b = f'<span class="chart-badge">{badge}</span>' if badge else ""
    return f"""<div class="chart-card">
  <div class="chart-card-header"><span class="chart-title">{title}</span>{b}</div>
  <div class="chart-body"><img src="data:image/png;base64,{b64}" loading="lazy"/></div>
</div>"""

# ═══════════════════════════════════════════════════════════════════════════════
# Build final HTML
# ═══════════════════════════════════════════════════════════════════════════════

def build_html(all_datasets, out_path):
    print("\n[html] rendering comparison charts …")

    # ── comparison charts ──
    print("  cmp: class bar …");         cb  = cmp_class_bar(all_datasets)
    print("  cmp: abnormal ratio …");    ar  = cmp_abnormal_ratio(all_datasets)
    print("  cmp: speaker count …");     sc  = cmp_speaker_count(all_datasets)
    print("  cmp: fbank mean …");        fm  = cmp_fbank_mean(all_datasets)
    print("  cmp: energy boxplot …");    eb  = cmp_energy_box(all_datasets)
    print("  cmp: utts/spk density …");  up  = cmp_utts_per_spk(all_datasets)

    cmp_html = f"""
<div class="chart-grid mb">
  {cmp_card("Utterance Count by Class", cb, "grouped bar")}
  {cmp_card("Abnormal Ratio (%)", ar, "per dataset")}
</div>
<div class="chart-grid mb">
  {cmp_card("Speaker Count", sc, "per dataset")}
  {cmp_card("Utts-per-Speaker Density", up, "overlay")}
</div>
{"<div class='chart-grid full mb'>" + cmp_card("FBank Mean by Class (overlay)", fm, "all datasets") + "</div>" if fm else ""}
{"<div class='chart-grid full mb'>" + cmp_card("Frame-Mean Energy Boxplots", eb, "all datasets") + "</div>" if eb else ""}
"""

    # ── per-dataset detail HTML ──
    print("\n[html] rendering per-dataset detail charts …")
    detail_htmls = []
    for i, ds in enumerate(all_datasets):
        detail_htmls.append(render_detail(ds, i))

    # ── strip private keys from stats for JSON ──
    def clean(ds):
        return {k: v for k, v in ds.items() if not k.startswith("_")}

    all_stats_json   = json.dumps([clean(ds) for ds in all_datasets], ensure_ascii=False)
    detail_html_json = json.dumps(detail_htmls, ensure_ascii=False)

    html = HTML_TEMPLATE
    html = html.replace("__CMP_CHARTS__",       cmp_html)
    html = html.replace("__ALL_STATS_JSON__",   all_stats_json)
    html = html.replace("__DETAIL_HTML_JSON__", detail_html_json)

    with open(out_path, "w", encoding="utf-8") as f:
        f.write(html)
    size_kb = os.path.getsize(out_path) // 1024
    print(f"\n  [saved] {out_path}  ({size_kb:,} KB)")

# ═══════════════════════════════════════════════════════════════════════════════
# CLI
# ═══════════════════════════════════════════════════════════════════════════════

def main():
    ap = argparse.ArgumentParser(
        description="Kaldi multi-dataset visualization — single HTML SPA",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=textwrap.dedent("""
        Examples
        --------
        # Single dataset
        python visualize_dataset.py \\
            --datasets "data/train:feats/train"

        # Multiple datasets with friendly labels
        python visualize_dataset.py \\
            --datasets "data/train_A:feats/A" "data/train_B:feats/B" "data/train_C" \\
            --labels "Train-A" "Train-B" "Train-C (no feats)"

        Entry format for --datasets:  data_dir:feats_dir
          feats_dir is optional — omit the colon if not needed.
        """))
    ap.add_argument("--datasets", nargs="+", required=True,
                    metavar="DATA_DIR[:FEATS_DIR]",
                    help="One or more dataset entries: data_dir or data_dir:feats_dir")
    ap.add_argument("--labels", nargs="*", default=None,
                    help="Friendly display names (must match --datasets count if given)")
    ap.add_argument("--scp-name",         default="feats.scp")
    ap.add_argument("--output-dir",       default="./vis_output")
    ap.add_argument("--output-name",      default="report.html")
    ap.add_argument("--sample-per-class", type=int, default=2000)
    ap.add_argument("--normal-keyword",   default="normal")
    ap.add_argument("--abnormal-keyword", default="abnormal")
    args = ap.parse_args()

    # parse dataset entries
    entries = []
    for entry in args.datasets:
        if ":" in entry:
            parts = entry.split(":", 1)
            entries.append((parts[0].strip(), parts[1].strip()))
        else:
            entries.append((entry.strip(), None))

    # resolve labels
    labels = args.labels or [None] * len(entries)
    if len(labels) != len(entries):
        print(f"[WARNING] --labels count ({len(labels)}) != --datasets count ({len(entries)}); ignoring labels")
        labels = [None] * len(entries)
    labels = [lb if lb else Path(dd).name for lb, (dd, _) in zip(labels, entries)]

    out_dir = Path(args.output_dir)
    out_dir.mkdir(parents=True, exist_ok=True)

    # load all datasets
    all_datasets = []
    for (data_dir, feats_dir), label in zip(entries, labels):
        ds = load_dataset(data_dir, feats_dir, label,
                          args.scp_name, args.sample_per_class,
                          args.normal_keyword, args.abnormal_keyword)
        if ds: all_datasets.append(ds)

    if not all_datasets:
        print("[ERROR] No datasets loaded successfully."); sys.exit(1)

    # summary
    print(f"\n{'─'*54}")
    print(f"  Loaded {len(all_datasets)} dataset(s)")
    for ds in all_datasets:
        pct_a = ds['n_abnormal']/max(ds['total_utts'],1)*100
        print(f"  {ds['label']:30s}  {ds['total_utts']:>8,} utts  "
              f"abnormal {pct_a:.1f}%  {ds['n_speakers']} spk")
    print(f"{'─'*54}\n")

    out_html = out_dir / args.output_name
    build_html(all_datasets, out_html)

    print(f"\nDone.  Open in browser:\n  {out_html}\n")


if __name__ == "__main__":
    main()
