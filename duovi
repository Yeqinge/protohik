#!/usr/bin/env python3
"""
Kaldi Multi-Dataset Visualization — single HTML SPA
────────────────────────────────────────────────────
• Landing page: side-by-side comparison cards for all datasets
• Click any card → per-dataset detail view (speakers, features, outliers)
• All rendered as one self-contained HTML file (base64 images embedded)

Usage (single dataset):
    python3 visualize_dataset.py \
        --datasets "data/train_set1:feats_exp/train_set1" \
        --output-dir ./vis_output

Usage (multiple datasets, space-separated):
    python3 visualize_dataset.py \
        --datasets \
            "data/train_A:feats_exp/train_A" \
            "data/train_B:feats_exp/train_B" \
            "data/train_C" \
        --labels "Train-A" "Train-B" "Train-C" \
        --output-dir ./vis_output

Each --datasets entry is  data_dir:feats_dir  (feats_dir optional, omit colon too).
--labels gives friendly display names (defaults to data-dir basename).
"""

