def read_utt2spk(path):
    d = {}
    with open(path) as f:
        for line in f:
            p = line.strip().split()
            if len(p) >= 2: d[p[0]] = p[1]
    return d

def read_spk2utt(path):
    d = {}
    if not os.path.exists(path): return d
    with open(path) as f:
        for line in f:
            p = line.strip().split()
            if p: d[p[0]] = p[1:]
    return d

def infer_label(spk_id, nkw, akw):
    s = spk_id.lower()
    if akw.lower() in s: return "abnormal"
    if nkw.lower() in s: return "normal"
    return "normal"

def build_utt2label(utt2spk, nkw, akw):
    return {u: infer_label(spk, nkw, akw) for u, spk in utt2spk.items()}

def sample_scp_balanced(scp_path, utt2label, sample_per_class=2000):
    try:
        import kaldiio
    except ImportError:
        print("  [ERROR] kaldiio not installed: pip install kaldiio"); return {}
    ids_by_class = defaultdict(list)
    with open(scp_path) as f:
        for line in f:
            p = line.strip().split()
            if len(p) >= 2:
                ids_by_class[utt2label.get(p[0], "normal")].append(p[0])
    sampled_ids = set()
    for lbl, ids in ids_by_class.items():
        n = min(sample_per_class, len(ids))
        chosen = np.random.choice(ids, n, replace=False).tolist()
        sampled_ids.update(chosen)
        print(f"    [{lbl}] total={len(ids):,}  sampled={n}")
    feats = {}
    try:
        reader = kaldiio.load_scp(scp_path)
        for uid in sampled_ids:
            feats[uid] = reader[uid].astype(np.float32)
        print(f"    [kaldiio] loaded {len(feats)} utterances")
    except Exception as e:
        print(f"    [WARNING] random-access failed, sequential fallback: {e}")
        for uid, mat in kaldiio.load_scp_sequential(scp_path):
            if uid in sampled_ids:
                feats[uid] = mat.astype(np.float32)
            if len(feats) >= len(sampled_ids): break
    return feats

