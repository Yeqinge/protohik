def cmp_class_bar(all_stats):
    """Grouped bar: normal vs abnormal count per dataset."""
    labels = [s["label"] for s in all_stats]
    n_norm = [s["n_normal"]   for s in all_stats]
    n_abnm = [s["n_abnormal"] for s in all_stats]
    x = np.arange(len(labels)); w = 0.38
    fig, ax = plt.subplots(figsize=(max(7, len(labels)*1.4), 5), facecolor=C_FIG)
    ax.bar(x - w/2, n_norm, w, color=C_NORMAL,   alpha=0.82, label="Normal")
    ax.bar(x + w/2, n_abnm, w, color=C_ABNORMAL, alpha=0.82, label="Abnormal")
    ax.set_xticks(x); ax.set_xticklabels(labels, rotation=20, ha="right", fontsize=8.5)
    ax.legend()
    _ax(ax, "Utterance Count by Class per Dataset", "", "# Utterances")
    fig.tight_layout(); return fig_to_b64(fig)

def cmp_abnormal_ratio(all_stats):
    """Line + scatter: abnormal ratio across datasets."""
    labels = [s["label"] for s in all_stats]
    ratios = [s["n_abnormal"] / max(s["total_utts"], 1) * 100 for s in all_stats]
    x = np.arange(len(labels))
    fig, ax = plt.subplots(figsize=(max(7, len(labels)*1.4), 5), facecolor=C_FIG)
    ax.plot(x, ratios, "o-", color=C_ABNORMAL, lw=2, ms=8, zorder=4)
    for xi, r in zip(x, ratios):
        ax.text(xi, r + 0.8, f"{r:.1f}%", ha="center", fontsize=8, color=C_ABNORMAL)
    ax.axhline(np.mean(ratios), color="#9ca3af", lw=1.2, ls="--", label="Mean")
    ax.set_xticks(x); ax.set_xticklabels(labels, rotation=20, ha="right", fontsize=8.5)
    ax.set_ylim(0, max(ratios)*1.25 + 5); ax.legend()
    _ax(ax, "Abnormal Ratio (%) per Dataset", "", "Abnormal %")
    fig.tight_layout(); return fig_to_b64(fig)

def cmp_speaker_count(all_stats):
    labels = [s["label"] for s in all_stats]
    spks   = [s["n_speakers"] for s in all_stats]
    x = np.arange(len(labels))
    fig, ax = plt.subplots(figsize=(max(7, len(labels)*1.4), 5), facecolor=C_FIG)
    bars = ax.bar(x, spks, color=[DS_COLORS[i % len(DS_COLORS)] for i in range(len(labels))],
                  alpha=0.82, width=0.55)
    for bar, v in zip(bars, spks):
        ax.text(bar.get_x() + bar.get_width()/2, bar.get_height() + max(spks)*0.01,
                f"{v:,}", ha="center", fontsize=8, color=C_SUB)
    ax.set_xticks(x); ax.set_xticklabels(labels, rotation=20, ha="right", fontsize=8.5)
    _ax(ax, "Speaker Count per Dataset", "", "# Speakers")
    fig.tight_layout(); return fig_to_b64(fig)

def cmp_energy_box(all_stats):
    """Side-by-side energy boxplots for datasets that have features."""
    ds_with_feats = [s for s in all_stats if s.get("energy_samples")]
    if not ds_with_feats:
        return None
    fig, ax = plt.subplots(figsize=(max(7, len(ds_with_feats)*1.6), 5), facecolor=C_FIG)
    data   = [s["energy_samples"] for s in ds_with_feats]
    labels = [s["label"]          for s in ds_with_feats]
    colors = [DS_COLORS[i % len(DS_COLORS)] for i in range(len(ds_with_feats))]
    bp = ax.boxplot(data, patch_artist=True,
                    whiskerprops=dict(color="#9ca3af", lw=1.2),
                    capprops=dict(color="#6b7280", lw=1.5),
                    medianprops=dict(color="#374151", lw=2.2),
                    flierprops=dict(marker="o", ms=3, linestyle="none",
                                    markerfacecolor=C_ANOMALY, markeredgecolor="none", alpha=0.5))
    for patch, c in zip(bp["boxes"], colors):
        patch.set_facecolor(c + "33"); patch.set_edgecolor(c); patch.set_linewidth(1.8)
    ax.set_xticks(range(1, len(labels)+1)); ax.set_xticklabels(labels, rotation=20, ha="right", fontsize=8.5)
    _ax(ax, "Frame-Mean Energy Distribution across Datasets", "", "Mean energy")
    fig.tight_layout(); return fig_to_b64(fig)

def cmp_fbank_mean(all_stats):
    """Overlay mean FBank curves for all datasets (normal only)."""
    ds_with_feats = [s for s in all_stats if s.get("fbank_mean_normal") is not None]
    if not ds_with_feats: return None
    fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(14, 5), facecolor=C_FIG)
    for i, s in enumerate(ds_with_feats):
        c = DS_COLORS[i % len(DS_COLORS)]
        mn = s["fbank_mean_normal"]
        ma = s.get("fbank_mean_abnormal")
        x  = np.arange(len(mn))
        ax1.plot(x, mn, color=c, lw=1.8, label=s["label"])
        if ma is not None:
            ax2.plot(x, ma, color=c, lw=1.8, label=s["label"])
    ax1.legend(fontsize=7.5); ax2.legend(fontsize=7.5)
    _ax(ax1, "FBank Mean (Normal) per Dataset",   "Filter index", "Mean")
    _ax(ax2, "FBank Mean (Abnormal) per Dataset",  "Filter index", "Mean")
    fig.tight_layout(); return fig_to_b64(fig)

def cmp_utts_per_spk(all_stats):
    """Overlaid density histograms of utts-per-speaker."""
    fig, ax = plt.subplots(figsize=(9, 5), facecolor=C_FIG)
    for i, s in enumerate(all_stats):
        if not s.get("utts_per_spk"): continue
        c = DS_COLORS[i % len(DS_COLORS)]
        v = s["utts_per_spk"]
        bins = np.linspace(0, np.percentile(v, 98), 35)
        ax.hist(v, bins=bins, alpha=0.45, color=c, density=True, label=s["label"])
    ax.legend(fontsize=8)
    _ax(ax, "Utts-per-Speaker Density (all datasets)", "# Utterances", "Density")
    fig.tight_layout(); return fig_to_b64(fig)

