# Render per-dataset detail block (returns HTML string)
# ═══════════════════════════════════════════════════════════════════════════════

def render_detail(ds, idx):
    utt2label = ds["_utt2label"]
    spk2utt   = ds["_spk2utt"]
    feats     = ds["_feats"]

    def card(title, b64, badge=""):
        b = f'<span class="chart-badge">{badge}</span>' if badge else ""
        return f"""<div class="chart-card">
  <div class="chart-card-header"><span class="chart-title">{title}</span>{b}</div>
  <div class="chart-body"><img src="data:image/png;base64,{b64}" loading="lazy"/></div>
</div>"""

    print(f"  [{ds['label']}] pie chart …")
    pie = card("Class Distribution", make_pie(utt2label), "utterances")

    print(f"  [{ds['label']}] utts/spk histogram …")
    if spk2utt:
        hist = card("Utts-per-Speaker", make_utts_hist(spk2utt, utt2label), "density")
    else:
        hist = ""

    print(f"  [{ds['label']}] speaker bar …")
    spk_bar  = card("Top-50 Speakers", make_spk_bar(spk2utt, utt2label), "stacked bar")

    print(f"  [{ds['label']}] ratio bar …")
    if spk2utt:
        ratio    = card("Abnormal Ratio per Speaker", make_ratio_bar(spk2utt, utt2label), "top 40")
    else:
        ratio = ""

    feat_html = ""
    if feats:
        print(f"  [{ds['label']}] fbank mean/std …")
        ms  = card("FBank Mean & Std per Filter Bank", make_feat_mean_std(feats, utt2label), "±1 SD")
        print(f"  [{ds['label']}] energy hist …")
        eh  = card("Energy Distribution", make_energy_hist(feats, utt2label), "density")
        print(f"  [{ds['label']}] len vs energy …")
        lve = card("Length vs. Mean Energy", make_len_vs_energy(feats, utt2label), "scatter")
        print(f"  [{ds['label']}] variance dim …")
        vd  = card("Variance per Filter Bank", make_variance_dim(feats, utt2label), "top-5 dotted")
        print(f"  [{ds['label']}] boxplot …")
        bp  = card("Energy Boxplot", make_energy_box(feats, utt2label), "jitter")

        n_utts = [u for u in feats if utt2label.get(u,"normal")=="normal"]
        a_utts = [u for u in feats if utt2label.get(u,"normal")=="abnormal"]
        hm = ""
        if n_utts:
            u = np.random.choice(n_utts)
            print(f"  [{ds['label']}] heatmap normal …")
            hm += card("FBank Heatmap · Normal Sample", make_heatmap(feats[u], f"Normal — {u[:50]}"), "example")
        if a_utts:
            u = np.random.choice(a_utts)
            print(f"  [{ds['label']}] heatmap abnormal …")
            hm += card("FBank Heatmap · Abnormal Sample", make_heatmap(feats[u], f"Abnormal — {u[:50]}"), "example")

        feat_html = f"""
<div class="detail-section-title">FBank Features</div>
<div class="chart-grid full mb">{ms}</div>
<div class="chart-grid mb">{eh}{lve}</div>
<div class="chart-grid mb">{vd}{bp}</div>
<div class="chart-grid mb">{hm}
</div>"""
    else:
        feat_html = '<div class="empty"><strong>No feature data</strong>Run with feats-dir pointing to feats.scp.</div>'

    # outlier table
    outliers = ds["outliers"]
    n_out    = len(outliers)
    if n_out:
        out_html = f"""<div class="table-wrap">
  <div class="table-toolbar">
    <span style="font-size:.78rem;color:var(--sub)"><strong style="color:var(--text)">{n_out:,}</strong> outliers</span>
    <input type="text" placeholder="Filter…" oninput="filterTbl({idx},this.value)"/>
  </div>
  <div style="overflow-x:auto">
  <table>
    <thead><tr>
      <th onclick="sortTbl({idx},'utt_id')">Utterance ID ↕</th>
      <th onclick="sortTbl({idx},'label')">Label ↕</th>
      <th onclick="sortTbl({idx},'energy')">Energy ↕</th>
      <th onclick="sortTbl({idx},'reason')">Reason ↕</th>
    </tr></thead>
    <tbody id="otbody-{idx}"></tbody>
  </table></div>
  <div class="pager">
    <span id="oinfo-{idx}"></span>
    <div style="display:flex;gap:.5rem">
      <button onclick="prevPage({idx})">← Prev</button>
      <button onclick="nextPage({idx})">Next →</button>
    </div>
  </div>
</div>"""
    else:
        out_html = '<div class="empty"><strong>No outliers detected</strong>No utterance exceeded Z-score 2.8 for frame-mean energy.</div>'

    return f"""
<div class="detail-section-title">Class &amp; Speaker Overview</div>
<div class="chart-grid mb">{pie}{hist}</div>
<div class="chart-grid full mb">{spk_bar}</div>
<div class="chart-grid mb">{ratio}</div>
{feat_html}
<div class="detail-section-title">Outlier Utterances <span style="font-size:.75rem;font-weight:400;color:var(--sub)">Z-score &gt; 2.8</span></div>
{out_html}
"""

