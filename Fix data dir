#!/bin/bash

# This script makes sure that only the segments present in
# all of "feats.scp", "wav.scp" [if present], segments [if present]
# text, and utt2spk are present in any of them.
# It puts the original contents of data-dir into
# data-dir/.backup

cmd="$@"

utt_extra_files=
spk_extra_files=
# [NEW] JSON file containing sample metadata; when set, removed samples
# will be written to <data-dir>/removed_samples.json in wav.scp style
json_file=

. subtools/kaldi/utils/parse_options.sh

if [ $# != 1 ]; then
  echo "Usage: subtools/kaldi/utils/data/fix_data_dir.sh [options] <data-dir>"
  echo "  --json-file <path>   JSON file with sample metadata; removed samples"
  echo "                       will be written to <data-dir>/removed_samples.json"
  echo "e.g.: subtools/kaldi/utils/data/fix_data_dir.sh data/train"
  echo "e.g.: subtools/kaldi/utils/data/fix_data_dir.sh --json-file meta.json data/train"
  echo "This script helps ensure that the various files in a data directory"
  echo "are correctly sorted and filtered, for example removing utterances"
  echo "that have no features (if feats.scp is present)"
  exit 1
fi

data=$1

if [ -f $data/images.scp ]; then
  image/fix_data_dir.sh $cmd
  exit $?
fi

mkdir -p $data/.backup

[ ! -d $data ] && echo "$0: no such directory $data" && exit 1;

[ ! -f $data/utt2spk ] && echo "$0: no such file $data/utt2spk" && exit 1;

set -e -o pipefail -u

tmpdir=$(mktemp -d /tmp/kaldi.XXXX);
trap 'rm -rf "$tmpdir"' EXIT HUP INT PIPE TERM

export LC_ALL=C

# [NEW] Save original utt list right at the start, before any filtering.
awk '{print $1}' < $data/utt2spk | sort > $tmpdir/utts_original

# [NEW] File to accumulate "utt_id<TAB>reason" lines throughout filtering.
#       Multiple reasons for the same utt are all appended (one line each).
removed_reasons=$tmpdir/removed_reasons
touch $removed_reasons

# [NEW] Helper: diff the utt list before/after a filter step and record reason.
#   Usage: record_removed_reason <before_file> <after_file> <reason_string>
function record_removed_reason {
  local before=$1
  local after=$2
  local reason=$3
  # utts that were in 'before' but not in 'after'
  comm -23 <(sort "$before") <(sort "$after") | \
    awk -v r="$reason" '{print $1 "\t" r}' >> $removed_reasons
}

function check_sorted {
  file=$1
  sort -k1,1 -u <$file >$file.tmp
  if ! cmp -s $file $file.tmp; then
    echo "$0: file $1 is not in sorted order or not unique, sorting it"
    mv $file.tmp $file
  else
    rm $file.tmp
  fi
}

for x in utt2spk spk2utt feats.scp text segments wav.scp cmvn.scp vad.scp \
    reco2file_and_channel spk2gender utt2lang utt2uniq utt2dur reco2dur utt2num_frames; do
  if [ -f $data/$x ]; then
    cp $data/$x $data/.backup/$x
    check_sorted $data/$x
  fi
done

function filter_file {
  filter=$1
  file_to_filter=$2
  cp $file_to_filter ${file_to_filter}.tmp
  subtools/kaldi/utils/filter_scp.pl $filter ${file_to_filter}.tmp > $file_to_filter
  if ! cmp ${file_to_filter}.tmp  $file_to_filter >&/dev/null; then
    length1=$(cat ${file_to_filter}.tmp | wc -l)
    length2=$(cat ${file_to_filter} | wc -l)
    if [ $length1 -ne $length2 ]; then
      echo "$0: filtered $file_to_filter from $length1 to $length2 lines based on filter $filter."
    fi
  fi
  rm $file_to_filter.tmp
}

function filter_recordings {
  # We call this once before the stage when we filter on utterance-id, and once
  # after.

  if [ -f $data/segments ]; then
  # We have a segments file -> we need to filter this and the file wav.scp, and
  # reco2file_and_utt, if it exists, to make sure they have the same list of
  # recording-ids.

    if [ ! -f $data/wav.scp ]; then
      echo "$0: $data/segments exists but not $data/wav.scp"
      exit 1;
    fi
    awk '{print $2}' < $data/segments | sort | uniq > $tmpdir/recordings
    n1=$(cat $tmpdir/recordings | wc -l)
    [ ! -s $tmpdir/recordings ] && \
      echo "Empty list of recordings (bad file $data/segments)?" && exit 1;
    subtools/kaldi/utils/filter_scp.pl $data/wav.scp $tmpdir/recordings > $tmpdir/recordings.tmp
    mv $tmpdir/recordings.tmp $tmpdir/recordings


    cp $data/segments{,.tmp}; awk '{print $2, $1, $3, $4}' <$data/segments.tmp >$data/segments
    filter_file $tmpdir/recordings $data/segments
    cp $data/segments{,.tmp}; awk '{print $2, $1, $3, $4}' <$data/segments.tmp >$data/segments
    rm $data/segments.tmp

    filter_file $tmpdir/recordings $data/wav.scp
    [ -f $data/reco2file_and_channel ] && filter_file $tmpdir/recordings $data/reco2file_and_channel
    [ -f $data/reco2dur ] && filter_file $tmpdir/recordings $data/reco2dur
    true
  fi
}

function filter_speakers {
  # throughout this program, we regard utt2spk as primary and spk2utt as derived, so...
  subtools/kaldi/utils/utt2spk_to_spk2utt.pl $data/utt2spk > $data/spk2utt

  cat $data/spk2utt | awk '{print $1}' > $tmpdir/speakers
  for s in cmvn.scp spk2gender; do
    f=$data/$s
    if [ -f $f ]; then
      filter_file $f $tmpdir/speakers
    fi
  done

  filter_file $tmpdir/speakers $data/spk2utt
  subtools/kaldi/utils/spk2utt_to_utt2spk.pl $data/spk2utt > $data/utt2spk

  for s in cmvn.scp spk2gender $spk_extra_files; do
    f=$data/$s
    if [ -f $f ]; then
      filter_file $tmpdir/speakers $f
    fi
  done
}

function filter_utts {
  cat $data/utt2spk | awk '{print $1}' > $tmpdir/utts

  ! cat $data/utt2spk | sort | cmp - $data/utt2spk && \
    echo "utt2spk is not in sorted order (fix this yourself)" && exit 1;

  ! cat $data/utt2spk | sort -k2 | cmp - $data/utt2spk && \
    echo "utt2spk is not in sorted order when sorted first on speaker-id " && \
    echo "(fix this by making speaker-ids prefixes of utt-ids)" && exit 1;

  ! cat $data/spk2utt | sort | cmp - $data/spk2utt && \
    echo "spk2utt is not in sorted order (fix this yourself)" && exit 1;

  if [ -f $data/utt2uniq ]; then
    ! cat $data/utt2uniq | sort | cmp - $data/utt2uniq && \
      echo "utt2uniq is not in sorted order (fix this yourself)" && exit 1;
  fi

  maybe_wav=
  maybe_reco2dur=
  [ ! -f $data/segments ] && maybe_wav=wav.scp # wav indexed by utts only if segments does not exist.
  [ -s $data/reco2dur ] && [ ! -f $data/segments ] && maybe_reco2dur=reco2dur # reco2dur indexed by utts

  maybe_utt2dur=
  if [ -f $data/utt2dur ]; then
    cat $data/utt2dur | \
      awk '{ if (NF == 2 && $2 > 0) { print }}' > $data/utt2dur.ok || exit 1
    maybe_utt2dur=utt2dur.ok
  fi

  maybe_utt2num_frames=
  if [ -f $data/utt2num_frames ]; then
    cat $data/utt2num_frames | \
      awk '{ if (NF == 2 && $2 > 0) { print }}' > $data/utt2num_frames.ok || exit 1
    maybe_utt2num_frames=utt2num_frames.ok
  fi

  # [NEW] For each filter file, snapshot utts before → filter → record reason
  for x in feats.scp text segments utt2lang $maybe_wav $maybe_utt2dur $maybe_utt2num_frames; do
    if [ -f $data/$x ]; then
      cp $tmpdir/utts $tmpdir/utts_before_filter   # [NEW] snapshot
      subtools/kaldi/utils/filter_scp.pl $data/$x $tmpdir/utts > $tmpdir/utts.tmp
      mv $tmpdir/utts.tmp $tmpdir/utts
      # [NEW] record which utts were dropped and why
      # utt2dur.ok / utt2num_frames.ok → map back to the real filename for the reason message
      display_name=$x
      [[ "$x" == "utt2dur.ok" ]]        && display_name="utt2dur (duration <= 0)"
      [[ "$x" == "utt2num_frames.ok" ]] && display_name="utt2num_frames (num_frames <= 0)"
      record_removed_reason $tmpdir/utts_before_filter $tmpdir/utts \
        "missing or invalid in $display_name"
    fi
  done
  rm $data/utt2dur.ok 2>/dev/null || true
  rm $data/utt2num_frames.ok 2>/dev/null || true

  [ ! -s $tmpdir/utts ] && echo "fix_data_dir.sh: no utterances remained: not proceeding further." && \
    rm $tmpdir/utts && exit 1;

  if [ -f $data/utt2spk ]; then
    new_nutts=$(cat $tmpdir/utts | wc -l)
    old_nutts=$(cat $data/utt2spk | wc -l)
    if [ $new_nutts -ne $old_nutts ]; then
      echo "fix_data_dir.sh: kept $new_nutts utterances out of $old_nutts"
    else
      echo "fix_data_dir.sh: kept all $old_nutts utterances."
    fi
  fi

  for x in utt2spk utt2uniq feats.scp vad.scp text segments utt2lang utt2dur utt2num_frames $maybe_wav $maybe_reco2dur $utt_extra_files; do
    if [ -f $data/$x ]; then
      cp $data/$x $data/.backup/$x
      if ! cmp -s $data/$x <( subtools/kaldi/utils/filter_scp.pl $tmpdir/utts $data/$x ) ; then
        subtools/kaldi/utils/filter_scp.pl $tmpdir/utts $data/.backup/$x > $data/$x
      fi
    fi
  done
}


filter_recordings
filter_speakers
filter_utts
# [NEW] After filter_utts, record utts dropped by the second filter_speakers pass
#       (speakers whose cmvn/spk2gender went missing pull utterances with them).
cp $tmpdir/utts_original $tmpdir/utts_before_spk2  # reuse original as reference base
awk '{print $1}' < $data/utt2spk | sort > $tmpdir/utts_after_utts  # state after filter_utts

filter_speakers
awk '{print $1}' < $data/utt2spk | sort > $tmpdir/utts_after_spk2
record_removed_reason $tmpdir/utts_after_utts $tmpdir/utts_after_spk2 \
  "speaker dropped in second filter_speakers pass (cmvn.scp / spk2gender mismatch)"

filter_recordings
# [NEW] Record utts dropped by the second filter_recordings pass
#       (segments whose recording vanished from wav.scp pull utterances with them).
awk '{print $1}' < $data/utt2spk | sort > $tmpdir/utts_after_reco2
record_removed_reason $tmpdir/utts_after_spk2 $tmpdir/utts_after_reco2 \
  "recording dropped in second filter_recordings pass (wav.scp / segments mismatch)"

subtools/kaldi/utils/utt2spk_to_spk2utt.pl $data/utt2spk > $data/spk2utt

# wav-to-duration scp:$data/wav.scp ark,t:$data/utt2dur

echo "fix_data_dir.sh: old files are kept in $data/.backup"

# ============================================================
# [NEW] Collect removed utterances and dump their JSON entries
# ============================================================

# Build the final kept-utt list from the updated utt2spk
awk '{print $1}' < $data/utt2spk | sort > $tmpdir/utts_final

# Diff: lines in original but not in final → removed utts
comm -23 $tmpdir/utts_original $tmpdir/utts_final > $tmpdir/utts_removed

n_removed=$(wc -l < $tmpdir/utts_removed)
echo "fix_data_dir.sh: $n_removed utterance(s) were removed in total."

if [ $n_removed -gt 0 ]; then
  # Write removed_utts.scp in the same "key value" format as wav.scp,
  # with the removal reason(s) appended as a comment at the end of each line.
  # Example:
  #   utt001 /data/utt001.wav  # missing or invalid in feats.scp
  removed_scp=$data/removed_utts.scp

  # Build a lookup: utt_id -> deduplicated reason string
  # removed_reasons has lines: "utt_id<TAB>reason" (may repeat for same utt)
  # We collapse multiple reasons with " | " as separator.
  awk -F'\t' '{
    if ($1 in reasons) reasons[$1] = reasons[$1] " | " $2
    else               reasons[$1] = $2
  }
  END { for (u in reasons) print u "\t" reasons[u] }
  ' $removed_reasons | sort > $tmpdir/utt_reasons_collapsed

  if [ -f $data/.backup/wav.scp ]; then
    # Join wav.scp entries with their reasons on utt_id (field 1 in both files)
    join -1 1 -2 1 \
      <(subtools/kaldi/utils/filter_scp.pl $tmpdir/utts_removed $data/.backup/wav.scp | sort -k1,1) \
      <(sort -k1,1 $tmpdir/utt_reasons_collapsed) | \
      awk '{
        utt=$1; path=$2
        reason=""
        for(i=3;i<=NF;i++) reason=(i==3)?$i:reason" "$i
        print utt, path, " # " reason
      }' > $removed_scp
    # Utts with no reason recorded (edge case) fall through without a comment
    join -1 1 -2 1 -v1 \
      <(subtools/kaldi/utils/filter_scp.pl $tmpdir/utts_removed $data/.backup/wav.scp | sort -k1,1) \
      <(sort -k1,1 $tmpdir/utt_reasons_collapsed) >> $removed_scp
  else
    # No wav.scp: emit "utt_id utt_id  # reason"
    join -1 1 -2 1 \
      <(awk '{print $1, $1}' $tmpdir/utts_removed | sort -k1,1) \
      <(sort -k1,1 $tmpdir/utt_reasons_collapsed) | \
      awk '{
        utt=$1; path=$2
        reason=""
        for(i=3;i<=NF;i++) reason=(i==3)?$i:reason" "$i
        print utt, path, " # " reason
      }' > $removed_scp
    join -1 1 -2 1 -v1 \
      <(awk '{print $1, $1}' $tmpdir/utts_removed | sort -k1,1) \
      <(sort -k1,1 $tmpdir/utt_reasons_collapsed) >> $removed_scp
  fi
  echo "fix_data_dir.sh: removed utterances written to $removed_scp (wav.scp format with reasons)"

  # ------------------------------------------------------------------
  # If --json-file was supplied, extract matching entries, attach the
  # removal reason(s), and write <data-dir>/removed_samples.json.
  # ------------------------------------------------------------------
  if [ -n "$json_file" ]; then
    if [ ! -f "$json_file" ]; then
      echo "$0: WARNING: --json-file $json_file not found, skipping JSON extraction."
    else
      removed_json=$data/removed_samples.json
      python3 - "$json_file" "$tmpdir/utts_removed" "$removed_reasons" "$removed_json" <<'PYEOF'
import sys
import json
from collections import defaultdict

json_file      = sys.argv[1]
utts_file      = sys.argv[2]
reasons_file   = sys.argv[3]
output_file    = sys.argv[4]

# Load the set of removed utterance-ids
with open(utts_file) as f:
    removed_utts = set(line.strip() for line in f if line.strip())

# Load reasons: each line is "utt_id<TAB>reason"
# One utt may have multiple reason lines → collect all into a list
utt_reasons = defaultdict(list)
with open(reasons_file) as f:
    for line in f:
        line = line.rstrip("\n")
        if "\t" in line:
            uid, reason = line.split("\t", 1)
            if uid in removed_utts:
                utt_reasons[uid].append(reason)

# Load sample metadata
with open(json_file) as f:
    samples = json.load(f)

# Fields to probe for the utterance-id, in priority order
ID_FIELDS = ["utt_id", "uttid", "utt", "id", "key", "wav_id"]

def get_utt_id(obj):
    if not isinstance(obj, dict):
        return None
    for field in ID_FIELDS:
        if field in obj:
            val = obj[field]
            if isinstance(val, str):
                return val
    for val in obj.values():
        if isinstance(val, str) and val in removed_utts:
            return val
    return None

removed_samples = []
matched_ids     = set()

def attach_reason(item, uid):
    """Return a copy of item with 'removed_reason' field added."""
    reasons = utt_reasons.get(uid, [])
    out = dict(item)
    # Deduplicate while preserving order
    seen = []
    for r in reasons:
        if r not in seen:
            seen.append(r)
    out["removed_reason"] = seen if len(seen) != 1 else seen[0]
    return out

if isinstance(samples, list):
    for item in samples:
        uid = get_utt_id(item)
        if uid and uid in removed_utts:
            removed_samples.append(attach_reason(item, uid))
            matched_ids.add(uid)
elif isinstance(samples, dict):
    for key, item in samples.items():
        if key in removed_utts:
            removed_samples.append(attach_reason(item, key))
            matched_ids.add(key)
        else:
            uid = get_utt_id(item)
            if uid and uid in removed_utts:
                removed_samples.append(attach_reason(item, uid))
                matched_ids.add(uid)
else:
    print(f"WARNING: unrecognised JSON structure in {json_file}, skipping.", file=sys.stderr)
    sys.exit(0)

unmatched = removed_utts - matched_ids
if unmatched:
    print(f"WARNING: {len(unmatched)} removed utt(s) had no matching entry in JSON:", file=sys.stderr)
    for u in sorted(unmatched)[:10]:
        print(f"  {u}", file=sys.stderr)
    if len(unmatched) > 10:
        print(f"  ... (and {len(unmatched)-10} more)", file=sys.stderr)

with open(output_file, "w") as f:
    json.dump(removed_samples, f, ensure_ascii=False, indent=2)

print(f"fix_data_dir.sh: wrote {len(removed_samples)} removed sample(s) to {output_file}")
PYEOF
    fi
  fi
fi
