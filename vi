# Figure → base64 helper
# ═══════════════════════════════════════════════════════════════════════════════

def fig_to_b64(fig, dpi=150):
    buf = io.BytesIO()
    fig.savefig(buf, format="png", dpi=dpi, bbox_inches="tight", facecolor=C_FIG)
    buf.seek(0)
    return base64.b64encode(buf.read()).decode("utf-8")


