</head>
<body>

<header>
  <div class="logo">
    <div class="logo-dot"></div>
    kaldi · vis
  </div>
  <nav>
    <a href="#overview">Overview</a>
    <a href="#speakers">Speakers</a>
    <a href="#features">Features</a>
    <a href="#outliers">Outliers</a>
  </nav>
</header>

<div class="hero">
  <div class="hero-inner">
    <div class="hero-tag">Kaldi Training Set Report</div>
    <h1>Dataset <span>Visualization</span><br>Dashboard</h1>
    <p class="hero-desc">
      Automated analysis of class distribution, speaker statistics,
      FBank feature properties, and outlier detection.
    </p>
  </div>
</div>

<!-- ── stats strip ── -->
<div class="stats-strip">
  <div class="stat-card g">
    <div class="stat-label">Total Utterances</div>
    <div class="stat-value" id="st-total">—</div>
  </div>
  <div class="stat-card n">
    <div class="stat-label">Normal</div>
