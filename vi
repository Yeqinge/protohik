#!/usr/bin/env python3
"""
Kaldi Dataset Visualization Generator
Reads data files, computes stats, and generates a self-contained HTML dashboard.

Usage:
    python3 gen_vis.py \
        --data-dir  data/fbank_20k_test5/fiber_train_s10_fix105_20k \
        --feats-dir feats_exp/feats/fbank_20k_test5/fiber_train_s10_fix105_20k \
        --output    kaldi_vis.html \
        [--scp-name feats.scp] \
        [--sample-per-class 2000] \
        [--normal-keyword normal] \
        [--abnormal-keyword abnormal]
"""

import os, sys, json, argparse, warnings
import numpy as np
from pathlib import Path
from collections import defaultdict

warnings.filterwarnings("ignore")


# ═══════════════════════════════════════════════════════════════════════════════
# I/O
# ═══════════════════════════════════════════════════════════════════════════════

def read_utt2spk(path):
    d = {}
    with open(path) as f:
        for line in f:
            p = line.strip().split()
            if len(p) >= 2: d[p[0]] = p[1]
    return d

def read_spk2utt(path):
    d = {}
    if not os.path.exists(path): return d
    with open(path) as f:
        for line in f:
            p = line.strip().split()
            if p: d[p[0]] = p[1:]
    return d

def infer_label(spk_id, nkw, akw):
    s = spk_id.lower()
    if akw.lower() in s: return "abnormal"
    if nkw.lower() in s: return "normal"
    return "normal"

def build_utt2label(utt2spk, nkw, akw):
    return {u: infer_label(spk, nkw, akw) for u, spk in utt2spk.items()}

def sample_scp_balanced(scp_path, utt2label, sample_per_class=2000):
    try:
        import kaldiio
    except ImportError:
        print("  [ERROR] pip install kaldiio"); return {}

    ids_by_class = defaultdict(list)
    with open(scp_path) as f:
        for line in f:
            p = line.strip().split()
            if len(p) >= 2:
                ids_by_class[utt2label.get(p[0], "normal")].append(p[0])

    sampled_ids = set()
    for lbl, ids in ids_by_class.items():
        n = min(sample_per_class, len(ids))
        chosen = np.random.choice(ids, n, replace=False).tolist()
        sampled_ids.update(chosen)
        print(f"  [{lbl}] total={len(ids):,}  sampled={n}")

    feats = {}
    try:
        reader = kaldiio.load_scp(scp_path)
        for uid in sampled_ids:
            feats[uid] = reader[uid].astype(np.float32)
        print(f"  [kaldiio] loaded {len(feats)} utterances")
    except Exception as e:
        print(f"  [WARNING] random access failed, sequential fallback: {e}")
        for uid, mat in kaldiio.load_scp_sequential(scp_path):
            if uid in sampled_ids:
                feats[uid] = mat.astype(np.float32)
            if len(feats) >= len(sampled_ids): break
    return feats


# ═══════════════════════════════════════════════════════════════════════════════
# Build export dict
# ═══════════════════════════════════════════════════════════════════════════════

def build_export(utt2spk, spk2utt, utt2label, feats, args):
    utt_ids = list(utt2spk.keys())

    # Speakers
    spk_n_cnt = defaultdict(int)
    spk_a_cnt = defaultdict(int)
    for uid, spk in utt2spk.items():
        if utt2label.get(uid) == "abnormal": spk_a_cnt[spk] += 1
        else:                                 spk_n_cnt[spk] += 1

    speakers = []
    for spk, utts in spk2utt.items():
        n = spk_n_cnt[spk]; a = spk_a_cnt[spk]
        speakers.append({"id": spk, "label": infer_label(spk, args.normal_keyword, args.abnormal_keyword),
                         "utt_count": n + a, "normal_count": n, "abnormal_count": a})

    # Utterances (all metadata; feature stats only for sampled)
    utts_export = []
    for uid in utt_ids:
        spk = utt2spk[uid]
        lbl = utt2label.get(uid, "normal")
        entry = {"id": uid, "spk": spk, "label": lbl, "frames": None,
                 "energy": None, "mean_vec": None, "std_vec": None}
        if uid in feats:
            mat = feats[uid]
            entry["frames"]   = int(mat.shape[0])
            entry["energy"]   = float(mat.mean())
            entry["mean_vec"] = [round(float(v), 4) for v in mat.mean(axis=0)]
            entry["std_vec"]  = [round(float(v), 4) for v in mat.std(axis=0)]
        utts_export.append(entry)

    # Heatmap examples (5 per class, first 100 frames, all dims)
    heatmaps = {"normal": [], "abnormal": []}
    for lbl in ["normal", "abnormal"]:
        candidates = [uid for uid in feats if utt2label.get(uid) == lbl]
        np.random.shuffle(candidates)
        for uid in candidates[:5]:
            mat = feats[uid][:100]   # cap at 100 frames
            heatmaps[lbl].append({
                "id": uid,
                "mat": [[round(float(v),3) for v in row] for row in mat.T]  # [D][T]
            })

    return {
        "dataset_name": Path(args.data_dir).name,
        "conf":         Path(args.data_dir).parent.name,
        "fbank_dim":    int(list(feats.values())[0].shape[1]) if feats else 80,
        "frame_shift_ms": 10,
        "normal_keyword":   args.normal_keyword,
        "abnormal_keyword": args.abnormal_keyword,
        "speakers": speakers,
        "utts":     utts_export,
        "heatmaps": heatmaps,
    }


