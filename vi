def collect_stats(utt_ids, utt2label, spk2utt, feats):
    cnt = defaultdict(int)
    for u in utt_ids: cnt[utt2label.get(u, "normal")] += 1

    stats = {
        "total_utts": len(utt_ids),
        "n_normal":   cnt.get("normal", 0),
        "n_abnormal": cnt.get("abnormal", 0),
        "n_speakers": len(spk2utt),
        "feats_loaded": len(feats),
        "fbank_dim": None,
    }
    if feats:
        s = next(iter(feats.values()))
        stats["fbank_dim"] = int(s.shape[1])
    if spk2utt:
        cnts = [len(v) for v in spk2utt.values()]
        stats["mean_utts_per_spk"] = float(np.mean(cnts))

    # Outliers
    outliers = []
    if feats:
        energies = [(uid, float(mat.mean())) for uid, mat in feats.items()]
        ids_, vals = zip(*energies)
        mask = zscore_outlier_mask(vals, thr=2.8)
        for i, m in enumerate(mask):
            if m:
                outliers.append({
                    "utt_id": ids_[i],
                    "label": utt2label.get(ids_[i], "normal"),
                    "energy": round(vals[i], 4),
                    "reason": "ENERGY_ZSCORE",
                })
    stats["outliers"] = outliers
    return stats


