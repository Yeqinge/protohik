// ── §4 Heatmap ──
function buildHeatmap(){{
  const sel=document.getElementById('heatmap-utt-select');
  sel.innerHTML='';
  (DS.heatmaps[heatmapClass]||[]).forEach((h,i)=>{{
    const o=document.createElement('option');o.value=i;o.textContent=h.id;sel.appendChild(o);
  }});
  renderHeatmap();
}}
function switchHeatmap(cls,btn){{
  heatmapClass=cls;
  document.querySelectorAll('.heatmap-controls button').forEach(b=>b.classList.remove('active'));
  btn.classList.add('active');buildHeatmap();
}}
function renderHeatmap(){{
  const sel=document.getElementById('heatmap-utt-select');
  const idx=parseInt(sel.value)||0;
  const h=(DS.heatmaps[heatmapClass]||[])[idx];
  if(!h)return;
  const mat=h.mat, D=mat.length, T=mat[0].length;
  const canvas=document.getElementById('heatmap-canvas');
  canvas.width=T;canvas.height=D;
  const ctx=canvas.getContext('2d');
  const img=ctx.createImageData(T,D);
  let mn=Infinity,mx=-Infinity;
  mat.forEach(row=>row.forEach(v=>{{if(v<mn)mn=v;if(v>mx)mx=v;}}));
  for(let d=0;d<D;d++)for(let t=0;t<T;t++){{
    const n=(mat[d][t]-mn)/(mx-mn+1e-9);
    let r,g,b;
    if(n<.25){{r=0;g=Math.round(n*4*255);b=255;}}
    else if(n<.5){{r=0;g=255;b=Math.round((1-(n-.25)*4)*255);}}
    else if(n<.75){{r=Math.round((n-.5)*4*255);g=255;b=0;}}
    else{{r=255;g=Math.round((1-(n-.75)*4)*255);b=0;}}
    const px=((D-1-d)*T+t)*4;
    img.data[px]=r;img.data[px+1]=g;img.data[px+2]=b;img.data[px+3]=255;
  }}
  ctx.putImageData(img,0,0);
}}
buildHeatmap();

// ── §5 Scatter ──
(()=>{{
  const canvas=document.getElementById('scatter-canvas');
  const utts=DS.utts.filter(u=>u.frames&&u.energy!=null);
  if(!utts.length)return;
  const lengths=utts.map(u=>u.frames), energies=utts.map(u=>u.energy);
  const zl=zscore(lengths),ze=zscore(energies);
  const isAnom=zl.map((z,i)=>z>2.5||ze[i]>2.5);
  const pad={{t:20,r:20,b:50,l:60}};
  const W=canvas.offsetWidth||900,H=300;
  canvas.width=W;canvas.height=H;
  const ctx=canvas.getContext('2d');
  const minL=Math.min(...lengths),maxL=Math.max(...lengths);
  const minE=Math.min(...energies),maxE=Math.max(...energies);
  const tx=v=>pad.l+(v-minL)/(maxL-minL+1e-9)*(W-pad.l-pad.r);
  const ty=v=>H-pad.b-(v-minE)/(maxE-minE+1e-9)*(H-pad.t-pad.b);
  ctx.strokeStyle='#e8e8e8';ctx.lineWidth=1;
  for(let i=0;i<=5;i++){{
    const y=pad.t+i*(H-pad.t-pad.b)/5;
    ctx.beginPath();ctx.moveTo(pad.l,y);ctx.lineTo(W-pad.r,y);ctx.stroke();
    ctx.fillStyle='#999';ctx.font="9px 'IBM Plex Mono'";ctx.textAlign='right';
    ctx.fillText((maxE-i*(maxE-minE)/5).toFixed(2),pad.l-6,y+3);
  }}
  for(let i=0;i<=6;i++){{
    const x=pad.l+i*(W-pad.l-pad.r)/6;
    ctx.beginPath();ctx.moveTo(x,pad.t);ctx.lineTo(x,H-pad.b);ctx.stroke();
    ctx.fillStyle='#999';ctx.font="9px 'IBM Plex Mono'";ctx.textAlign='center';
    ctx.fillText(Math.round(minL+i*(maxL-minL)/6),x,H-pad.b+14);
  }}
  ctx.fillStyle='#666';ctx.font="10px 'IBM Plex Mono'";ctx.textAlign='center';
  ctx.fillText('Frames (T)',W/2,H-6);
  ctx.save();ctx.translate(13,H/2);ctx.rotate(-Math.PI/2);ctx.fillText('Mean energy',0,0);ctx.restore();
  utts.forEach((u,i)=>{{
    const x=tx(u.frames),y=ty(u.energy);
    if(isAnom[i]){{ctx.fillStyle=COLORS.outlier;ctx.font='16px sans-serif';ctx.textAlign='center';ctx.fillText('★',x,y+5);}}
    else{{ctx.beginPath();ctx.arc(x,y,3,0,Math.PI*2);ctx.fillStyle=u.label==='normal'?'rgba(42,100,150,0.45)':'rgba(192,57,43,0.45)';ctx.fill();}}
  }});
  const tooltip=document.getElementById('tooltip');
  canvas.onmousemove=(e)=>{{
    const rect=canvas.getBoundingClientRect();
    const mx=(e.clientX-rect.left)*(W/rect.width),my=(e.clientY-rect.top)*(H/rect.height);
    let closest=null,best=100;
    utts.forEach((u,i)=>{{const d=Math.hypot(tx(u.frames)-mx,ty(u.energy)-my);if(d<best){{best=d;closest=i;}}}});
    if(closest!==null&&best<20){{
      const u=utts[closest];
      tooltip.style.display='block';tooltip.style.left=(e.clientX+12)+'px';tooltip.style.top=(e.clientY-28)+'px';
      tooltip.innerHTML=`${{u.id}}<br>label: ${{u.label}}<br>frames: ${{u.frames}}<br>energy: ${{u.energy.toFixed(4)}}${{isAnom[closest]?'<br><b>⚠ outlier</b>':''}}`;
    }}else tooltip.style.display='none';
  }};
  canvas.onmouseleave=()=>tooltip.style.display='none';
}})();

