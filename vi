def make_pie_chart(utt2label):
    cnt = defaultdict(int)
    for v in utt2label.values(): cnt[v] += 1
    labels = sorted(cnt.keys())
    sizes  = [cnt[k] for k in labels]
    colors = [LABEL_COLOR.get(k, "#888888") for k in labels]

    fig, ax = plt.subplots(figsize=(6, 5), facecolor=C_FIG)
    wedges, texts, autotexts = ax.pie(
        sizes, labels=labels, autopct="%1.1f%%", colors=colors,
        explode=[0.05]*len(labels), startangle=90,
        wedgeprops=dict(edgecolor="white", linewidth=2.5),
        textprops=dict(color=C_TEXT, fontsize=10),
    )
    for at in autotexts:
        at.set_fontsize(10); at.set_fontweight("bold"); at.set_color("white")
    ax.text(0, -1.38, f"Total: {sum(sizes):,} utterances",
            ha="center", fontsize=9, color=C_SUB)
    _ax_style(ax, "Class Distribution", grid=False)
    fig.tight_layout()
    return fig


def make_spk_bar(spk2utt, utt2label):
    if not spk2utt:
        fig, ax = plt.subplots(figsize=(12, 4), facecolor=C_FIG)
        ax.text(0.5, 0.5, "No spk2utt data", ha="center", va="center",
                transform=ax.transAxes, color=C_SUB, fontsize=13)
        _ax_style(ax, "Speaker Distribution")
        return fig

    spk_n = defaultdict(int); spk_a = defaultdict(int)
    for spk, utts in spk2utt.items():
        for u in utts:
            if utt2label.get(u, "normal") == "abnormal": spk_a[spk] += 1
            else:                                         spk_n[spk] += 1

    spks = sorted(spk2utt.keys(), key=lambda s: -len(spk2utt[s]))[:50]
    x    = np.arange(len(spks))
    nv   = np.array([spk_n[s] for s in spks])
    av   = np.array([spk_a[s] for s in spks])

    fig, ax = plt.subplots(figsize=(14, 5), facecolor=C_FIG)
    ax.bar(x, nv, color=C_NORMAL,   alpha=0.80, width=0.72, label="Normal")
    ax.bar(x, av, color=C_ABNORMAL, alpha=0.80, width=0.72, bottom=nv, label="Abnormal")

    totals = nv + av
    ratios = np.where(totals > 0, av / totals, 0)
    thr    = ratios.mean() + 2.0 * ratios.std()
    for i, r in enumerate(ratios):
        if r > thr:
            ax.annotate("★", (x[i], totals[i] + 0.3), ha="center",
                        color=C_ABNORMAL, fontsize=9, fontweight="bold")
    step = max(1, len(spks) // 16)
    ax.set_xticks(x[::step])
    ax.set_xticklabels([spks[i] for i in range(0, len(spks), step)],
                        rotation=35, ha="right", fontsize=7)
    ax.legend()
    _ax_style(ax, "Top-50 Speakers: Utterance Count  (★ = high abnormal ratio)",
              "Speaker ID", "# Utterances")
    fig.tight_layout()
    return fig


def make_utts_per_spk_hist(spk2utt, utt2label):
    n_counts, a_counts = [], []
    for spk, utts in spk2utt.items():
        n = sum(1 for u in utts if utt2label.get(u, "normal") == "normal")
        a = sum(1 for u in utts if utt2label.get(u, "normal") == "abnormal")
        if n: n_counts.append(n)
        if a: a_counts.append(a)
    fig, ax = plt.subplots(figsize=(7, 5), facecolor=C_FIG)
    all_c = n_counts + a_counts
    if all_c:
        bins = np.linspace(0, np.percentile(all_c, 99), 35)
        ax.hist(n_counts, bins=bins, alpha=0.65, color=C_NORMAL,
                label=f"Normal spk (n={len(n_counts)})", density=True)
        ax.hist(a_counts, bins=bins, alpha=0.65, color=C_ABNORMAL,
                label=f"Abnormal spk (n={len(a_counts)})", density=True)
        ax.legend()
    _ax_style(ax, "Utts-per-Speaker Distribution", "# Utterances", "Density")
    fig.tight_layout()
    return fig


def make_ratio_bar(spk2utt, utt2label):
    ratios = {}
    for spk, utts in spk2utt.items():
        n_a = sum(1 for u in utts if utt2label.get(u, "normal") == "abnormal")
        ratios[spk] = n_a / len(utts) if utts else 0
    spks = sorted(ratios, key=ratios.get, reverse=True)[:40]
    x    = np.arange(len(spks))
    vals = [ratios[s] for s in spks]
    colors_arr = [C_ABNORMAL if v > 0.5 else C_NORMAL for v in vals]

    fig, ax = plt.subplots(figsize=(12, 5), facecolor=C_FIG)
    ax.bar(x, vals, color=colors_arr, alpha=0.80, width=0.75)
    ax.axhline(0.5, color="#9ca3af", lw=1.2, ls="--", label="50 % threshold")
    step = max(1, len(spks) // 10)
    ax.set_xticks(x[::step])
    ax.set_xticklabels([spks[i] for i in range(0, len(spks), step)],
                        rotation=35, ha="right", fontsize=7)
    ax.set_ylim(0, 1.08)
    ax.legend()
    _ax_style(ax, "Abnormal Ratio per Speaker (top 40)", "Speaker ID", "Abnormal ratio")
    fig.tight_layout()
    return fig


def make_feat_mean_std(feats, utt2label):
    buckets = {"normal": [], "abnormal": []}
    for uid, mat in feats.items():
        lbl = utt2label.get(uid, "normal")
        if lbl in buckets: buckets[lbl].append(mat)

    fig, (ax_m, ax_s) = plt.subplots(1, 2, figsize=(13, 5), facecolor=C_FIG)
    for lbl, mats in buckets.items():
        if not mats: continue
        c     = LABEL_COLOR[lbl]
        stack = np.stack([m.mean(axis=0) for m in mats])
        mu, se = stack.mean(0), stack.std(0)
        x = np.arange(stack.shape[1])
        ax_m.plot(x, mu, color=c, lw=1.8, label=lbl)
        ax_m.fill_between(x, mu-se, mu+se, color=c, alpha=0.15)
        stack_s = np.stack([m.std(axis=0) for m in mats])
        mu_s = stack_s.mean(0)
        ax_s.plot(x, mu_s, color=c, lw=1.8, label=lbl)
        ax_s.fill_between(x, mu_s - stack_s.std(0), mu_s + stack_s.std(0),
                          color=c, alpha=0.12)
    ax_m.legend(); ax_s.legend()
    _ax_style(ax_m, "FBank Mean per Filter Bank (±1 SD)", "Filter index", "Mean")
    _ax_style(ax_s, "FBank Std per Filter Bank (±1 SD)",  "Filter index", "Std")
    fig.tight_layout()
    return fig


def make_energy_hist(feats, utt2label):
    en_n, en_a = [], []
    for uid, mat in feats.items():
        e = float(mat.mean())
        (en_a if utt2label.get(uid, "normal") == "abnormal" else en_n).append(e)
    fig, ax = plt.subplots(figsize=(7, 5), facecolor=C_FIG)
    all_e = en_n + en_a
    if all_e:
        bins = np.linspace(np.percentile(all_e, 0.5), np.percentile(all_e, 99.5), 55)
        ax.hist(en_n, bins=bins, alpha=0.65, color=C_NORMAL,
                density=True, label=f"Normal (n={len(en_n)})")
        ax.hist(en_a, bins=bins, alpha=0.65, color=C_ABNORMAL,
                density=True, label=f"Abnormal (n={len(en_a)})")
        if en_n:
            outs = np.array(en_n)[zscore_outlier_mask(en_n, thr=2.8)]
            if len(outs):
                ylim = ax.get_ylim()
                ax.scatter(outs, np.full(len(outs), (ylim[1]-ylim[0])*0.03 + ylim[0]),
                           c=C_ANOMALY, marker="v", s=50, zorder=6,
                           label=f"Outliers (n={len(outs)})")
        ax.legend()
    _ax_style(ax, "Frame-Mean Energy Distribution", "Energy", "Density")
    fig.tight_layout()
    return fig


def make_len_vs_energy(feats, utt2label):
    lengths, energies, colors_arr = [], [], []
    for uid, mat in feats.items():
        lengths.append(mat.shape[0]); energies.append(float(mat.mean()))
        colors_arr.append(LABEL_COLOR.get(utt2label.get(uid, "normal"), C_NORMAL))
    fig, ax = plt.subplots(figsize=(7, 5), facecolor=C_FIG)
    ax.scatter(lengths, energies, c=colors_arr, s=8, alpha=0.45, linewidths=0)
    al = np.array(lengths); ae = np.array(energies)
    anom = zscore_outlier_mask(al, 2.5) | zscore_outlier_mask(ae, 2.5)
    if anom.sum():
        ax.scatter(al[anom], ae[anom], c=C_ANOMALY, s=50, marker="*",
                   zorder=6, linewidths=0, label=f"Bivariate outliers (n={anom.sum()})")
    handles = [mpatches.Patch(color=C_NORMAL,   label="Normal"),
               mpatches.Patch(color=C_ABNORMAL, label="Abnormal")]
    if anom.sum():
        handles.append(mpatches.Patch(color=C_ANOMALY,
                                       label=f"Outliers (n={anom.sum()})"))
    ax.legend(handles=handles)
    _ax_style(ax, "Utterance Length vs. Mean Energy", "Frames (T)", "Mean energy")
    fig.tight_layout()
    return fig


def make_variance_per_dim(feats, utt2label):
    buckets = {"normal": [], "abnormal": []}
    for uid, mat in feats.items():
        lbl = utt2label.get(uid, "normal")
        if lbl in buckets: buckets[lbl].append(mat.var(axis=0))
    means_n = means_a = None
    fig, ax = plt.subplots(figsize=(7, 5), facecolor=C_FIG)
    for lbl, vlist in buckets.items():
        if not vlist: continue
        stacked = np.stack(vlist)
        mu = stacked.mean(0); x = np.arange(stacked.shape[1])
        c = LABEL_COLOR[lbl]
        ax.plot(x, mu, color=c, lw=1.8, label=lbl)
        ax.fill_between(x, mu - stacked.std(0), mu + stacked.std(0),
                        color=c, alpha=0.12)
        if lbl == "normal":   means_n = mu
        if lbl == "abnormal": means_a = mu
    if means_n is not None and means_a is not None:
        top5 = np.argsort(np.abs(means_n - means_a))[-5:]
        for d in top5:
            ax.axvline(d, color=C_ANOMALY, lw=1.0, ls=":", alpha=0.85)
    ax.legend()
    _ax_style(ax, "Variance per Filter Bank  (dotted = top-5 diverging dims)",
              "Filter index", "Variance")
    fig.tight_layout()
    return fig


def make_energy_boxplot(feats, utt2label):
    en_n = [float(mat.mean()) for uid, mat in feats.items()
            if utt2label.get(uid, "normal") == "normal"]
    en_a = [float(mat.mean()) for uid, mat in feats.items()
            if utt2label.get(uid, "normal") == "abnormal"]
    data   = [x for x in [en_n, en_a] if x]
    labels = [l for l, x in [("Normal", en_n), ("Abnormal", en_a)] if x]
    colors = [LABEL_COLOR[l.lower()] for l in labels]

    fig, ax = plt.subplots(figsize=(6, 5), facecolor=C_FIG)
    bp = ax.boxplot(data, patch_artist=True,
                    whiskerprops=dict(color="#9ca3af", lw=1.2),
                    capprops=dict(color="#6b7280", lw=1.5),
                    medianprops=dict(color="#374151", lw=2.2),
                    flierprops=dict(marker="o", ms=3.5, linestyle="none",
                                    markerfacecolor=C_ANOMALY,
                                    markeredgecolor="none", alpha=0.6))
    for patch, c in zip(bp["boxes"], colors):
        patch.set_facecolor(c + "33"); patch.set_edgecolor(c); patch.set_linewidth(1.8)
    for i, (d, c) in enumerate(zip(data, colors), 1):
        s = np.random.choice(d, min(400, len(d)), replace=False)
        ax.scatter(np.full(len(s), i) + np.random.uniform(-0.18, 0.18, len(s)),
                   s, alpha=0.18, s=6, color=c, zorder=3, linewidths=0)
    ax.set_xticks(range(1, len(labels)+1)); ax.set_xticklabels(labels)
    _ax_style(ax, "Energy Boxplot by Class", "", "Mean energy")
    fig.tight_layout()
    return fig


def make_heatmap(mat, title):
    cmap = LinearSegmentedColormap.from_list(
        "academic", ["#f0f9ff", "#7dd3fc", "#2563eb", "#dc2626", "#7f1d1d"])
    fig, ax = plt.subplots(figsize=(10, 4.5), facecolor=C_FIG)
    im = ax.imshow(mat.T, aspect="auto", origin="lower", cmap=cmap,
                   interpolation="nearest")
    plt.colorbar(im, ax=ax, fraction=0.028, pad=0.03)
    _ax_style(ax, title, "Frame index", "Filter index", grid=False)
    fig.tight_layout()
    return fig


