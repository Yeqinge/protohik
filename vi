  </div>
</div>

<div class="page">

  <!-- ── Section 1: Overview ── -->
  <div class="section" id="overview">
    <div class="section-header">
      <div class="section-title">Class Distribution</div>
      <div class="section-tag">overview</div>
    </div>
    <div class="chart-grid" id="overview-grid">
      __OVERVIEW_CARDS__
    </div>
  </div>

  <!-- ── Section 2: Speakers ── -->
  <div class="section" id="speakers">
    <div class="section-header">
      <div class="section-title">Speaker Analysis</div>
      <div class="section-tag">speaker stats</div>
    </div>
    <div class="chart-grid full" id="speakers-grid">
      __SPEAKER_CARDS__
    </div>
  </div>

  <!-- ── Section 3: FBank Features ── -->
  <div class="section" id="features">
    <div class="section-header">
      <div class="section-title">FBank Feature Analysis</div>
      <div class="section-tag">acoustic features</div>
    </div>
    <div id="features-content">
      __FEATURE_CONTENT__
    </div>
  </div>

