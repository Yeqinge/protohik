      __OUTLIER_CONTENT__
    </div>
  </div>

</div>

<footer>
  Generated by <span>visualize_dataset.py</span> · Kaldi Training Set Visualization
</footer>

<script>
const STATS = __STATS_JSON__;

function fmt(n) {
  if (n === null || n === undefined) return '—';
  return n.toLocaleString();
}
function pct(a, b) {
  if (!b) return '';
  return (a / b * 100).toFixed(1) + '%';
}

// populate stat strip
window.addEventListener('DOMContentLoaded', () => {
  document.getElementById('st-total').textContent   = fmt(STATS.total_utts);
  document.getElementById('st-normal').textContent  = fmt(STATS.n_normal);
  document.getElementById('st-abnormal').textContent= fmt(STATS.n_abnormal);
  document.getElementById('st-spk').textContent     = fmt(STATS.n_speakers);
  document.getElementById('st-dim').textContent     = STATS.fbank_dim ?? '—';
  document.getElementById('st-normal-pct').textContent =
    pct(STATS.n_normal, STATS.total_utts);
  document.getElementById('st-abnormal-pct').textContent =
    pct(STATS.n_abnormal, STATS.total_utts);
  if (STATS.mean_utts_per_spk != null)
    document.getElementById('st-spk-sub').textContent =
      'avg ' + STATS.mean_utts_per_spk.toFixed(1) + ' utts/spk';
  document.getElementById('st-feats-sub').textContent =
    fmt(STATS.feats_loaded) + ' utts loaded';
});

// ── Outlier table ──
const outliers = STATS.outliers || [];
let filtered = [...outliers];
let sortCol = null, sortDir = 1;
let page = 0;
const PAGE_SIZE = 15;

function renderTable() {
  const tbody = document.getElementById('otbody');
  const info  = document.getElementById('oinfo');
  const btnP  = document.getElementById('oprev');
  const btnN  = document.getElementById('onext');
  if (!tbody) return;

  const start = page * PAGE_SIZE;
  const slice = filtered.slice(start, start + PAGE_SIZE);

  tbody.innerHTML = slice.map(r => `
    <tr>
      <td style="font-family:var(--mono);font-size:.72rem">${r.utt_id}</td>
      <td><span class="badge ${r.label==='normal'?'badge-n':'badge-a'}">${r.label}</span></td>
      <td style="font-family:var(--mono)">${r.energy.toFixed(4)}</td>
      <td><span class="badge badge-o">${r.reason}</span></td>
    </tr>`).join('');

  info.textContent = filtered.length === 0
    ? 'No results'
    : `Showing ${start+1}–${Math.min(start+PAGE_SIZE, filtered.length)} of ${filtered.length}`;
  btnP.disabled = page === 0;
  btnN.disabled = start + PAGE_SIZE >= filtered.length;
}

function sortBy(col) {
  if (sortCol === col) sortDir *= -1;
  else { sortCol = col; sortDir = 1; }
  filtered.sort((a, b) => {
    let va = a[col], vb = b[col];
    if (typeof va === 'string') return va.localeCompare(vb) * sortDir;
    return (va - vb) * sortDir;
  });
  page = 0;
  renderTable();
}

function filterTable(q) {
  q = q.toLowerCase();
  filtered = outliers.filter(r =>
    r.utt_id.toLowerCase().includes(q) ||
    r.label.includes(q) ||
    r.reason.toLowerCase().includes(q)
  );
  if (sortCol) {
    filtered.sort((a, b) => {
      let va = a[sortCol], vb = b[sortCol];
      if (typeof va === 'string') return va.localeCompare(vb) * sortDir;
      return (va - vb) * sortDir;
    });
  }
  page = 0;
  renderTable();
}

window.addEventListener('DOMContentLoaded', renderTable);
</script>
</body>
</html>
"""

# ── card builder ──
def chart_card(title, b64_img, badge=""):
    badge_html = f'<div class="chart-badge">{badge}</div>' if badge else ""
    return f"""
<div class="chart-card">
  <div class="chart-card-header">
    <div class="chart-title">{title}</div>
    {badge_html}
  </div>
  <div class="chart-body">
    <img src="data:image/png;base64,{b64_img}" alt="{title}" loading="lazy"/>
  </div>
</div>
"""


# ═══════════════════════════════════════════════════════════════════════════════
# Summary printer
# ═══════════════════════════════════════════════════════════════════════════════

def print_summary(utt_ids, utt2label, spk2utt, feats):
    sep = "-" * 56
    print(f"\n{sep}\n  Dataset Summary\n{sep}")
    cnt = defaultdict(int)
    for u in utt_ids: cnt[utt2label.get(u, "normal")] += 1
    print(f"  Total utterances : {len(utt_ids):,}")
    for k in sorted(cnt):
        print(f"    {k:12s}: {cnt[k]:6,}  ({cnt[k]/len(utt_ids)*100:.1f}%)")
    if spk2utt:
        cnts = [len(v) for v in spk2utt.values()]
        print(f"\n  Speakers        : {len(spk2utt):,}")
        print(f"    Mean utts/spk : {np.mean(cnts):.1f}")
    if feats:
        s = next(iter(feats.values()))
        print(f"\n  Features loaded : {len(feats):,}")
        print(f"  FBank dim       : {s.shape[1]}")
    print(f"{sep}\n")


# ═══════════════════════════════════════════════════════════════════════════════
# HTML assembly
# ═══════════════════════════════════════════════════════════════════════════════

def build_html(utt_ids, utt2label, spk2utt, feats, out_path):
    print("[html] rendering charts ...")

    # ── overview section ──
    print("  overview: pie chart ...")
    pie_b64 = fig_to_b64(make_pie_chart(utt2label))
    plt.close("all")

    overview_cards = chart_card("Class Distribution", pie_b64, "utterances")

    if spk2utt:
        print("  overview: utts-per-spk histogram ...")
        hist_b64 = fig_to_b64(make_utts_per_spk_hist(spk2utt, utt2label))
        plt.close("all")
        overview_cards += chart_card("Utts-per-Speaker Histogram", hist_b64, "density")

    # ── speaker section ──
    print("  speakers: bar chart ...")
    spk_b64 = fig_to_b64(make_spk_bar(spk2utt, utt2label))
    plt.close("all")
    speaker_cards = chart_card("Top-50 Speakers by Utterance Count", spk_b64, "stacked bar")

    if spk2utt:
        print("  speakers: ratio bar ...")
        ratio_b64 = fig_to_b64(make_ratio_bar(spk2utt, utt2label))
        plt.close("all")
        speaker_cards += chart_card("Abnormal Ratio per Speaker", ratio_b64, "top 40")

    # ── feature section ──
    if feats:
        print("  features: mean/std ...")
        ms_b64 = fig_to_b64(make_feat_mean_std(feats, utt2label))
        plt.close("all")

        print("  features: energy hist ...")
        eh_b64 = fig_to_b64(make_energy_hist(feats, utt2label))
        plt.close("all")

        print("  features: length vs energy ...")
        lv_b64 = fig_to_b64(make_len_vs_energy(feats, utt2label))
        plt.close("all")

        print("  features: variance per dim ...")
        vd_b64 = fig_to_b64(make_variance_per_dim(feats, utt2label))
        plt.close("all")

        print("  features: boxplot ...")
        bp_b64 = fig_to_b64(make_energy_boxplot(feats, utt2label))
        plt.close("all")

        print("  features: heatmaps ...")
        n_utts = [u for u in feats if utt2label.get(u, "normal") == "normal"]
        a_utts = [u for u in feats if utt2label.get(u, "normal") == "abnormal"]
        hm_cards = ""
        if n_utts:
            u = np.random.choice(n_utts)
            hm_b64 = fig_to_b64(make_heatmap(feats[u], f"Normal — {u[:50]}"))
            plt.close("all")
            hm_cards += chart_card("FBank Heatmap · Normal Sample", hm_b64, "example")
        if a_utts:
            u = np.random.choice(a_utts)
            hm_b64 = fig_to_b64(make_heatmap(feats[u], f"Abnormal — {u[:50]}"))
            plt.close("all")
            hm_cards += chart_card("FBank Heatmap · Abnormal Sample", hm_b64, "example")

        feature_content = f"""
<div class="chart-grid full" style="margin-bottom:1.4rem">
  {chart_card("FBank Mean & Std per Filter Bank", ms_b64, "mean ± 1 SD")}
</div>
<div class="chart-grid" style="margin-bottom:1.4rem">
  {chart_card("Frame-Mean Energy Distribution", eh_b64, "density")}
  {chart_card("Utterance Length vs. Mean Energy", lv_b64, "scatter")}
</div>
<div class="chart-grid" style="margin-bottom:1.4rem">
  {chart_card("Variance per Filter Bank", vd_b64, "dotted = top-5 diverging")}
  {chart_card("Energy Boxplot by Class", bp_b64, "with jitter")}
</div>
<div class="chart-grid" style="margin-bottom:1.4rem">
  {hm_cards}
</div>"""
    else:
        feature_content = """
<div class="empty">
  <strong>No feature data available</strong>
  Run with <code>--feats-dir</code> pointing to a directory containing feats.scp.
</div>"""

    # ── outlier table ──
    stats = collect_stats(utt_ids, utt2label, spk2utt, feats)
    n_out = len(stats["outliers"])
    if n_out:
        outlier_content = f"""
<div class="table-wrap">
  <div class="table-toolbar">
    <span style="font-size:.78rem;color:var(--sub)">
      <strong style="color:var(--text)">{n_out:,}</strong> outlier utterances detected
    </span>
    <input type="text" id="osearch" placeholder="Filter by utt_id, label, reason…"
           oninput="filterTable(this.value)"/>
  </div>
  <div style="overflow-x:auto">
  <table>
    <thead>
      <tr>
        <th onclick="sortBy('utt_id')">Utterance ID ↕</th>
        <th onclick="sortBy('label')">Label ↕</th>
        <th onclick="sortBy('energy')">Energy ↕</th>
        <th onclick="sortBy('reason')">Reason ↕</th>
      </tr>
    </thead>
    <tbody id="otbody"></tbody>
  </table>
  </div>
  <div class="pager">
    <span id="oinfo"></span>
    <div style="display:flex;gap:.5rem">
      <button id="oprev" onclick="page--;renderTable()">← Prev</button>
      <button id="onext" onclick="page++;renderTable()">Next →</button>
    </div>
  </div>
</div>"""
    else:
        outlier_content = """
<div class="empty">
  <strong>No outliers detected</strong>
  No utterances exceeded the Z-score threshold of 2.8 for frame-mean energy.
</div>"""

    # ── assemble ──
    html = HTML_TEMPLATE
    html = html.replace("__OVERVIEW_CARDS__",  overview_cards)
    html = html.replace("__SPEAKER_CARDS__",   speaker_cards)
    html = html.replace("__FEATURE_CONTENT__", feature_content)
    html = html.replace("__OUTLIER_CONTENT__", outlier_content)
    html = html.replace("__STATS_JSON__",      json.dumps(stats))

    with open(out_path, "w", encoding="utf-8") as f:
        f.write(html)
    print(f"\n  [saved] {out_path}  ({os.path.getsize(out_path)//1024:,} KB)")


