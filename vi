# Main
# ═══════════════════════════════════════════════════════════════════════════════

def main():
    ap = argparse.ArgumentParser(description="Generate self-contained Kaldi visualization HTML")
    ap.add_argument("--data-dir",         required=True)
    ap.add_argument("--feats-dir",        default=None)
    ap.add_argument("--scp-name",         default="feats.scp")
    ap.add_argument("--output",           default="kaldi_vis.html")
    ap.add_argument("--sample-per-class", type=int, default=2000)
    ap.add_argument("--normal-keyword",   default="normal")
    ap.add_argument("--abnormal-keyword", default="abnormal")
    args = ap.parse_args()

    data_dir = Path(args.data_dir)
    print(f"\n[data dir] {data_dir}")

    utt2spk_path = data_dir / "utt2spk"
    if not utt2spk_path.exists():
        print(f"[ERROR] not found: {utt2spk_path}"); sys.exit(1)

    utt2spk   = read_utt2spk(utt2spk_path)
    spk2utt   = read_spk2utt(data_dir / "spk2utt")
    utt_ids   = list(utt2spk.keys())
    utt2label = build_utt2label(utt2spk, args.normal_keyword, args.abnormal_keyword)

    n_norm = sum(1 for v in utt2label.values() if v == "normal")
    n_abnm = sum(1 for v in utt2label.values() if v == "abnormal")
    print(f"  utterances: {len(utt_ids):,}  |  normal: {n_norm:,}  abnormal: {n_abnm:,}")

    feats = {}
    feats_dir = Path(args.feats_dir) if args.feats_dir else data_dir
    scp_path  = feats_dir / args.scp_name
    if scp_path.exists():
        print(f"[feats] {scp_path}")
        feats = sample_scp_balanced(str(scp_path), utt2label, args.sample_per_class)
    else:
        print(f"  [note] {scp_path} not found — feature sections will be empty")

    print("[building export] ...")
    export = build_export(utt2spk, spk2utt, utt2label, feats, args)

    print("[generating HTML] ...")
    json_str = json.dumps(export, separators=(',', ':'))
    html = HTML_TEMPLATE.format(
        dataset_name = export["dataset_name"],
        conf         = export["conf"],
        n_utts       = len(utt_ids),
        n_speakers   = len(spk2utt),
        json_data    = json_str,
    )

    out_path = Path(args.output)
    with open(out_path, "w", encoding="utf-8") as f:
        f.write(html)

    size_mb = out_path.stat().st_size / 1024 / 1024
    print(f"\n✅ Done: {out_path}  ({size_mb:.1f} MB)")
    print("   Open in any browser — no server needed\n")


if __name__ == "__main__":
    main()
