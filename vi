}};
let charts={{}}, heatmapClass='normal';

function zscore(arr){{
  const mu=arr.reduce((s,v)=>s+v,0)/arr.length;
  const sd=Math.sqrt(arr.reduce((s,v)=>s+(v-mu)**2,0)/arr.length)+1e-9;
  return arr.map(v=>Math.abs((v-mu)/sd));
}}
function histogram(values,bins=40){{
  const mn=Math.min(...values),mx=Math.max(...values),step=(mx-mn)/bins;
  const counts=new Array(bins).fill(0);
  const labels=Array.from({{length:bins}},(_,i)=>(mn+i*step).toFixed(2));
  values.forEach(v=>{{const idx=Math.min(Math.floor((v-mn)/step),bins-1);counts[idx]++;}});
  return {{labels,counts}};
}}
function dc(id){{if(charts[id]){{charts[id].destroy();delete charts[id];}}}}
