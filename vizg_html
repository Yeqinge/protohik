<script>
try {
const DATA = __DATA_PLACEHOLDER__;
const TC={harmful_suspect:"#ef4444",hard:"#f59e0b",high_influence:"#8b5cf6",normal:"#6b7280",easy_redundant:"#22c55e"};
const TL={harmful_suspect:"有害嫌疑",hard:"关键难样本",high_influence:"高影响力",normal:"正常",easy_redundant:"冗余易样本"};
const PS=50;
let filt=[],pg=0,selId=null,gC=null,aC=null;
document.getElementById("sub").textContent=DATA.total.toLocaleString()+" total · "+DATA.exported.toLocaleString()+" exported · "+DATA.epochs.length+" epochs";

// 标签图
var tgs=Object.entries(DATA.tag_counts).sort(function(a,b){return b[1]-a[1]});
new Chart(document.getElementById("cTag"),{type:"bar",data:{labels:tgs.map(function(t){return TL[t[0]]||t[0]}),datasets:[{data:tgs.map(function(t){return t[1]}),backgroundColor:tgs.map(function(t){return TC[t[0]]||"#666"}),borderRadius:4}]},options:{indexAxis:"y",responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{x:{ticks:{color:"#555",font:{size:10}},grid:{color:"#1a1a24"}},y:{ticks:{color:"#999",font:{size:11}},grid:{display:false}}}}});

// 散点图
var pts=DATA.samples.slice(0,3000);
var byT={};
pts.forEach(function(s){(byT[s.tag]=byT[s.tag]||[]).push({x:s.mgn,y:s.ma})});
new Chart(document.getElementById("cScat"),{type:"scatter",data:{datasets:Object.entries(byT).map(function(e){return{label:TL[e[0]]||e[0],data:e[1],backgroundColor:TC[e[0]]||"#666",pointRadius:2}})},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{labels:{color:"#888",font:{size:10},boxWidth:10}}},scales:{x:{title:{display:true,text:"grad_norm",color:"#555",font:{size:10}},ticks:{color:"#555",font:{size:9}},grid:{color:"#1a1a24"}},y:{title:{display:true,text:"align",color:"#555",font:{size:10}},ticks:{color:"#555",font:{size:9}},grid:{color:"#1a1a24"}}}}});

// 标签筛选器
var fTag=document.getElementById("fTag");
Object.keys(TC).forEach(function(t){var o=document.createElement("option");o.value=t;o.textContent=(TL[t]||t)+" ("+(DATA.tag_counts[t]||0)+")";fTag.appendChild(o)});

// 表头
var cols=DATA.has_utt?[["utt","UTT-ID"],["id","ID"],["tag","标签"],["si","Self Inf"],["mgn","Grad Norm"],["ma","Align"],["fna","负对齐%"],["fe","遗忘"],["fc","末轮"]]:[["id","ID"],["tag","标签"],["si","Self Inf"],["mgn","Grad Norm"],["ma","Align"],["fna","负对齐%"],["fe","遗忘"],["fc","末轮"]];
document.getElementById("thd").innerHTML="<tr>"+cols.map(function(c){return"<th>"+c[1]+"</th>"}).join("")+"</tr>";

function applyF(){
  var tag=fTag.value,q=document.getElementById("fQ").value.trim().toLowerCase(),sk=document.getElementById("fSort").value;
  var rows=DATA.samples;
  if(tag!=="all") rows=rows.filter(function(s){return s.tag===tag});
  if(q) rows=rows.filter(function(s){return(s.utt||s.id).toLowerCase().indexOf(q)>=0||s.id.indexOf(q)>=0});
  rows=rows.slice();
  if(sk==="ma_asc") rows.sort(function(a,b){return a.ma-b.ma});
  else if(sk==="ma_desc") rows.sort(function(a,b){return b.ma-a.ma});
  else rows.sort(function(a,b){return(b[sk]||0)-(a[sk]||0)});
  filt=rows;pg=0;render()
}

function render(){
  var tp=Math.max(1,Math.ceil(filt.length/PS));
  document.getElementById("pInfo").textContent=filt.length.toLocaleString()+" 条 · 第 "+(pg+1)+"/"+tp+" 页";
  document.getElementById("bPrev").disabled=pg===0;
  document.getElementById("bNext").disabled=pg>=tp-1;
  var sl=filt.slice(pg*PS,(pg+1)*PS);
  var tb=document.getElementById("tbd");tb.innerHTML="";
  sl.forEach(function(s){
    var tr=document.createElement("tr");
    tr.className="r"+(s.id===selId?" sel":"");
    tr.onclick=function(){selSample(s)};
    var c=[];
    if(DATA.has_utt) c.push('<td style="max-width:220px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="'+(s.utt||"")+'">'+(s.utt||"")+"</td>");
    c.push('<td style="color:#888">'+s.id+"</td>");
    c.push('<td><span class="tg tg-'+s.tag+'">'+(TL[s.tag]||s.tag)+"</span></td>");
    c.push("<td>"+(s.si!=null?s.si.toFixed(1):"—")+"</td>");
    c.push("<td>"+(s.mgn!=null?s.mgn.toFixed(4):"—")+"</td>");
    c.push('<td class="'+(s.ma<0?"neg":"pos")+'">'+(s.ma!=null?s.ma.toFixed(4):"—")+"</td>");
    c.push("<td>"+((s.fna!=null?(s.fna*100).toFixed(0):"-"))+"%</td>");
    c.push('<td style="color:'+(s.fe>=2?"#f59e0b":"#666")+'">'+(s.fe!=null?s.fe:"—")+"</td>");
    c.push('<td class="'+(s.fc===1?"pos":s.fc===0?"neg":"dim")+'">'+(s.fc===1?"✓":s.fc===0?"✗":"—")+"</td>");
    tr.innerHTML=c.join("");
    tb.appendChild(tr)
  })
}

function selSample(s){
  selId=s.id;
  var sec=document.getElementById("trajSec");sec.style.display="block";
  document.getElementById("tTag").innerHTML='<span class="tg tg-'+s.tag+'">'+(TL[s.tag]||s.tag)+"</span>";
  document.getElementById("tName").textContent=s.utt||s.id;
  document.getElementById("tMeta").textContent="SI="+s.si+"  GN="+s.mgn+"  Align="+s.ma+"  Forget="+s.fe;
  var lb=DATA.epochs.map(function(e){return"ep"+e});
  if(gC)gC.destroy();if(aC)aC.destroy();
  gC=new Chart(document.getElementById("cGn"),{type:"line",data:{labels:lb,datasets:[{label:"grad_norm",data:s.tgn,borderColor:"#f59e0b",backgroundColor:"#f59e0b",pointRadius:4,tension:.2,spanGaps:true}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{x:{ticks:{color:"#555",font:{size:10}},grid:{color:"#1a1a24"}},y:{ticks:{color:"#555",font:{size:10}},grid:{color:"#1a1a24"}}}}});
  aC=new Chart(document.getElementById("cAl"),{type:"line",data:{labels:lb,datasets:[{label:"align",data:s.tal,borderColor:"#3b82f6",backgroundColor:"#3b82f6",pointRadius:4,tension:.2,spanGaps:true},{label:"零线",data:DATA.epochs.map(function(){return 0}),borderColor:"#ef4444",borderDash:[4,4],pointRadius:0}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{x:{ticks:{color:"#555",font:{size:10}},grid:{color:"#1a1a24"}},y:{ticks:{color:"#555",font:{size:10}},grid:{color:"#1a1a24"}}}}});
  render();
  sec.scrollIntoView({behavior:"smooth",block:"start"})
}

function pPrev(){if(pg>0){pg--;render()}}
function pNext(){var tp=Math.ceil(filt.length/PS);if(pg<tp-1){pg++;render()}}

fTag.addEventListener("change",applyF);
document.getElementById("fSort").addEventListener("change",applyF);
document.getElementById("fQ").addEventListener("input",applyF);
applyF();

} catch(err) {
  var box=document.getElementById("errBox");
  box.style.display="block";
  box.textContent="JavaScript 错误:\\n"+err.message+"\\n\\n"+err.stack;
}
</script>
</body>
</html>"""


def main():
    parser = argparse.ArgumentParser(description="生成自包含 HTML 可视化")
    parser.add_argument("--contrib-dir", required=True)
    parser.add_argument("--summary-csv", required=True)
    parser.add_argument("--output", default=None)
    parser.add_argument("--max-rows", type=int, default=10000)
    args = parser.parse_args()
    out = args.output or os.path.join(args.contrib_dir, "viz.html")

    print("[gen_viz] 收集数据 ...")
    data_json = collect_data(args.contrib_dir, args.summary_csv, args.max_rows)
    print(f"[gen_viz] JSON 大小: {len(data_json)/1024/1024:.1f} MB")
    html = HTML_TEMPLATE.replace("__DATA_PLACEHOLDER__", data_json)
    with open(out, "w", encoding="utf-8") as f:
        f.write(html)
    size_mb = os.path.getsize(out) / 1024 / 1024
    print(f"[gen_viz] 已生成 {out}  ({size_mb:.1f} MB)")


if __name__ == "__main__":
    main()
