# -*- coding: utf-8 -*-
"""
gen_viz_html.py
读 npz + summary CSV → 输出一个自包含 HTML 可视化。浏览器直接打开。

用法:
  python3 gen_viz_html.py \
    --contrib-dir  model_exp/.../contrib \
    --summary-csv  model_exp/.../contrib/contrib_summary_with_uttid.csv \
    --output       model_exp/.../contrib/viz.html \
    --max-rows     10000
"""

import argparse, os, glob, json, csv, math
import numpy as np
from collections import Counter


def sf(v, default=0):
    """safe float: nan/inf/空字符串 → default"""
    if isinstance(v, float) and (math.isnan(v) or math.isinf(v)):
        return default
    try:
        f = float(v)
        return default if (math.isnan(f) or math.isinf(f)) else round(f, 4)
    except (ValueError, TypeError):
        return default


class SafeEncoder(json.JSONEncoder):
    """NaN/Inf → null, numpy 类型 → Python 原生"""
    def default(self, o):
        if isinstance(o, (np.integer,)):
            return int(o)
        if isinstance(o, (np.floating,)):
            v = float(o)
            return None if (math.isnan(v) or math.isinf(v)) else v
        if isinstance(o, np.ndarray):
            return o.tolist()
        return super().default(o)

    def encode(self, o):
        return super().encode(self._clean(o))

    def _clean(self, o):
        if isinstance(o, float):
            return None if (math.isnan(o) or math.isinf(o)) else o
        if isinstance(o, dict):
            return {k: self._clean(v) for k, v in o.items()}
        if isinstance(o, (list, tuple)):
            return [self._clean(v) for v in o]
        if isinstance(o, (np.floating,)):
            v = float(o)
            return None if (math.isnan(v) or math.isinf(v)) else v
        if isinstance(o, (np.integer,)):
            return int(o)
        return o


def collect_data(contrib_dir, summary_csv, max_rows):
    with open(summary_csv) as f:
        all_rows = list(csv.DictReader(f))
    has_utt = "utt_id" in all_rows[0] if all_rows else False
    tag_counts = dict(Counter(r.get("tag", "normal") for r in all_rows))
    total = len(all_rows)

    priority = {"harmful_suspect": 0, "hard": 1, "high_influence": 2, "normal": 3, "easy_redundant": 4}
    all_rows.sort(key=lambda r: (priority.get(r.get("tag", "normal"), 9), -sf(r.get("self_influence", 0))))
    selected = all_rows[:max_rows]
    selected_ids = set(r["id"] for r in selected)

    files = sorted(glob.glob(os.path.join(contrib_dir, "contrib_epoch*.npz")))
    epochs = []
    traj = {}
    sel_arr = np.array(list(selected_ids))
    for f in files:
        ep = int(os.path.basename(f)[len("contrib_epoch"):-len(".npz")])
        epochs.append(ep)
        d = np.load(f, allow_pickle=True)
        ids_arr = d["ids"].astype(str)
        mask = np.isin(ids_arr, sel_arr)
        hit_ids = ids_arr[mask]
        hit_gn = d["grad_norm"][mask]
        hit_al = d["align"][mask]
        for k in range(len(hit_ids)):
            gn = float(hit_gn[k]); al = float(hit_al[k])
            traj.setdefault(hit_ids[k], {})[ep] = (
                round(gn, 4) if not math.isnan(gn) else None,
                round(al, 4) if not math.isnan(al) else None,
            )
        print(f"  epoch {ep}: {mask.sum()} matched")
    epochs.sort()

    samples = []
    for r in selected:
        sid = r["id"]
        ep_data = traj.get(sid, {})
        tgn = [ep_data.get(e, (None, None))[0] for e in epochs]
        tal = [ep_data.get(e, (None, None))[1] for e in epochs]
        entry = {
            "id": sid,
            "tag": r.get("tag", "normal"),
            "mgn": sf(r.get("mean_grad_norm", 0)),
            "si": sf(r.get("self_influence", 0)),
            "ma": sf(r.get("mean_align", 0)),
            "fna": sf(r.get("frac_neg_align", 0)),
            "fe": int(sf(r.get("forget_events", 0))),
            "fc": int(sf(r.get("final_correct", -1), -1)),
            "tgn": tgn,
            "tal": tal,
        }
        if has_utt:
            entry["utt"] = r.get("utt_id", "")
        samples.append(entry)

    data = {
        "total": total, "exported": len(samples), "tag_counts": tag_counts,
        "epochs": epochs, "has_utt": has_utt, "samples": samples,
    }
    return json.dumps(data, ensure_ascii=False, cls=SafeEncoder)


