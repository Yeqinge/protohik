# -*- coding: utf-8 -*-
"""
gen_viz_html.py
一个脚本搞定：读 npz + summary CSV，输出一个自包含的 HTML 可视化文件。

用法:
  python3 gen_viz_html.py \
    --contrib-dir  model_exp/.../contrib \
    --summary-csv  model_exp/.../contrib/contrib_summary_with_uttid.csv \
    --output       model_exp/.../contrib/viz.html \
    --max-rows     10000
"""

import argparse, os, glob, json, csv
import numpy as np
from collections import Counter


def collect_data(contrib_dir, summary_csv, max_rows):
    # 读 summary
    with open(summary_csv) as f:
        all_rows = list(csv.DictReader(f))
    has_utt = "utt_id" in all_rows[0] if all_rows else False
    tag_counts = dict(Counter(r.get("tag", "normal") for r in all_rows))
    total = len(all_rows)

    # 选样本：优先 harmful_suspect > hard > high_influence > normal > easy
    priority = {"harmful_suspect": 0, "hard": 1, "high_influence": 2, "normal": 3, "easy_redundant": 4}
    all_rows.sort(key=lambda r: (priority.get(r.get("tag", "normal"), 9), -float(r.get("self_influence", 0))))
    selected = all_rows[:max_rows]
    selected_ids = set(r["id"] for r in selected)

    # 读 npz 轨迹
    files = sorted(glob.glob(os.path.join(contrib_dir, "contrib_epoch*.npz")))
    epochs = []
    traj = {}
    for f in files:
        ep = int(os.path.basename(f)[len("contrib_epoch"):-len(".npz")])
        epochs.append(ep)
        d = np.load(f, allow_pickle=True)
        ids_arr = d["ids"].astype(str)
        for k in range(len(ids_arr)):
            sid = ids_arr[k]
            if sid in selected_ids:
                traj.setdefault(sid, {})[ep] = (
                    round(float(d["grad_norm"][k]), 4),
                    round(float(d["align"][k]), 4),
                )
        print(f"  epoch {ep} loaded")
    epochs.sort()

    samples = []
    for r in selected:
        sid = r["id"]
        ep_data = traj.get(sid, {})
        tgn = [ep_data.get(e, (None, None))[0] for e in epochs]
        tal = [ep_data.get(e, (None, None))[1] for e in epochs]
        entry = {
            "id": sid,
            "tag": r.get("tag", "normal"),
            "mgn": round(float(r.get("mean_grad_norm", 0)), 4),
            "si": round(float(r.get("self_influence", 0)), 2),
            "ma": round(float(r.get("mean_align", 0)), 4),
            "fna": round(float(r.get("frac_neg_align", 0)), 3),
            "fe": int(r.get("forget_events", 0)),
            "fc": int(r.get("final_correct", -1)),
            "tgn": tgn,
            "tal": tal,
        }
        if has_utt:
            entry["utt"] = r.get("utt_id", "")
        samples.append(entry)

    return json.dumps({
        "total": total, "exported": len(samples), "tag_counts": tag_counts,
        "epochs": epochs, "has_utt": has_utt, "samples": samples,
    }, ensure_ascii=False)


HTML_TEMPLATE = r"""<!DOCTYPE html>
<html lang="zh">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Sample Contribution Tracker</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<style>
  * { margin:0; padding:0; box-sizing:border-box; }
  body { background:#0a0a0f; color:#d0d0dc; font-family:'JetBrains Mono','Fira Code','SF Mono','Consolas',monospace; font-size:12px; }
  .wrap { max-width:1260px; margin:0 auto; padding:20px 24px; }
  h1 { font-size:20px; font-weight:800; color:#e0e0ef; letter-spacing:-0.5px; }
  .subtitle { font-size:11px; color:#555; margin-left:16px; }
  .header { display:flex; align-items:baseline; gap:8px; margin-bottom:20px; }
  .charts { display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:20px; }
  .card { background:#16161e; border-radius:8px; padding:18px; }
  .card-title { font-size:12px; font-weight:700; color:#8888a0; margin-bottom:10px; }
  .traj-section { display:none; margin-bottom:20px; }
  .traj-section.active { display:block; }
  .traj-header { display:flex; align-items:center; gap:12px; margin-bottom:14px; }
  .traj-name { font-size:14px; font-weight:700; color:#e0e0e8; }
  .traj-meta { font-size:11px; color:#666; }
  .traj-charts { display:grid; grid-template-columns:1fr 1fr; gap:16px; }
  .controls { display:flex; gap:10px; margin-bottom:12px; flex-wrap:wrap; align-items:center; }
  select,input[type=text] { background:#1e1e2a; color:#ccc; border:1px solid #333; border-radius:4px; padding:6px 10px; font-size:12px; font-family:inherit; outline:none; }
  input[type=text] { flex:1; min-width:180px; }
  .page-info { font-size:11px; color:#555; margin-left:auto; }
  table { width:100%; border-collapse:collapse; }
  th { padding:8px 10px; text-align:left; font-size:10px; font-weight:700; color:#555; text-transform:uppercase; letter-spacing:1px; border-bottom:1px solid #222; position:sticky; top:0; background:#16161e; cursor:pointer; user-select:none; }
  th:hover { color:#aaa; }
  td { padding:6px 10px; font-size:12px; color:#c0c0cc; border-bottom:1px solid #1a1a24; font-variant-numeric:tabular-nums; }
  tr.row { cursor:pointer; transition:background .12s; }
  tr.row:hover { background:#1a1a28; }
  tr.row.selected { background:#1e1e3a; }
  .tag { display:inline-block; padding:2px 8px; border-radius:4px; font-size:10px; font-weight:700; color:#fff; letter-spacing:.5px; white-space:nowrap; }
  .tag-harmful_suspect { background:#ef4444; }
  .tag-hard { background:#f59e0b; }
  .tag-high_influence { background:#8b5cf6; }
  .tag-normal { background:#4b5563; }
  .tag-easy_redundant { background:#22c55e; }
  .neg { color:#ef4444; }
  .pos { color:#22c55e; }
  .dim { color:#444; }
  .pager { display:flex; justify-content:center; gap:6px; margin-top:12px; }
  .btn { background:#1e1e2a; color:#aaa; border:1px solid #333; border-radius:4px; padding:5px 14px; font-size:11px; cursor:pointer; font-family:inherit; }
  .btn:disabled { opacity:.3; cursor:default; }
  .hint { font-size:11px; color:#444; margin-bottom:8px; }
  .table-wrap { max-height:460px; overflow:auto; }
</style>
</head>
<body>
<div class="wrap">
  <div class="header">
    <h1>Sample Contribution Tracker</h1>
    <span class="subtitle" id="subtitle"></span>
  </div>
  <div class="charts">
    <div class="card"><div class="card-title">标签分布（全量）</div><canvas id="tagChart" height="200"></canvas></div>
    <div class="card"><div class="card-title">Grad Norm vs Align（前 3000）</div><canvas id="scatterChart" height="200"></canvas></div>
  </div>
  <div class="traj-section" id="trajSection">
    <div class="card">
      <div class="traj-header">
        <span id="trajTag"></span>
        <span class="traj-name" id="trajName"></span>
        <span class="traj-meta" id="trajMeta"></span>
      </div>
      <div class="traj-charts">
        <div><div class="card-title">Gradient Norm（越高=越难）</div><canvas id="gnChart" height="180"></canvas></div>
        <div><div class="card-title">Alignment（负=逆共识=有害嫌疑）</div><canvas id="alChart" height="180"></canvas></div>
      </div>
    </div>
  </div>
  <div class="hint">👆 点击表格中的样本查看梯度随 epoch 的变化轨迹</div>
  <div class="card">
    <div class="controls">
      <select id="tagFilter"><option value="all">全部标签</option></select>
      <select id="sortKey">
        <option value="si">Self Influence ↓</option>
        <option value="mgn">Grad Norm ↓</option>
        <option value="ma_desc">Align ↑</option>
        <option value="ma_asc">Align ↓（最负）</option>
        <option value="fna">负对齐占比 ↓</option>
        <option value="fe">遗忘次数 ↓</option>
      </select>
      <input type="text" id="searchBox" placeholder="搜索 utt-id / sample id ...">
      <span class="page-info" id="pageInfo"></span>
    </div>
    <div class="table-wrap"><table><thead id="thead"></thead><tbody id="tbody"></tbody></table></div>
    <div class="pager">
      <button class="btn" id="prevBtn" onclick="goPrev()">← 上一页</button>
      <button class="btn" id="nextBtn" onclick="goNext()">下一页 →</button>
    </div>
  </div>
</div>
<script>
const DATA = __DATA_PLACEHOLDER__;
const TAG_COLORS = {harmful_suspect:"#ef4444",hard:"#f59e0b",high_influence:"#8b5cf6",normal:"#6b7280",easy_redundant:"#22c55e"};
const TAG_LABELS = {harmful_suspect:"有害嫌疑",hard:"关键难样本",high_influence:"高影响力",normal:"正常",easy_redundant:"冗余易样本"};
const PAGE_SIZE = 50;
let filtered = [], page = 0, selectedId = null, gnChartObj = null, alChartObj = null;

document.getElementById("subtitle").textContent =
  `${DATA.total.toLocaleString()} total · ${DATA.exported.toLocaleString()} exported · ${DATA.epochs.length} epochs`;

// --- 标签分布图 ---
{
  const tags = Object.entries(DATA.tag_counts).sort((a,b)=>b[1]-a[1]);
  new Chart(document.getElementById("tagChart"), {
    type:"bar",
    data:{labels:tags.map(t=>TAG_LABELS[t[0]]||t[0]),datasets:[{data:tags.map(t=>t[1]),backgroundColor:tags.map(t=>TAG_COLORS[t[0]]||"#666"),borderRadius:4}]},
    options:{indexAxis:"y",responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false},tooltip:{callbacks:{label:c=>c.raw.toLocaleString()}}},scales:{x:{ticks:{color:"#555",font:{size:10}},grid:{color:"#1a1a24"}},y:{ticks:{color:"#999",font:{size:11}},grid:{display:false}}}}
  });
}

// --- 散点图 ---
{
  const pts = DATA.samples.slice(0,3000);
  const byTag = {};
  pts.forEach(s => { (byTag[s.tag] = byTag[s.tag]||[]).push({x:s.mgn,y:s.ma}); });
  new Chart(document.getElementById("scatterChart"), {
    type:"scatter",
    data:{datasets:Object.entries(byTag).map(([tag,d])=>({label:TAG_LABELS[tag]||tag,data:d,backgroundColor:TAG_COLORS[tag]||"#666",pointRadius:2}))},
    options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{labels:{color:"#888",font:{size:10},boxWidth:10}}},scales:{x:{title:{display:true,text:"grad_norm",color:"#555",font:{size:10}},ticks:{color:"#555",font:{size:9}},grid:{color:"#1a1a24"}},y:{title:{display:true,text:"align",color:"#555",font:{size:10}},ticks:{color:"#555",font:{size:9}},grid:{color:"#1a1a24"}}}}
  });
}

// --- 表格 ---
const tagFilter = document.getElementById("tagFilter");
Object.entries(TAG_COLORS).forEach(([t])=>{
  const opt = document.createElement("option");
  opt.value=t; opt.textContent=`${TAG_LABELS[t]} (${DATA.tag_counts[t]||0})`;
  tagFilter.appendChild(opt);
});
const cols = DATA.has_utt
  ? [{k:"utt",l:"UTT-ID"},{k:"id",l:"ID"},{k:"tag",l:"标签"},{k:"si",l:"Self Inf"},{k:"mgn",l:"Grad Norm"},{k:"ma",l:"Align"},{k:"fna",l:"负对齐%"},{k:"fe",l:"遗忘"},{k:"fc",l:"末轮正确"}]
  : [{k:"id",l:"ID"},{k:"tag",l:"标签"},{k:"si",l:"Self Inf"},{k:"mgn",l:"Grad Norm"},{k:"ma",l:"Align"},{k:"fna",l:"负对齐%"},{k:"fe",l:"遗忘"},{k:"fc",l:"末轮正确"}];
document.getElementById("thead").innerHTML = "<tr>" + cols.map(c=>`<th>${c.l}</th>`).join("") + "</tr>";

function applyFilter() {
  const tag = tagFilter.value;
  const q = document.getElementById("searchBox").value.trim().toLowerCase();
  const sk = document.getElementById("sortKey").value;
  let rows = DATA.samples;
  if (tag !== "all") rows = rows.filter(s => s.tag === tag);
  if (q) rows = rows.filter(s => (s.utt||s.id).toLowerCase().includes(q) || s.id.includes(q));
  rows = [...rows];
  if (sk === "ma_asc") rows.sort((a,b) => a.ma - b.ma);
  else if (sk === "ma_desc") rows.sort((a,b) => b.ma - a.ma);
  else rows.sort((a,b) => (b[sk]||0) - (a[sk]||0));
  filtered = rows; page = 0; render();
}

function render() {
  const totalPages = Math.max(1, Math.ceil(filtered.length / PAGE_SIZE));
  document.getElementById("pageInfo").textContent = `${filtered.length.toLocaleString()} 条 · 第 ${page+1}/${totalPages} 页`;
  document.getElementById("prevBtn").disabled = page === 0;
  document.getElementById("nextBtn").disabled = page >= totalPages - 1;
  const slice = filtered.slice(page * PAGE_SIZE, (page+1) * PAGE_SIZE);
  const tbody = document.getElementById("tbody");
  tbody.innerHTML = "";
  slice.forEach(s => {
    const tr = document.createElement("tr");
    tr.className = "row" + (s.id === selectedId ? " selected" : "");
    tr.onclick = () => selectSample(s);
    const cells = [];
    if (DATA.has_utt) cells.push(`<td style="max-width:220px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="${s.utt||''}">${s.utt||''}</td>`);
    cells.push(`<td style="color:#888">${s.id}</td>`);
    cells.push(`<td><span class="tag tag-${s.tag}">${TAG_LABELS[s.tag]||s.tag}</span></td>`);
    cells.push(`<td>${s.si.toFixed(1)}</td>`);
    cells.push(`<td>${s.mgn.toFixed(4)}</td>`);
    cells.push(`<td class="${s.ma<0?'neg':'pos'}">${s.ma.toFixed(4)}</td>`);
    cells.push(`<td>${(s.fna*100).toFixed(0)}%</td>`);
    cells.push(`<td style="color:${s.fe>=2?'#f59e0b':'#666'}">${s.fe}</td>`);
    cells.push(`<td class="${s.fc===1?'pos':s.fc===0?'neg':'dim'}">${s.fc===1?'✓':s.fc===0?'✗':'—'}</td>`);
    tr.innerHTML = cells.join("");
    tbody.appendChild(tr);
  });
}

function selectSample(s) {
  selectedId = s.id;
  const sec = document.getElementById("trajSection");
  sec.className = "traj-section active";
  document.getElementById("trajTag").innerHTML = `<span class="tag tag-${s.tag}">${TAG_LABELS[s.tag]||s.tag}</span>`;
  document.getElementById("trajName").textContent = s.utt || s.id;
  document.getElementById("trajMeta").textContent = `SI=${s.si}  GN=${s.mgn}  Align=${s.ma}  Forget=${s.fe}`;
  const labels = DATA.epochs.map(e => "ep"+e);
  if (gnChartObj) gnChartObj.destroy();
  if (alChartObj) alChartObj.destroy();
  gnChartObj = new Chart(document.getElementById("gnChart"), {
    type:"line",
    data:{labels, datasets:[{label:"grad_norm",data:s.tgn,borderColor:"#f59e0b",backgroundColor:"#f59e0b",pointRadius:4,tension:.2}]},
    options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{x:{ticks:{color:"#555",font:{size:10}},grid:{color:"#1a1a24"}},y:{ticks:{color:"#555",font:{size:10}},grid:{color:"#1a1a24"}}}}
  });
  alChartObj = new Chart(document.getElementById("alChart"), {
    type:"line",
    data:{labels, datasets:[
      {label:"align",data:s.tal,borderColor:"#3b82f6",backgroundColor:"#3b82f6",pointRadius:4,tension:.2},
      {label:"零线",data:DATA.epochs.map(()=>0),borderColor:"#ef4444",borderDash:[4,4],pointRadius:0}
    ]},
    options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{x:{ticks:{color:"#555",font:{size:10}},grid:{color:"#1a1a24"}},y:{ticks:{color:"#555",font:{size:10}},grid:{color:"#1a1a24"}}}}
  });
  render();
  sec.scrollIntoView({behavior:"smooth",block:"start"});
}

function goPrev() { if(page>0){page--;render();} }
function goNext() { const tp=Math.ceil(filtered.length/PAGE_SIZE); if(page<tp-1){page++;render();} }

tagFilter.addEventListener("change", applyFilter);
document.getElementById("sortKey").addEventListener("change", applyFilter);
document.getElementById("searchBox").addEventListener("input", applyFilter);
applyFilter();
</script>
</body>
</html>"""


def main():
    parser = argparse.ArgumentParser(description="生成自包含 HTML 可视化")
    parser.add_argument("--contrib-dir", required=True)
    parser.add_argument("--summary-csv", required=True)
    parser.add_argument("--output", default=None)
    parser.add_argument("--max-rows", type=int, default=10000)
    args = parser.parse_args()
    out = args.output or os.path.join(args.contrib_dir, "viz.html")

    print("[gen_viz] 收集数据 ...")
    data_json = collect_data(args.contrib_dir, args.summary_csv, args.max_rows)
    html = HTML_TEMPLATE.replace("__DATA_PLACEHOLDER__", data_json)
    with open(out, "w", encoding="utf-8") as f:
        f.write(html)
    size_mb = os.path.getsize(out) / 1024 / 1024
    print(f"[gen_viz] 已生成 {out}  ({size_mb:.1f} MB)")
    print(f"[gen_viz] 用浏览器打开即可，无需任何服务器。")


if __name__ == "__main__":
    main()
