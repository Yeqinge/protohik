        {label:'一致对齐度 (align)', data:al, borderColor:'#818cf8', backgroundColor:'rgba(129,140,248,.05)', borderWidth:2, pointRadius:3, yAxisID:'y2'}
      ]
    },
    options: {
      responsive: true, maintainAspectRatio: false, animation: {duration:100},
      interaction: {mode:'index', intersect:false},
      plugins: { legend: {display:false} },
      scales: {
        x: {grid:{color:'#1e2333'}, ticks:{color:'#5a658a', font:{family:'Fira Code',size:10}}},
        y: {grid:{color:'#1e2333'}, ticks:{color:'#f59e0b', font:{family:'Fira Code',size:10}}, title:{display:true,text:'梯度显著性',color:'#5a658a'}},
        y2:{position:'right', grid:{display:false}, ticks:{color:'#818cf8', font:{family:'Fira Code',size:10}}, title:{display:true,text:'优化方向对齐度 [-1, 1]',color:'#5a658a'}}
      }
    }
  });
}

