// ── 解压 utt_ids ──────────────────────────────────────────
let UTT_IDS = null;

async function decompressGzip(b64) {
  const bytes = Uint8Array.from(atob(b64), c => c.charCodeAt(0));
  const ds = new DecompressionStream('gzip');
  const w = ds.writable.getWriter(); w.write(bytes); w.close();
  const chunks = []; const r = ds.readable.getReader();
  while (true) { const {value, done} = await r.read(); if (done) break; chunks.push(value); }
  const total = chunks.reduce((s,c)=>s+c.length,0);
  const out = new Uint8Array(total); let off=0;
  for (const c of chunks) { out.set(c, off); off+=c.length; }
  return new TextDecoder().decode(out);
}

function setProgress(pct, msg) {
  document.getElementById('progress-fill').style.width = pct+'%';
  document.getElementById('ost').textContent = msg;
}

async function init() {
  setProgress(10, '解压 utt_ids...');
  try {
    const txt = await decompressGzip(UTT_GZ);
    UTT_IDS = txt.split('\n');
  } catch(e) {
    // fallback: use integer IDs
    UTT_IDS = Array.from({length:_N}, (_,i) => String(IDS[i]));
  }
  setProgress(60, '构建索引...');
  await new Promise(r => setTimeout(r, 0));
  buildIndex();
  setProgress(90, '渲染...');
  await new Promise(r => setTimeout(r, 0));
  buildTagBadges();
  rebuild();
  setProgress(100, '完成');
  document.getElementById('overlay').style.display = 'none';
  document.getElementById('app').style.display = '';
}

// ── 索引 & 筛选 ───────────────────────────────────────────
const PAGE = 100, ROW_H = 34;
let filtered = null;
let pageStart = 0;
let selIdx = -1;
let chart = null;
let stimer = null;

// 预排序索引（按 self_influence 降序，最常用）
let sortedBySI = null;
function buildIndex() {
  const idx = new Int32Array(_N);
  for (let i=0;i<_N;i++) idx[i]=i;
  idx.sort((a,b)=>SELF_INF[b]-SELF_INF[a]);
  sortedBySI = idx;
}

function getSort(key, i) {
  if (key==='si') return SELF_INF[i];
  if (key==='gn') return MEAN_GN[i];
  if (key==='al') return -MEAN_AL[i];   // ↑ means ascending, so negate
  if (key==='fn') return FRAC_NEG[i];
  if (key==='fo') return FORGET[i];
  return SELF_INF[i];
}

function rebuild() {
  const tagF = parseInt(document.getElementById('tag-f').value);
  const sk   = document.getElementById('sort-f').value;
  const q    = document.getElementById('search').value.trim().toLowerCase();

  let arr = [];
  // start from pre-sorted si index for speed when no other sort
  const base = sortedBySI || (() => { const a=new Int32Array(_N);for(let i=0;i<_N;i++)a[i]=i;return a; })();
  for (let j=0; j<_N; j++) {
    const i = base[j];
    if (tagF >= 0 && TAGS[i] !== tagF) continue;
    if (q) {
      const uid = UTT_IDS[i].toLowerCase();
      if (!uid.includes(q) && !String(IDS[i]).includes(q)) continue;
    }
    arr.push(i);
  }
  if (sk !== 'si') {
    arr.sort((a,b) => getSort(sk,b)-getSort(sk,a));
  }
  filtered = arr;
  pageStart = 0;
  renderPage();
}

function renderPage() {
  const total = filtered.length;
  const pages = Math.max(1, Math.ceil(total/PAGE));
  const page  = Math.floor(pageStart/PAGE)+1;
  const slice = filtered.slice(pageStart, pageStart+PAGE);

  document.getElementById('pginfo').textContent =
    `${page}/${pages}  (${total.toLocaleString()})`;
  document.getElementById('bp').disabled = pageStart<=0;
  document.getElementById('bn').disabled = pageStart+PAGE>=total;

  const inner = document.getElementById('vinner');
  inner.style.height = (slice.length * ROW_H)+'px';
  inner.innerHTML = '';
  renderVisible(slice, 0, slice.length-1);
}

function renderVisible(slice, from, to) {
  const inner = document.getElementById('vinner');
  // clear existing children in range
  for (let vi=from; vi<=to; vi++) {
    const i = slice[vi];
    const d = document.createElement('div');
    d.className = 'srow'+(i===selIdx?' sel':'');
    d.style.top = (vi*ROW_H)+'px';
    const uid = UTT_IDS[i];
    const tag = TAG_NAMES[TAGS[i]];
    const gn  = MEAN_GN[i];
    const al  = MEAN_AL[i];
    const alc = isNaN(al)?'':al>=0?'pos':'neg';
    d.innerHTML =
      `<div class="sid" title="${uid}">${uid}</div>`+
      `<div class="sgn">${isNaN(gn)?'—':gn.toFixed(3)}</div>`+
      `<div class="sal ${alc}">${isNaN(al)?'—':al.toFixed(3)}</div>`+
      `<div class="col-tag"><span class="tag-badge ${tag}">${tag.replace(/_/g,' ')}</span></div>`;
    d.addEventListener('click', ()=>selectSample(i, d));
    inner.appendChild(d);
  }
}

