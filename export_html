<script>
{data_js}

// ── init ──────────────────────────────────────────────────
const ROW_H = 34, PAGE = 100;
let filtered = null;  // Int32Array of indices into base arrays
let pageStart = 0;
let selIdx = -1;
let chart = null;
let searchTimer = null;

window.addEventListener('load', () => {{
  document.getElementById('hloading').textContent = '';
  buildTagStats();
  rebuild();
}});

function buildTagStats() {{
  const cnt = [0,0,0,0,0];
  for(let i=0;i<_N;i++) cnt[TAGS[i]]++;
  document.getElementById('hmeta').textContent =
    `${{_N.toLocaleString()}} samples · ${{_NE}} epochs`;
  // small tag badges in header
  const hdr = document.getElementById('hloading');
  hdr.style.marginLeft='auto';
  hdr.style.display='flex'; hdr.style.gap='6px'; hdr.style.flexWrap='wrap';
  hdr.innerHTML = [0,1,2,3].map(t => cnt[t]>0 ?
    `<span class="tag-badge ${{TAG_NAMES[t]}}">${{TAG_NAMES[t].replace('_',' ')}} ${{cnt[t].toLocaleString()}}</span>` : ''
  ).join('');
}}

function rebuild() {{
  const tagF = parseInt(document.getElementById('tag-filter').value);
  const sortK = document.getElementById('sort-field').value;
  const q = document.getElementById('search').value.trim().toLowerCase();

  // collect matching indices
  let arr = [];
  for(let i=0;i<_N;i++) {{
    if(tagF >= 0 && TAGS[i] !== tagF) continue;
    if(q) {{
      const uid = UTT_IDS[i].toLowerCase();
      const id  = String(IDS[i]);
      if(!uid.includes(q) && !id.includes(q)) continue;
    }}
    arr.push(i);
  }}

  // sort
  const [key, dir] = sortK.split('-');
  const desc = dir==='d';
  const getV = key==='si'? i=>SELF_INF[i]
              :key==='gn'? i=>MEAN_GN[i]
              :key==='al'? i=>MEAN_AL[i]
              :key==='fn'? i=>FRAC_NEG[i]
              :key==='fo'? i=>FORGET[i]
              : i=>SELF_INF[i];
  arr.sort((a,b) => desc ? getV(b)-getV(a) : getV(a)-getV(b));

  filtered = arr;
  pageStart = 0;
  renderPage();
}}

function renderPage() {{
  const total = filtered.length;
  const pages = Math.max(1, Math.ceil(total/PAGE));
  const page  = Math.floor(pageStart/PAGE)+1;
  const slice = filtered.slice(pageStart, pageStart+PAGE);

  document.getElementById('pginfo').textContent = `${{page}} / ${{pages}}  (${{total.toLocaleString()}})`;
  document.getElementById('btn-p').disabled = pageStart <= 0;
  document.getElementById('btn-n').disabled = pageStart + PAGE >= total;

  const container = document.getElementById('list-rows');
  container.innerHTML = '';
  slice.forEach(i => container.appendChild(makeRow(i)));
  document.getElementById('list-scroll').scrollTop = 0;
}}

function makeRow(i) {{
  const d = document.createElement('div');
  d.className = 'srow' + (i===selIdx?' sel':'');
  d.dataset.idx = i;
  d.onclick = () => selectSample(i, d);
  const tag = TAG_NAMES[TAGS[i]];
  const gn  = MEAN_GN[i];
  const al  = MEAN_AL[i];
  const alCls = isNaN(al)?'':al>=0?'pos':'neg';
  const label = UTT_IDS[i] || String(IDS[i]);
  d.innerHTML =
    `<div class="sid" title="${{label}}">${{label}}</div>`+
    `<div class="sgn">${{isNaN(gn)?'—':gn.toFixed(3)}}</div>`+
    `<div class="sal ${{alCls}}">${{isNaN(al)?'—':al.toFixed(3)}}</div>`+
    `<div class="col-tag"><span class="tag-badge ${{tag}}">${{tag.replace('_',' ')}}</span></div>`;
  return d;
}}

function prevPage() {{ if(pageStart>0){{pageStart=Math.max(0,pageStart-PAGE);renderPage();}} }}
function nextPage() {{ if(pageStart+PAGE<filtered.length){{pageStart+=PAGE;renderPage();}} }}
function onSearch()  {{ clearTimeout(searchTimer); searchTimer=setTimeout(rebuild,300); }}

function selectSample(idx, el) {{
  selIdx = idx;
  document.querySelectorAll('.srow').forEach(r=>r.classList.remove('sel'));
  el.classList.add('sel');

  const label = UTT_IDS[idx] || `id: ${{IDS[idx]}}`;
  const tag   = TAG_NAMES[TAGS[idx]];
  document.getElementById('ctitle').textContent = label;
  document.getElementById('csub').textContent =
    `tag: ${{tag}}  ·  self_influence: ${{SELF_INF[idx].toFixed(2)}}  ·  forget: ${{FORGET[idx]}}`;

  const stats = [
    {{l:'SELF INFLUENCE',v: SELF_INF[idx].toFixed(1)}},
    {{l:'MEAN GRAD NORM',v: MEAN_GN[idx].toFixed(4)}},
    {{l:'MEAN ALIGN',    v: MEAN_AL[idx].toFixed(4)}},
    {{l:'NEG ALIGN %',  v: (FRAC_NEG[idx]*100).toFixed(0)+'%'}},
  ];
  document.getElementById('stat-grid').innerHTML = stats.map(s=>
    `<div class="stat-item"><div class="stat-lbl">${{s.l}}</div><div class="stat-val">${{s.v}}</div></div>`
  ).join('');

  drawChart(idx);
}}

function getTraj(idx) {{
  const gn=[], al=[], ls=[];
  for(let e=0;e<_NE;e++) {{
    const base = idx*_NE+e;
