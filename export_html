#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
export_html_diag.py —— 工业级大样本贡献度分析可视化工具（带全链路诊断日志）
优化策略：骨架 HTML + 外挂二进制数据包 (.bin)，利用前端零拷贝流式加载解决卡死问题。
"""

import argparse
import csv
import glob
import os
import sys
import numpy as np

# 标签映射
TAG_MAP = {"harmful_suspect": 0, "hard": 1, "high_influence": 2, "easy_redundant": 3, "normal": 4}

def fv(row, key):
    try:    return float(row.get(key, "nan"))
    except: return float("nan")

def main():
    print("\n" + "="*60)
    print("🚀 [START] 诊断与数据打包脚本启动...")
    print("="*60)
    
    ap = argparse.ArgumentParser(description="高性能样本贡献度可视化分析 HTML 生成器（诊断版）")
    ap.add_argument("--contrib", required=True, help="包含 contrib_epoch*.npz 和 summary CSV 的目录路径")
    ap.add_argument("--egs",     default="", help="可选：包含原始 utt_id 映射的 train.csv 或 text 文件路径")
    ap.add_argument("--summary", default="", help="可选：明确指定 summary CSV 的路径")
    ap.add_argument("--output",  default="contrib_viz.html", help="输出的 HTML 文件名")
    args = ap.parse_args()

    # 打印环境诊断信息
    print(f"📍 命令行当前工作路径 (CWD): {os.getcwd()}")
    print(f"📁 输入的目标数据目录 (--contrib): {os.path.abspath(args.contrib)}")
    print(f"📄 预设的网页输出名称 (--output): {args.output}")

    # 1. 寻找并加载 Summary CSV
    sp = args.summary
    if not sp:
        for nm in ("contrib_summary_with_uttid.csv", "contrib_summary.csv"):
            p = os.path.join(args.contrib, nm)
            if os.path.exists(p): 
                sp = p
                break
    
    print(f"🔍 [步骤 1/4] 正在定位 Summary CSV 配置文件...")
    print(f"      寻找到的 CSV 路径: {sp}")
    if not sp or not os.path.exists(sp):
        print(f"❌ 严重错误: 在指定目录下找不到任何 summary CSV 配置文件！")
        print(f"   请检查该目录下是否存在 'contrib_summary.csv' 或 'contrib_summary_with_uttid.csv'")
        sys.exit(1)

    rows = []
    with open(sp, newline="", encoding="utf-8") as f:
        for r in csv.DictReader(f): 
            rows.append(r)
    
    n = len(rows)
    print(f"      📊 成功读取！共解析出 {n} 行样本配置指标。")
    if n == 0:
        print("⚠️ 警告: CSV 文件内容为空或标题行不匹配，无法建立索引，程序安全退出。")
        sys.exit(0)

    id2idx = {r["id"]: i for i, r in enumerate(rows)}

    # 2. 读取额外映射的 utt-id
    print("[步骤 2/4] 正在建立 sample_id 到 utt_id 的文本映射...")
    idx2utt = {}
    if args.egs and os.path.exists(args.egs):
        print(f"      -> 检测到外挂文本映射文件: {args.egs}")
        with open(args.egs, encoding="utf-8") as f:
            first = f.readline()
            delim = "\t" if "\t" in first else " "
        with open(args.egs, encoding="utf-8") as f:
            for i, line in enumerate(f):
                if i >= n: break
                p = line.strip().split(delim)
                if p: idx2utt[i] = p[0]
                
    if rows and "utt_id" in rows[0]:
        print("      -> 直接从 CSV 内部激活 'utt_id' 字段映射。")
        idx2utt = {i: r["utt_id"] for i, r in enumerate(rows) if r.get("utt_id")}

    # 3. 载入各 Epoch 的轨迹数据 (.npz)
    print("[步骤 3/4] 正在扫描并解析各 Epoch 轨迹矩阵 (.npz) ...")
    search_path = os.path.join(args.contrib, "contrib_epoch*.npz")
    files = sorted(glob.glob(search_path))
    print(f"      🔎 检索通配符路径: {search_path}")
    print(f"      匹配到的轨迹文件 (.npz) 数量: {len(files)} 个")
    
    epochs = []
    gn_mat, al_mat = None, None
    gn_min, gn_scale = 0.0, 1.0
    has_traj = len(files) > 0

    if has_traj:
        ne = len(files)
        gn = np.full((n, ne), np.nan, dtype=np.float32)
        al = np.full((n, ne), np.nan, dtype=np.float32)
        for ei, f in enumerate(files):
            ep = int(os.path.basename(f)[len("contrib_epoch"):-len(".npz")])
            epochs.append(ep)
            d = np.load(f, allow_pickle=True)
            ids_str = d["ids"].astype(str)
            try:
                idxs = ids_str.astype(np.int64)
                if idxs.max() >= n or idxs.min() < 0: raise ValueError
            except (ValueError, OverflowError):
                idxs = np.array([id2idx.get(s, -1) for s in ids_str], dtype=np.int64)
            m = idxs >= 0
            gn[idxs[m], ei] = d["grad_norm"][m]
            al[idxs[m], ei] = d["align"][m]
        
        epochs = sorted(epochs)
        gn_min = float(np.nanmin(gn))
        gn_max = float(np.nanpercentile(gn[~np.isnan(gn)], 99))
        gn_scale = max(gn_max - gn_min, 1e-9)
        
        gn_q = np.clip((gn - gn_min) / gn_scale * 255, 0, 255)
        gn_q[np.isnan(gn)] = 255
        al_q = np.clip((al + 1.0) / 2.0 * 253, 0, 253)
        al_q[np.isnan(al)] = 254
        gn_mat = gn_q.astype(np.uint8)
        al_mat = al_q.astype(np.uint8)
        print("      ✅ 历史轨迹大矩阵动态压缩完毕。")
    else:
        print("      ℹ️ 提示: 未发现任何 epoch 轨迹文件，系统将自适应退化为纯静态指标模式。")

    # 4. 后端核心优化：预排序与流式打包
    print("[步骤 4/4] 正在执行后端预排序与二进制流紧凑打包...")
    si_vals = np.array([fv(r, "self_influence") for r in rows], dtype=np.float64)
    order = np.argsort(-si_vals)
    rows = [rows[i] for i in order]

    ids_arr = np.array([int(r["id"]) if r["id"].isdigit() else int(order[i]) for i, r in enumerate(rows)], dtype=np.int32)
    tags_arr = np.array([TAG_MAP.get(r.get("tag", "normal"), 4) for r in rows], dtype=np.uint8)
    self_inf = np.array([fv(r, "self_influence") for r in rows], dtype=np.float32)
    mean_gn = np.array([fv(r, "mean_grad_norm") for r in rows], dtype=np.float32)
    mean_al = np.array([fv(r, "mean_align") for r in rows], dtype=np.float32)
    frac_neg = np.array([fv(r, "frac_neg_align") for r in rows], dtype=np.float32)
    forget = np.clip([fv(r, "forget_events") for r in rows], -128, 127).astype(np.int8)
    final_co = np.clip([fv(r, "final_correct") for r in rows], -128, 127).astype(np.int8)

    utt_list = [idx2utt.get(int(ids_arr[i]), "") for i in range(n)]
    utt_bytes = "\n".join(utt_list).encode("utf-8")
    utt_len = len(utt_bytes)

    if has_traj:
        gn_final = gn_mat[order].flatten().tobytes()
        al_final = al_mat[order].flatten().tobytes()
    else:
        gn_final = b""
        al_final = b""

    # ── 开始执行磁盘写入（带物理诊断） ──
    print("\n💾 [WRITE] 开始请求磁盘写入物理文件...")
    
    bin_path = os.path.splitext(args.output)[0] + ".bin"
    abs_bin_path = os.path.abspath(bin_path)
    abs_html_path = os.path.abspath(args.output)
    
    # A. 写入二进制数据包
    print(f"  ➡️ 正在写入二进制数据包: {abs_bin_path}")
    with open(bin_path, "wb") as fb:
        fb.write(np.array([n, len(epochs), utt_len, 1 if has_traj else 0], dtype=np.int32).tobytes())
        fb.write(np.array([gn_min, gn_scale], dtype=np.float32).tobytes())
        fb.write(b"\x00" * 40)
        fb.write(ids_arr.tobytes())
        fb.write(tags_arr.tobytes())
        fb.write(self_inf.tobytes())
        fb.write(mean_gn.tobytes())
        fb.write(mean_al.tobytes())
        fb.write(frac_neg.tobytes())
        fb.write(forget.tobytes())
        fb.write(final_co.tobytes())
        fb.write(utt_bytes)
        fb.write(gn_final)
        fb.write(al_final)
    
    if os.path.exists(bin_path):
        print(f"     👍 检查成功！.bin 文件已生成，空间占用: {os.path.getsize(bin_path)/1e6:.2f} MB")
    else:
        print(f"     ❌ 严重错误！.bin 文件在写入后未能在操作系统中检测到，请检查磁盘写权限。")

    # B. 写入骨架 HTML 页面
    print(f"  ➡️ 正在写入可视化网页骨架: {abs_html_path}")
    bin_filename = os.path.basename(bin_path)
    with open(args.output, "w", encoding="utf-8") as f:
        f.write(make_skeleton_html(bin_filename, epochs, n))
        
    if os.path.exists(args.output):
        print(f"     👍 检查成功！.html 文件已生成，空间占用: {os.path.getsize(args.output)/1024:.2f} KB")
    else:
        print(f"     ❌ 严重错误！.html 网页文件未能成功创建。")

    print("\n" + "="*60)
    print("✨ [SUCCESS] 脚本全链路运行完毕！无任何隐藏中断发生。")
    print("="*60 + "\n")


