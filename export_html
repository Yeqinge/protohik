#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
export_html.py — 把 contrib 数据全部打包进一个自包含 HTML
用法:
  python export_html.py \
      --contrib model_exp/.../contrib/ \
      --egs     egs/.../train.csv \
      [--output contrib_viz.html]
"""
import argparse, base64, csv, glob, os, sys
import numpy as np

def load_summary(path):
    rows = []
    with open(path, newline='') as f:
        for r in csv.DictReader(f):
            rows.append(r)
    print(f"  summary: {len(rows)} 样本")
    return rows

def load_npz(contrib_dir, n_samples, id2idx):
    files = sorted(glob.glob(os.path.join(contrib_dir, "contrib_epoch*.npz")))
    if not files:
        print("  警告: 没找到 npz 文件，轨迹将不可用")
        return [], np.array([]), np.array([]), np.array([])
    epochs = []
    n_ep = len(files)
    gn = np.full((n_samples, n_ep), np.nan, dtype=np.float32)
    al = np.full((n_samples, n_ep), np.nan, dtype=np.float32)
    ls = np.full((n_samples, n_ep), np.nan, dtype=np.float32)
    for ei, f in enumerate(files):
        ep = int(os.path.basename(f)[len("contrib_epoch"):-len(".npz")])
        epochs.append(ep)
        d  = np.load(f, allow_pickle=True)
        ids_str = d["ids"].astype(str)
        try:
            idxs = ids_str.astype(np.int64)
            if idxs.max() >= n_samples or idxs.min() < 0:
                raise ValueError
        except (ValueError, OverflowError):
            idxs = np.array([id2idx.get(s, -1) for s in ids_str], dtype=np.int64)
            mask = idxs >= 0
            valid_idxs = idxs[mask]
            gn[valid_idxs, ei] = d["grad_norm"][mask]
            al[valid_idxs, ei] = d["align"][mask]
            ls[valid_idxs, ei] = d["loss"][mask]
            print(f"  epoch {ep:03d} loaded")
            continue
        gn[idxs, ei] = d["grad_norm"]
        al[idxs, ei] = d["align"]
        ls[idxs, ei] = d["loss"]
        print(f"  epoch {ep:03d} loaded")
    return sorted(epochs), gn.flatten(), al.flatten(), ls.flatten()

def b64(arr):
    return base64.b64encode(np.ascontiguousarray(arr).tobytes()).decode()

TAG_MAP = {"harmful_suspect":0,"hard":1,"high_influence":2,"easy_redundant":3,"normal":4}

def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--contrib",  required=True)
    ap.add_argument("--egs",      default="")
    ap.add_argument("--summary",  default="")
    ap.add_argument("--output",   default="contrib_viz.html")
    args = ap.parse_args()

    # find summary
    sp = args.summary
    if not sp:
        for n in ("contrib_summary_with_uttid.csv","contrib_summary.csv"):
            p = os.path.join(args.contrib, n)
            if os.path.exists(p): sp = p; break
    if not sp or not os.path.exists(sp):
        print("错误: 找不到 summary CSV，用 --summary 指定"); sys.exit(1)
    print(f"读取数据...")
    rows = load_summary(sp)
    n = len(rows)

    # load egs utt-ids if summary doesn't have them
    if rows and "utt_id" not in rows[0] and args.egs and os.path.exists(args.egs):
        print("  读取 egs utt-id ...")
        delim = None
        with open(args.egs) as f:
            first = f.readline()
            delim = '\t' if '\t' in first else ' '
        with open(args.egs) as f:
            for i, line in enumerate(f):
                if i >= n: break
                parts = line.strip().split(delim)
                if parts: rows[i]["utt_id"] = parts[0]

    # build id → row index map
    id2idx = {r["id"]: i for i, r in enumerate(rows)}

    print("读取轨迹 npz ...")
    epochs, gn_flat, al_flat, ls_flat = load_npz(args.contrib, n, id2idx)

    print("编码数据 ...")
    FNAN = float("nan")
    def fv(r, k):
        try: return float(r.get(k,"nan"))
        except: return FNAN

    ids_arr     = np.array([int(r["id"]) if r["id"].isdigit() else i
                            for i, r in enumerate(rows)], dtype=np.int32)
    tags_arr    = np.array([TAG_MAP.get(r.get("tag","normal"),4) for r in rows], dtype=np.uint8)
    self_inf    = np.array([fv(r,"self_influence")  for r in rows], dtype=np.float32)
    mean_gn     = np.array([fv(r,"mean_grad_norm")  for r in rows], dtype=np.float32)
    early_gn    = np.array([fv(r,"early_grad_norm") for r in rows], dtype=np.float32)
    mean_al     = np.array([fv(r,"mean_align")      for r in rows], dtype=np.float32)
    frac_neg    = np.array([fv(r,"frac_neg_align")  for r in rows], dtype=np.float32)
    forget      = np.array([fv(r,"forget_events")   for r in rows], dtype=np.int16)
    final_co    = np.array([fv(r,"final_correct")   for r in rows], dtype=np.int8)

    utt_ids = "\n".join(r.get("utt_id", r.get("id","")) for r in rows)

    data_js = f"""
const _N={n}, _NE={len(epochs)};
const EPOCHS={epochs};
const TAG_NAMES=["harmful_suspect","hard","high_influence","easy_redundant","normal"];
const TAG_CLR={{"harmful_suspect":"#f87171","hard":"#fb923c","high_influence":"#818cf8","easy_redundant":"#34d399","normal":"#4a5270"}};

function _f32(b64){{const b=atob(b64),buf=new ArrayBuffer(b.length),u=new Uint8Array(buf);for(let i=0;i<b.length;i++)u[i]=b.charCodeAt(i);return new Float32Array(buf);}}
function _i32(b64){{const b=atob(b64),buf=new ArrayBuffer(b.length),u=new Uint8Array(buf);for(let i=0;i<b.length;i++)u[i]=b.charCodeAt(i);return new Int32Array(buf);}}
function _u8(b64) {{const b=atob(b64),buf=new ArrayBuffer(b.length),u=new Uint8Array(buf);for(let i=0;i<b.length;i++)u[i]=b.charCodeAt(i);return new Uint8Array(buf);}}
function _i16(b64){{const b=atob(b64),buf=new ArrayBuffer(b.length),u=new Uint8Array(buf);for(let i=0;i<b.length;i++)u[i]=b.charCodeAt(i);return new Int16Array(buf);}}
function _i8(b64) {{const b=atob(b64),buf=new ArrayBuffer(b.length),u=new Uint8Array(buf);for(let i=0;i<b.length;i++)u[i]=b.charCodeAt(i);return new Int8Array(buf);}}

const IDS     = _i32("{b64(ids_arr)}");
const TAGS    = _u8 ("{b64(tags_arr)}");
const SELF_INF= _f32("{b64(self_inf)}");
const MEAN_GN = _f32("{b64(mean_gn)}");
const EARLY_GN= _f32("{b64(early_gn)}");
const MEAN_AL = _f32("{b64(mean_al)}");
const FRAC_NEG= _f32("{b64(frac_neg)}");
const FORGET  = _i16("{b64(forget)}");
const FINAL_CO= _i8 ("{b64(final_co)}");
const GN_TRAJ = _f32("{b64(gn_flat) if len(gn_flat) else ''}");
const AL_TRAJ = _f32("{b64(al_flat) if len(al_flat) else ''}");
const LS_TRAJ = _f32("{b64(ls_flat) if len(ls_flat) else ''}");
const UTT_IDS = `{utt_ids}`.split("\\n");
"""

    html = build_html(data_js, n)
    with open(args.output, "w", encoding="utf-8") as f:
        f.write(html)
    size_mb = os.path.getsize(args.output) / 1024 / 1024
    print(f"\n完成 → {args.output}  ({size_mb:.1f} MB)")
    print("浏览器直接打开该文件即可。")

