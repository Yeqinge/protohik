<script>
const DATA_URL = "{bin_filename}";
const EPOCHS = {epochs};
const TAG_NAMES = ["harmful_suspect","hard","high_influence","easy_redundant","normal"];

let _N, _NE, HAS_TRAJ, _GN_MIN, _GN_SC;
let IDS, TAGS, SELF_INF, MEAN_GN, MEAN_AL, FRAC_NEG, FORGET, FINAL_CO, UTT_IDS;
let GN_U8 = null, AL_U8 = null;

const PAGE = 100, ROW_H = 36;
let filtered = null, pageStart = 0, selIdx = -1, chart = null, stimer = null;
let presordered = null;
const sortCache = {{}};

async function loadBinaryData() {{
  try {{
    const res = await fetch(DATA_URL);
    if(!res.ok) throw new Error("无法读取对应的 .bin 数据包，请确保它们放在同一目录下且通过 Web Server 访问。");
    const buffer = await res.arrayBuffer();
    
    const metaI32 = new Int32Array(buffer, 0, 4);
    _N = metaI32[0];
    _NE = metaI32[1];
    const uttLen = metaI32[2];
    HAS_TRAJ = metaI32[3] === 1;
    
    const metaF32 = new Float32Array(buffer, 16, 2);
    _GN_MIN = metaF32[0];
    _GN_SC = metaF32[1];
    
    document.getElementById('hmeta').textContent = `${{_N.toLocaleString()}} samples · ${{_NE}} epochs`;

    let offset = 64;
    IDS      = new Int32Array(buffer, offset, _N); offset += _N * 4;
    TAGS     = new Uint8Array(buffer, offset, _N); offset += _N * 1;
    SELF_INF = new Float32Array(buffer, offset, _N); offset += _N * 4;
    MEAN_GN  = new Float32Array(buffer, offset, _N); offset += _N * 4;
    MEAN_AL  = new Float32Array(buffer, offset, _N); offset += _N * 4;
    FRAC_NEG = new Float32Array(buffer, offset, _N); offset += _N * 4;
    FORGET   = new Int8Array(buffer, offset, _N); offset += _N * 1;
    FINAL_CO = new Int8Array(buffer, offset, _N); offset += _N * 1;
    
    const txtDecoder = new TextDecoder("utf-8");
    const stringBlock = new Uint8Array(buffer, offset, uttLen); offset += uttLen;
    // UTT_IDS[i] 可能为空字符串（CSV 没有 utt_id 字段时），回退到 sample_id
    UTT_IDS = txtDecoder.decode(stringBlock).split('\\n');
    
    if(HAS_TRAJ) {{
      const trajSize = _N * _NE;
      GN_U8 = new Uint8Array(buffer, offset, trajSize); offset += trajSize;
      AL_U8 = new Uint8Array(buffer, offset, trajSize); offset += trajSize;
    }}

    presordered = new Int32Array(_N);
    for(let i=0; i<_N; i++) presordered[i] = i;
    filtered = presordered;
    
    buildTagBadges();
    renderPage();
    document.getElementById('hstatus').style.display = 'none';

  }} catch(e) {{
    document.getElementById('hstatus').textContent = "❌ 加载失败: " + e.message;
    document.getElementById('hstatus').style.color = "var(--harmful)";
    document.getElementById('hstatus').style.animation = "none";
  }}
}}

function buildTagBadges() {{
  const cnt = [0,0,0,0,0];
  for(let i=0; i<_N; i++) cnt[TAGS[i]]++;
  const el = document.getElementById('hbadges');
  el.innerHTML = '';
  [0,1,2,3].forEach(t => {{
    if(!cnt[t]) return;
    const b = document.createElement('span');
    b.className = `tag-badge ${{TAG_NAMES[t]}}`;
    b.textContent = `${{TAG_NAMES[t].replace(/_/g,' ')}} ${{cnt[t].toLocaleString()}}`;
    el.appendChild(b);
  }});
}}

// 获取显示用的 utt_id（若为空则回退到 sample_id 字符串）
function getUttDisplay(i) {{
  const u = UTT_IDS[i];
  return (u && u.length > 0) ? u : String(IDS[i]);
}}

function renderPage() {{
  const total = filtered.length;
  const pages = Math.max(1, Math.ceil(total / PAGE));
  const page = Math.floor(pageStart / PAGE) + 1;
  const slice = filtered.slice(pageStart, pageStart + PAGE);

  document.getElementById('pginfo').textContent = `${{page}}/${{pages}} (${{total.toLocaleString()}})`;
  document.getElementById('bp').disabled = pageStart <= 0;
  document.getElementById('bn').disabled = pageStart + PAGE >= total;

  const inner = document.getElementById('vinner');
  inner.style.height = (slice.length * ROW_H) + 'px';
  inner.innerHTML = '';
  
  for(let vi=0; vi<slice.length; vi++) {{
    const i = slice[vi];
    const d = document.createElement('div');
    d.className = 'srow' + (i === selIdx ? ' sel' : '');
    d.style.top = (vi * ROW_H) + 'px';
    const uid = getUttDisplay(i);
    const sid = String(IDS[i]);
    const tag = TAG_NAMES[TAGS[i]];
    const gn = MEAN_GN[i];
    const al = MEAN_AL[i];
    const alc = isNaN(al) ? '' : al >= 0 ? 'pos' : 'neg';
    // 6 列：rank-id(序号) | utt_id | sample_id | grad_norm | align | tag
    d.innerHTML =
      `<div class="s-sid" title="sample_id: ${{sid}}">#${{pageStart + vi + 1}}</div>`+
      `<div class="s-uid" title="utt_id: ${{uid}}">${{uid}}</div>`+
      `<div class="s-sid" title="sample_id: ${{sid}}">${{sid}}</div>`+
      `<div class="sgn">${{isNaN(gn)?'—':gn.toFixed(3)}}</div>`+
      `<div class="sal ${{alc}}">${{isNaN(al)?'—':al.toFixed(3)}}</div>`+
      `<div class="col-tag"><span class="tag-badge ${{tag}}">${{tag.replace(/_/g,' ')}}</span></div>`;
    d.addEventListener('click', () => selectSample(i, d));
    inner.appendChild(d);
  }}
  document.getElementById('vlist').scrollTop = 0;
}}

function prevPage() {{ if(pageStart > 0) {{ pageStart = Math.max(0, pageStart - PAGE); renderPage(); }} }}
function nextPage() {{ if(pageStart + PAGE < filtered.length) {{ pageStart += PAGE; renderPage(); }} }}
function onSearch() {{ clearTimeout(stimer); stimer = setTimeout(rebuild, 200); }}

function getVal(sk, i) {{
  if(sk === 'si') return SELF_INF[i];
  if(sk === 'gn') return MEAN_GN[i];
  if(sk === 'al') return -MEAN_AL[i];
  if(sk === 'fn') return FRAC_NEG[i];
  if(sk === 'fo') return FORGET[i];
  return SELF_INF[i];
}}

function rebuild() {{
  const tagF = parseInt(document.getElementById('tag-f').value);
  const sk = document.getElementById('sort-f').value;
  const q = document.getElementById('search').value.trim().toLowerCase();
  const noFilter = tagF < 0 && !q;

  if (noFilter && sk === 'si') {{
    filtered = presordered;
  }} else {{
    const cacheKey = `${{tagF}}|${{sk}}|${{q}}`;
    if(sortCache[cacheKey]) {{
      filtered = sortCache[cacheKey];
    }} else {{
      let arr = [];
      for(let i=0; i<_N; i++) {{
        if(tagF >= 0 && TAGS[i] !== tagF) continue;
        if(q) {{
          // 同时匹配 utt_id 和 sample_id
          const uid = getUttDisplay(i).toLowerCase();
          const sid = String(IDS[i]).toLowerCase();
          if(!uid.includes(q) && !sid.includes(q)) continue;
        }}
        arr.push(i);
      }}
      if(sk !== 'si') arr.sort((a, b) => getVal(sk, b) - getVal(sk, a));
      if(!q) sortCache[cacheKey] = arr;
      filtered = arr;
    }}
  }}
  pageStart = 0; 
  renderPage();
}}

function selectSample(idx, el) {{
  selIdx = idx;
  document.querySelectorAll('.srow').forEach(r => r.classList.remove('sel'));
  el.classList.add('sel');
  
  const uid = getUttDisplay(idx);
  const sid = String(IDS[idx]);
  const tag = TAG_NAMES[TAGS[idx]];

  // 详情面板：主标题显示 utt_id，副行显示 sample_id
  document.getElementById('ctitle').textContent = uid;
  document.getElementById('c-sid-val').textContent = sid;
  document.getElementById('c-sid-row').style.display = 'flex';
  document.getElementById('csub').textContent =
    `tag: ${{tag}}  ·  self_influence: ${{SELF_INF[idx].toFixed(2)}}  ·  forget: ${{FORGET[idx]}}`;

  const stats = [
    {{l:'SELF INFLUENCE', v:SELF_INF[idx].toFixed(1)}},
    {{l:'MEAN GRAD NORM', v:MEAN_GN[idx].toFixed(4)}},
    {{l:'MEAN ALIGN',     v:MEAN_AL[idx].toFixed(4)}},
    {{l:'NEG ALIGN %',    v:(FRAC_NEG[idx]*100).toFixed(0)+'%'}},
  ];
  document.getElementById('stat-grid').innerHTML = stats.map(s =>
    `<div class="stat-item"><div class="slbl">${{s.l}}</div><div class="sval">${{s.v}}</div></div>`
  ).join('');

  drawChart(idx);
}}

function drawChart(idx) {{
  if(!HAS_TRAJ) {{
    document.getElementById('ph').style.display = 'flex';
    document.getElementById('ph').querySelector('p').textContent = '轨迹数据不可用';
    document.getElementById('cc').style.display = 'none';
    return;
  }}
  document.getElementById('ph').style.display = 'none';
  document.getElementById('cc').style.display = 'flex';
  
  const gn = [], al = [];
  for(let e=0; e<_NE; e++) {{
    const base = idx * _NE + e;
    const g = GN_U8[base], a = AL_U8[base];
    gn.push(g === 255 ? null : _GN_MIN + (g / 255) * _GN_SC);
    al.push(a === 254 ? null : (a / 253) * 2 - 1);
  }}
  
  const ctx = document.getElementById('myChart').getContext('2d');
  if(chart) chart.destroy();
  chart = new Chart(ctx, {{
    type: 'line',
    data: {{
      labels: EPOCHS.map(e => `ep${{e}}`),
      datasets: [
        {{label:'grad_norm', data:gn, borderColor:'#f59e0b', backgroundColor:'rgba(245,158,11,.1)', borderWidth:2, pointRadius:4, tension:.3, yAxisID:'y'}},
        {{label:'align', data:al, borderColor:'#818cf8', backgroundColor:'rgba(129,140,248,.1)', borderWidth:2, pointRadius:4, tension:.3, yAxisID:'y2'}}
      ]
    }},
    options: {{
      responsive: true, maintainAspectRatio: false, animation: {{duration:150}},
      interaction: {{mode:'index', intersect:false}},
      plugins: {{
        legend: {{display:false}},
        tooltip: {{
          backgroundColor:'#141820', borderColor:'#252b3d', borderWidth:1,
          titleColor:'#c8d0e0', bodyColor:'#7a8299',
          titleFont:{{family:'Fira Code',size:11}}, bodyFont:{{family:'Fira Code',size:10}},
          callbacks:{{label:c=>`  ${{c.dataset.label}}: ${{c.parsed.y?.toFixed(5)??'—'}}`}}
        }}
      }},
      scales: {{
        x: {{grid:{{color:'#1e2333'}}, ticks:{{color:'#4a5270', font:{{family:'Fira Code',size:10}}}}}},
        y: {{grid:{{color:'#1e2333'}}, ticks:{{color:'#f59e0b', font:{{family:'Fira Code',size:9}}}}, title:{{display:true,text:'grad_norm',color:'#4a5270',font:{{family:'Fira Code',size:9}}}}}},
        y2:{{position:'right', grid:{{display:false}}, ticks:{{color:'#818cf8', font:{{family:'Fira Code',size:9}}}}, title:{{display:true,text:'align',color:'#4a5270',font:{{family:'Fira Code',size:9}}}}}}
      }}
    }}
  }});
}}

loadBinaryData();
</script></body></html>"""

