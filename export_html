"""
export_html_v3.py —— 工业级大样本贡献度分析可视化工具（智能路径与自适应对齐版）
"""

import argparse
import csv
import glob
import os
import sys
import re
import numpy as np

# 标签映射
TAG_MAP = {"harmful_suspect": 0, "hard": 1, "high_influence": 2, "easy_redundant": 3, "normal": 4}

def fv(row, key):
    try:    return float(row.get(key, "nan"))
    except: return float("nan")

def main():
    print("\n" + "="*60)
    print("🚀 [START] V3 智能自适应修复版可视化打包工具启动...")
    print("="*60)
    
    ap = argparse.ArgumentParser(description="高性能样本贡献度可视化分析 HTML 生成器 (V3)")
    ap.add_argument("--contrib", required=True, help="包含 epoch*.npz 和 summary CSV 的目录路径")
    ap.add_argument("--egs",     default="", help="可选：外部文本映射文件")
    ap.add_argument("--summary", default="", help="可选：明确指定 summary CSV 的路径")
    ap.add_argument("--output",  default="contrib_viz.html", help="输出的 HTML 文件名")
    args = ap.parse_args()

    # 1. 定位并读取 Summary CSV
    sp = args.summary
    if not sp:
        for nm in ("contrib_summary_with_uttid.csv", "contrib_summary.csv"):
            p = os.path.join(args.contrib, nm)
            if os.path.exists(p): sp = p; break
    
    if not sp or not os.path.exists(sp):
        # 兜底机制：如果找不到上面两个特定名字，直接模糊搜索当前目录下的任意 csv
        csv_files = glob.glob(os.path.join(args.contrib, "*.csv"))
        if csv_files: sp = csv_files[0]

    if not sp or not os.path.exists(sp):
        print(f"❌ 严重错误: 在指定目录 [{args.contrib}] 下找不到任何 summary CSV 配置文件！")
        sys.exit(1)

    print(f"🔍 [1/4] 正在解析主配置 CSV: {sp}")
    rows = []
    with open(sp, newline="", encoding="utf-8") as f:
        for r in csv.DictReader(f): rows.append(r)
    n = len(rows)
    print(f"      成功读取 {n} 条样本。")

    id2idx = {r["id"]: i for i, r in enumerate(rows)}

    # 2. 提取 utt_id 映射
    print("[2/4] 正在建立 sample_id -> utt_id 的文本映射...")
    idx2utt = {}
    
    if rows and "utt_id" in rows[0]:
        print("      ✅ 检测到 CSV 包含 'utt_id' 列，完美匹配！")
        idx2utt = {i: r["utt_id"] for i, r in enumerate(rows) if r.get("utt_id")}
    else:
        print("      ℹ️ CSV 中未发现 'utt_id' 列，将默认使用数字 ID 填充展示")

    # 3. 自适应载入各 Epoch 的轨迹数据 (.npz)
    print("[3/4] 正在扫描并压缩各 Epoch 轨迹矩阵 (.npz) ...")
    
    # 智能模糊匹配：同时搜寻包含 epoch 的所有 npz 文件
    all_files = glob.glob(os.path.join(args.contrib, "*epoch*.npz"))
    
    # 正则表达式：专门用来提取文件名里的数字（比如从 contrib_epoch12.npz 或 epoch_12.npz 中提取出 12）
    epoch_pattern = re.compile(r'epoch_?(\d+)')
    
    valid_files_with_ep = []
    for f in window_files if 'window_files' in locals() else _filter_files(all_files, epoch_pattern):
        pass
        
    # 辅助过滤与提取函数
    files_with_ep = []
    for f in all_files:
        match = epoch_pattern.search(os.path.basename(f))
        if match:
            ep_num = int(match.group(1))
            files_with_ep.append((ep_num, f))
            
    # 按 Epoch 数字从小到大严格排序
    files_with_ep.sort(key=lambda x: x[0])
    
    epochs = [x[0] for x in files_with_ep]
    files = [x[1] for x in files_with_ep]
    
    gn_mat, al_mat = None, None
    gn_min, gn_scale = 0.0, 1.0
    has_traj = len(files) > 0

    if has_traj:
        ne = len(files)
        print(f"      ✅ 智能识别成功！共抓取到 {ne} 个 Epoch 轨迹文件。Epoch 序列: {epochs}")
        gn = np.full((n, ne), np.nan, dtype=np.float32)
        al = np.full((n, ne), np.nan, dtype=np.float32)
        
        for ei, f in enumerate(files):
            d = np.load(f, allow_pickle=True)
            ids_str = d["ids"].astype(str)
            try:
                idxs = ids_str.astype(np.int64)
                if idxs.max() >= n or idxs.min() < 0: raise ValueError
            except (ValueError, OverflowError):
                idxs = np.array([id2idx.get(s, -1) for s in ids_str], dtype=np.int64)
            m = idxs >= 0
            gn[idxs[m], ei] = d["grad_norm"][m]
            al[idxs[m], ei] = d["align"][m]
        
        gn_min = float(np.nanmin(gn))
        gn_max = float(np.nanpercentile(gn[~np.isnan(gn)], 99))
        gn_scale = max(gn_max - gn_min, 1e-9)
        
        gn_q = np.clip((gn - gn_min) / gn_scale * 255, 0, 255).astype(np.uint8)
        al_q = np.clip((al + 1.0) / 2.0 * 253, 0, 253).astype(np.uint8)
        gn_q[np.isnan(gn)] = 255
        al_q[np.isnan(al)] = 245
        gn_mat = gn_q
        al_mat = al_q
    else:
        print("      ⚠️ 警告: 未在指定目录下扫描到任何包含 'epoch' 关键字的 .npz 轨迹文件！右侧图表将无法渲染。")

    # 4. 排序并流式紧凑打包
    print("[4/4] 正在执行后端流式紧凑打包...")
    si_vals = np.array([fv(r, "self_influence") for r in rows], dtype=np.float64)
    order = np.argsort(-si_vals)
    rows = [rows[i] for i in order]

    ids_arr = np.array([int(r["id"]) if r["id"].isdigit() else int(order[i]) for i, r in enumerate(rows)], dtype=np.int32)
    tags_arr = np.array([TAG_MAP.get(r.get("tag", "normal"), 4) for r in rows], dtype=np.uint8)
    self_inf = np.array([fv(r, "self_influence") for r in rows], dtype=np.float32)
    mean_gn = np.array([fv(r, "mean_grad_norm") for r in rows], dtype=np.float32)
    mean_al = np.array([fv(r, "mean_align") for r in rows], dtype=np.float32)
    frac_neg = np.array([fv(r, "frac_neg_align") for r in rows], dtype=np.float32)
    forget = np.clip([fv(r, "forget_events") for r in rows], -128, 127).astype(np.int8)
    final_co = np.clip([fv(r, "final_correct") for r in rows], -128, 127).astype(np.int8)

    utt_list = [idx2utt.get(int(ids_arr[i]), f"ID-{ids_arr[i]}") for i in range(n)]
    utt_bytes = "\n".join(utt_list).encode("utf-8")
    utt_len = len(utt_bytes)

    if has_traj:
        gn_final = gn_mat[order].flatten().tobytes()
        al_final = al_mat[order].flatten().tobytes()
    else:
        gn_final = b""
        al_final = b""

    # 写入二进制文件
    bin_path = os.path.splitext(args.output)[0] + ".bin"
    with open(bin_path, "wb") as fb:
        fb.write(np.array([n, len(epochs), utt_len, 1 if has_traj else 0], dtype=np.int32).tobytes())
        fb.write(np.array([gn_min, gn_scale], dtype=np.float32).tobytes())
        fb.write(b"\x00" * 40)
        fb.write(ids_arr.tobytes())
        fb.write(tags_arr.tobytes())
        fb.write(self_inf.tobytes())
        fb.write(mean_gn.tobytes())
        fb.write(mean_al.tobytes())
        fb.write(frac_neg.tobytes())
        fb.write(forget.tobytes())
        fb.write(final_co.tobytes())
        fb.write(utt_bytes)
        fb.write(gn_final)
        fb.write(al_final)

    # 写入安全替换的 HTML 网页
    bin_filename = os.path.basename(bin_path)
    
    # 借用之前的原生 HTML 骨架
    from main import get_html_skeleton_template if 'get_html_skeleton_template' in globals() else None
    html_content = _get_html_layout()
    
    html_content = html_content.replace("__BIN_FILENAME__", str(bin_filename))
    html_content = html_content.replace("__EPOCHS_ARRAY__", str(epochs))

    with open(args.output, "w", encoding="utf-8") as f:
        f.write(html_content)

    print(f"\n✨ [SUCCESS] 修复版可视化数据流全套构建成功！")
    print(f" 📂 网页骨架: {os.path.abspath(args.output)}")
    print(f" 📦 数据底座: {os.path.abspath(bin_path)} (当前大小: {os.path.getsize(bin_path)/1024/1024:.2f} MB)")


