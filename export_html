#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
export_html.py  ——  生成自包含的可视化 HTML（目标 ~35 MB）

三项主要压缩措施：
  1. 去掉全是 NaN 的 loss 轨迹（原占 ~40 MB）
  2. grad_norm / align 轨迹用 uint8 量化（float32 → 1 byte，节省 ~58 MB）
  3. utt_id 字符串用 gzip 压缩后 base64，浏览器用 DecompressionStream 解压

用法：
  python export_html.py \\
      --contrib model_exp/.../contrib/ \\
      --egs     egs/.../train.csv \\
      [--output contrib_viz.html]
"""

import argparse, base64, csv, gzip, glob, os, sys
import numpy as np

# ── 工具 ──────────────────────────────────────────────────
def b64(arr):
    return base64.b64encode(np.ascontiguousarray(arr).tobytes()).decode()

def gz_b64(text):
    """gzip 压缩字符串 → base64"""
    compressed = gzip.compress(text.encode("utf-8"), compresslevel=9)
    return base64.b64encode(compressed).decode()

TAG_MAP = {"harmful_suspect": 0, "hard": 1, "high_influence": 2,
           "easy_redundant": 3, "normal": 4}

def fv(row, key):
    try:    return float(row.get(key, "nan"))
    except: return float("nan")

# ── 数据加载 ──────────────────────────────────────────────
def load_summary(path):
    rows = []
    with open(path, newline="") as f:
        for r in csv.DictReader(f):
            rows.append(r)
    print(f"  summary: {len(rows)} 样本，字段: {list(rows[0].keys())}")
    return rows

def load_egs(path, n):
    idx2utt = {}
    if not path or not os.path.exists(path):
        return idx2utt
    delim = None
    with open(path) as f:
        first = f.readline(); delim = "\t" if "\t" in first else " "
    with open(path) as f:
        for i, line in enumerate(f):
            if i >= n: break
            parts = line.strip().split(delim)
            if parts: idx2utt[i] = parts[0]
    print(f"  egs: {len(idx2utt)} 条 utt-id")
    return idx2utt

def load_trajectories(contrib_dir, n, id2idx):
    """返回 (epochs, gn_u8, al_u8, gn_min, gn_scale) —— uint8 量化轨迹"""
    files = sorted(glob.glob(os.path.join(contrib_dir, "contrib_epoch*.npz")))
    if not files:
        print("  警告: 没找到 npz，轨迹不可用")
        return [], None, None, 0.0, 1.0

    ne = len(files)
    epochs = []
    gn = np.full((n, ne), np.nan, dtype=np.float32)
    al = np.full((n, ne), np.nan, dtype=np.float32)

    for ei, f in enumerate(files):
        ep = int(os.path.basename(f)[len("contrib_epoch"):-len(".npz")])
        epochs.append(ep)
        d = np.load(f, allow_pickle=True)
        ids_str = d["ids"].astype(str)
        try:
            idxs = ids_str.astype(np.int64)
            if idxs.max() >= n or idxs.min() < 0:
                raise ValueError
        except (ValueError, OverflowError):
            idxs = np.array([id2idx.get(s, -1) for s in ids_str], dtype=np.int64)
            valid = idxs >= 0
            gn[idxs[valid], ei] = d["grad_norm"][valid]
            al[idxs[valid], ei] = d["align"][valid]
            print(f"  epoch {ep:03d} OK")
            continue
        gn[idxs, ei] = d["grad_norm"]
        al[idxs, ei] = d["align"]
        print(f"  epoch {ep:03d} OK")

    # ── uint8 量化 ──
    # grad_norm: 用第95百分位作上限，避免极端值压缩整体动态范围
    gn_min   = float(np.nanmin(gn))
    gn_max   = float(np.nanpercentile(gn[~np.isnan(gn)], 99))
    gn_scale = (gn_max - gn_min) if gn_max > gn_min else 1.0
    gn_q = np.clip((gn - gn_min) / gn_scale * 255, 0, 255)
    gn_q[np.isnan(gn)] = 255          # 255 作 NaN 标记
    gn_u8 = gn_q.astype(np.uint8)

    # align: 固定范围 [-1, 1]
    al_q = np.clip((al + 1.0) / 2.0 * 253, 0, 253)  # 0..253 有效
    al_q[np.isnan(al)] = 254          # 254 作 NaN 标记
    al_u8 = al_q.astype(np.uint8)

    return sorted(epochs), gn_u8.flatten(), al_u8.flatten(), gn_min, gn_scale

# ── 主逻辑 ────────────────────────────────────────────────
def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--contrib", required=True)
    ap.add_argument("--egs",     default="")
    ap.add_argument("--summary", default="")
    ap.add_argument("--output",  default="contrib_viz.html")
    args = ap.parse_args()

    sp = args.summary
    if not sp:
        for name in ("contrib_summary_with_uttid.csv", "contrib_summary.csv"):
            p = os.path.join(args.contrib, name)
            if os.path.exists(p): sp = p; break
    if not sp or not os.path.exists(sp):
        print("错误: 找不到 summary CSV"); sys.exit(1)

    print(f"[1/4] 读取 summary...")
    rows = load_summary(sp)
    n = len(rows)
    id2idx = {r["id"]: i for i, r in enumerate(rows)}

    print(f"[2/4] 读取 egs utt-id...")
    idx2utt = {}
    if args.egs and os.path.exists(args.egs):
        idx2utt = load_egs(args.egs, n)
    # 如果 summary 本身有 utt_id，优先用它
    if rows and "utt_id" in rows[0]:
        idx2utt = {i: r["utt_id"] for i, r in enumerate(rows) if r.get("utt_id")}

    print(f"[3/4] 读取轨迹 npz...")
    epochs, gn_u8, al_u8, gn_min, gn_scale = load_trajectories(args.contrib, n, id2idx)

    print(f"[4/4] 编码并生成 HTML...")

    # ── 摘要数值（float32，只保留关键字段）──
    self_inf  = np.array([fv(r,"self_influence")  for r in rows], dtype=np.float32)
    mean_gn   = np.array([fv(r,"mean_grad_norm")  for r in rows], dtype=np.float32)
    mean_al   = np.array([fv(r,"mean_align")      for r in rows], dtype=np.float32)
    frac_neg  = np.array([fv(r,"frac_neg_align")  for r in rows], dtype=np.float32)
    forget    = np.clip([fv(r,"forget_events")  for r in rows], -128, 127).astype(np.int8)
    final_co  = np.clip([fv(r,"final_correct")  for r in rows], -128, 127).astype(np.int8)
    ids_arr   = np.array([int(r["id"]) if r["id"].isdigit() else i
                          for i, r in enumerate(rows)], dtype=np.int32)
    tags_arr  = np.array([TAG_MAP.get(r.get("tag","normal"),4) for r in rows], dtype=np.uint8)

    # ── utt_ids：gzip 压缩 ──
    utt_raw = "\n".join(idx2utt.get(i, str(ids_arr[i])) for i in range(n))
    utt_gz  = gz_b64(utt_raw)
    print(f"  utt_ids  raw={len(utt_raw)/1e6:.1f}MB  gzip+b64={len(utt_gz)/1e6:.1f}MB")

    has_traj = gn_u8 is not None
    traj_js = ""
    if has_traj:
        gn_b64 = b64(gn_u8)
        al_b64 = b64(al_u8)
        traj_js = f"""
const _GN_MIN={gn_min:.6f}, _GN_SC={gn_scale:.6f};
const GN_U8 = _u8("{gn_b64}");
const AL_U8 = _u8("{al_b64}");
"""
        print(f"  gn_u8    {len(gn_b64)/1e6:.1f}MB  al_u8 {len(al_b64)/1e6:.1f}MB")

    data_js = f"""
const _N={n}, _NE={len(epochs)};
const EPOCHS={epochs};
const HAS_TRAJ={'true' if has_traj else 'false'};
function _u8(b){{const s=atob(b),a=new Uint8Array(s.length);for(let i=0;i<s.length;i++)a[i]=s.charCodeAt(i);return a;}}
function _i32(b){{const a=_u8(b);return new Int32Array(a.buffer);}}
function _f32(b){{const a=_u8(b);return new Float32Array(a.buffer);}}
function _i8(b) {{const a=_u8(b);return new Int8Array(a.buffer);}}
const IDS     = _i32("{b64(ids_arr)}");
const TAGS    = _u8 ("{b64(tags_arr)}");
const SELF_INF= _f32("{b64(self_inf)}");
const MEAN_GN = _f32("{b64(mean_gn)}");
const MEAN_AL = _f32("{b64(mean_al)}");
const FRAC_NEG= _f32("{b64(frac_neg)}");
const FORGET  = _i8 ("{b64(forget)}");
const FINAL_CO= _i8 ("{b64(final_co)}");
const UTT_GZ  = "{utt_gz}";
{traj_js}
const TAG_NAMES=["harmful_suspect","hard","high_influence","easy_redundant","normal"];
const TAG_CLR={{"harmful_suspect":"#f87171","hard":"#fb923c","high_influence":"#818cf8","easy_redundant":"#34d399","normal":"#4a5270"}};
"""

    html = make_html(data_js)
    with open(args.output, "w", encoding="utf-8") as f:
        f.write(html)
    mb = os.path.getsize(args.output) / 1e6
    print(f"\n✓ 生成完成 → {args.output}  ({mb:.1f} MB)")
    print("浏览器直接打开即可（首次加载约 2-5 秒解码数据）。")

