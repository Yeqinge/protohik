    cc.style.display='none'; return;
  }

  const ctx=document.getElementById('myChart').getContext('2d');
  if(chart) chart.destroy();
  chart=new Chart(ctx,{
    type:'line',
    data:{labels:EPOCHS.map(e=>`ep${e}`),datasets:[
      {label:'grad_norm',data:t.gn,borderColor:'#f59e0b',backgroundColor:'rgba(245,158,11,.1)',
       borderWidth:2,pointRadius:4,pointBackgroundColor:'#f59e0b',tension:.3,yAxisID:'y'},
      {label:'align',    data:t.al,borderColor:'#818cf8',backgroundColor:'rgba(129,140,248,.1)',
       borderWidth:2,pointRadius:4,pointBackgroundColor:'#818cf8',tension:.3,yAxisID:'y2'},
    ]},
    options:{
      responsive:true,maintainAspectRatio:false,animation:{duration:200},
      interaction:{mode:'index',intersect:false},
      plugins:{legend:{display:false},
        tooltip:{backgroundColor:'#141820',borderColor:'#252b3d',borderWidth:1,
          titleColor:'#c8d0e0',bodyColor:'#7a8299',
          titleFont:{family:'Fira Code',size:11},bodyFont:{family:'Fira Code',size:10},
          callbacks:{label:c=>`  ${c.dataset.label}: ${c.parsed.y?.toFixed(5)??'—'}`}}},
      scales:{
        x:{grid:{color:'#1e2333'},ticks:{color:'#4a5270',font:{family:'Fira Code',size:10}}},
        y:{grid:{color:'#1e2333'},ticks:{color:'#f59e0b',font:{family:'Fira Code',size:9}},
           title:{display:true,text:'grad_norm',color:'#4a5270',font:{family:'Fira Code',size:9}}},
        y2:{position:'right',grid:{display:false},
            ticks:{color:'#818cf8',font:{family:'Fira Code',size:9}},
            title:{display:true,text:'align',color:'#4a5270',font:{family:'Fira Code',size:9}}}
      }
    }
  });
}
