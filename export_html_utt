.ld{{width:8px;height:8px;border-radius:50%;flex-shrink:0;}}
.ld.gn{{background:var(--ac);}}.ld.al{{background:var(--inf);}}
/* 重复度筛选警告条 */
.dup-warn{{display:none;padding:4px 12px;background:rgba(232,121,249,.08);border-bottom:1px solid rgba(232,121,249,.2);font-family:var(--mono);font-size:10px;color:var(--dup);}}
</style>
</head><body>
<div class="layout" id="app">
  <header class="header">
    <span class="htitle">UTTERANCE CONTRIBUTION ANALYZER</span>
    <span class="hmeta" id="hmeta">正在加载...</span>
    <div class="hbadges" id="hbadges">
      <span class="hstatus" id="hstatus">⏳ STREAMING BINARY...</span>
    </div>
  </header>
  <div class="panel-left">
    <div class="controls">
      <input id="search" placeholder="搜索 utt_id ..." oninput="onSearch()">
      <div class="crow">
        <select id="tag-f" onchange="rebuild()">
          <option value="-1">所有 Tag</option>
          <option value="0">⚠ harmful_suspect</option>
          <option value="1">hard</option>
          <option value="2">↑ high_influence</option>
          <option value="3">easy_redundant</option>
          <option value="4">normal</option>
        </select>
        <select id="dup-f" onchange="rebuild()">
          <option value="-1">全部重复度</option>
          <option value="0.9">高重复 (&gt;90%)</option>
          <option value="0.7">中重复 (&gt;70%)</option>
          <option value="0.5">低重复 (&gt;50%)</option>
        </select>
      </div>
      <div class="crow">
        <select id="sort-f" onchange="rebuild()">
          <option value="si">mean_self_influence ↓</option>
          <option value="maxsi">max_self_influence ↓</option>
          <option value="gn">mean_grad_norm ↓</option>
          <option value="al">mean_align ↑</option>
          <option value="dup">dup_ratio ↓（最重复）</option>
          <option value="nc">chunk_count ↓</option>
        </select>
      </div>
    </div>
    <div class="dup-warn" id="dup-warn">⚠ 当前筛选包含高重复度 utterance，这些样本的训练贡献可能被高估</div>
    <div class="list-header">
      <span>#</span>
      <span>utt_id</span>
      <span style="text-align:center">chunks</span>
      <span style="text-align:right">mean_gn</span>
      <span style="text-align:right">mean_al</span>
      <span style="text-align:right">tag</span>
    </div>
    <div class="vlist" id="vlist">
      <div id="vinner" style="position:relative;"></div>
    </div>
    <div class="pagination">
      <button id="bp" onclick="prevPage()" disabled>◀</button>
      <span class="pginfo" id="pginfo">—</span>
      <button id="bn" onclick="nextPage()" disabled>▶</button>
    </div>
  </div>
  <div class="panel-right">
    <div class="chart-hdr">
      <div class="chdr-id-block">
        <div class="ctitle" id="ctitle">— SELECT A UTTERANCE —</div>
        <div class="csub" id="csub"></div>
        <div class="dup-bar-wrap" id="dup-bar-wrap" style="display:none;">
          <span id="dup-lbl">重复度</span>
          <div class="dup-bar-bg"><div class="dup-bar-fill" id="dup-bar-fill"></div></div>
          <span id="dup-pct"></span>
        </div>
      </div>
      <div class="stat-grid" id="stat-grid"></div>
    </div>
    <div class="chart-area">
      <div id="ph" class="placeholder">
        <div class="phi">◈</div>
        <p>从左侧选择一条 utterance，查看聚合后的梯度轨迹（所有 chunk 均值）</p>
      </div>
      <div id="cc" style="display:none;flex:1;flex-direction:column;gap:12px;">
        <div class="chart-wrap"><canvas id="myChart"></canvas></div>
        <div class="legend">
          <div class="li"><div class="ld gn"></div>grad_norm 均值（左轴）</div>
          <div class="li"><div class="ld al"></div>align 均值（右轴）</div>
        </div>
      </div>
    </div>
  </div>
</div>
<script>
const DATA_URL = "{bin_filename}";
const EPOCHS = {epochs};
const TAG_NAMES = ["harmful_suspect","hard","high_influence","easy_redundant","normal"];

let _N, _NE, HAS_TRAJ, _GN_MIN, _GN_SC;
let N_CHUNKS, DUP, MEAN_SI, MAX_SI, MEAN_GN, MAX_GN, GN_STD, MEAN_AL, MEAN_FN, TAGS, UTT_IDS;
let GN_U8 = null, AL_U8 = null;

const PAGE = 100, ROW_H = 36;
let filtered = null, pageStart = 0, selIdx = -1, chart = null, stimer = null;
let presordered = null;
const sortCache = {{}};

async function loadBinaryData() {{
  try {{
    const res = await fetch(DATA_URL);
    if(!res.ok) throw new Error("无法读取 .bin 数据包，请通过 Web Server 访问（如 python -m http.server）");
    const buffer = await res.arrayBuffer();

    const metaI32 = new Int32Array(buffer, 0, 4);
    _N = metaI32[0]; _NE = metaI32[1];
    const uttLen = metaI32[2];
    HAS_TRAJ = metaI32[3] === 1;
    const metaF32 = new Float32Array(buffer, 16, 2);
    _GN_MIN = metaF32[0]; _GN_SC = metaF32[1];

    document.getElementById('hmeta').textContent = `${{_N.toLocaleString()}} utterances · ${{_NE}} epochs`;

    let offset = 64;
    N_CHUNKS = new Int16Array(buffer, offset, _N);  offset += _N * 2;
    DUP      = new Float32Array(buffer, offset, _N); offset += _N * 4;
    MEAN_SI  = new Float32Array(buffer, offset, _N); offset += _N * 4;
    MAX_SI   = new Float32Array(buffer, offset, _N); offset += _N * 4;
    MEAN_GN  = new Float32Array(buffer, offset, _N); offset += _N * 4;
    MAX_GN   = new Float32Array(buffer, offset, _N); offset += _N * 4;
    GN_STD   = new Float32Array(buffer, offset, _N); offset += _N * 4;
    MEAN_AL  = new Float32Array(buffer, offset, _N); offset += _N * 4;
    MEAN_FN  = new Float32Array(buffer, offset, _N); offset += _N * 4;
    TAGS     = new Uint8Array(buffer, offset, _N);   offset += _N * 1;
    // Note: mean_fo (Int8) skipped in compact layout — add if needed

    const txtDecoder = new TextDecoder("utf-8");
    const stringBlock = new Uint8Array(buffer, offset, uttLen); offset += uttLen;
    UTT_IDS = txtDecoder.decode(stringBlock).split('\\n');

    if(HAS_TRAJ && _NE > 0) {{
      const trajSize = _N * _NE;
      GN_U8 = new Uint8Array(buffer, offset, trajSize); offset += trajSize;
      AL_U8 = new Uint8Array(buffer, offset, trajSize);
    }}

    presordered = new Int32Array(_N);
    for(let i=0; i<_N; i++) presordered[i] = i;
    filtered = presordered;

    buildTagBadges();
    renderPage();
    document.getElementById('hstatus').style.display = 'none';
  }} catch(e) {{
    document.getElementById('hstatus').textContent = "❌ " + e.message;
    document.getElementById('hstatus').style.color = "var(--harmful)";
    document.getElementById('hstatus').style.animation = "none";
  }}
}}

function buildTagBadges() {{
  const cnt = [0,0,0,0,0];
  for(let i=0; i<_N; i++) cnt[TAGS[i]]++;
  // 统计高重复度数量
  let dupCnt = 0;
  for(let i=0; i<_N; i++) if(DUP[i] > 0.9) dupCnt++;
  const el = document.getElementById('hbadges');
  el.innerHTML = '';
  [0,1,2,3].forEach(t => {{
    if(!cnt[t]) return;
    const b = document.createElement('span');
    b.className = `tag-badge ${{TAG_NAMES[t]}}`;
    b.textContent = `${{TAG_NAMES[t].replace(/_/g,' ')}} ${{cnt[t].toLocaleString()}}`;
    el.appendChild(b);
  }});
  if(dupCnt > 0) {{
    const b = document.createElement('span');
    b.className = 'tag-badge dup';
    b.textContent = `high-dup ${{dupCnt.toLocaleString()}}`;
    el.appendChild(b);
  }}
}}

function getVal(sk, i) {{
  if(sk === 'si')    return MEAN_SI[i];
  if(sk === 'maxsi') return MAX_SI[i];
  if(sk === 'gn')    return MEAN_GN[i];
  if(sk === 'al')    return -MEAN_AL[i];
  if(sk === 'dup')   return -DUP[i];
  if(sk === 'nc')    return -N_CHUNKS[i];
  return MEAN_SI[i];
}}

function rebuild() {{
  const tagF = parseInt(document.getElementById('tag-f').value);
  const dupF = parseFloat(document.getElementById('dup-f').value);
  const sk   = document.getElementById('sort-f').value;
  const q    = document.getElementById('search').value.trim().toLowerCase();
  const noFilter = tagF < 0 && isNaN(dupF) && !q;

  if (noFilter && sk === 'si') {{
    filtered = presordered;
  }} else {{
    const cacheKey = `${{tagF}}|${{dupF}}|${{sk}}|${{q}}`;
    if(sortCache[cacheKey]) {{
      filtered = sortCache[cacheKey];
    }} else {{
      let arr = [];
      for(let i=0; i<_N; i++) {{
        if(tagF >= 0 && TAGS[i] !== tagF) continue;
        if(!isNaN(dupF) && DUP[i] < dupF) continue;
        if(q && !UTT_IDS[i].toLowerCase().includes(q)) continue;
        arr.push(i);
      }}
      if(sk !== 'si') arr.sort((a,b) => getVal(sk,b) - getVal(sk,a));
      if(!q) sortCache[cacheKey] = arr;
      filtered = arr;
    }}
  }}

  // 重复度警告条
  const hasDup = filtered.some(i => DUP[i] > 0.9);
  document.getElementById('dup-warn').style.display = hasDup ? 'block' : 'none';

  pageStart = 0;
  renderPage();
}}

function renderPage() {{
  const total = filtered.length;
  const pages = Math.max(1, Math.ceil(total / PAGE));
  const page  = Math.floor(pageStart / PAGE) + 1;
  const slice = filtered.slice(pageStart, pageStart + PAGE);

  document.getElementById('pginfo').textContent = `${{page}}/${{pages}} (${{total.toLocaleString()}})`;
  document.getElementById('bp').disabled = pageStart <= 0;
  document.getElementById('bn').disabled = pageStart + PAGE >= total;

  const inner = document.getElementById('vinner');
  inner.style.height = (slice.length * ROW_H) + 'px';
  inner.innerHTML = '';

  for(let vi=0; vi<slice.length; vi++) {{
    const i = slice[vi];
    const d = document.createElement('div');
    d.className = 'srow' + (i === selIdx ? ' sel' : '');
    d.style.top = (vi * ROW_H) + 'px';
    const uid = UTT_IDS[i] || String(i);
    const nc  = N_CHUNKS[i];
    const dup = DUP[i];
    const gn  = MEAN_GN[i];
    const al  = MEAN_AL[i];
    const tag = TAG_NAMES[TAGS[i]];
    const alc = isNaN(al) ? '' : al >= 0 ? 'pos' : 'neg';
    const ncClass = dup > 0.9 ? 'dup-high' : '';
    d.innerHTML =
      `<div class="s-rank">${{pageStart+vi+1}}</div>`+
      `<div class="s-uid" title="${{uid}}">${{uid}}</div>`+
      `<div class="s-nc ${{ncClass}}" title="重复度:${{(dup*100).toFixed(0)}}%">${{nc}}</div>`+
      `<div class="sgn">${{isNaN(gn)?'—':gn.toFixed(3)}}</div>`+
      `<div class="sal ${{alc}}">${{isNaN(al)?'—':al.toFixed(3)}}</div>`+
      `<div class="col-tag"><span class="tag-badge ${{tag}}">${{tag.replace(/_/g,' ')}}</span></div>`;
    d.addEventListener('click', () => selectSample(i, d));
    inner.appendChild(d);
  }}
  document.getElementById('vlist').scrollTop = 0;
}}

function prevPage() {{ if(pageStart > 0) {{ pageStart = Math.max(0, pageStart-PAGE); renderPage(); }} }}
function nextPage() {{ if(pageStart+PAGE < filtered.length) {{ pageStart += PAGE; renderPage(); }} }}
function onSearch() {{ clearTimeout(stimer); stimer = setTimeout(rebuild, 200); }}

function selectSample(idx, el) {{
  selIdx = idx;
  document.querySelectorAll('.srow').forEach(r => r.classList.remove('sel'));
  el.classList.add('sel');

  const uid = UTT_IDS[idx] || String(idx);
  const nc  = N_CHUNKS[idx];
  const dup = DUP[idx];
  const tag = TAG_NAMES[TAGS[idx]];

  document.getElementById('ctitle').textContent = uid;
  document.getElementById('csub').textContent =
    `tag: ${{tag}}  ·  chunks: ${{nc}}  ·  mean_si: ${{MEAN_SI[idx].toFixed(2)}}  ·  max_si: ${{MAX_SI[idx].toFixed(2)}}`;

  // 重复度进度条
  const wrap = document.getElementById('dup-bar-wrap');
  wrap.style.display = 'flex';
  const fill = document.getElementById('dup-bar-fill');
  const pct  = (dup * 100).toFixed(0);
  fill.style.width = pct + '%';
  fill.style.background = dup > 0.9 ? 'var(--dup)' : dup > 0.7 ? 'var(--hard)' : 'var(--easy)';
  document.getElementById('dup-pct').textContent = pct + '%';
  document.getElementById('dup-lbl').textContent = dup > 0.9 ? '⚠ 重复度' : '重复度';

  const stats = [
    {{l:'MEAN SI',     v:MEAN_SI[idx].toFixed(2)}},
    {{l:'MAX SI',      v:MAX_SI[idx].toFixed(2)}},
    {{l:'MEAN GN',     v:MEAN_GN[idx].toFixed(4)}},
    {{l:'GN STD',      v:GN_STD[idx].toFixed(4)}},
    {{l:'MEAN ALIGN',  v:MEAN_AL[idx].toFixed(4)}},
    {{l:'NEG ALIGN %', v:(MEAN_FN[idx]*100).toFixed(0)+'%'}},
  ];
  document.getElementById('stat-grid').innerHTML = stats.map(s =>
    `<div class="stat-item"><div class="slbl">${{s.l}}</div><div class="sval">${{s.v}}</div></div>`
  ).join('');

  drawChart(idx);
}}

function drawChart(idx) {{
  if(!HAS_TRAJ || !GN_U8) {{
    document.getElementById('ph').style.display = 'flex';
    document.getElementById('ph').querySelector('p').textContent = '轨迹数据不可用（无 .npz 文件）';
    document.getElementById('cc').style.display = 'none';
    return;
  }}
  document.getElementById('ph').style.display = 'none';
  document.getElementById('cc').style.display = 'flex';

  const gn = [], al = [];
  for(let e=0; e<_NE; e++) {{
    const base = idx * _NE + e;
    const g = GN_U8[base], a = AL_U8[base];
    gn.push(g === 255 ? null : _GN_MIN + (g/255)*_GN_SC);
    al.push(a === 254 ? null : (a/253)*2 - 1);
  }}

  const ctx = document.getElementById('myChart').getContext('2d');
  if(chart) chart.destroy();
  chart = new Chart(ctx, {{
    type: 'line',
    data: {{
      labels: EPOCHS.map(e => `ep${{e}}`),
      datasets: [
        {{label:'grad_norm(均值)', data:gn, borderColor:'#f59e0b', backgroundColor:'rgba(245,158,11,.1)', borderWidth:2, pointRadius:4, tension:.3, yAxisID:'y'}},
        {{label:'align(均值)',     data:al, borderColor:'#818cf8', backgroundColor:'rgba(129,140,248,.1)', borderWidth:2, pointRadius:4, tension:.3, yAxisID:'y2'}}
      ]
    }},
    options: {{
      responsive:true, maintainAspectRatio:false, animation:{{duration:150}},
      interaction:{{mode:'index',intersect:false}},
      plugins:{{
        legend:{{display:false}},
        tooltip:{{
          backgroundColor:'#141820',borderColor:'#252b3d',borderWidth:1,
          titleColor:'#c8d0e0',bodyColor:'#7a8299',
          titleFont:{{family:'Fira Code',size:11}},bodyFont:{{family:'Fira Code',size:10}},
          callbacks:{{label:c=>`  ${{c.dataset.label}}: ${{c.parsed.y?.toFixed(5)??'—'}}`}}
        }}
      }},
      scales:{{
        x:{{grid:{{color:'#1e2333'}},ticks:{{color:'#4a5270',font:{{family:'Fira Code',size:10}}}}}},
        y:{{grid:{{color:'#1e2333'}},ticks:{{color:'#f59e0b',font:{{family:'Fira Code',size:9}}}},title:{{display:true,text:'grad_norm(均值)',color:'#4a5270',font:{{family:'Fira Code',size:9}}}}}},
        y2:{{position:'right',grid:{{display:false}},ticks:{{color:'#818cf8',font:{{family:'Fira Code',size:9}}}},title:{{display:true,text:'align(均值)',color:'#4a5270',font:{{family:'Fira Code',size:9}}}}}}
      }}
    }}
  }});
}}

loadBinaryData();
</script></body></html>"""

if __name__ == "__main__":
    main()
