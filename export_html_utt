        <button class="export-btn" onclick="exportCSV()">⬇ CSV</button>
      </div>
    </div>

    <div class="list-header">
      <span class="th" onclick="setSort('rank')" id="th-rank">#<span class="arrow"></span></span>
      <span class="th" onclick="setSort('uid')" id="th-uid">utt_id<span class="arrow"></span></span>
      <span class="th th-c" onclick="setSort('nc')" id="th-nc">chunks<span class="arrow"></span></span>
      <span class="th th-r" onclick="setSort('gn')" id="th-gn">mean_gn<span class="arrow"></span></span>
      <span class="th th-r" onclick="setSort('al')" id="th-al">mean_al<span class="arrow"></span></span>
      <span class="th th-r" onclick="setSort('tag')" id="th-tag">tag<span class="arrow"></span></span>
    </div>

    <div class="vlist" id="vlist">
      <div id="vinner"></div>
    </div>

    <div class="pagination">
      <button id="bp" onclick="prevPage()" disabled>◀</button>
      <span class="pginfo" id="pginfo">—</span>
      <button id="bn" onclick="nextPage()" disabled>▶</button>
    </div>
  </div>

  <div class="panel-right">
    <div class="chart-hdr">
      <div class="chdr-left">
        <div class="ctitle" id="ctitle">— 点击左侧选择一条 utterance —</div>
        <div class="csub"   id="csub"></div>
      </div>
      <div class="stat-grid" id="stat-grid"></div>
    </div>
    <div class="chart-area">
      <div id="ph" class="placeholder">
        <div class="phi">◈</div>
        <p>选择 utterance 后，此处显示各 epoch 的梯度均值轨迹</p>
      </div>
      <div id="cc" style="display:none;flex:1;flex-direction:column;gap:10px;">
        <div class="chart-wrap"><canvas id="myChart"></canvas></div>
        <div class="legend">
          <div class="li"><div class="ld gn"></div>grad_norm 均值（左轴）</div>
          <div class="li"><div class="ld al"></div>align 均值（右轴）</div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
const DATA_URL  = "{bin_filename}";
const EPOCHS    = {epochs};
const TAG_NAMES = ["harmful_suspect","hard","high_influence","easy_redundant","normal"];

// ── 全局数据（无 DUP）──
let _N, _NE, HAS_TRAJ, _GN_MIN, _GN_SC;
let N_CHUNKS, MEAN_SI, MAX_SI, MEAN_GN, MAX_GN, GN_STD, MEAN_AL, MEAN_FN, TAGS, UTT_IDS;
let GN_U8=null, AL_U8=null;

// ── 状态 ──
const PAGE=100, ROW_H=36;
let filtered=null, pageStart=0, selIdx=-1, chart=null, stimer=null;
let sortKey='si', sortAsc=false;

// ── 列头 id 映射 ──
const TH_IDS={{rank:'th-rank',uid:'th-uid',nc:'th-nc',gn:'th-gn',al:'th-al',tag:'th-tag'}};

// ── 数据加载 ──
async function loadBinaryData(){{
  try{{
    const res = await fetch(DATA_URL);
    if(!res.ok) throw new Error("无法读取 .bin，请用 Web Server 打开（python -m http.server）");
    const buf = await res.arrayBuffer();

    const mi=new Int32Array(buf,0,4);
    _N=mi[0]; _NE=mi[1]; const uttLen=mi[2]; HAS_TRAJ=mi[3]===1;
    const mf=new Float32Array(buf,16,2);
    _GN_MIN=mf[0]; _GN_SC=mf[1];

    document.getElementById('hmeta').textContent=`${{_N.toLocaleString()}} utterances · ${{_NE}} epochs`;

    // 偏移顺序与 Python 写入完全一致（无 DUP）
    let o=64;
    N_CHUNKS=new Int16Array(buf,o,_N);    o+=_N*2;
    MEAN_SI =new Float32Array(buf,o,_N);  o+=_N*4;
    MAX_SI  =new Float32Array(buf,o,_N);  o+=_N*4;
    MEAN_GN =new Float32Array(buf,o,_N);  o+=_N*4;
    MAX_GN  =new Float32Array(buf,o,_N);  o+=_N*4;
    GN_STD  =new Float32Array(buf,o,_N);  o+=_N*4;
    MEAN_AL =new Float32Array(buf,o,_N);  o+=_N*4;
    MEAN_FN =new Float32Array(buf,o,_N);  o+=_N*4;
    TAGS    =new Uint8Array(buf,o,_N);    o+=_N*1;

    UTT_IDS=new TextDecoder("utf-8").decode(new Uint8Array(buf,o,uttLen)).split('\\n'); o+=uttLen;

    if(HAS_TRAJ&&_NE>0){{
      const ts=_N*_NE;
      GN_U8=new Uint8Array(buf,o,ts); o+=ts;
      AL_U8=new Uint8Array(buf,o,ts);
    }}

    filtered=Int32Array.from({{length:_N}},(_,i)=>i);
    buildTagBadges();
    renderPage();
    document.getElementById('hstatus').style.display='none';
  }}catch(e){{
    const s=document.getElementById('hstatus');
    s.textContent='❌ '+e.message; s.style.color='var(--harmful)'; s.style.animation='none';
  }}
}}

// ── Tag 统计徽章 ──
function buildTagBadges(){{
  const cnt=[0,0,0,0,0];
  for(let i=0;i<_N;i++) cnt[TAGS[i]]++;
  const el=document.getElementById('hbadges'); el.innerHTML='';
  [0,1,2,3].forEach(t=>{{
    if(!cnt[t]) return;
    const b=document.createElement('span');
    b.className=`badge ${{TAG_NAMES[t]}}`;
    b.textContent=`${{TAG_NAMES[t].replace(/_/g,' ')}} ${{cnt[t].toLocaleString()}}`;
    el.appendChild(b);
  }});
}}

// ── 排序值 ──
function getVal(sk,i){{
  if(sk==='si'||sk==='rank') return MEAN_SI[i];
  if(sk==='maxsi') return MAX_SI[i];
  if(sk==='gn')    return MEAN_GN[i];
  if(sk==='al')    return MEAN_AL[i];
  if(sk==='nc')    return N_CHUNKS[i];
  if(sk==='tag')   return TAGS[i];
  return 0;
}}

// ── 列头点击排序 ──
function setSort(key){{
  const realKey=key==='rank'?'si':key;
  if(sortKey===realKey){{ sortAsc=!sortAsc; }}
  else{{ sortKey=realKey; sortAsc=(realKey==='al'); }}
  // 更新列头样式
  Object.entries(TH_IDS).forEach(([k,id])=>{{
    const el=document.getElementById(id);
    if(!el) return;
    el.classList.remove('active');
    el.querySelector('.arrow').textContent='';
  }});
  const activeId=TH_IDS[key];
  if(activeId){{
    const el=document.getElementById(activeId);
    if(el){{ el.classList.add('active'); el.querySelector('.arrow').textContent=sortAsc?' ↑':' ↓'; }}
  }}
  rebuild();
}}

// ── 搜索框初始化 ──
document.addEventListener('DOMContentLoaded',()=>{{
  const inp=document.getElementById('search');
  const clr=document.getElementById('search-clear');
  inp.addEventListener('input',()=>{{
    clr.style.display=inp.value?'block':'none';
    clearTimeout(stimer); stimer=setTimeout(rebuild,180);
  }});
}});
function clearSearch(){{
  document.getElementById('search').value='';
  document.getElementById('search-clear').style.display='none';
  rebuild();
}}

// ── 重建过滤+排序 ──
function rebuild(){{
  const tagF=parseInt(document.getElementById('tag-f').value);
  const q=document.getElementById('search').value.trim().toLowerCase();

  let arr=[];
  for(let i=0;i<_N;i++){{
    if(tagF>=0 && TAGS[i]!==tagF) continue;
    if(q && !((UTT_IDS[i]||'').toLowerCase().includes(q))) continue;
    arr.push(i);
  }}

  if(sortKey==='uid'){{
    arr.sort((a,b)=>{{
      const r=(UTT_IDS[a]||'').localeCompare(UTT_IDS[b]||'');
      return sortAsc?r:-r;
    }});
  }}else{{
    arr.sort((a,b)=>{{
      const va=getVal(sortKey,a), vb=getVal(sortKey,b);
      if(isNaN(va)&&isNaN(vb)) return 0;
      if(isNaN(va)) return 1; if(isNaN(vb)) return -1;
      return sortAsc?(va-vb):(vb-va);
    }});
  }}

  filtered=arr;
  pageStart=0;
  renderPage();
}}

// ── 渲染列表 ──
function escH(s){{return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}}
function highlight(text,q){{
  if(!q) return escH(text);
  const idx=text.toLowerCase().indexOf(q);
  if(idx<0) return escH(text);
  return escH(text.slice(0,idx))+'<mark>'+escH(text.slice(idx,idx+q.length))+'</mark>'+escH(text.slice(idx+q.length));
}}

function renderPage(){{
  const total=filtered.length;
  const pages=Math.max(1,Math.ceil(total/PAGE));
  const page=Math.floor(pageStart/PAGE)+1;
  const slice=filtered.slice(pageStart,pageStart+PAGE);
  const q=document.getElementById('search').value.trim().toLowerCase();

  document.getElementById('pginfo').textContent=`${{page}}/${{pages}} (${{total.toLocaleString()}})`;
  document.getElementById('bp').disabled=pageStart<=0;
  document.getElementById('bn').disabled=pageStart+PAGE>=total;

  const inner=document.getElementById('vinner');
  inner.style.height=(slice.length*ROW_H)+'px';
  inner.innerHTML='';

  for(let vi=0;vi<slice.length;vi++){{
    const i=slice[vi];
    const row=document.createElement('div');
    row.className='srow'+(i===selIdx?' sel':'');
    row.style.top=(vi*ROW_H)+'px';
    const uid=UTT_IDS[i]||String(i);
    const gn=MEAN_GN[i], al=MEAN_AL[i];
    const tag=TAG_NAMES[TAGS[i]];
    const alc=isNaN(al)?'':(al>=0?'pos':'neg');
    row.innerHTML=
      `<div class="s-rank">${{pageStart+vi+1}}</div>`+
      `<div class="s-uid" title="${{escH(uid)}}">${{highlight(uid,q)}}</div>`+
      `<div class="s-nc">${{N_CHUNKS[i]}}</div>`+
      `<div class="s-gn">${{isNaN(gn)?'—':gn.toFixed(3)}}</div>`+
      `<div class="s-al ${{alc}}">${{isNaN(al)?'—':al.toFixed(3)}}</div>`+
      `<div class="col-tag"><span class="badge ${{tag}}">${{tag.replace(/_/g,' ')}}</span></div>`;
    row.addEventListener('click',()=>selectSample(i,row));
    inner.appendChild(row);
  }}
  document.getElementById('vlist').scrollTop=0;
}}

function prevPage(){{ if(pageStart>0){{ pageStart=Math.max(0,pageStart-PAGE); renderPage(); }} }}
function nextPage(){{ if(pageStart+PAGE<filtered.length){{ pageStart+=PAGE; renderPage(); }} }}

// ── 选中样本 ──
function selectSample(idx,el){{
  selIdx=idx;
  document.querySelectorAll('.srow').forEach(r=>r.classList.remove('sel'));
  el.classList.add('sel');

  const uid=UTT_IDS[idx]||String(idx);
  const tag=TAG_NAMES[TAGS[idx]];
  document.getElementById('ctitle').textContent=uid;
  document.getElementById('csub').textContent=
    `tag: ${{tag}}  ·  chunks: ${{N_CHUNKS[idx]}}  ·  mean_si: ${{MEAN_SI[idx].toFixed(2)}}  ·  max_si: ${{MAX_SI[idx].toFixed(2)}}`;

  const stats=[
    {{l:'MEAN SI',    v:MEAN_SI[idx].toFixed(2)}},
    {{l:'MAX SI',     v:MAX_SI[idx].toFixed(2)}},
    {{l:'MEAN GN',    v:MEAN_GN[idx].toFixed(4)}},
    {{l:'GN STD',     v:GN_STD[idx].toFixed(4)}},
    {{l:'MEAN ALIGN', v:MEAN_AL[idx].toFixed(4)}},
    {{l:'NEG ALIGN',  v:(MEAN_FN[idx]*100).toFixed(0)+'%'}},
  ];
  document.getElementById('stat-grid').innerHTML=stats.map(s=>
    `<div class="stat-item"><div class="slbl">${{s.l}}</div><div class="sval">${{s.v}}</div></div>`
  ).join('');

  drawChart(idx);
}}

// ── 折线图 ──
function drawChart(idx){{
  if(!HAS_TRAJ||!GN_U8){{
    document.getElementById('ph').style.display='flex';
    document.getElementById('ph').querySelector('p').textContent='无轨迹数据（未找到 .npz 文件）';
    document.getElementById('cc').style.display='none';
    return;
  }}
  document.getElementById('ph').style.display='none';
  document.getElementById('cc').style.display='flex';

  const gn=[],al=[];
  for(let e=0;e<_NE;e++){{
    const b=idx*_NE+e;
    gn.push(GN_U8[b]===255?null:_GN_MIN+(GN_U8[b]/255)*_GN_SC);
    al.push(AL_U8[b]===254?null:(AL_U8[b]/253)*2-1);
  }}

  if(chart) chart.destroy();
  chart=new Chart(document.getElementById('myChart').getContext('2d'),{{
    type:'line',
    data:{{
      labels:EPOCHS.map(e=>`ep${{e}}`),
      datasets:[
        {{label:'grad_norm(均值)',data:gn,borderColor:'#2563eb',backgroundColor:'rgba(37,99,235,.08)',
          borderWidth:2,pointRadius:4,pointBackgroundColor:'#2563eb',tension:.3,yAxisID:'y'}},
        {{label:'align(均值)',data:al,borderColor:'#7c3aed',backgroundColor:'rgba(124,58,237,.08)',
          borderWidth:2,pointRadius:4,pointBackgroundColor:'#7c3aed',tension:.3,yAxisID:'y2'}}
      ]
    }},
    options:{{
      responsive:true,maintainAspectRatio:false,animation:{{duration:200}},
      interaction:{{mode:'index',intersect:false}},
      plugins:{{
        legend:{{display:false}},
        tooltip:{{
          backgroundColor:'#fff',borderColor:'#dde3ee',borderWidth:1,
          titleColor:'#1a2035',bodyColor:'#6b7a99',
          titleFont:{{family:'IBM Plex Mono',size:11}},bodyFont:{{family:'IBM Plex Mono',size:10}},
          callbacks:{{label:c=>`  ${{c.dataset.label}}: ${{c.parsed.y?.toFixed(5)??'—'}}`}}
        }}
      }},
      scales:{{
        x:{{grid:{{color:'#eef1f7'}},ticks:{{color:'#6b7a99',font:{{family:'IBM Plex Mono',size:10}}}}}},
        y:{{grid:{{color:'#eef1f7'}},ticks:{{color:'#2563eb',font:{{family:'IBM Plex Mono',size:9}}}},
          title:{{display:true,text:'grad_norm',color:'#9aa3ba',font:{{family:'IBM Plex Mono',size:9}}}}}},
        y2:{{position:'right',grid:{{display:false}},ticks:{{color:'#7c3aed',font:{{family:'IBM Plex Mono',size:9}}}},
          title:{{display:true,text:'align',color:'#9aa3ba',font:{{family:'IBM Plex Mono',size:9}}}}}}
      }}
    }}
  }});
}}

// ── 导出当前视图 CSV ──
function exportCSV(){{
  if(!filtered||!UTT_IDS) return;
  const rows=[['utt_id','n_chunks','mean_si','max_si','mean_gn','gn_std','mean_al','mean_fn','tag']];
  for(let i=0;i<filtered.length;i++){{
    const idx=filtered[i];
    rows.push([
      UTT_IDS[idx]||idx,
      N_CHUNKS[idx],
      MEAN_SI[idx].toFixed(4),
      MAX_SI[idx].toFixed(4),
      MEAN_GN[idx].toFixed(4),
      GN_STD[idx].toFixed(4),
      MEAN_AL[idx].toFixed(4),
      MEAN_FN[idx].toFixed(4),
      TAG_NAMES[TAGS[idx]]
    ]);
  }}
  const csv=rows.map(r=>r.map(c=>`"${{String(c).replace(/"/g,'""')}}"`).join(',')).join('\\n');
  const a=document.createElement('a');
  a.href='data:text/csv;charset=utf-8,\\uFEFF'+encodeURIComponent(csv);
  a.download='utt_contribution_export.csv';
  a.click();
}}

loadBinaryData();
</script>
</body></html>"""

if __name__ == "__main__":
    main()
