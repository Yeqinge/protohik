function exportCSV(){{
  if(!filtered||!UTT_IDS) return;
  const hdr=['utt_id','n_chunks','mean_si','max_si','mean_gn','gn_std','mean_al','mean_fn'];
  if(HAS_WEIGHT) hdr.push('mean_wt','wt_std');
  hdr.push('tag');
