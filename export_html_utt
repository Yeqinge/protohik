#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
export_html_utt.py —— Utterance 级样本贡献度分析可视化工具 v4
新增 weight 字段：epoch 轨迹 + utterance 级聚合 (mean_weight / weight_std)
去掉 dup_ratio，修复搜索，列头点击排序升降序，导出 CSV，亮色主题

修复说明（v4.1）：
  gn_egs / al_egs / wt_egs 填充时，原来先尝试把 id 字段的整数值直接当矩阵行号，
  但 summary CSV 按 self_influence 降序排列，id 与物理行号完全不对应，
  导致几乎所有样本的轨迹图数据错位或全为 nan。
  修复：统一通过 id2idx_egs（id字符串 → CSV物理行号）查行号，删除整数强转分支。
"""

import argparse
import csv
import glob
import os
import re
import sys
import json
import numpy as np
from collections import defaultdict

TAG_MAP   = {"harmful_suspect": 0, "hard": 1, "high_influence": 2, "easy_redundant": 3, "normal": 4}
TAG_NAMES = ["harmful_suspect", "hard", "high_influence", "easy_redundant", "normal"]

def fv(row, key):
    try:    return float(row.get(key, "nan"))
    except: return float("nan")

def strip_chunk_suffix(utt_id):
    return re.sub(r'-\d+$', '', utt_id)

_LABEL_PREFIXES = re.compile(
    r'^(?:abnormal|normal|hard|unknown|noise|fault|'
    r'harmful_suspect|high_influence|easy_redundant)-',
    re.IGNORECASE
)

def strip_label_prefix(utt_id):
    return _LABEL_PREFIXES.sub('', utt_id)

def main():
    print("\n" + "="*60)
    print("🚀 [START] Utterance 级聚合分析脚本 v4.3 启动...")
    print("="*60)

    ap = argparse.ArgumentParser(description="Utterance 级样本贡献度可视化 HTML 生成器 v4.3")
    ap.add_argument("--contrib", required=True, help="包含 contrib_epoch*.npz 和 summary CSV 的目录")
    ap.add_argument("--egs",     default="", help="可选：train.egs.csv 路径")
    ap.add_argument("--summary", default="", help="可选：明确指定 summary CSV 路径")
    ap.add_argument("--output",  default="contrib_utt.html", help="输出 HTML 文件名")
    ap.add_argument("--meta",    default="", help="可选：JSON 汇总文件路径（含 file_path/label/detector_id 等字段）")
    args = ap.parse_args()

    print(f"📍 CWD: {os.getcwd()}")
    print(f"📁 --contrib: {os.path.abspath(args.contrib)}")

    # ── 0. 加载 JSON 元信息（可选）──
    meta_map = {}
    if args.meta and os.path.exists(args.meta):
        print(f"\n[0/5] 加载 JSON 元信息: {args.meta}")
        with open(args.meta, encoding="utf-8") as f:
            jdata = json.load(f)
        items = jdata if isinstance(jdata, list) else jdata.get("datas", jdata.get("data", []))
        for item in items:
            entry = {
                "file_path":   item.get("file_path", ""),
                "label":       item.get("label", ""),
                "detector_id": item.get("detector_id", ""),
                "channel_id":  item.get("channel_id", ""),
                "project":     item.get("project", ""),
                "duration":    item.get("duration", ""),
                "time_point":  item.get("time_point", ""),
            }
            fp = item.get("file_path", "") or item.get("ID", "")
            fp_stem = re.sub(r"\.wav$", "", os.path.basename(fp), flags=re.IGNORECASE)
            if fp_stem:
                meta_map[fp_stem] = entry
            raw_id = item.get("ID", "")
            id_stem = re.sub(r"\.wav$", "", raw_id, flags=re.IGNORECASE)
            if id_stem and id_stem != fp_stem:
                meta_map[id_stem] = entry
        print(f"   元信息条目数: {len(meta_map)}")
    else:
        print("\n[0/5] 未指定 --meta，跳过元信息加载")

    # ── 1. 加载 egs 粒度 Summary CSV ──
    print("\n[1/5] 加载 egs 粒度 Summary CSV ...")
    sp = args.summary
    if not sp:
        for nm in ("contrib_summary_with_uttid.csv", "contrib_summary.csv"):
            p = os.path.join(args.contrib, nm)
            if os.path.exists(p):
                sp = p
                break
    if not sp or not os.path.exists(sp):
        print("❌ 找不到 summary CSV")
        sys.exit(1)

    egs_rows = []
    with open(sp, newline="", encoding="utf-8") as f:
        for r in csv.DictReader(f):
            egs_rows.append(r)
    n_egs = len(egs_rows)
    print(f"   egs 样本数: {n_egs}")

    # ── 2. sample_id → utt_id 映射 ──
    print("\n[2/5] 建立 sample_id → utt_id 映射 ...")
    idx2utt = {}
    if args.egs and os.path.exists(args.egs):
        print(f"   -> 从外挂 egs 文件读取: {args.egs}")
        with open(args.egs, encoding="utf-8") as f:
            first = f.readline()
            delim = "\t" if "\t" in first else " "
        egs_uttid2lineno = {}
        with open(args.egs, encoding="utf-8") as f:
            data_i = 0
            for line in f:
                p = line.strip().split(delim)
                if not p or not p[0]: continue
                if not any(c.isdigit() for c in p[0]):
                    continue
                egs_uttid2lineno[p[0]] = data_i
                data_i += 1
        print(f"   egs 总数据行: {len(egs_uttid2lineno)}")

        lineno2uttid = {v: k for k, v in egs_uttid2lineno.items()}
        hit = 0
        for i, row in enumerate(egs_rows):
            csv_id = row.get("id", "")
            try:
                lineno = int(csv_id)
                raw = lineno2uttid.get(lineno)
                if raw:
                    idx2utt[i] = raw
                    hit += 1
            except (ValueError, TypeError):
                pass
        print(f"   summary CSV 命中 egs 行: {hit}/{n_egs}")
        if hit == 0:
            print("   ⚠️  未能从 egs 行号匹配！检查 summary CSV 的 id 列是否为 egs 数据行号")
            sample_csv_ids  = [r.get("id", "") for r in egs_rows[:5]]
            sample_egs_keys = list(egs_uttid2lineno.keys())[:5]
            print(f"      CSV id 样本:      {sample_csv_ids}")
            print(f"      egs utt_id 样本:  {sample_egs_keys}")
    elif egs_rows and "utt_id" in egs_rows[0]:
        print("   -> 从 CSV utt_id 列读取（fallback）")
        idx2utt = {i: r["utt_id"] for i, r in enumerate(egs_rows) if r.get("utt_id")}
        print(f"   有效映射数: {len(idx2utt)}")
    else:
        print("   ⚠️  未找到 utt_id 来源，将使用数字 id（可通过 --egs 指定外挂文件）")

    # ── 3. 加载 epoch 轨迹（含 focal_weight）──
    print("\n[3/5] 加载 epoch 轨迹 ...")
    files = sorted(glob.glob(os.path.join(args.contrib, "contrib_epoch*.npz")))
    print(f"   找到 {len(files)} 个 .npz")

    # ── 修复：统一用 id字符串 → CSV物理行号 的映射 ──
    # 原来的逻辑：先尝试把 id 整数值直接当行号（idxs = ids_str.astype(np.int64)），
    # summary CSV 按 self_influence 降序排，id 与物理行号完全不对应，
    # 导致轨迹数据全部错位。现在删除该分支，统一走 id2idx_egs。
    id2idx_egs = {r["id"]: i for i, r in enumerate(egs_rows)}

    epochs = []
    gn_egs = al_egs = wt_egs = None
    has_traj   = len(files) > 0
    has_weight = False

    if has_traj:
        ne = len(files)
        gn_egs = np.full((n_egs, ne), np.nan, dtype=np.float32)
        al_egs = np.full((n_egs, ne), np.nan, dtype=np.float32)
        wt_egs = np.full((n_egs, ne), np.nan, dtype=np.float32)

        for ei, fp in enumerate(files):
            ep = int(os.path.basename(fp)[len("contrib_epoch"):-len(".npz")])
            epochs.append(ep)
            d = np.load(fp, allow_pickle=True)
            ids_str = d["ids"].astype(str)

            # 统一通过 id2idx_egs 查 CSV 物理行号，-1 表示未命中
            idxs = np.array([id2idx_egs.get(s, -1) for s in ids_str], dtype=np.int64)
            m    = idxs >= 0

            if ei == 0 and not m.any():
                print(f"  ⚠️  epoch {ei}: 没有任何 id 命中 summary CSV，检查 id 格式是否一致")
                print(f"      npz id 样本:  {list(ids_str[:5])}")
                print(f"      csv id 样本:  {list(id2idx_egs.keys())[:5]}")

            gn_egs[idxs[m], ei] = d["grad_norm"][m]
            al_egs[idxs[m], ei] = d["align"][m]
            if "focal_weight" in d:
                has_weight = True
                wt_egs[idxs[m], ei] = d["focal_weight"][m]

            # utt_ids fallback：只在 step2 未建立有效映射时才用
            if ei == 0 and "utt_ids" in d and len(idx2utt) == 0:
                utt_ids_npz = d["utt_ids"].astype(str)
                for k in range(len(ids_str)):
                    egs_i = idxs[k]
                    if egs_i >= 0:
                        idx2utt[egs_i] = utt_ids_npz[k]
                print(f"   -> 从 npz utt_ids 补充映射（fallback），有效: {len(idx2utt)}")
            elif ei == 0 and "utt_ids" in d:
                print(f"   -> npz 含 utt_ids 但 --egs 映射已建立，跳过覆盖")

        epochs = sorted(epochs)
        last_hit = int(m.sum())
        print(f"   轨迹命中率（最后 epoch）: {last_hit}/{len(ids_str)}")
        if has_weight:
            print(f"   ✅ 检测到 focal_weight 字段（将生成 focal_weight 轨迹）")
        else:
            print(f"   ℹ️  未检测到 focal_weight 字段，跳过 weight 可视化")

    # ── 4. 聚合到 utterance 粒度 ──
    print("\n[4/5] 聚合到 utterance 粒度 ...")
    utt2chunks = defaultdict(list)
    for i, row in enumerate(egs_rows):
        raw = idx2utt.get(i, row.get("id", str(i)))
        key = strip_chunk_suffix(raw)
        key = strip_label_prefix(key)
        key = re.sub(r'\.wav$', '', key, flags=re.IGNORECASE)
        key = os.path.basename(key)
        utt2chunks[key].append(i)

    utt_ids_list = sorted(utt2chunks.keys())
    n_utt = len(utt_ids_list)
    print(f"   chunk 数: {n_egs}  →  utterance 数: {n_utt}")

    utt_data = []
    for utt_id in utt_ids_list:
        idxs = utt2chunks[utt_id]
        nc   = len(idxs)

        def arr(key): return [fv(egs_rows[i], key) for i in idxs]
        def sm(lst):  v=[x for x in lst if not np.isnan(x)]; return float(np.mean(v)) if v else float("nan")
        def sx(lst):  v=[x for x in lst if not np.isnan(x)]; return float(np.max(v))  if v else float("nan")
        def sd(lst):  v=[x for x in lst if not np.isnan(x)]; return float(np.std(v))  if len(v)>1 else 0.0

        si = arr("self_influence"); gn = arr("mean_grad_norm")
        al = arr("mean_align");     fn = arr("frac_neg_align")
        fo = arr("forget_events");  fc = arr("final_correct")

        gn_std = sd(gn)
        tags      = [TAG_MAP.get(egs_rows[i].get("tag", "normal"), 4) for i in idxs]
        worst_tag = min(tags)

        gn_traj = al_traj = wt_traj = None
        mean_wt = float("nan"); wt_std = 0.0
        if has_traj:
            gn_traj = np.nanmean(gn_egs[idxs, :], axis=0)
            al_traj = np.nanmean(al_egs[idxs, :], axis=0)
            if has_weight:
                wt_traj = np.nanmean(wt_egs[idxs, :], axis=0)
                wt_flat  = wt_egs[idxs, :].flatten()
                wt_valid = wt_flat[~np.isnan(wt_flat)]
                if len(wt_valid):
                    mean_wt = float(np.mean(wt_valid))
                    wt_std  = float(np.std(wt_valid)) if len(wt_valid) > 1 else 0.0

        meta = meta_map.get(utt_id, {})
        utt_data.append(dict(
            utt_id=utt_id, n_chunks=nc,
            mean_si=sm(si), max_si=sx(si),
            mean_gn=sm(gn), max_gn=sx(gn), gn_std=gn_std,
            mean_al=sm(al), mean_fn=sm(fn),
            mean_fo=sm(fo), mean_fc=sm(fc),
            mean_wt=mean_wt, wt_std=wt_std,
            worst_tag=worst_tag,
            gn_traj=gn_traj, al_traj=al_traj, wt_traj=wt_traj,
            file_path=meta.get("file_path", ""),
            label=meta.get("label", ""),
            detector_id=meta.get("detector_id", ""),
            channel_id=meta.get("channel_id", ""),
            project=meta.get("project", ""),
            duration=str(meta.get("duration", "")),
            time_point=meta.get("time_point", ""),
        ))

    if meta_map:
        hit  = sum(1 for d in utt_data if d.get("file_path") or d.get("label"))
        miss = [d["utt_id"] for d in utt_data if not d.get("file_path") and not d.get("label")]
        print(f"   meta 匹配率: {hit}/{n_utt} utterances")
        print(f"   utt_id 样本 (聚合后):  {utt_ids_list[:5]}")
        print(f"   meta key 样本:         {list(meta_map.keys())[:5]}")
        if miss:
            print(f"   未命中 utt_id 样本:    {miss[:5]}")

    utt_data.sort(key=lambda x: x["mean_si"] if not np.isnan(x["mean_si"]) else -1e9, reverse=True)

    # ── 导出 utterance 级 CSV ──
    csv_out = os.path.splitext(args.output)[0] + "_utt_summary.csv"
    print(f"\n   导出 utterance CSV → {csv_out}")
    fieldnames = ["utt_id", "n_chunks", "mean_si", "max_si",
                  "mean_gn", "max_gn", "gn_std", "mean_al", "mean_fn",
                  "mean_fo", "mean_fc", "mean_wt", "wt_std", "worst_tag"]
    with open(csv_out, "w", newline="", encoding="utf-8") as f:
        w = csv.DictWriter(f, fieldnames=fieldnames)
        w.writeheader()
        for d in utt_data:
            w.writerow({k: (TAG_NAMES[d[k]] if k == "worst_tag" else
                            ("" if isinstance(d[k], float) and np.isnan(d[k]) else
                             round(d[k], 6) if isinstance(d[k], float) else d[k]))
                        for k in fieldnames})
    print(f"   ✅ CSV 写入完成")

    # ── 5. 打包二进制 + 生成 HTML ──
    print("\n[5/5] 打包二进制并生成 HTML ...")
    n_u = len(utt_data)
    ne  = len(epochs)

    n_chunks_arr = np.array([d["n_chunks"] for d in utt_data], dtype=np.int16)
    mean_si_arr  = np.array([d["mean_si"]  for d in utt_data], dtype=np.float32)
    max_si_arr   = np.array([d["max_si"]   for d in utt_data], dtype=np.float32)
    mean_gn_arr  = np.array([d["mean_gn"]  for d in utt_data], dtype=np.float32)
    max_gn_arr   = np.array([d["max_gn"]   for d in utt_data], dtype=np.float32)
    gn_std_arr   = np.array([d["gn_std"]   for d in utt_data], dtype=np.float32)
    mean_al_arr  = np.array([d["mean_al"]  for d in utt_data], dtype=np.float32)
    mean_fn_arr  = np.array([d["mean_fn"]  for d in utt_data], dtype=np.float32)
    mean_wt_arr  = np.array([d["mean_wt"]  for d in utt_data], dtype=np.float32)
    wt_std_arr   = np.array([d["wt_std"]   for d in utt_data], dtype=np.float32)
    tags_arr     = np.array([d["worst_tag"]for d in utt_data], dtype=np.uint8)

    gn_mat_u8 = al_mat_u8 = wt_mat_u8 = None
    gn_min = 0.0; gn_scale = 1.0
    wt_min = 0.0; wt_scale = 1.0
    if has_traj and ne > 0:
        gn_s = np.stack([d["gn_traj"] for d in utt_data])
        al_s = np.stack([d["al_traj"] for d in utt_data])

        valid_gn = gn_s[~np.isnan(gn_s)]
        if len(valid_gn):
            gn_min   = float(np.nanmin(gn_s))
            gn_scale = max(float(np.nanpercentile(valid_gn, 99)) - gn_min, 1e-9)
        gq = np.clip((gn_s - gn_min) / gn_scale * 254, 0, 254); gq[np.isnan(gn_s)] = 255
        aq = np.clip((al_s + 1.0) / 2.0 * 253, 0, 253);          aq[np.isnan(al_s)] = 254
        gn_mat_u8 = gq.astype(np.uint8)
        al_mat_u8 = aq.astype(np.uint8)

        if has_weight:
            wt_s = np.stack([d["wt_traj"] if d["wt_traj"] is not None
                             else np.full(ne, np.nan) for d in utt_data])
            valid_wt = wt_s[~np.isnan(wt_s)]
            if len(valid_wt):
                wt_min   = float(np.nanmin(wt_s))
                wt_scale = max(float(np.nanpercentile(valid_wt, 99)) - wt_min, 1e-9)
            wq = np.clip((wt_s - wt_min) / wt_scale * 253, 0, 253); wq[np.isnan(wt_s)] = 254
            wt_mat_u8 = wq.astype(np.uint8)

    utt_bytes = "\n".join(d["utt_id"] for d in utt_data).encode("utf-8")
    utt_len   = len(utt_bytes)

    flags    = (1 if has_traj else 0) | (2 if has_weight else 0)
    bin_path = os.path.splitext(args.output)[0] + "_utt.bin"
    with open(bin_path, "wb") as fb:
        fb.write(np.array([n_u, ne, utt_len, flags], dtype=np.int32).tobytes())
        fb.write(np.array([gn_min, gn_scale], dtype=np.float32).tobytes())
        fb.write(np.array([wt_min, wt_scale], dtype=np.float32).tobytes())
        fb.write(b"\x00" * 48)
        for a in [n_chunks_arr, mean_si_arr, max_si_arr,
                  mean_gn_arr, max_gn_arr, gn_std_arr,
                  mean_al_arr, mean_fn_arr,
                  mean_wt_arr, wt_std_arr,
                  tags_arr]:
            fb.write(a.tobytes())
        fb.write(utt_bytes)
        if has_traj and gn_mat_u8 is not None:
            fb.write(gn_mat_u8.flatten().tobytes())
            fb.write(al_mat_u8.flatten().tobytes())
            if has_weight and wt_mat_u8 is not None:
                fb.write(wt_mat_u8.flatten().tobytes())

    print(f"   ✅ .bin  {os.path.getsize(bin_path)/1e6:.2f} MB → {os.path.abspath(bin_path)}")

    meta_out = []
    for d in utt_data:
        meta_out.append({
            "file_path":   d.get("file_path", ""),
            "label":       d.get("label", ""),
            "detector_id": d.get("detector_id", ""),
            "channel_id":  d.get("channel_id", ""),
            "project":     d.get("project", ""),
            "duration":    d.get("duration", ""),
            "time_point":  d.get("time_point", ""),
        })
    meta_json_name = os.path.splitext(os.path.basename(bin_path))[0] + "_meta.json"
    meta_json_path = os.path.join(os.path.dirname(bin_path), meta_json_name)
    with open(meta_json_path, "w", encoding="utf-8") as f:
        json.dump(meta_out, f, ensure_ascii=False)
    print(f"   ✅ .json {os.path.getsize(meta_json_path)/1024:.1f} KB → {os.path.abspath(meta_json_path)}")

    with open(args.output, "w", encoding="utf-8") as f:
        f.write(make_html(os.path.basename(bin_path), meta_json_name, epochs, n_u))
    print(f"   ✅ .html {os.path.getsize(args.output)/1024:.1f} KB → {os.path.abspath(args.output)}")

    single_chunk = sum(1 for d in utt_data if d["n_chunks"] == 1)
    print(f"\n{'='*60}")
    print(f"✨ 完成！utterance 数: {n_utt}")
    print(f"   单 chunk（短语音）: {single_chunk} ({100*single_chunk/max(n_utt,1):.1f}%)")
    print(f"   weight 轨迹: {'已生成' if has_weight else '未检测到'}")
    print(f"{'='*60}\n")


# ─────────────────────────────────────────────────────────────────
#  HTML
# ─────────────────────────────────────────────────────────────────
def make_html(bin_filename, meta_filename, epochs, n_u):
    return f"""<!DOCTYPE html>
<html lang="zh"><head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Utterance Contribution Analyzer</title>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<style>
:root{{
  --bg:#f4f6fa; --surf:#ffffff; --surf2:#f0f3f8; --surf3:#e8edf5;
  --bdr:#dde3ee; --bdr2:#c8d0e0;
  --tx:#1a2035;  --mt:#6b7a99;  --mt2:#9aa3ba;
  --ac:#2563eb;  --ac2:#1d4ed8; --ac-bg:#eff4ff;
  --harmful:#dc2626; --harmful-bg:#fef2f2;
  --hard:#ea580c;    --hard-bg:#fff7ed;
  --inf:#7c3aed;     --inf-bg:#f5f3ff;
  --easy:#16a34a;    --easy-bg:#f0fdf4;
  --wt:#0891b2;      --wt-bg:#ecfeff;
  --mono:'IBM Plex Mono',monospace; --sans:'Inter',sans-serif;
  --radius:6px;
  --shadow:0 1px 3px rgba(0,0,0,.08),0 1px 2px rgba(0,0,0,.04);
}}
*,*::before,*::after{{box-sizing:border-box;margin:0;padding:0;}}
html,body{{height:100%;background:var(--bg);color:var(--tx);font-family:var(--sans);overflow:hidden;font-size:13px;}}
.layout{{display:grid;grid-template-columns:560px 1fr;grid-template-rows:52px 1fr;height:100vh;}}
.header{{grid-column:1/-1;display:flex;align-items:center;padding:0 18px;gap:12px;
  border-bottom:1px solid var(--bdr);background:var(--surf);box-shadow:var(--shadow);z-index:10;}}
.htitle{{font-family:var(--mono);font-size:13px;font-weight:600;color:var(--ac);letter-spacing:.04em;}}
.hmeta{{font-size:11px;color:var(--mt);font-family:var(--mono);}}
.hbadges{{margin-left:auto;display:flex;gap:6px;flex-wrap:wrap;align-items:center;}}
.hstatus{{font-size:11px;color:var(--ac);font-family:var(--mono);padding:2px 8px;
  border:1px solid var(--bdr2);border-radius:4px;animation:pulse 1.4s infinite;}}
@keyframes pulse{{0%,100%{{opacity:1}}50%{{opacity:.4}}}}
.badge{{display:inline-flex;align-items:center;padding:2px 7px;border-radius:4px;
  font-size:10px;font-family:var(--mono);font-weight:500;border:1px solid;white-space:nowrap;}}
.badge.harmful_suspect{{color:var(--harmful);border-color:#fca5a5;background:var(--harmful-bg);}}
.badge.hard{{color:var(--hard);border-color:#fdba74;background:var(--hard-bg);}}
.badge.high_influence{{color:var(--inf);border-color:#c4b5fd;background:var(--inf-bg);}}
.badge.easy_redundant{{color:var(--easy);border-color:#86efac;background:var(--easy-bg);}}
.badge.normal{{color:var(--mt);border-color:var(--bdr2);background:var(--surf2);}}
.panel-left{{display:flex;flex-direction:column;background:var(--surf);border-right:1px solid var(--bdr);overflow:hidden;}}
.controls{{padding:10px 12px;border-bottom:1px solid var(--bdr);display:flex;flex-direction:column;gap:7px;background:var(--surf2);}}
.search-wrap{{position:relative;display:flex;align-items:center;}}
.search-wrap svg{{position:absolute;left:9px;width:14px;height:14px;color:var(--mt2);pointer-events:none;flex-shrink:0;}}
#search{{width:100%;padding:7px 32px 7px 30px;background:var(--surf);border:1px solid var(--bdr2);color:var(--tx);font-family:var(--mono);font-size:11px;outline:none;border-radius:var(--radius);transition:border-color .15s,box-shadow .15s;}}
#search:focus{{border-color:var(--ac);box-shadow:0 0 0 3px rgba(37,99,235,.12);}}
#search-clear{{position:absolute;right:8px;cursor:pointer;background:none;border:none;color:var(--mt2);font-size:14px;line-height:1;padding:2px;display:none;}}
#search-clear:hover{{color:var(--tx);}}
.filter-row{{display:flex;gap:6px;}}
.filter-row select{{flex:1;padding:5px 8px;background:var(--surf);border:1px solid var(--bdr2);color:var(--tx);font-family:var(--mono);font-size:11px;outline:none;border-radius:var(--radius);cursor:pointer;}}
.filter-row select:focus{{border-color:var(--ac);}}
.export-btn{{padding:5px 12px;background:var(--ac);color:#fff;border:none;border-radius:var(--radius);font-family:var(--mono);font-size:10px;font-weight:500;cursor:pointer;letter-spacing:.02em;transition:background .15s;white-space:nowrap;}}
.export-btn:hover{{background:var(--ac2);}}
.list-header{{display:grid;grid-template-columns:38px 1fr 46px 60px 60px 60px 106px;align-items:center;padding:0 12px;gap:4px;height:28px;border-bottom:2px solid var(--bdr);background:var(--surf3);font-family:var(--mono);font-size:9px;color:var(--mt);text-transform:uppercase;letter-spacing:.05em;user-select:none;}}
.th{{cursor:pointer;display:flex;align-items:center;gap:3px;padding:2px 3px;border-radius:3px;transition:background .1s,color .1s;white-space:nowrap;}}
.th:hover{{background:var(--bdr);color:var(--tx);}}
.th.active{{color:var(--ac);font-weight:600;}}
.th .arrow{{font-size:8px;opacity:.7;}}
.th-r{{justify-content:flex-end;}} .th-c{{justify-content:center;}}
.vlist{{flex:1;overflow-y:auto;position:relative;}}
.vlist::-webkit-scrollbar{{width:5px;}}
.vlist::-webkit-scrollbar-track{{background:var(--surf2);}}
.vlist::-webkit-scrollbar-thumb{{background:var(--bdr2);border-radius:3px;}}
.vlist::-webkit-scrollbar-thumb:hover{{background:var(--mt2);}}
#vinner{{position:relative;}}
.srow{{display:grid;grid-template-columns:38px 1fr 46px 60px 60px 60px 106px;align-items:center;padding:0 12px;cursor:pointer;gap:4px;border-bottom:1px solid var(--bdr);height:36px;position:absolute;width:100%;transition:background .08s;}}
.srow:hover{{background:var(--surf2);}}
.srow.sel{{background:var(--ac-bg);border-left:3px solid var(--ac);padding-left:9px;}}
.s-rank{{font-family:var(--mono);font-size:10px;color:var(--mt2);}}
.s-uid{{font-family:var(--mono);font-size:10.5px;color:var(--tx);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}}
.s-uid mark{{background:rgba(37,99,235,.15);color:var(--ac);border-radius:2px;padding:0 1px;}}
.s-nc{{text-align:center;font-size:10px;font-family:var(--mono);color:var(--mt);}}
.s-gn,.s-al,.s-wt{{text-align:right;font-size:10px;font-family:var(--mono);color:var(--mt);}}
.s-al.pos{{color:var(--easy);}} .s-al.neg{{color:var(--harmful);}}
.s-wt.hi{{color:var(--wt);font-weight:500;}}
.col-tag{{justify-self:end;}}
.pagination{{padding:6px 12px;border-top:1px solid var(--bdr);display:flex;align-items:center;gap:8px;font-family:var(--mono);font-size:10px;color:var(--mt);background:var(--surf2);}}
.pagination button{{padding:3px 10px;background:var(--surf);border:1px solid var(--bdr2);color:var(--tx);font-family:var(--mono);font-size:10px;cursor:pointer;border-radius:4px;transition:all .1s;}}
.pagination button:disabled{{opacity:.35;cursor:default;}}
.pagination button:not(:disabled):hover{{border-color:var(--ac);color:var(--ac);background:var(--ac-bg);}}
.pginfo{{flex:1;text-align:center;}}
.panel-right{{display:flex;flex-direction:column;overflow:hidden;background:var(--bg);}}
.chart-hdr{{padding:14px 20px 12px;border-bottom:1px solid var(--bdr);background:var(--surf);box-shadow:var(--shadow);display:flex;align-items:flex-start;gap:16px;}}
.chdr-left{{display:flex;flex-direction:column;gap:5px;min-width:0;flex:1;}}
.ctitle{{font-family:var(--mono);font-size:12px;color:var(--tx);font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}}
.csub{{font-family:var(--mono);font-size:10px;color:var(--mt);}}
.stat-grid{{display:flex;gap:14px;flex-shrink:0;flex-wrap:wrap;}}
.stat-item{{text-align:right;}}
.slbl{{font-size:9px;color:var(--mt);font-family:var(--mono);text-transform:uppercase;letter-spacing:.05em;}}
.sval{{font-size:15px;font-family:var(--mono);font-weight:600;color:var(--tx);margin-top:1px;}}
.sval.wt-val{{color:var(--wt);}}
.chart-tabs{{display:flex;gap:0;border-bottom:1px solid var(--bdr);background:var(--surf);padding:0 20px;}}
.ctab{{padding:8px 16px;font-family:var(--mono);font-size:11px;color:var(--mt);cursor:pointer;border-bottom:2px solid transparent;margin-bottom:-1px;transition:color .15s,border-color .15s;user-select:none;}}
.ctab:hover{{color:var(--tx);}}
.ctab.active{{color:var(--ac);border-bottom-color:var(--ac);font-weight:600;}}
.ctab.wt-tab.active{{color:var(--wt);border-bottom-color:var(--wt);}}
.ctab[data-tab="wt"]{{display:none;}}
.ctab[data-tab="wt"].show{{display:block;}}
.chart-area{{flex:1;padding:16px 24px 14px;display:flex;flex-direction:column;gap:10px;overflow:hidden;}}
.chart-wrap{{flex:1;position:relative;min-height:0;}}
.chart-wrap canvas{{position:absolute;inset:0;}}
.chart-panel{{display:none;flex:1;flex-direction:column;gap:10px;}}
.chart-panel.active{{display:flex;}}
.placeholder{{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;color:var(--mt2);font-family:var(--mono);}}
.phi{{font-size:40px;opacity:.25;}}
.placeholder p{{font-size:11px;}}
.legend{{display:flex;gap:20px;font-family:var(--mono);font-size:10px;color:var(--mt);flex-wrap:wrap;}}
.li{{display:flex;align-items:center;gap:6px;}}
.ld{{width:8px;height:8px;border-radius:50%;}}
.ld.gn{{background:#2563eb;}} .ld.al{{background:#7c3aed;}} .ld.wt{{background:#0891b2;}}
.wt-bar{{position:absolute;bottom:0;left:0;height:2px;background:var(--wt);opacity:.5;border-radius:0 1px 1px 0;}}
.meta-bar{{padding:8px 20px;border-bottom:1px solid var(--bdr);background:var(--surf2);display:none;flex-wrap:wrap;gap:6px 18px;font-family:var(--mono);font-size:10px;}}
.meta-bar.show{{display:flex;}}
.meta-kv{{display:flex;gap:5px;align-items:baseline;min-width:0;}}
.meta-k{{color:var(--mt2);text-transform:uppercase;font-size:9px;letter-spacing:.04em;white-space:nowrap;}}
.meta-v{{color:var(--tx);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:320px;}}
.meta-v.fp{{color:var(--mt);font-size:9.5px;max-width:480px;cursor:pointer;}}
.meta-v.fp:hover{{color:var(--ac);text-decoration:underline;}}
.meta-badge{{padding:1px 6px;border-radius:3px;font-size:9px;border:1px solid;}}
.meta-badge.normal{{color:var(--easy);border-color:#86efac;background:var(--easy-bg);}}
.meta-badge.anomaly,.meta-badge.abnormal{{color:var(--harmful);border-color:#fca5a5;background:var(--harmful-bg);}}
.meta-badge.unknown{{color:var(--mt);border-color:var(--bdr2);background:var(--surf2);}}
</style>
</head><body>
<div class="layout">
  <header class="header">
    <span class="htitle">UTT CONTRIBUTION ANALYZER</span>
    <span class="hmeta" id="hmeta">正在加载...</span>
    <div class="hbadges" id="hbadges">
      <span class="hstatus" id="hstatus">⏳ LOADING...</span>
    </div>
  </header>

  <div class="panel-left">
    <div class="controls">
      <div class="search-wrap">
        <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd"/></svg>
        <input id="search" placeholder="搜索 utt_id（实时过滤）..." autocomplete="off">
        <button id="search-clear" onclick="clearSearch()" title="清除">✕</button>
      </div>
      <div class="filter-row">
        <select id="tag-f" onchange="rebuild()">
          <option value="-1">全部 Tag</option>
          <option value="0">⚠ harmful_suspect</option>
          <option value="1">● hard</option>
          <option value="2">↑ high_influence</option>
          <option value="3">↓ easy_redundant</option>
          <option value="4">· normal</option>
        </select>
        <select id="wt-f" onchange="rebuild()" style="display:none;">
          <option value="0">全部 Weight</option>
          <option value="1">高权重 (≥0.75)</option>
          <option value="2">中权重 (0.25–0.75)</option>
          <option value="3">低权重 (&lt;0.25)</option>
        </select>
        <button class="export-btn" onclick="exportCSV()">⬇ CSV</button>
      </div>
      <div class="filter-row" id="meta-filters" style="display:none;">
        <select id="label-f" onchange="rebuild()"><option value="">全部 Label</option></select>
        <select id="detector-f" onchange="rebuild()"><option value="">全部 Detector</option></select>
        <select id="project-f" onchange="rebuild()"><option value="">全部 Project</option></select>
      </div>
    </div>

    <div class="list-header">
      <span class="th" onclick="setSort('rank')" id="th-rank">#<span class="arrow"></span></span>
      <span class="th" onclick="setSort('uid')" id="th-uid">utt_id<span class="arrow"></span></span>
      <span class="th th-c" onclick="setSort('nc')" id="th-nc">chk<span class="arrow"></span></span>
      <span class="th th-r" onclick="setSort('gn')" id="th-gn">mean_gn<span class="arrow"></span></span>
      <span class="th th-r" onclick="setSort('al')" id="th-al">mean_al<span class="arrow"></span></span>
      <span class="th th-r" onclick="setSort('wt')" id="th-wt" style="display:none;">mean_wt<span class="arrow"></span></span>
      <span class="th th-r" onclick="setSort('tag')" id="th-tag">tag<span class="arrow"></span></span>
    </div>

    <div class="vlist" id="vlist"><div id="vinner"></div></div>

    <div class="pagination">
      <button id="bp" onclick="prevPage()" disabled>◀</button>
      <span class="pginfo" id="pginfo">—</span>
      <button id="bn" onclick="nextPage()" disabled>▶</button>
    </div>
  </div>

  <div class="panel-right">
    <div class="chart-hdr">
      <div class="chdr-left">
        <div class="ctitle" id="ctitle">— 点击左侧选择一条 utterance —</div>
        <div class="csub" id="csub"></div>
      </div>
      <div class="stat-grid" id="stat-grid"></div>
    </div>

    <div class="meta-bar" id="meta-bar">
      <div class="meta-kv"><span class="meta-k">label</span><span class="meta-v" id="m-label"></span></div>
      <div class="meta-kv"><span class="meta-k">detector</span><span class="meta-v" id="m-detector"></span></div>
      <div class="meta-kv"><span class="meta-k">channel</span><span class="meta-v" id="m-channel"></span></div>
      <div class="meta-kv"><span class="meta-k">project</span><span class="meta-v" id="m-project"></span></div>
      <div class="meta-kv"><span class="meta-k">duration</span><span class="meta-v" id="m-duration"></span></div>
      <div class="meta-kv"><span class="meta-k">time</span><span class="meta-v" id="m-time"></span></div>
      <div class="meta-kv" style="flex-basis:100%;"><span class="meta-k">path</span>
        <span class="meta-v fp" id="m-path" title="点击复制" onclick="copyPath(this)"></span></div>
    </div>

    <div class="chart-tabs" id="chart-tabs" style="display:none;">
      <div class="ctab active" data-tab="traj" onclick="switchTab('traj')">梯度 / 对齐 轨迹</div>
      <div class="ctab wt-tab" data-tab="wt" onclick="switchTab('wt')">权重轨迹</div>
    </div>

    <div class="chart-area">
      <div id="ph" class="placeholder">
        <div class="phi">◈</div>
        <p>选择 utterance 后，此处显示各 epoch 的梯度均值轨迹</p>
      </div>
      <div id="panel-traj" class="chart-panel">
        <div class="chart-wrap"><canvas id="chartTraj"></canvas></div>
        <div class="legend">
          <div class="li"><div class="ld gn"></div>grad_norm 均值（左轴）</div>
          <div class="li"><div class="ld al"></div>align 均值（右轴）</div>
        </div>
      </div>
      <div id="panel-wt" class="chart-panel">
        <div class="chart-wrap"><canvas id="chartWt"></canvas></div>
        <div class="legend">
          <div class="li"><div class="ld wt"></div>weight 均值（左轴）</div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
const DATA_URL  = "{bin_filename}";
const META_URL  = "{meta_filename}";
const EPOCHS    = {epochs};
const TAG_NAMES = ["harmful_suspect","hard","high_influence","easy_redundant","normal"];

let _N,_NE,HAS_TRAJ,HAS_WEIGHT;
let _GN_MIN,_GN_SC,_WT_MIN,_WT_SC;
let N_CHUNKS,MEAN_SI,MAX_SI,MEAN_GN,MAX_GN,GN_STD,MEAN_AL,MEAN_FN;
let MEAN_WT,WT_STD,TAGS,UTT_IDS;
let GN_U8=null,AL_U8=null,WT_U8=null;
let META=null;

const PAGE=100,ROW_H=36;
let filtered=null,pageStart=0,selIdx=-1;
let chartTraj=null,chartWt=null,stimer=null;
let sortKey='si',sortAsc=false,activeTab='traj',wtMax=1.0;

const TH_IDS={{rank:'th-rank',uid:'th-uid',nc:'th-nc',gn:'th-gn',al:'th-al',wt:'th-wt',tag:'th-tag'}};

async function loadBinaryData(){{
  try{{
    const res=await fetch(DATA_URL);
    if(!res.ok) throw new Error("无法读取 .bin，请用 Web Server 打开（python -m http.server）");
    const buf=await res.arrayBuffer();
    const mi=new Int32Array(buf,0,4);
    _N=mi[0];_NE=mi[1];const uttLen=mi[2];const flags=mi[3];
    HAS_TRAJ=(flags&1)===1; HAS_WEIGHT=(flags&2)===2;
    const mf=new Float32Array(buf,16,4);
    _GN_MIN=mf[0];_GN_SC=mf[1];_WT_MIN=mf[2];_WT_SC=mf[3];
    document.getElementById('hmeta').textContent=
      `${{_N.toLocaleString()}} utterances · ${{_NE}} epochs`+(HAS_WEIGHT?' · weight ✓':'');
    let o=80;
    N_CHUNKS=new Int16Array(buf,o,_N);   o+=_N*2;
    MEAN_SI =new Float32Array(buf,o,_N); o+=_N*4;
    MAX_SI  =new Float32Array(buf,o,_N); o+=_N*4;
    MEAN_GN =new Float32Array(buf,o,_N); o+=_N*4;
    MAX_GN  =new Float32Array(buf,o,_N); o+=_N*4;
    GN_STD  =new Float32Array(buf,o,_N); o+=_N*4;
    MEAN_AL =new Float32Array(buf,o,_N); o+=_N*4;
    MEAN_FN =new Float32Array(buf,o,_N); o+=_N*4;
    MEAN_WT =new Float32Array(buf,o,_N); o+=_N*4;
    WT_STD  =new Float32Array(buf,o,_N); o+=_N*4;
    TAGS    =new Uint8Array(buf,o,_N);   o+=_N*1;
    UTT_IDS=new TextDecoder("utf-8").decode(new Uint8Array(buf,o,uttLen)).split('\\n'); o+=uttLen;
    if(HAS_TRAJ&&_NE>0){{
      const ts=_N*_NE;
      GN_U8=new Uint8Array(buf,o,ts); o+=ts;
      AL_U8=new Uint8Array(buf,o,ts); o+=ts;
      if(HAS_WEIGHT){{ WT_U8=new Uint8Array(buf,o,ts); }}
    }}
    if(HAS_WEIGHT){{
      let mx=0;
      for(let i=0;i<_N;i++){{ if(!isNaN(MEAN_WT[i])&&MEAN_WT[i]>mx) mx=MEAN_WT[i]; }}
      wtMax=mx||1.0;
      document.getElementById('wt-f').style.display='';
      document.getElementById('th-wt').style.display='flex';
      document.querySelectorAll('.ctab[data-tab="wt"]').forEach(t=>t.classList.add('show'));
    }}
    buildTagBadges();
    try{{
      const mr=await fetch(META_URL);
      if(mr.ok){{ META=await mr.json(); buildMetaFilters(); }}
    }}catch(e){{}}
    filtered=Int32Array.from({{length:_N}},(_,i)=>i);
    renderPage();
    document.getElementById('hstatus').style.display='none';
  }}catch(e){{
    const s=document.getElementById('hstatus');
    s.textContent='❌ '+e.message; s.style.color='var(--harmful)'; s.style.animation='none';
  }}
}}

function buildTagBadges(){{
  const cnt=[0,0,0,0,0];
  for(let i=0;i<_N;i++) cnt[TAGS[i]]++;
  const el=document.getElementById('hbadges'); el.innerHTML='';
  [0,1,2,3].forEach(t=>{{
    if(!cnt[t]) return;
    const b=document.createElement('span');
    b.className=`badge ${{TAG_NAMES[t]}}`;
    b.textContent=`${{TAG_NAMES[t].replace(/_/g,' ')}} ${{cnt[t].toLocaleString()}}`;
    el.appendChild(b);
  }});
}}

function buildMetaFilters(){{
  if(!META||!META.length) return;
  const labels=new Set(),detectors=new Set(),projects=new Set();
  META.forEach(m=>{{
    if(m.label)       labels.add(m.label);
    if(m.detector_id) detectors.add(m.detector_id);
    if(m.project)     projects.add(m.project);
  }});
  function fill(selId,vals){{
    const sel=document.getElementById(selId); if(!sel) return;
    [...vals].sort().forEach(v=>{{ const o=document.createElement('option'); o.value=v; o.textContent=v; sel.appendChild(o); }});
  }}
  fill('label-f',labels); fill('detector-f',detectors); fill('project-f',projects);
  document.getElementById('meta-filters').style.display='flex';
}}

function getVal(sk,i){{
  if(sk==='si'||sk==='rank') return MEAN_SI[i];
  if(sk==='maxsi') return MAX_SI[i];
  if(sk==='gn')    return MEAN_GN[i];
  if(sk==='al')    return MEAN_AL[i];
  if(sk==='nc')    return N_CHUNKS[i];
  if(sk==='tag')   return TAGS[i];
  if(sk==='wt')    return MEAN_WT[i];
  return 0;
}}

function setSort(key){{
  const realKey=key==='rank'?'si':key;
  if(sortKey===realKey){{ sortAsc=!sortAsc; }}
  else{{ sortKey=realKey; sortAsc=(realKey==='al'); }}
  Object.entries(TH_IDS).forEach(([k,id])=>{{
    const el=document.getElementById(id); if(!el) return;
    el.classList.remove('active'); el.querySelector('.arrow').textContent='';
  }});
  const activeId=TH_IDS[key];
  if(activeId){{
    const el=document.getElementById(activeId);
    if(el){{ el.classList.add('active'); el.querySelector('.arrow').textContent=sortAsc?' ↑':' ↓'; }}
  }}
  rebuild();
}}

document.addEventListener('DOMContentLoaded',()=>{{
  const inp=document.getElementById('search');
  const clr=document.getElementById('search-clear');
  inp.addEventListener('input',()=>{{
    clr.style.display=inp.value?'block':'none';
    clearTimeout(stimer); stimer=setTimeout(rebuild,180);
  }});
}});
function clearSearch(){{
  document.getElementById('search').value='';
  document.getElementById('search-clear').style.display='none';
  rebuild();
}}

function rebuild(){{
  const tagF=parseInt(document.getElementById('tag-f').value);
  const wtF=parseInt(document.getElementById('wt-f')?.value||'0');
  const q=document.getElementById('search').value.trim().toLowerCase();
  const labelF=document.getElementById('label-f')?.value||'';
  const detectorF=document.getElementById('detector-f')?.value||'';
  const projectF=document.getElementById('project-f')?.value||'';
  let arr=[];
  for(let i=0;i<_N;i++){{
    if(tagF>=0&&TAGS[i]!==tagF) continue;
    if(HAS_WEIGHT&&wtF>0){{
      const w=MEAN_WT[i]/wtMax;
      if(wtF===1&&w<0.75) continue;
      if(wtF===2&&(w<0.25||w>=0.75)) continue;
      if(wtF===3&&w>=0.25) continue;
    }}
    if(q&&!((UTT_IDS[i]||'').toLowerCase().includes(q))) continue;
    if(META){{
      const m=META[i]||{{}};
      if(labelF&&m.label!==labelF) continue;
      if(detectorF&&m.detector_id!==detectorF) continue;
      if(projectF&&m.project!==projectF) continue;
    }}
    arr.push(i);
  }}
  if(sortKey==='uid'){{
    arr.sort((a,b)=>{{ const r=(UTT_IDS[a]||'').localeCompare(UTT_IDS[b]||''); return sortAsc?r:-r; }});
  }}else{{
    arr.sort((a,b)=>{{
      const va=getVal(sortKey,a),vb=getVal(sortKey,b);
      if(isNaN(va)&&isNaN(vb)) return 0;
      if(isNaN(va)) return 1; if(isNaN(vb)) return -1;
      return sortAsc?(va-vb):(vb-va);
    }});
  }}
  filtered=arr; pageStart=0; renderPage();
}}

function escH(s){{return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}}
function highlight(text,q){{
  if(!q) return escH(text);
  const idx=text.toLowerCase().indexOf(q);
  if(idx<0) return escH(text);
  return escH(text.slice(0,idx))+'<mark>'+escH(text.slice(idx,idx+q.length))+'</mark>'+escH(text.slice(idx+q.length));
}}

function renderPage(){{
  const total=filtered.length;
  const pages=Math.max(1,Math.ceil(total/PAGE));
  const page=Math.floor(pageStart/PAGE)+1;
  const slice=filtered.slice(pageStart,pageStart+PAGE);
  const q=document.getElementById('search').value.trim().toLowerCase();
  document.getElementById('pginfo').textContent=`${{page}}/${{pages}} (${{total.toLocaleString()}})`;
  document.getElementById('bp').disabled=pageStart<=0;
  document.getElementById('bn').disabled=pageStart+PAGE>=total;
  const inner=document.getElementById('vinner');
  inner.style.height=(slice.length*ROW_H)+'px';
  inner.innerHTML='';
  for(let vi=0;vi<slice.length;vi++){{
    const i=slice[vi];
    const row=document.createElement('div');
    row.className='srow'+(i===selIdx?' sel':'');
    row.style.top=(vi*ROW_H)+'px';
    const uid=UTT_IDS[i]||String(i);
    const gn=MEAN_GN[i],al=MEAN_AL[i],wt=MEAN_WT[i];
    const tag=TAG_NAMES[TAGS[i]];
    const alc=isNaN(al)?'':(al>=0?'pos':'neg');
    const wtc=(!HAS_WEIGHT||isNaN(wt))?'':(wt/wtMax>=0.75?'hi':'');
    const wtStr=(!HAS_WEIGHT||isNaN(wt))?'':wt.toFixed(3);
    const barW=HAS_WEIGHT&&!isNaN(wt)?Math.round(wt/wtMax*100):0;
    row.innerHTML=
      `<div class="s-rank">${{i+1}}</div>`+
      `<div class="s-uid" title="${{escH(uid)}}">${{highlight(uid,q)}}</div>`+
      `<div class="s-nc">${{N_CHUNKS[i]}}</div>`+
      `<div class="s-gn">${{isNaN(gn)?'—':gn.toFixed(3)}}</div>`+
      `<div class="s-al ${{alc}}">${{isNaN(al)?'—':al.toFixed(3)}}</div>`+
      (HAS_WEIGHT?`<div class="s-wt ${{wtc}}">${{wtStr||'—'}}</div>`:'<div></div>')+
      `<div class="col-tag"><span class="badge ${{tag}}">${{tag.replace(/_/g,' ')}}</span></div>`+
      (HAS_WEIGHT&&barW>0?`<div class="wt-bar" style="width:${{barW}}%"></div>`:'');
    row.addEventListener('click',()=>selectSample(i,row));
    inner.appendChild(row);
  }}
  document.getElementById('vlist').scrollTop=0;
}}

function prevPage(){{ if(pageStart>0){{ pageStart=Math.max(0,pageStart-PAGE); renderPage(); }} }}
function nextPage(){{ if(pageStart+PAGE<filtered.length){{ pageStart+=PAGE; renderPage(); }} }}

function switchTab(tab){{
  activeTab=tab;
  document.querySelectorAll('.ctab').forEach(t=>t.classList.toggle('active',t.dataset.tab===tab));
  document.querySelectorAll('.chart-panel').forEach(p=>p.classList.toggle('active',p.id===`panel-${{tab}}`));
  if(tab==='traj'&&chartTraj) chartTraj.resize();
  if(tab==='wt'&&chartWt) chartWt.resize();
}}

function selectSample(idx,el){{
  selIdx=idx;
  document.querySelectorAll('.srow').forEach(r=>r.classList.remove('sel'));
  el.classList.add('sel');
  const uid=UTT_IDS[idx]||String(idx);
  const tag=TAG_NAMES[TAGS[idx]];
  const wt=MEAN_WT[idx];
  document.getElementById('ctitle').textContent=uid;
  document.getElementById('csub').textContent=
    `tag: ${{tag}}  ·  chunks: ${{N_CHUNKS[idx]}}  ·  mean_si: ${{MEAN_SI[idx].toFixed(2)}}  ·  max_si: ${{MAX_SI[idx].toFixed(2)}}`+
    (HAS_WEIGHT&&!isNaN(wt)?`  ·  mean_wt: ${{wt.toFixed(4)}}  ±${{WT_STD[idx].toFixed(4)}}`:'');
  const stats=[
    {{l:'MEAN SI',v:MEAN_SI[idx].toFixed(2)}},
    {{l:'MAX SI',v:MAX_SI[idx].toFixed(2)}},
    {{l:'MEAN GN',v:MEAN_GN[idx].toFixed(4)}},
    {{l:'GN STD',v:GN_STD[idx].toFixed(4)}},
    {{l:'MEAN ALIGN',v:MEAN_AL[idx].toFixed(4)}},
    {{l:'NEG ALIGN',v:(MEAN_FN[idx]*100).toFixed(0)+'%'}},
  ];
  if(HAS_WEIGHT&&!isNaN(wt)){{
    stats.push({{l:'MEAN WT',v:wt.toFixed(4),cls:'wt-val'}});
    stats.push({{l:'WT STD',v:WT_STD[idx].toFixed(4),cls:'wt-val'}});
  }}
  document.getElementById('stat-grid').innerHTML=stats.map(s=>
    `<div class="stat-item"><div class="slbl">${{s.l}}</div><div class="sval ${{s.cls||''}}">${{s.v}}</div></div>`
  ).join('');
  const mb=document.getElementById('meta-bar');
  if(META&&META[idx]){{
    const m=META[idx];
    const lbl=m.label||'';
    const lc=lbl.toLowerCase();
    const bc=lc==='normal'?'normal':(lc==='anomaly'||lc==='abnormal'?'anomaly':'unknown');
    document.getElementById('m-label').innerHTML=`<span class="meta-badge ${{bc}}">${{lbl||'—'}}</span>`;
    document.getElementById('m-detector').textContent=m.detector_id||'—';
    document.getElementById('m-channel').textContent=m.channel_id||'—';
    document.getElementById('m-project').textContent=m.project||'—';
    document.getElementById('m-duration').textContent=m.duration?(m.duration+'s'):'—';
    document.getElementById('m-time').textContent=m.time_point||'—';
    const fp=document.getElementById('m-path');
    fp.textContent=m.file_path||'—'; fp.title='点击复制: '+(m.file_path||'');
    mb.classList.add('show');
  }}else{{ mb.classList.remove('show'); }}
  document.getElementById('chart-tabs').style.display=HAS_TRAJ?'flex':'none';
  document.getElementById('ph').style.display='none';
  document.getElementById('panel-traj').classList.add('active');
  drawTrajChart(idx);
  if(HAS_WEIGHT) drawWeightChart(idx);
}}

