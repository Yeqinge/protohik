#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
export_html_utt.py —— 原始 Utterance 级样本贡献度分析可视化工具
在 export_html_diag.py 基础上增加：
  - 将 egs chunk 样本按原始 utt_id 聚合（去掉末尾 -数字 后缀）
  - 聚合指标：mean/max/min grad_norm, mean align, chunk数量, 重复度（duplicate ratio）
  - 同时保留 egs 粒度视图，可切换
"""

import argparse
import csv
import glob
import os
import re
import sys
import numpy as np
from collections import defaultdict

TAG_MAP = {"harmful_suspect": 0, "hard": 1, "high_influence": 2, "easy_redundant": 3, "normal": 4}

def fv(row, key):
    try:    return float(row.get(key, "nan"))
    except: return float("nan")

def strip_chunk_suffix(utt_id):
    """
    'normal-D0040_U0311_C01_..._053-3'  →  'normal-D0040_U0311_C01_..._053'
    去掉末尾的 -<数字> chunk 索引后缀，还原原始 utt_id
    """
    return re.sub(r'-\d+$', '', utt_id)

def main():
    print("\n" + "="*60)
    print("🚀 [START] Utterance 级聚合分析脚本启动...")
    print("="*60)

    ap = argparse.ArgumentParser(description="Utterance 级样本贡献度可视化 HTML 生成器")
    ap.add_argument("--contrib", required=True, help="包含 contrib_epoch*.npz 和 summary CSV 的目录路径")
    ap.add_argument("--egs",     default="", help="可选：train.egs.csv 路径（用于获取原始 utt_id 映射）")
    ap.add_argument("--summary", default="", help="可选：明确指定 summary CSV 的路径")
    ap.add_argument("--output",  default="contrib_utt.html", help="输出 HTML 文件名")
    args = ap.parse_args()

    print(f"📍 CWD: {os.getcwd()}")
    print(f"📁 --contrib: {os.path.abspath(args.contrib)}")

    # ── 1. 加载 Summary CSV（egs 粒度）──
    print("\n[步骤 1/5] 加载 egs 粒度 Summary CSV ...")
    sp = args.summary
    if not sp:
        for nm in ("contrib_summary_with_uttid.csv", "contrib_summary.csv"):
            p = os.path.join(args.contrib, nm)
            if os.path.exists(p):
                sp = p
                break
    if not sp or not os.path.exists(sp):
        print(f"❌ 找不到 summary CSV，请检查 --contrib 目录或用 --summary 明确指定。")
        sys.exit(1)

    egs_rows = []
    with open(sp, newline="", encoding="utf-8") as f:
        for r in csv.DictReader(f):
            egs_rows.append(r)
    print(f"   egs 样本总数: {len(egs_rows)}")

    # ── 2. 建立 sample_id → utt_id 映射 ──
    print("\n[步骤 2/5] 建立 sample_id → utt_id 映射 ...")
    idx2utt = {}

    # 优先从 CSV 内部的 utt_id 字段读取
    if egs_rows and "utt_id" in egs_rows[0]:
        print("   -> 从 CSV 内部 utt_id 字段读取")
        idx2utt = {i: r["utt_id"] for i, r in enumerate(egs_rows) if r.get("utt_id")}
    # 其次从外挂 egs 文件读取
    elif args.egs and os.path.exists(args.egs):
        print(f"   -> 从外挂文件读取: {args.egs}")
        with open(args.egs, encoding="utf-8") as f:
            first = f.readline()
            delim = "\t" if "\t" in first else " "
        with open(args.egs, encoding="utf-8") as f:
            for i, line in enumerate(f):
                if i >= len(egs_rows): break
                p = line.strip().split(delim)
                if p: idx2utt[i] = p[0]

    print(f"   有效 utt_id 映射数: {len(idx2utt)}")

    # ── 3. 加载 epoch 轨迹 (.npz) ──
    print("\n[步骤 3/5] 加载 epoch 轨迹数据 ...")
    search_path = os.path.join(args.contrib, "contrib_epoch*.npz")
    files = sorted(glob.glob(search_path))
    print(f"   找到 {len(files)} 个 .npz 文件")

    n_egs = len(egs_rows)
    id2idx_egs = {r["id"]: i for i, r in enumerate(egs_rows)}

    epochs = []
    gn_egs = None
    al_egs = None
    has_traj = len(files) > 0

    if has_traj:
        ne = len(files)
        gn_egs = np.full((n_egs, ne), np.nan, dtype=np.float32)
        al_egs = np.full((n_egs, ne), np.nan, dtype=np.float32)
        for ei, f in enumerate(files):
            ep = int(os.path.basename(f)[len("contrib_epoch"):-len(".npz")])
            epochs.append(ep)
            d = np.load(f, allow_pickle=True)
            ids_str = d["ids"].astype(str)
            try:
                idxs = ids_str.astype(np.int64)
                if idxs.max() >= n_egs or idxs.min() < 0: raise ValueError
            except (ValueError, OverflowError):
                idxs = np.array([id2idx_egs.get(s, -1) for s in ids_str], dtype=np.int64)
            m = idxs >= 0
            gn_egs[idxs[m], ei] = d["grad_norm"][m]
            al_egs[idxs[m], ei] = d["align"][m]
        epochs = sorted(epochs)
        print(f"   epochs: {epochs}")

    # ── 4. 聚合到 utterance 粒度 ──
    print("\n[步骤 4/5] 按原始 utt_id 聚合 egs chunk 指标 ...")

    # utt_id → [egs_indices]
    utt2chunks = defaultdict(list)
    for i, row in enumerate(egs_rows):
        raw_utt = idx2utt.get(i, "")
        if not raw_utt:
            # 没有 utt_id 映射时，用 sample_id 本身（无法去后缀）
            raw_utt = row.get("id", str(i))
        orig_utt = strip_chunk_suffix(raw_utt)
        utt2chunks[orig_utt].append(i)

    utt_ids_list = sorted(utt2chunks.keys())
    n_utt = len(utt_ids_list)
    print(f"   egs chunk 数: {n_egs}")
    print(f"   原始 utterance 数: {n_utt}")
    print(f"   平均每条语音 chunk 数: {n_egs / max(n_utt, 1):.2f}")

    # 统计重复度（所有chunk起始帧完全相同的比例）
    # 这里用 mean_grad_norm 方差作为"多样性"代理指标
    utt_data = []
    for utt_id in utt_ids_list:
        chunk_idxs = utt2chunks[utt_id]
        n_chunks = len(chunk_idxs)

        si_vals  = [fv(egs_rows[i], "self_influence")  for i in chunk_idxs]
        gn_vals  = [fv(egs_rows[i], "mean_grad_norm")  for i in chunk_idxs]
        al_vals  = [fv(egs_rows[i], "mean_align")      for i in chunk_idxs]
        fn_vals  = [fv(egs_rows[i], "frac_neg_align")  for i in chunk_idxs]
        fo_vals  = [fv(egs_rows[i], "forget_events")   for i in chunk_idxs]
        fc_vals  = [fv(egs_rows[i], "final_correct")   for i in chunk_idxs]

        def safe_mean(lst):
            v = [x for x in lst if not np.isnan(x)]
            return float(np.mean(v)) if v else float("nan")
        def safe_max(lst):
            v = [x for x in lst if not np.isnan(x)]
            return float(np.max(v)) if v else float("nan")
        def safe_std(lst):
            v = [x for x in lst if not np.isnan(x)]
            return float(np.std(v)) if len(v) > 1 else 0.0

        # 重复度：grad_norm 跨 chunk 的标准差越小，说明 chunk 越雷同
        gn_std = safe_std(gn_vals)
        # 归一化重复度：std/(mean+eps)，越接近0说明越重复
        gn_mean_val = safe_mean(gn_vals)
        dup_ratio = 1.0 - min(gn_std / (abs(gn_mean_val) + 1e-9), 1.0)

        # 最差 tag（取最严重的那个）
        tags = [TAG_MAP.get(egs_rows[i].get("tag", "normal"), 4) for i in chunk_idxs]
        worst_tag = min(tags)  # 0=harmful最严重

        # 轨迹聚合：对该 utt 下所有 chunk 的轨迹取平均
        utt_gn_traj = None
        utt_al_traj = None
        if has_traj:
            chunk_gn = gn_egs[chunk_idxs, :]  # (n_chunks, ne)
            chunk_al = al_egs[chunk_idxs, :]
            utt_gn_traj = np.nanmean(chunk_gn, axis=0)
            utt_al_traj = np.nanmean(chunk_al, axis=0)

        utt_data.append({
            "utt_id":      utt_id,
            "n_chunks":    n_chunks,
            "dup_ratio":   dup_ratio,         # 重复度 0~1，越高越重复
            "mean_si":     safe_mean(si_vals),
            "max_si":      safe_max(si_vals),
            "mean_gn":     gn_mean_val,
            "max_gn":      safe_max(gn_vals),
            "gn_std":      gn_std,
            "mean_al":     safe_mean(al_vals),
            "mean_fn":     safe_mean(fn_vals),
            "mean_fo":     safe_mean(fo_vals),
            "mean_fc":     safe_mean(fc_vals),
            "worst_tag":   worst_tag,
            "chunk_idxs":  chunk_idxs,
            "gn_traj":     utt_gn_traj,
            "al_traj":     utt_al_traj,
        })

    # 按 mean_si 降序排列
    utt_data.sort(key=lambda x: x["mean_si"] if not np.isnan(x["mean_si"]) else -1e9, reverse=True)

    # ── 5. 打包二进制 + 生成 HTML ──
    print("\n[步骤 5/5] 打包二进制数据并生成 HTML ...")

    n_u = len(utt_data)
    ne  = len(epochs)

    # 标量指标矩阵
    utt_ids_arr   = [d["utt_id"]    for d in utt_data]
    n_chunks_arr  = np.array([d["n_chunks"]   for d in utt_data], dtype=np.int16)
    dup_arr       = np.array([d["dup_ratio"]  for d in utt_data], dtype=np.float32)
    mean_si_arr   = np.array([d["mean_si"]    for d in utt_data], dtype=np.float32)
    max_si_arr    = np.array([d["max_si"]     for d in utt_data], dtype=np.float32)
    mean_gn_arr   = np.array([d["mean_gn"]    for d in utt_data], dtype=np.float32)
    max_gn_arr    = np.array([d["max_gn"]     for d in utt_data], dtype=np.float32)
    gn_std_arr    = np.array([d["gn_std"]     for d in utt_data], dtype=np.float32)
    mean_al_arr   = np.array([d["mean_al"]    for d in utt_data], dtype=np.float32)
    mean_fn_arr   = np.array([d["mean_fn"]    for d in utt_data], dtype=np.float32)
    mean_fo_arr   = np.array([d["mean_fo"]    for d in utt_data], dtype=np.float32)
    tags_arr      = np.array([d["worst_tag"]  for d in utt_data], dtype=np.uint8)

    # 轨迹矩阵量化
    gn_mat_u8 = None
    al_mat_u8 = None
    gn_min = 0.0
    gn_scale = 1.0
    if has_traj and ne > 0:
        gn_stack = np.stack([d["gn_traj"] for d in utt_data], axis=0)  # (n_u, ne)
        al_stack = np.stack([d["al_traj"] for d in utt_data], axis=0)
        valid_gn = gn_stack[~np.isnan(gn_stack)]
        if len(valid_gn):
            gn_min   = float(np.nanmin(gn_stack))
            gn_max   = float(np.nanpercentile(valid_gn, 99))
            gn_scale = max(gn_max - gn_min, 1e-9)
        gn_q = np.clip((gn_stack - gn_min) / gn_scale * 255, 0, 255)
        gn_q[np.isnan(gn_stack)] = 255
        al_q = np.clip((al_stack + 1.0) / 2.0 * 253, 0, 253)
        al_q[np.isnan(al_stack)] = 254
        gn_mat_u8 = gn_q.astype(np.uint8)
        al_mat_u8 = al_q.astype(np.uint8)

    # 编码 utt_id 字符串
    utt_bytes = "\n".join(utt_ids_arr).encode("utf-8")
    utt_len   = len(utt_bytes)

    bin_path     = os.path.splitext(args.output)[0] + "_utt.bin"
    abs_bin_path = os.path.abspath(bin_path)
    abs_html_path= os.path.abspath(args.output)

    print(f"  ➡️ 写入二进制: {abs_bin_path}")
    with open(bin_path, "wb") as fb:
        # Header: n_u, ne, utt_len, has_traj
        fb.write(np.array([n_u, ne, utt_len, 1 if has_traj else 0], dtype=np.int32).tobytes())
        fb.write(np.array([gn_min, gn_scale], dtype=np.float32).tobytes())
        fb.write(b"\x00" * 40)  # padding to 64 bytes
        # Scalar arrays
        fb.write(n_chunks_arr.tobytes())
        fb.write(dup_arr.tobytes())
        fb.write(mean_si_arr.tobytes())
        fb.write(max_si_arr.tobytes())
        fb.write(mean_gn_arr.tobytes())
        fb.write(max_gn_arr.tobytes())
        fb.write(gn_std_arr.tobytes())
        fb.write(mean_al_arr.tobytes())
        fb.write(mean_fn_arr.tobytes())
        fb.write(mean_fo_arr.tobytes())
        fb.write(tags_arr.tobytes())
        # utt_id strings
        fb.write(utt_bytes)
        # Trajectory matrices
        if has_traj and gn_mat_u8 is not None:
            fb.write(gn_mat_u8.flatten().tobytes())
            fb.write(al_mat_u8.flatten().tobytes())

    sz = os.path.getsize(bin_path)
    print(f"     ✅ .bin 大小: {sz/1e6:.2f} MB")

    print(f"  ➡️ 写入 HTML: {abs_html_path}")
    bin_filename = os.path.basename(bin_path)
    with open(args.output, "w", encoding="utf-8") as f:
        f.write(make_html(bin_filename, epochs, n_u))
    print(f"     ✅ .html 大小: {os.path.getsize(args.output)/1024:.2f} KB")

    print("\n" + "="*60)
    print(f"✨ [SUCCESS] 完成！共聚合 {n_u} 条原始 utterance。")
    print(f"   重复样本统计：")
    # 统计高重复度的 utterance
    high_dup = sum(1 for d in utt_data if d["dup_ratio"] > 0.9)
    single_chunk = sum(1 for d in utt_data if d["n_chunks"] == 1)
    print(f"     单 chunk utterance (短语音): {single_chunk} ({100*single_chunk/max(n_u,1):.1f}%)")
    print(f"     高重复度(>0.9) utterance:    {high_dup} ({100*high_dup/max(n_u,1):.1f}%)")
    print("="*60 + "\n")


