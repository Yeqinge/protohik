#!/bin/bash

# ============================================================
# run.sh —— 批量运行不同 temperature 的训练
# 用法: bash run.sh
# ============================================================

# ---------- 配置区：按需修改 ----------
TRAIN_SH="./train.sh"
BASE_CONF="26051101"
BASE_TEMP="0.1"
TEMPERATURES=(0.05 0.07 0.1 0.15 0.2)
# --------------------------------------

# 检查 train.sh 是否存在
if [ ! -f "$TRAIN_SH" ]; then
    echo "[ERROR] 找不到 $TRAIN_SH，请确认路径"
    exit 1
fi

mkdir -p logs

for TEMP in "${TEMPERATURES[@]}"; do

    NEW_CONF="${BASE_CONF}_temp${TEMP}"

    echo "=================================================="
    echo "[RUN] temperature=${TEMP}  conf=${NEW_CONF}"
    echo "=================================================="

    # 生成临时 train.sh，同时替换两处：
    # 1. train_conf=26051101 → train_conf=26051101_temp0.05
    # 2. "temperature":0.1   → "temperature":0.05
    TEMP_TRAIN_SH="train_temp_${NEW_CONF}.sh"
    sed \
        "s/train_conf=${BASE_CONF}/train_conf=${NEW_CONF}/" \
        "$TRAIN_SH" | \
    sed \
        "s/\"temperature\":${BASE_TEMP}/\"temperature\":${TEMP}/" \
        > "$TEMP_TRAIN_SH"
    chmod +x "$TEMP_TRAIN_SH"

    # 运行，日志保存到 logs/
    LOG="logs/train_temp${TEMP}.log"
    echo "[INFO] 开始训练，日志: ${LOG}"
    bash "$TEMP_TRAIN_SH" 2>&1 | tee "$LOG"

    EXIT_CODE=${PIPESTATUS[0]}
    if [ $EXIT_CODE -ne 0 ]; then
        echo "[ERROR] temperature=${TEMP} 训练失败 (exit code=${EXIT_CODE})，继续下一个"
    else
        echo "[INFO] temperature=${TEMP} 训练完成"
    fi

    # 清理临时 train.sh
    rm -f "$TEMP_TRAIN_SH"

    echo ""
done

echo "=================================================="
echo "[DONE] 所有 temperature 实验完成"
echo "日志目录: logs/"
echo "=================================================="
