import { useState, useMemo, useCallback } from "react";
import { LineChart, Line, XAxis, YAxis, CartesianGrid, Tooltip, Legend, ResponsiveContainer, BarChart, Bar, Cell, ScatterChart, Scatter } from "recharts";

const TAG_COLORS = {
  harmful_suspect: "#ef4444",
  hard: "#f59e0b",
  high_influence: "#8b5cf6",
  normal: "#6b7280",
  easy_redundant: "#22c55e",
};

const TAG_LABELS = {
  harmful_suspect: "有害嫌疑",
  hard: "关键难样本",
  high_influence: "高影响力",
  normal: "正常",
  easy_redundant: "冗余易样本",
};

const SORT_KEYS = [
  { key: "si", label: "Self Influence ↓" },
  { key: "mgn", label: "Grad Norm ↓" },
  { key: "ma", label: "Align ↑" },
  { key: "ma_asc", label: "Align ↓ (最负)" },
  { key: "fna", label: "负对齐占比 ↓" },
  { key: "fe", label: "遗忘次数 ↓" },
];

function TagBadge({ tag }) {
  return (
    <span
      style={{
        background: TAG_COLORS[tag] || "#6b7280",
        color: "#fff",
        padding: "2px 8px",
        borderRadius: "4px",
        fontSize: "11px",
        fontWeight: 600,
        letterSpacing: "0.5px",
        whiteSpace: "nowrap",
      }}
    >
      {TAG_LABELS[tag] || tag}
    </span>
  );
}

function FileUpload({ onLoad }) {
  const handleFile = useCallback((e) => {
    const file = e.target.files?.[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = (ev) => {
      try {
        const data = JSON.parse(ev.target.result);
        onLoad(data);
      } catch (err) {
        alert("JSON 解析失败: " + err.message);
      }
    };
    reader.readAsText(file);
  }, [onLoad]);

  return (
    <div style={{
      display: "flex", flexDirection: "column", alignItems: "center", justifyContent: "center",
      height: "100vh", background: "#0a0a0f", color: "#e2e2e8", fontFamily: "'JetBrains Mono', 'Fira Code', monospace",
    }}>
      <div style={{
        border: "2px dashed #333", borderRadius: "12px", padding: "60px 80px",
        textAlign: "center", background: "#12121a",
      }}>
        <div style={{ fontSize: "42px", marginBottom: "16px", opacity: 0.6 }}>📊</div>
        <div style={{ fontSize: "18px", fontWeight: 700, marginBottom: "8px", color: "#c0c0d0" }}>
          加载可视化数据
        </div>
        <div style={{ fontSize: "12px", color: "#666", marginBottom: "24px" }}>
          上传 export_viz.py 生成的 viz_data.json
        </div>
        <label style={{
          display: "inline-block", padding: "10px 28px", background: "#8b5cf6",
          borderRadius: "6px", cursor: "pointer", fontSize: "13px", fontWeight: 600,
          transition: "background 0.2s",
        }}>
          选择文件
          <input type="file" accept=".json" onChange={handleFile} style={{ display: "none" }} />
        </label>
      </div>
    </div>
  );
}

function Overview({ data }) {
  const tagData = useMemo(() =>
    Object.entries(data.tag_counts).map(([tag, count]) => ({
      tag, count, label: TAG_LABELS[tag] || tag, fill: TAG_COLORS[tag] || "#6b7280",
    })).sort((a, b) => b.count - a.count),
    [data]
  );

  const scatterData = useMemo(() =>
    data.samples.slice(0, 3000).map((s) => ({
      x: s.mgn, y: s.ma, tag: s.tag, id: s.id,
    })),
    [data]
  );

  return (
    <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: "16px", marginBottom: "24px" }}>
      <div style={{ background: "#16161e", borderRadius: "8px", padding: "20px" }}>
        <div style={{ fontSize: "13px", fontWeight: 700, marginBottom: "12px", color: "#a0a0b0" }}>
          标签分布（全量 {data.total.toLocaleString()} 样本）
        </div>
        <ResponsiveContainer width="100%" height={200}>
          <BarChart data={tagData} layout="vertical" margin={{ left: 80 }}>
            <XAxis type="number" tick={{ fill: "#666", fontSize: 11 }} />
            <YAxis dataKey="label" type="category" tick={{ fill: "#999", fontSize: 11 }} width={80} />
            <Tooltip
              contentStyle={{ background: "#1e1e2a", border: "1px solid #333", fontSize: 12, borderRadius: 6 }}
              labelStyle={{ color: "#ccc" }}
              formatter={(v) => [v.toLocaleString(), "数量"]}
            />
            <Bar dataKey="count" radius={[0, 4, 4, 0]}>
              {tagData.map((d, i) => <Cell key={i} fill={d.fill} />)}
            </Bar>
          </BarChart>
        </ResponsiveContainer>
      </div>
      <div style={{ background: "#16161e", borderRadius: "8px", padding: "20px" }}>
        <div style={{ fontSize: "13px", fontWeight: 700, marginBottom: "12px", color: "#a0a0b0" }}>
          Grad Norm vs Align（前 3000 样本）
        </div>
        <ResponsiveContainer width="100%" height={200}>
          <ScatterChart margin={{ bottom: 5 }}>
            <CartesianGrid strokeDasharray="3 3" stroke="#222" />
            <XAxis dataKey="x" name="grad_norm" tick={{ fill: "#666", fontSize: 10 }} label={{ value: "grad_norm", position: "bottom", fill: "#666", fontSize: 10 }} />
            <YAxis dataKey="y" name="align" tick={{ fill: "#666", fontSize: 10 }} label={{ value: "align", angle: -90, position: "insideLeft", fill: "#666", fontSize: 10 }} />
            <Tooltip
              contentStyle={{ background: "#1e1e2a", border: "1px solid #333", fontSize: 11, borderRadius: 6 }}
              formatter={(v, name) => [v.toFixed(4), name]}
            />
            {Object.keys(TAG_COLORS).map((tag) => (
              <Scatter
                key={tag}
                data={scatterData.filter((d) => d.tag === tag)}
                fill={TAG_COLORS[tag]}
                opacity={0.5}
                r={2}
              />
            ))}
          </ScatterChart>
        </ResponsiveContainer>
        <div style={{ display: "flex", gap: "12px", justifyContent: "center", marginTop: "8px", flexWrap: "wrap" }}>
          {Object.entries(TAG_COLORS).map(([tag, color]) => (
            <div key={tag} style={{ display: "flex", alignItems: "center", gap: "4px", fontSize: "10px", color: "#888" }}>
              <div style={{ width: 8, height: 8, borderRadius: "50%", background: color }} />
              {TAG_LABELS[tag]}
            </div>
          ))}
        </div>
      </div>
    </div>
  );
}

function TrajectoryChart({ sample, epochs }) {
  const chartData = useMemo(() =>
    epochs.map((ep, i) => ({
      epoch: ep,
      grad_norm: sample.tgn?.[i] ?? null,
      align: sample.tal?.[i] ?? null,
    })),
    [sample, epochs]
  );

  const uttLabel = sample.utt || sample.id;

  return (
    <div style={{ background: "#16161e", borderRadius: "8px", padding: "20px", marginBottom: "16px" }}>
      <div style={{ display: "flex", alignItems: "center", gap: "12px", marginBottom: "16px" }}>
        <TagBadge tag={sample.tag} />
        <span style={{ fontSize: "14px", fontWeight: 700, color: "#e0e0e8" }}>{uttLabel}</span>
        <span style={{ fontSize: "11px", color: "#666" }}>
          SI={sample.si} · GN={sample.mgn} · Align={sample.ma} · Forget={sample.fe}
        </span>
      </div>
      <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: "16px" }}>
        <div>
          <div style={{ fontSize: "11px", color: "#888", marginBottom: "8px", fontWeight: 600 }}>
            Gradient Norm（越高=越难/贡献越大）
          </div>
          <ResponsiveContainer width="100%" height={180}>
            <LineChart data={chartData}>
              <CartesianGrid strokeDasharray="3 3" stroke="#222" />
              <XAxis dataKey="epoch" tick={{ fill: "#666", fontSize: 10 }} label={{ value: "epoch", position: "bottom", fill: "#555", fontSize: 10 }} />
              <YAxis tick={{ fill: "#666", fontSize: 10 }} />
              <Tooltip contentStyle={{ background: "#1e1e2a", border: "1px solid #333", fontSize: 11, borderRadius: 6 }} />
              <Line type="monotone" dataKey="grad_norm" stroke="#f59e0b" strokeWidth={2} dot={{ fill: "#f59e0b", r: 3 }} connectNulls />
            </LineChart>
          </ResponsiveContainer>
        </div>
        <div>
          <div style={{ fontSize: "11px", color: "#888", marginBottom: "8px", fontWeight: 600 }}>
            Alignment（负=逆共识=有害嫌疑）
          </div>
          <ResponsiveContainer width="100%" height={180}>
            <LineChart data={chartData}>
              <CartesianGrid strokeDasharray="3 3" stroke="#222" />
              <XAxis dataKey="epoch" tick={{ fill: "#666", fontSize: 10 }} label={{ value: "epoch", position: "bottom", fill: "#555", fontSize: 10 }} />
              <YAxis tick={{ fill: "#666", fontSize: 10 }} />
              <Tooltip contentStyle={{ background: "#1e1e2a", border: "1px solid #333", fontSize: 11, borderRadius: 6 }} />
              <Line type="monotone" dataKey="align" stroke="#3b82f6" strokeWidth={2} dot={{ fill: "#3b82f6", r: 3 }} connectNulls />
              <Line type="monotone" dataKey={() => 0} stroke="#ef4444" strokeWidth={1} strokeDasharray="4 4" dot={false} />
            </LineChart>
          </ResponsiveContainer>
        </div>
      </div>
    </div>
  );
}

function SampleTable({ data, onSelect, selected }) {
  const [tagFilter, setTagFilter] = useState("all");
  const [search, setSearch] = useState("");
  const [sortKey, setSortKey] = useState("si");
  const [page, setPage] = useState(0);
  const pageSize = 50;

  const filtered = useMemo(() => {
    let rows = data.samples;
    if (tagFilter !== "all") rows = rows.filter((s) => s.tag === tagFilter);
    if (search.trim()) {
      const q = search.trim().toLowerCase();
      rows = rows.filter((s) => (s.utt || s.id).toLowerCase().includes(q) || s.id.includes(q));
    }
    const sorted = [...rows];
    if (sortKey === "ma_asc") sorted.sort((a, b) => a.ma - b.ma);
    else if (sortKey === "ma") sorted.sort((a, b) => b.ma - a.ma);
    else sorted.sort((a, b) => b[sortKey] - a[sortKey]);
    return sorted;
  }, [data, tagFilter, search, sortKey]);

  const totalPages = Math.ceil(filtered.length / pageSize);
  const pageRows = filtered.slice(page * pageSize, (page + 1) * pageSize);

  const thStyle = {
    padding: "8px 10px", textAlign: "left", fontSize: "10px", fontWeight: 700,
    color: "#666", textTransform: "uppercase", letterSpacing: "1px",
    borderBottom: "1px solid #222", position: "sticky", top: 0, background: "#12121a",
  };
  const tdStyle = { padding: "6px 10px", fontSize: "12px", color: "#c8c8d4", borderBottom: "1px solid #1a1a24" };

  return (
    <div style={{ background: "#16161e", borderRadius: "8px", padding: "16px" }}>
      <div style={{ display: "flex", gap: "10px", marginBottom: "12px", flexWrap: "wrap", alignItems: "center" }}>
        <select
          value={tagFilter}
          onChange={(e) => { setTagFilter(e.target.value); setPage(0); }}
          style={{
            background: "#1e1e2a", color: "#ccc", border: "1px solid #333", borderRadius: "4px",
            padding: "6px 10px", fontSize: "12px", outline: "none",
          }}
        >
          <option value="all">全部标签</option>
          {Object.keys(TAG_COLORS).map((t) => (
            <option key={t} value={t}>{TAG_LABELS[t]} ({data.tag_counts[t] || 0})</option>
          ))}
        </select>
        <select
          value={sortKey}
          onChange={(e) => { setSortKey(e.target.value); setPage(0); }}
          style={{
            background: "#1e1e2a", color: "#ccc", border: "1px solid #333", borderRadius: "4px",
            padding: "6px 10px", fontSize: "12px", outline: "none",
          }}
        >
          {SORT_KEYS.map((s) => <option key={s.key} value={s.key}>{s.label}</option>)}
        </select>
        <input
          placeholder="搜索 utt-id / sample id ..."
          value={search}
          onChange={(e) => { setSearch(e.target.value); setPage(0); }}
          style={{
            background: "#1e1e2a", color: "#ccc", border: "1px solid #333", borderRadius: "4px",
            padding: "6px 12px", fontSize: "12px", flex: 1, minWidth: "180px", outline: "none",
          }}
        />
        <span style={{ fontSize: "11px", color: "#555" }}>
          {filtered.length.toLocaleString()} 条 · 第 {page + 1}/{totalPages || 1} 页
        </span>
      </div>

      <div style={{ overflowX: "auto", maxHeight: "420px", overflowY: "auto" }}>
        <table style={{ width: "100%", borderCollapse: "collapse" }}>
          <thead>
            <tr>
              {data.has_utt && <th style={thStyle}>UTT-ID</th>}
              <th style={thStyle}>ID</th>
              <th style={thStyle}>标签</th>
              <th style={thStyle}>Self Inf</th>
              <th style={thStyle}>Grad Norm</th>
              <th style={thStyle}>Align</th>
              <th style={thStyle}>负对齐%</th>
              <th style={thStyle}>遗忘</th>
              <th style={thStyle}>末轮正确</th>
            </tr>
          </thead>
          <tbody>
            {pageRows.map((s) => {
              const isSelected = selected?.id === s.id;
              return (
                <tr
                  key={s.id}
                  onClick={() => onSelect(s)}
                  style={{
                    cursor: "pointer",
                    background: isSelected ? "#1e1e3a" : "transparent",
                    transition: "background 0.15s",
                  }}
                  onMouseEnter={(e) => { if (!isSelected) e.currentTarget.style.background = "#1a1a28"; }}
                  onMouseLeave={(e) => { if (!isSelected) e.currentTarget.style.background = "transparent"; }}
                >
                  {data.has_utt && <td style={{ ...tdStyle, maxWidth: "220px", overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap" }}>{s.utt}</td>}
                  <td style={{ ...tdStyle, color: "#888" }}>{s.id}</td>
                  <td style={tdStyle}><TagBadge tag={s.tag} /></td>
                  <td style={{ ...tdStyle, fontVariantNumeric: "tabular-nums" }}>{s.si.toFixed(1)}</td>
                  <td style={{ ...tdStyle, fontVariantNumeric: "tabular-nums" }}>{s.mgn.toFixed(4)}</td>
                  <td style={{
                    ...tdStyle, fontVariantNumeric: "tabular-nums",
                    color: s.ma < 0 ? "#ef4444" : "#22c55e",
                  }}>{s.ma.toFixed(4)}</td>
                  <td style={{ ...tdStyle, fontVariantNumeric: "tabular-nums" }}>{(s.fna * 100).toFixed(0)}%</td>
                  <td style={{ ...tdStyle, color: s.fe >= 2 ? "#f59e0b" : "#666" }}>{s.fe}</td>
                  <td style={{ ...tdStyle, color: s.fc === 1 ? "#22c55e" : s.fc === 0 ? "#ef4444" : "#444" }}>
                    {s.fc === 1 ? "✓" : s.fc === 0 ? "✗" : "—"}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>

      <div style={{ display: "flex", justifyContent: "center", gap: "6px", marginTop: "12px" }}>
        <button
          onClick={() => setPage(Math.max(0, page - 1))} disabled={page === 0}
          style={{ ...btnStyle, opacity: page === 0 ? 0.3 : 1 }}
        >← 上一页</button>
        <button
          onClick={() => setPage(Math.min(totalPages - 1, page + 1))} disabled={page >= totalPages - 1}
          style={{ ...btnStyle, opacity: page >= totalPages - 1 ? 0.3 : 1 }}
        >下一页 →</button>
      </div>
    </div>
  );
}

const btnStyle = {
  background: "#1e1e2a", color: "#aaa", border: "1px solid #333", borderRadius: "4px",
  padding: "5px 14px", fontSize: "11px", cursor: "pointer",
};

export default function App() {
  const [data, setData] = useState(null);
  const [selected, setSelected] = useState(null);

  if (!data) return <FileUpload onLoad={setData} />;

  return (
    <div style={{
      background: "#0a0a0f", color: "#e2e2e8", minHeight: "100vh", padding: "20px 24px",
      fontFamily: "'JetBrains Mono', 'Fira Code', 'SF Mono', monospace",
    }}>
      <div style={{ maxWidth: "1200px", margin: "0 auto" }}>
        <div style={{ display: "flex", alignItems: "baseline", gap: "16px", marginBottom: "20px" }}>
          <h1 style={{ fontSize: "20px", fontWeight: 800, color: "#e0e0ef", margin: 0, letterSpacing: "-0.5px" }}>
            Sample Contribution Tracker
          </h1>
          <span style={{ fontSize: "11px", color: "#555" }}>
            {data.total.toLocaleString()} total · {data.exported.toLocaleString()} exported · {data.epochs.length} epochs
          </span>
          <button
            onClick={() => { setData(null); setSelected(null); }}
            style={{ ...btnStyle, marginLeft: "auto" }}
          >重新加载</button>
        </div>

        <Overview data={data} />

        {selected && <TrajectoryChart sample={selected} epochs={data.epochs} />}

        <div style={{ fontSize: "12px", color: "#555", marginBottom: "8px" }}>
          👆 点击表格中的样本查看梯度随 epoch 的变化轨迹
        </div>
        <SampleTable data={data} onSelect={setSelected} selected={selected} />
      </div>
    </div>
  );
}
