def read_utt2spk(path):
    d = {}
    with open(path) as f:
        for line in f:
            p = line.strip().split()
            if len(p) >= 2:
                d[p[0]] = p[1]
    return d

def read_spk2utt(path):
    d = {}
    if not os.path.exists(path):
        return d
    with open(path) as f:
        for line in f:
            p = line.strip().split()
            if p:
                d[p[0]] = p[1:]
    return d

def infer_label(spk_id, normal_kw, abnormal_kw):
    s = spk_id.lower()
    if abnormal_kw.lower() in s: return "abnormal"
    if normal_kw.lower()   in s: return "normal"
    return "normal"

def build_utt2label(utt2spk, nkw, akw):
    return {u: infer_label(spk, nkw, akw) for u, spk in utt2spk.items()}

def read_feats_scp(scp_path, max_utts=3000):
    try:
        import kaldiio
    except ImportError:
        print("  [ERROR] kaldiio not installed: pip install kaldiio"); return {}
    feats = {}
    try:
        for uid, mat in kaldiio.load_scp_sequential(scp_path):
            feats[uid] = mat.astype(np.float32)
            if len(feats) >= max_utts:
                break
        print(f"  [kaldiio] loaded {len(feats)} utterances (limit={max_utts})")
    except Exception as e:
        print(f"  [WARNING] feature loading failed: {e}")
    return feats


# ═══════════════════════════════════════════════════════════════════════════════
# Outlier detection
# ═══════════════════════════════════════════════════════════════════════════════

def iqr_outlier_mask(values, k=2.0):
    arr = np.asarray(values, float)
    q1, q3 = np.percentile(arr, 25), np.percentile(arr, 75)
    iqr = q3 - q1
    lo, hi = q1 - k * iqr, q3 + k * iqr
    return (arr < lo) | (arr > hi), lo, hi

def zscore_outlier_mask(values, thr=2.8):
    arr = np.asarray(values, float)
    return np.abs((arr - arr.mean()) / (arr.std() + 1e-9)) > thr


