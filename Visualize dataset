def read_utt2spk(path):
    """返回 {utt_id: spk_id}"""
    d = {}
    with open(path) as f:
        for line in f:
            p = line.strip().split()
            if len(p) >= 2:
                d[p[0]] = p[1]
    return d

def read_utt2dur(path):
    """返回 {utt_id: float(sec)}"""
    d = {}
    if not os.path.exists(path):
        return d
    with open(path) as f:
        for line in f:
            p = line.strip().split()
            if len(p) == 2:
                try:
                    d[p[0]] = float(p[1])
                except ValueError:
                    pass
    return d

def read_spk2utt(path):
    d = {}
    if not os.path.exists(path):
        return d
    with open(path) as f:
        for line in f:
            p = line.strip().split()
            if p:
                d[p[0]] = p[1:]
    return d

def infer_label(spk_id, normal_kw, abnormal_kw):
    """从 spk_id 推断标签，不区分大小写"""
    s = spk_id.lower()
    if abnormal_kw.lower() in s:
        return "abnormal"
    if normal_kw.lower() in s:
        return "normal"
    return "normal"   # 无法判断时默认 normal

def build_utt2label(utt2spk, normal_kw, abnormal_kw):
    return {u: infer_label(spk, normal_kw, abnormal_kw)
            for u, spk in utt2spk.items()}

def read_feats_scp(scp_path, max_utts=3000):
    """
    用 kaldiio 读取 feats.scp（自动解析多分片 ark 路径）
    返回 {utt_id: np.ndarray(T, D)}
    """
    try:
        import kaldiio
    except ImportError:
        print("  [错误] 未安装 kaldiio，请执行: pip install kaldiio")
        return {}

    feats = {}
    try:
        for utt_id, mat in kaldiio.load_scp_sequential(scp_path):
            feats[utt_id] = mat.astype(np.float32)
            if len(feats) >= max_utts:
                break
        print(f"  [kaldiio] 读取 {len(feats)} 条特征 (上限={max_utts})")
    except Exception as e:
        print(f"  [警告] 特征读取失败: {e}")
    return feats


# ═══════════════════════════════════════════════════════════════════════════════
# 异常检测
# ═══════════════════════════════════════════════════════════════════════════════

def iqr_bounds(values, k=2.0):
    arr = np.asarray(values, dtype=float)
    q1, q3 = np.percentile(arr, 25), np.percentile(arr, 75)
    iqr = q3 - q1
    return q1 - k * iqr, q3 + k * iqr

def iqr_outlier_mask(values, k=2.0):
    arr = np.asarray(values, dtype=float)
    lo, hi = iqr_bounds(arr, k)
    return (arr < lo) | (arr > hi), lo, hi

def zscore_outlier_mask(values, thr=2.8):
    arr = np.asarray(values, dtype=float)
    z = np.abs((arr - arr.mean()) / (arr.std() + 1e-9))
    return z > thr


# ═══════════════════════════════════════════════════════════════════════════════
# 工具
