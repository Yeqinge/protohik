def _ax_style(ax, title, xlabel="", ylabel="", grid=True):
    ax.set_title(title, fontsize=10, pad=7, fontweight="bold", color=C_TITLE)
    if xlabel: ax.set_xlabel(xlabel, fontsize=8.5, color=C_SUB)
    if ylabel: ax.set_ylabel(ylabel, fontsize=8.5, color=C_SUB)
    if grid:   ax.grid(True, alpha=0.5, linestyle="--", linewidth=0.5)
    ax.tick_params(labelsize=8)


