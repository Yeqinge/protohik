# CLI
# ═══════════════════════════════════════════════════════════════════════════════

def main():
    ap = argparse.ArgumentParser(
        description="Kaldi 训练集多维可视化 (normal/abnormal 标签从 spk_id 推断)")
    ap.add_argument("--data-dir",          required=True,
                    help="Kaldi data 目录，含 utt2spk spk2utt utt2dur")
    ap.add_argument("--feats-dir",         default=None,
                    help="特征目录，含 feats.scp 和 *.ark")
    ap.add_argument("--scp-name",          default="feats.scp",
                    help="scp 文件名 (默认 feats.scp)")
    ap.add_argument("--output-dir",        default="./vis_output")
    ap.add_argument("--max-feats",         type=int, default=3000,
                    help="最多读取特征条数 (默认 3000)")
    ap.add_argument("--normal-keyword",    default="normal",
                    help="spk_id 中代表 normal 的关键词 (默认 'normal')")
    ap.add_argument("--abnormal-keyword",  default="abnormal",
                    help="spk_id 中代表 abnormal 的关键词 (默认 'abnormal')")
    args = ap.parse_args()

    data_dir  = Path(args.data_dir)
    out_dir   = Path(args.output_dir)
    out_dir.mkdir(parents=True, exist_ok=True)

    print(f"\n[数据目录] {data_dir}")

    # ── 读取元数据 ──────────────────────────────────────────
    utt2spk_path = data_dir / "utt2spk"
    if not utt2spk_path.exists():
        print(f"[错误] 找不到 {utt2spk_path}"); sys.exit(1)

    utt2spk = read_utt2spk(utt2spk_path)
    utt2dur = read_utt2dur(data_dir / "utt2dur")
    spk2utt = read_spk2utt(data_dir / "spk2utt")

    utt_ids   = list(utt2spk.keys())
    utt2label = build_utt2label(utt2spk, args.normal_keyword, args.abnormal_keyword)

    n_norm = sum(1 for v in utt2label.values() if v == "normal")
    n_abnm = sum(1 for v in utt2label.values() if v == "abnormal")
    print(f"  utterances: {len(utt_ids)}  |  normal: {n_norm}  abnormal: {n_abnm}")

    if not utt2dur:
        print("  [提示] utt2dur 不存在，时长图表将跳过。"
              "可用 utils/data/get_utt2dur.sh 生成。")

    # ── 读取特征 ────────────────────────────────────────────
    feats = {}
    feats_dir = Path(args.feats_dir) if args.feats_dir else data_dir
    scp_path  = feats_dir / args.scp_name
    if scp_path.exists():
        print(f"[特征] {scp_path}")
        feats = read_feats_scp(str(scp_path), max_utts=args.max_feats)
    else:
        print(f"  [提示] 找不到 {scp_path}，跳过特征分析。")

    # ── 摘要 ────────────────────────────────────────────────
    print_summary(utt_ids, utt2label, utt2dur, spk2utt, feats)

    # ── 绘图 ────────────────────────────────────────────────
    print("[绘图] page1: 元数据统计 ...")
    build_page1(utt_ids, utt2label, utt2dur, spk2utt,
                out_dir / "page1_metadata.png")

    if feats:
        print("[绘图] page2: FBank 特征分析 ...")
        build_page2(feats, utt2label, out_dir / "page2_fbank.png")
    else:
        print("[跳过] page2 (无特征数据)")

    # ── 异常导出 ────────────────────────────────────────────
    export_outliers(utt_ids, utt2dur, utt2label, feats,
                    out_dir / "outliers.tsv")

    print(f"\n✅ 完成！结果目录: {out_dir}")
    print("   page1_metadata.png  元数据 / 时长分析")
    print("   page2_fbank.png     FBank 特征分析")
    print("   outliers.tsv        异常 utterance 列表\n")


if __name__ == "__main__":
    main()
