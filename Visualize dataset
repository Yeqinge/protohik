#!/usr/bin/env python3
"""
Kaldi Training Set Visualization
- Labels inferred from spk_id (normal / abnormal keywords)
- Multi-shard ark support via feats.scp
- Statistical outlier annotation (IQR / Z-score / bivariate)
- Academic white-background style

Usage:
    python3 visualize_dataset.py \
        --data-dir  data/fbank_20k_test5/fiber_train_s10_fix105_20k \
        --feats-dir feats_exp/feats/fbank_20k_test5/fiber_train_s10_fix105_20k \
        --output-dir ./vis_output \
        [--scp-name feats.scp] \
        [--max-feats 3000] \
        [--normal-keyword normal] \
        [--abnormal-keyword abnormal]
"""

import os, sys, argparse, warnings
import numpy as np
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
import matplotlib.gridspec as gridspec
import matplotlib.patches as mpatches
from matplotlib.colors import LinearSegmentedColormap
from collections import defaultdict
from pathlib import Path

warnings.filterwarnings("ignore")

# ── Academic color palette ────────────────────────────────────────────────────
C_NORMAL   = "#2166ac"
C_ABNORMAL = "#d6604d"
C_ANOMALY  = "#f4a582"
C_GRID     = "#dddddd"
C_TEXT     = "#222222"
C_TITLE    = "#1a1a2e"
C_SUB      = "#555555"
C_FIG      = "#ffffff"
C_AX       = "#fafafa"

LABEL_COLOR = {"normal": C_NORMAL, "abnormal": C_ABNORMAL}

