C_ABNORMAL = "#e74c3c"   # 红
C_ANOMALY  = "#f39c12"   # 橙（统计异常点）
C_BG       = "#0d1117"
C_GRID     = "#21262d"
C_TEXT     = "#c9d1d9"
C_TITLE    = "#58a6ff"

plt.rcParams.update({
    "figure.facecolor": C_BG,
    "axes.facecolor":   C_BG,
    "axes.edgecolor":   C_GRID,
    "axes.labelcolor":  C_TEXT,
    "axes.titlecolor":  C_TEXT,
    "xtick.color":      C_TEXT,
    "ytick.color":      C_TEXT,
    "text.color":       C_TEXT,
    "grid.color":       C_GRID,
    "grid.linewidth":   0.6,
    "legend.facecolor": "#161b22",
    "legend.edgecolor": C_GRID,
    "font.family":      "DejaVu Sans",
    "font.size":        9,
})


