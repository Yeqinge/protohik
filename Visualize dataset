        ax_hn.remove()
        gs2 = gridspec.GridSpecFromSubplotSpec(2, 1, subplot_spec=gs[2, 1],
                                               hspace=0.45)
        u_n = np.random.choice(n_utts)
        u_a = np.random.choice(a_utts)
        plot_heatmap(fig.add_subplot(gs2[0]), feats[u_n],
                     f"Normal  示例: {u_n[:28]}")
        plot_heatmap(fig.add_subplot(gs2[1]), feats[u_a],
                     f"Abnormal 示例: {u_a[:28]}")
