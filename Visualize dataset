def build_page1(utt_ids, utt2label, spk2utt, out_path):
    fig = plt.figure(figsize=(20, 12), facecolor=C_FIG)
    fig.suptitle("Kaldi Training Set — Class & Speaker Distribution",
                 fontsize=14, fontweight="bold", color=C_TITLE, y=0.985)
    gs = gridspec.GridSpec(2, 3, figure=fig,
                            hspace=0.45, wspace=0.32,
                            left=0.06, right=0.97, top=0.95, bottom=0.07)

    plot_label_pie(fig.add_subplot(gs[0, 0]), utt2label)
    plot_utts_per_spk_hist(fig.add_subplot(gs[0, 1]), spk2utt, utt2label)
    plot_label_per_spk_ratio(fig.add_subplot(gs[0, 2]), spk2utt, utt2label)
    plot_spk_utt_dist(fig.add_subplot(gs[1, :]), spk2utt, utt2label)

    plt.savefig(out_path, dpi=150, bbox_inches="tight", facecolor=C_FIG)
    plt.close()
    print(f"  [saved] {out_path}")


def build_page2(feats, utt2label, out_path):
    fig = plt.figure(figsize=(20, 16), facecolor=C_FIG)
    fig.suptitle("Kaldi Training Set — FBank Feature Analysis",
                 fontsize=14, fontweight="bold", color=C_TITLE, y=0.985)
    gs = gridspec.GridSpec(3, 2, figure=fig,
                            hspace=0.45, wspace=0.28,
                            left=0.07, right=0.97, top=0.95, bottom=0.06)

    plot_feat_mean_std(fig.add_subplot(gs[0, 0]), fig.add_subplot(gs[0, 1]),
                       feats, utt2label)
    plot_energy_hist(fig.add_subplot(gs[1, 0]), feats, utt2label)
    plot_len_vs_energy(fig.add_subplot(gs[1, 1]), feats, utt2label)
    plot_variance_per_dim(fig.add_subplot(gs[2, 0]), feats, utt2label)
    plot_energy_boxplot(fig.add_subplot(gs[2, 1]), feats, utt2label)

    plt.savefig(out_path, dpi=150, bbox_inches="tight", facecolor=C_FIG)
    plt.close()
    print(f"  [saved] {out_path}")


def build_page3(feats, utt2label, out_path):
    """FBank heatmap examples: one normal, one abnormal."""
    n_utts = [u for u in feats if utt2label.get(u, "normal") == "normal"]
    a_utts = [u for u in feats if utt2label.get(u, "normal") == "abnormal"]
    if not n_utts and not a_utts:
        print("  [skip] page3 — no samples"); return

    fig = plt.figure(figsize=(20, 8), facecolor=C_FIG)
    fig.suptitle("Kaldi Training Set — FBank Heatmap Examples",
                 fontsize=14, fontweight="bold", color=C_TITLE, y=0.98)
    gs = gridspec.GridSpec(1, 2, figure=fig,
                            hspace=0.3, wspace=0.25,
                            left=0.06, right=0.97, top=0.90, bottom=0.10)
    ax_n = fig.add_subplot(gs[0, 0])
    ax_a = fig.add_subplot(gs[0, 1])
    if n_utts:
        u = np.random.choice(n_utts)
        plot_heatmap(ax_n, feats[u], f"Normal — {u[:40]}")
    else:
        ax_n.text(0.5, 0.5, "No normal features", ha="center", va="center",
                  transform=ax_n.transAxes, color=C_SUB)
    if a_utts:
        u = np.random.choice(a_utts)
        plot_heatmap(ax_a, feats[u], f"Abnormal — {u[:40]}")
    else:
        ax_a.text(0.5, 0.5, "No abnormal features", ha="center", va="center",
                  transform=ax_a.transAxes, color=C_SUB)

    plt.savefig(out_path, dpi=150, bbox_inches="tight", facecolor=C_FIG)
    plt.close()
    print(f"  [saved] {out_path}")


