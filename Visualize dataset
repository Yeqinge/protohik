#!/usr/bin/env python3
"""
Kaldi 训练集特征多维可视化脚本
- 从 utt2spk 的 spk_id 自动推断 normal / abnormal 标签
- 支持多分片 ark（.1.ark .2.ark ...），通过 feats.scp 统一读取
- 自动标注统计异常点（IQR / Z-score / 双维）
- 输出两页高清 PNG

用法:
    python visualize_dataset.py \
        --data-dir  /path/to/kaldi/data/conf/train_name \
        --feats-dir /feats_exp/feats/fbank_20k_test5/fiber_train_s10_fix105_20k \
        --output-dir ./vis_output \
        [--scp-name feats.scp]          # 默认 feats.scp
        [--max-feats 3000]              # 最多读取特征条数
        [--normal-keyword normal]       # spk_id 中 normal 的关键词
        [--abnormal-keyword abnormal]   # spk_id 中 abnormal 的关键词
"""

import os
import sys
import glob
import argparse
import warnings
