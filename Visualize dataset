def build_page1(utt_ids, utt2label, utt2dur, spk2utt, out_path):
    fig = plt.figure(figsize=(20, 15), facecolor=C_BG)
    fig.suptitle("Kaldi 训练集可视化  ·  元数据统计 & 时长分析",
                 fontsize=15, color=C_TITLE, fontweight="bold", y=0.985)

    gs = gridspec.GridSpec(3, 3, figure=fig,
                            hspace=0.48, wspace=0.32,
                            left=0.06, right=0.97, top=0.95, bottom=0.06)

    dur_n, dur_a = split_by_label(
        utt_ids, utt2label,
        [utt2dur.get(u, 0) for u in utt_ids]
    )
    # 过滤掉没有 utt2dur 的情况（值全为 0）
    if not any([utt2dur.get(u) for u in utt_ids]):
        dur_n, dur_a = [], []

    plot_label_pie(fig.add_subplot(gs[0, 0]), utt2label)
    plot_dur_hist(fig.add_subplot(gs[0, 1]), dur_n, dur_a)
    plot_dur_cumulative(fig.add_subplot(gs[0, 2]), dur_n, dur_a)
    plot_dur_boxplot(fig.add_subplot(gs[1, 0]), dur_n, dur_a)

    durs_all = [utt2dur.get(u, 0) for u in utt_ids]
    plot_dur_timeline(fig.add_subplot(gs[1, 1:]), utt_ids, durs_all, utt2label)
    plot_spk_utt_dist(fig.add_subplot(gs[2, :]), spk2utt, utt2label)

    plt.savefig(out_path, dpi=150, bbox_inches="tight", facecolor=C_BG)
    plt.close()
    print(f"  ✔ {out_path}")


def build_page2(feats, utt2label, out_path):
    fig = plt.figure(figsize=(20, 16), facecolor=C_BG)
    fig.suptitle("Kaldi 训练集可视化  ·  FBank 特征分析",
