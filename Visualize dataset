def print_summary(utt_ids, utt2label, spk2utt, feats):
    sep = "-" * 56
    print(f"\n{sep}\n  Dataset Summary\n{sep}")
    cnt = defaultdict(int)
    for u in utt_ids: cnt[utt2label.get(u, "normal")] += 1
    print(f"  Total utterances : {len(utt_ids):,}")
    for k in sorted(cnt):
        print(f"    {k:12s}: {cnt[k]:6,}  ({cnt[k]/len(utt_ids)*100:.1f}%)")
    if spk2utt:
        cnts = [len(v) for v in spk2utt.values()]
        print(f"\n  Speakers        : {len(spk2utt):,}")
        print(f"    Mean utts/spk : {np.mean(cnts):.1f}")
    if feats:
        s = next(iter(feats.values()))
        print(f"\n  Features loaded : {len(feats):,}")
        print(f"  FBank dim       : {s.shape[1]}")
    print(f"{sep}\n")


def export_outliers(utt_ids, utt2label, feats, out_path):
    rows = []
    if feats:
        energies = [(uid, float(mat.mean())) for uid, mat in feats.items()]
        ids_, vals = zip(*energies)
        for i, m in enumerate(zscore_outlier_mask(vals, thr=2.8)):
            if m:
                rows.append(dict(utt_id=ids_[i],
                                 label=utt2label.get(ids_[i], "normal"),
                                 energy=f"{vals[i]:.4f}",
                                 reason="ENERGY_ZSCORE"))
    if not rows:
        print("  [export] No outliers detected"); return
    with open(out_path, "w") as f:
        f.write("utt_id\tlabel\tenergy\treason\n")
        for r in rows:
            f.write(f"{r['utt_id']}\t{r['label']}\t{r['energy']}\t{r['reason']}\n")
    print(f"  [saved] {out_path}  ({len(rows)} outliers)")


