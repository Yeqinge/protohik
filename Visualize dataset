def plot_feat_mean_std(ax_m, ax_s, feats, utt2label):
    buckets = {"normal": [], "abnormal": []}
    for uid, mat in feats.items():
        lbl = utt2label.get(uid, "normal")
        if lbl in buckets:
            buckets[lbl].append(mat)

    for lbl, mats in buckets.items():
        if not mats:
            continue
        c = LABEL_COLOR[lbl]
        stack = np.stack([m.mean(axis=0) for m in mats])  # (N, D)
        mu = stack.mean(0); se = stack.std(0)
        x  = np.arange(stack.shape[1])
        ax_m.plot(x, mu, color=c, lw=1.6, label=lbl)
        ax_m.fill_between(x, mu - se, mu + se, color=c, alpha=0.15)

        stack_s = np.stack([m.std(axis=0) for m in mats])
        mu_s = stack_s.mean(0)
        ax_s.plot(x, mu_s, color=c, lw=1.6, label=lbl)
        ax_s.fill_between(x, mu_s - stack_s.std(0),
                          mu_s + stack_s.std(0), color=c, alpha=0.12)

    ax_m.legend(); ax_s.legend()
    _ax_style(ax_m, "FBank 各维度均值对比 (±1σ)", "滤波器组 index", "均值")
    _ax_style(ax_s, "FBank 各维度标准差对比 (±1σ)", "滤波器组 index", "标准差")


def plot_energy_hist(ax, feats, utt2label):
    en_n, en_a = [], []
    for uid, mat in feats.items():
        e = float(mat.mean())
        if utt2label.get(uid, "normal") == "abnormal":
            en_a.append(e)
        else:
            en_n.append(e)

    all_e = en_n + en_a
    if not all_e:
        return
    lo_b = np.percentile(all_e, 0.5); hi_b = np.percentile(all_e, 99.5)
    bins = np.linspace(lo_b, hi_b, 55)

    ax.hist(en_n, bins=bins, alpha=0.65, color=C_NORMAL,
            density=True, label=f"Normal  n={len(en_n)}")
    ax.hist(en_a, bins=bins, alpha=0.65, color=C_ABNORMAL,
            density=True, label=f"Abnormal n={len(en_a)}")

    # 标注低能量异常
    if en_n:
        mask_z = zscore_outlier_mask(en_n, thr=2.8)
        outs = np.array(en_n)[mask_z]
        if len(outs):
            ax.scatter(outs, np.full(len(outs), ax.get_ylim()[1] * 0.02 if ax.get_ylim()[1] > 0 else 0.01),
                       c=C_ANOMALY, marker="v", s=35, zorder=6,
                       label=f"能量异常 n={len(outs)}")
    ax.legend()
    _ax_style(ax, "帧平均能量分布", "能量", "密度")


def plot_len_vs_energy(ax, feats, utt2label):
    lengths, energies, colors_arr = [], [], []
    for uid, mat in feats.items():
        lengths.append(mat.shape[0])
        energies.append(float(mat.mean()))
        colors_arr.append(LABEL_COLOR.get(utt2label.get(uid, "normal"), C_NORMAL))

    ax.scatter(lengths, energies, c=colors_arr, s=6, alpha=0.4, linewidths=0)

    arr_l = np.array(lengths); arr_e = np.array(energies)
    z_l = np.abs((arr_l - arr_l.mean()) / (arr_l.std() + 1e-9))
    z_e = np.abs((arr_e - arr_e.mean()) / (arr_e.std() + 1e-9))
    anom = (z_l > 2.5) | (z_e > 2.5)
    if anom.sum():
        ax.scatter(arr_l[anom], arr_e[anom], c=C_ANOMALY, s=35,
                   marker="*", zorder=6, label=f"双维异常 n={anom.sum()}")

    handles = legend_patches(("Normal", C_NORMAL), ("Abnormal", C_ABNORMAL))
    if anom.sum():
        handles.append(mpatches.Patch(color=C_ANOMALY, label=f"双维异常 n={anom.sum()}"))
    ax.legend(handles=handles)
    _ax_style(ax, "utterance 长度 vs 平均能量", "帧数 (T)", "平均能量")


def plot_heatmap(ax, mat, title):
    cmap = LinearSegmentedColormap.from_list(
        "fbank", ["#0d1117", "#1a3a5c", "#1f6f8b", "#27ae60", "#f1c40f", "#e74c3c"]
    )
    im = ax.imshow(mat.T, aspect="auto", origin="lower", cmap=cmap,
                   interpolation="nearest")
    plt.colorbar(im, ax=ax, fraction=0.025, pad=0.02)
    _ax_style(ax, title, "时间帧", "滤波器组 index", grid=False)


def plot_feat_variance_per_dim(ax, feats, utt2label):
    """各维度方差对比（normal 和 abnormal）"""
    vars_n, vars_a = [], []
    for uid, mat in feats.items():
        v = mat.var(axis=0)   # (D,)
        if utt2label.get(uid, "normal") == "abnormal":
            vars_a.append(v)
        else:
            vars_n.append(v)

    x = np.arange(list(feats.values())[0].shape[1]) if feats else np.array([])
    for vlist, lbl, c in [(vars_n, "Normal", C_NORMAL),
                           (vars_a, "Abnormal", C_ABNORMAL)]:
        if vlist:
            stacked = np.stack(vlist)
            mu = stacked.mean(0)
            ax.plot(x, mu, color=c, lw=1.5, label=lbl)
            ax.fill_between(x, mu - stacked.std(0), mu + stacked.std(0),
                            color=c, alpha=0.13)

    # 标出方差差异最大的维度
    if vars_n and vars_a:
        mu_n = np.stack(vars_n).mean(0)
        mu_a = np.stack(vars_a).mean(0)
        diff = np.abs(mu_n - mu_a)
        top5 = np.argsort(diff)[-5:]
        for d in top5:
            ax.axvline(d, color=C_ANOMALY, lw=0.8, ls=":", alpha=0.7)
        ax.text(top5[-1], ax.get_ylim()[1] if ax.get_ylim()[1] > 0 else 1,
                f"差异最大维度", fontsize=6.5, color=C_ANOMALY, va="top")

    ax.legend()
    _ax_style(ax, "各维度方差对比 (虚线=差异最大维度)", "滤波器组 index", "方差")


