def build_page1(utt_ids, utt2label, utt2dur, spk2utt, out_path):
    """第一页：元数据统计"""
    fig = plt.figure(figsize=(18, 14), facecolor=C_BG)
    fig.suptitle("Kaldi 训练集可视化 · 元数据统计", fontsize=15, color=C_TITLE,
                 fontweight="bold", y=0.98)

    gs = gridspec.GridSpec(3, 3, figure=fig, hspace=0.45, wspace=0.35,
                            left=0.07, right=0.97, top=0.93, bottom=0.07)

    # 1. 类别饼图
    ax0 = fig.add_subplot(gs[0, 0])
    plot_label_pie(ax0, utt2label)

    # 2. 时长分布直方图
    ax1 = fig.add_subplot(gs[0, 1:])
    dur_n = [utt2dur[u] for u in utt_ids if u in utt2dur and utt2label.get(u, "normal") == "normal"]
    dur_a = [utt2dur[u] for u in utt_ids if u in utt2dur and utt2label.get(u, "normal") == "abnormal"]
    if dur_n or dur_a:
        plot_duration_distribution(ax1, dur_n, dur_a)
    else:
        ax1.text(0.5, 0.5, "utt2dur 不存在", ha="center", va="center", transform=ax1.transAxes)
        _ax_style(ax1, "时长分布")

    # 3. 箱线图
    ax2 = fig.add_subplot(gs[1, 0])
    if dur_n or dur_a:
        plot_duration_boxplot(ax2, dur_n, dur_a)

    # 4. 时序散点（含异常标注）
    ax3 = fig.add_subplot(gs[1, 1:])
    durs_all   = [utt2dur.get(u, 0) for u in utt_ids]
    if any(durs_all):
        plot_duration_scatter_with_outliers(ax3, utt_ids, durs_all, utt2label)

    # 5. 说话人分布
    ax4 = fig.add_subplot(gs[2, :])
    if spk2utt:
        plot_utterance_count_per_speaker(ax4, spk2utt, utt2label)
    else:
        ax4.text(0.5, 0.5, "spk2utt 不存在", ha="center", va="center", transform=ax4.transAxes)
        _ax_style(ax4, "说话人分布")

    plt.savefig(out_path, dpi=150, bbox_inches="tight", facecolor=C_BG)
    plt.close()
    print(f"  [保存] {out_path}")


def build_page2(feats, utt2label, out_path):
    """第二页：FBank 特征统计"""
    fig = plt.figure(figsize=(18, 16), facecolor=C_BG)
    fig.suptitle("Kaldi 训练集可视化 · FBank 特征分析", fontsize=15, color=C_TITLE,
                 fontweight="bold", y=0.98)

    gs = gridspec.GridSpec(3, 2, figure=fig, hspace=0.45, wspace=0.3,
                            left=0.07, right=0.97, top=0.93, bottom=0.07)

    # 1. FBank 均值对比
    ax0 = fig.add_subplot(gs[0, 0])
    ax1 = fig.add_subplot(gs[0, 1])
    plot_feat_stats(ax0, ax1, feats, utt2label)

    # 2. 帧能量分布
    ax2 = fig.add_subplot(gs[1, 0])
    plot_energy_distribution(ax2, feats, utt2label)

    # 3. 长度 vs 能量散点
    ax3 = fig.add_subplot(gs[1, 1])
    plot_utt_length_vs_energy(ax3, feats, utt2label)

    # 4 & 5. 随机各取一条 normal / abnormal 的热力图
    normal_utts   = [u for u in feats if utt2label.get(u, "normal") == "normal"]
    abnormal_utts = [u for u in feats if utt2label.get(u, "normal") == "abnormal"]

    ax4 = fig.add_subplot(gs[2, 0])
    ax5 = fig.add_subplot(gs[2, 1])

    if normal_utts:
        u = np.random.choice(normal_utts)
        plot_fbank_heatmap(ax4, feats[u], f"Normal 示例: {u[:20]}")
    else:
        ax4.text(0.5, 0.5, "无 normal 特征", ha="center", va="center", transform=ax4.transAxes)

    if abnormal_utts:
        u = np.random.choice(abnormal_utts)
        plot_fbank_heatmap(ax5, feats[u], f"Abnormal 示例: {u[:20]}")
    else:
        ax5.text(0.5, 0.5, "无 abnormal 特征", ha="center", va="center", transform=ax5.transAxes)

    plt.savefig(out_path, dpi=150, bbox_inches="tight", facecolor=C_BG)
    plt.close()
    print(f"  [保存] {out_path}")


def print_summary(utt_ids, utt2label, utt2dur, spk2utt, feats):
    """终端打印统计摘要"""
    print("\n" + "=" * 60)
    print("  训练集统计摘要")
    print("=" * 60)
    cnt = defaultdict(int)
    for u in utt_ids:
        cnt[utt2label.get(u, "normal")] += 1
    print(f"  总 utterances: {len(utt_ids)}")
    for k, v in sorted(cnt.items()):
        print(f"    {k:12s}: {v:6d}  ({v/len(utt_ids)*100:.1f}%)")

    if utt2dur:
        durs = [utt2dur[u] for u in utt_ids if u in utt2dur]
        print(f"\n  时长统计 (秒):")
        print(f"    总时长: {sum(durs)/3600:.2f} 小时")
        print(f"    均值:   {np.mean(durs):.2f}  中位数: {np.median(durs):.2f}")
        print(f"    最短:   {min(durs):.2f}  最长:   {max(durs):.2f}")
        out_idx, lo, hi = detect_outliers_iqr(durs)
        print(f"    IQR 异常点 (k=2.0): {len(out_idx)} 条  (< {lo:.1f}s 或 > {hi:.1f}s)")

    if spk2utt:
        print(f"\n  说话人数: {len(spk2utt)}")
        cnts = [len(v) for v in spk2utt.values()]
        print(f"    每人平均 utterances: {np.mean(cnts):.1f}")

    if feats:
        print(f"\n  已读取特征条数: {len(feats)}")
        sample = list(feats.values())[0]
        print(f"  FBank 维度: {sample.shape[1]}")

    print("=" * 60 + "\n")


def export_outlier_list(utt_ids, utt2dur, utt2label, out_path):
    """导出统计异常 utterance 列表"""
    durs = [(u, utt2dur[u]) for u in utt_ids if u in utt2dur]
    if not durs:
        return
    ids_list, dur_list = zip(*durs)
    out_idx, lo, hi = detect_outliers_iqr(dur_list, k=2.0)
    out_lines = []
    for i in out_idx:
        u = ids_list[i]
        out_lines.append(f"{u}\t{dur_list[i]:.3f}\t{utt2label.get(u, 'normal')}\tDUR_OUTLIER")

    with open(out_path, "w") as f:
        f.write("utt_id\tduration\tlabel\treason\n")
        f.write("\n".join(out_lines))
    print(f"  [导出] 异常列表: {out_path}  ({len(out_lines)} 条)")


# ═══════════════════════════════════════════════════════════════════════════════
# CLI 入口
# ═══════════════════════════════════════════════════════════════════════════════

def main():
    parser = argparse.ArgumentParser(
        description="Kaldi 训练集多维可视化 (normal/abnormal)")
    parser.add_argument("--data-dir",    required=True,  help="Kaldi data 目录")
    parser.add_argument("--feat-scp",    default=None,   help="feats.scp 路径（可选）")
    parser.add_argument("--label-file",  default=None,   help="utt2label 文件路径（可选，默认全视为 normal）")
    parser.add_argument("--output-dir",  default="./vis_output", help="输出目录")
    parser.add_argument("--max-feats",   type=int, default=2000, help="最多读取特征数量")
    args = parser.parse_args()

    data_dir = Path(args.data_dir)
    out_dir  = Path(args.output_dir)
    out_dir.mkdir(parents=True, exist_ok=True)

    print(f"\n[读取数据目录] {data_dir}")

    # ── 读取元数据 ──────────────────────────────────
    utt2spk = read_kv(data_dir / "utt2spk")
    utt2dur = read_utt2dur(data_dir / "utt2dur")
    spk2utt = read_spk2utt(data_dir / "spk2utt")

    # 如果 utt2dur 不存在，尝试从 segments / wav.scp 推断（跳过）
    if not utt2dur:
        print("  [提示] utt2dur 不存在，时长相关图表将跳过。"
              "可用 utils/data/get_utt2dur.sh 生成。")

    utt_ids = list(utt2spk.keys()) if utt2spk else []
    if not utt_ids:
        # fallback: 从 wav.scp 取 key
        wav_scp = read_kv(data_dir / "wav.scp")
        utt_ids = list(wav_scp.keys())

    print(f"  utterances: {len(utt_ids)}, speakers: {len(spk2utt)}")

    # ── 读取标签 ────────────────────────────────────
    label_path = args.label_file or data_dir / "utt2label"
    utt2label = read_label_file(label_path)
    if not utt2label:
        print("  [提示] 未找到 utt2label，所有样本默认为 normal。")
        utt2label = {u: "normal" for u in utt_ids}

    # ── 读取特征 ────────────────────────────────────
    feats = {}
    scp_path = args.feat_scp or data_dir / "feats.scp"
    if os.path.exists(scp_path):
        print(f"  [读取特征] {scp_path}")
        feats = try_read_feats_ark(str(scp_path), max_utts=args.max_feats)

    # ── 统计摘要 ────────────────────────────────────
    print_summary(utt_ids, utt2label, utt2dur, spk2utt, feats)

    # ── 绘图 ────────────────────────────────────────
    print("[绘图] 第一页：元数据统计 ...")
    build_page1(utt_ids, utt2label, utt2dur, spk2utt,
                out_dir / "page1_metadata.png")

    if feats:
        print("[绘图] 第二页：FBank 特征分析 ...")
        build_page2(feats, utt2label, out_dir / "page2_fbank.png")
    else:
        print("[跳过] 第二页（无特征数据）")

    # ── 导出异常列表 ────────────────────────────────
    export_outlier_list(utt_ids, utt2dur, utt2label, out_dir / "outliers.tsv")

    print(f"\n✅ 完成！结果保存在: {out_dir}/")
    print("   page1_metadata.png  — 元数据统计")
    print("   page2_fbank.png     — FBank 特征分析（需 feats.scp）")
    print("   outliers.tsv        — 统计异常 utterance 列表\n")


if __name__ == "__main__":
    main()
