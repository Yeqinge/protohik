def _ax_style(ax, title, xlabel="", ylabel="", grid=True):
    ax.set_title(title, fontsize=10, pad=7, color=C_TITLE, fontweight="bold")
    if xlabel: ax.set_xlabel(xlabel, fontsize=8, color=C_SUB)
    if ylabel: ax.set_ylabel(ylabel, fontsize=8, color=C_SUB)
    if grid:   ax.grid(True, alpha=0.35, linestyle="--")
    ax.tick_params(labelsize=7.5)

def legend_patches(*pairs):
    """pairs: (label, color)"""
    return [mpatches.Patch(color=c, label=l) for l, c in pairs]

def split_by_label(utt_ids, utt2label, values):
    """将 values 按 normal/abnormal 分组，返回 (list_normal, list_abnormal)"""
    n, a = [], []
    for u, v in zip(utt_ids, values):
        if utt2label.get(u, "normal") == "abnormal":
            a.append(v)
        else:
            n.append(v)
    return n, a


