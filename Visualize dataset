def _ax_style(ax, title, xlabel="", ylabel=""):
    ax.set_title(title, fontsize=10, pad=8, color=C_TITLE)
    ax.set_xlabel(xlabel, fontsize=8)
    ax.set_ylabel(ylabel, fontsize=8)
    ax.grid(True, alpha=0.4)
    ax.tick_params(labelsize=8)


def plot_duration_distribution(ax, dur_normal, dur_abnormal):
    """时长分布对比直方图 + 异常点标注"""
    bins = np.histogram_range = None
    all_dur = dur_normal + dur_abnormal
    bins = np.linspace(0, min(np.percentile(all_dur, 99), 60), 50) if all_dur else 30

    ax.hist(dur_normal,   bins=bins, alpha=0.65, color=C_NORMAL,   label=f"Normal  (n={len(dur_normal)})",   density=True)
    ax.hist(dur_abnormal, bins=bins, alpha=0.65, color=C_ABNORMAL, label=f"Abnormal (n={len(dur_abnormal)})", density=True)

    # 标注 normal 集合中的时长异常点
    if dur_normal:
        idx, lo, hi = detect_outliers_iqr(dur_normal)
        for i in idx:
            ax.axvline(dur_normal[i], color=C_ANOMALY, alpha=0.5, linewidth=0.8, linestyle=":")
        if len(idx):
            ax.axvline(lo, color=C_ANOMALY, linewidth=1.2, linestyle="--", label=f"Outlier bounds (IQR)")
            ax.axvline(hi, color=C_ANOMALY, linewidth=1.2, linestyle="--")

    _ax_style(ax, "语音时长分布 (秒)", "时长 (s)", "密度")
    ax.legend(fontsize=8)


def plot_duration_boxplot(ax, dur_normal, dur_abnormal):
    """箱线图对比 + 散点"""
    data  = [dur_normal, dur_abnormal]
    labels = ["Normal", "Abnormal"]
    colors = [C_NORMAL, C_ABNORMAL]

    bp = ax.boxplot(data, patch_artist=True, notch=False,
                    whiskerprops=dict(color=C_TEXT, linewidth=1),
                    capprops=dict(color=C_TEXT, linewidth=1.5),
                    medianprops=dict(color="#f1c40f", linewidth=2),
                    flierprops=dict(marker="o", markersize=3, linestyle="none",
                                    markerfacecolor=C_ANOMALY, alpha=0.6))
    for patch, color in zip(bp["boxes"], colors):
        patch.set_facecolor(color + "55")
        patch.set_edgecolor(color)

    # 抖动散点
    for i, (d, c) in enumerate(zip(data, colors), 1):
        if len(d) > 500:
            d = np.random.choice(d, 500, replace=False).tolist()
        jitter = np.random.uniform(-0.15, 0.15, len(d))
        ax.scatter([i + j for j in jitter], d, alpha=0.25, s=4, color=c, zorder=3)

    ax.set_xticks([1, 2])
    ax.set_xticklabels(labels)
    _ax_style(ax, "时长箱线图对比", "", "时长 (s)")


def plot_utterance_count_per_speaker(ax, spk2utt, utt2label):
    """每说话人 utterance 数量，按 normal/abnormal 着色"""
    spk_normal_cnt  = defaultdict(int)
    spk_abnormal_cnt = defaultdict(int)

    for spk, utts in spk2utt.items():
        for u in utts:
            lbl = utt2label.get(u, "normal")
            if lbl == "abnormal":
                spk_abnormal_cnt[spk] += 1
            else:
                spk_normal_cnt[spk] += 1

    spks = sorted(spk2utt.keys(), key=lambda s: -len(spk2utt[s]))[:40]
    x = np.arange(len(spks))
    n_vals = [spk_normal_cnt[s] for s in spks]
    a_vals = [spk_abnormal_cnt[s] for s in spks]

    ax.bar(x, n_vals, color=C_NORMAL,   alpha=0.8, label="Normal",   width=0.7)
    ax.bar(x, a_vals, color=C_ABNORMAL, alpha=0.8, label="Abnormal", width=0.7,
           bottom=n_vals)

    # 标出 total 异常的说话人
    totals = [n + a for n, a in zip(n_vals, a_vals)]
    ratios = [a / t if t > 0 else 0 for a, t in zip(a_vals, totals)]
    outlier_idx = [i for i, r in enumerate(ratios) if r > np.mean(ratios) + 2 * np.std(ratios)]
    for i in outlier_idx:
        ax.annotate("!", (x[i], totals[i] + 0.5), ha="center", color=C_ANOMALY,
                    fontsize=10, fontweight="bold")

    ax.set_xticks(x[::max(1, len(spks)//10)])
    ax.set_xticklabels([spks[i] for i in range(0, len(spks), max(1, len(spks)//10))],
                        rotation=30, ha="right", fontsize=7)
    _ax_style(ax, "Top 40 说话人语句分布", "说话人", "utterance 数")
    ax.legend(fontsize=8)


def plot_label_pie(ax, utt2label):
    """正常/异常比例饼图"""
    cnt = defaultdict(int)
    for v in utt2label.values():
        cnt[v] += 1
    if not cnt:
        ax.text(0.5, 0.5, "无标签数据", ha="center", va="center", transform=ax.transAxes)
        return

    labels_list = list(cnt.keys())
    sizes = [cnt[k] for k in labels_list]
    colors = [C_NORMAL if k == "normal" else C_ABNORMAL for k in labels_list]

    wedges, texts, autotexts = ax.pie(
        sizes, labels=labels_list, autopct="%1.1f%%",
        colors=colors, startangle=90,
        wedgeprops=dict(edgecolor=C_BG, linewidth=2),
        textprops=dict(color=C_TEXT, fontsize=9),
    )
    for at in autotexts:
        at.set_color("#f1f1f1")
        at.set_fontsize(9)
    _ax_style(ax, "样本类别比例")


def plot_duration_scatter_with_outliers(ax, utt_ids, durations, utt2label):
    """时序散点图，标出持续时长异常点"""
    colors_arr = [C_NORMAL if utt2label.get(u, "normal") == "normal" else C_ABNORMAL
                  for u in utt_ids]
    ax.scatter(range(len(durations)), durations, c=colors_arr, s=3, alpha=0.4)

    # IQR 异常点
    out_idx, lo, hi = detect_outliers_iqr(durations, k=2.5)
    if len(out_idx):
        ax.scatter(out_idx, [durations[i] for i in out_idx],
                   c=C_ANOMALY, s=20, alpha=0.9, zorder=5, marker="^",
                   label=f"统计异常点 (IQR, n={len(out_idx)})")
    ax.axhline(lo, color=C_ANOMALY, linewidth=1, linestyle="--", alpha=0.7)
    ax.axhline(hi, color=C_ANOMALY, linewidth=1, linestyle="--", alpha=0.7)

    n_patch = mpatches.Patch(color=C_NORMAL,   label="Normal")
    a_patch = mpatches.Patch(color=C_ABNORMAL, label="Abnormal")
    handles = [n_patch, a_patch]
    if len(out_idx):
        handles.append(mpatches.Patch(color=C_ANOMALY, label=f"异常点 (n={len(out_idx)})"))
    ax.legend(handles=handles, fontsize=8)
    _ax_style(ax, "语句时长时序图（含异常标注）", "utterance index", "时长 (s)")


def plot_feat_stats(ax_mean, ax_std, feats, utt2label):
    """FBank 特征均值和标准差分布（按类别）"""
    mean_normal, mean_abnormal = [], []
    std_normal,  std_abnormal  = [], []

    for utt_id, mat in feats.items():
        lbl = utt2label.get(utt_id, "normal")
        m = mat.mean(axis=0)  # (D,)
        s = mat.std(axis=0)   # (D,)
        if lbl == "abnormal":
            mean_abnormal.append(m)
            std_abnormal.append(s)
        else:
            mean_normal.append(m)
            std_normal.append(s)

    dim = None
    for arr, color, label in [
        (mean_normal,   C_NORMAL,   "Normal"),
        (mean_abnormal, C_ABNORMAL, "Abnormal"),
    ]:
        if arr:
            stack = np.array(arr)   # (N, D)
            dim = stack.shape[1]
            x = np.arange(dim)
            mu = stack.mean(axis=0)
            se = stack.std(axis=0)
            ax_mean.plot(x, mu, color=color, linewidth=1.5, label=label)
            ax_mean.fill_between(x, mu - se, mu + se, color=color, alpha=0.15)

    for arr, color, label in [
        (std_normal,   C_NORMAL,   "Normal"),
        (std_abnormal, C_ABNORMAL, "Abnormal"),
    ]:
        if arr:
            stack = np.array(arr)
            x = np.arange(stack.shape[1])
            mu = stack.mean(axis=0)
            ax_std.plot(x, mu, color=color, linewidth=1.5, label=label)

    _ax_style(ax_mean, "FBank 各维度均值对比", "滤波器组 index", "均值")
    _ax_style(ax_std,  "FBank 各维度标准差对比", "滤波器组 index", "标准差")
    ax_mean.legend(fontsize=8)
    ax_std.legend(fontsize=8)


def plot_fbank_heatmap(ax, feat_mat, title="FBank 热力图示例"):
    """单条 utterance 的 FBank 热力图"""
    cmap = LinearSegmentedColormap.from_list(
        "heat", ["#0d1117", "#1a3a5c", "#2980b9", "#27ae60", "#f1c40f", "#e74c3c"]
    )
    im = ax.imshow(feat_mat.T, aspect="auto", origin="lower", cmap=cmap,
                   interpolation="nearest")
    plt.colorbar(im, ax=ax, fraction=0.03, pad=0.02)
    _ax_style(ax, title, "时间帧", "滤波器组 index")


def plot_energy_distribution(ax, feats, utt2label):
    """每条 utterance 的平均帧能量分布"""
    energy_normal, energy_abnormal = [], []
    ids_n, ids_a = [], []

    for utt_id, mat in feats.items():
        e = mat.mean()
        lbl = utt2label.get(utt_id, "normal")
        if lbl == "abnormal":
            energy_abnormal.append(e)
            ids_a.append(utt_id)
        else:
            energy_normal.append(e)
            ids_n.append(utt_id)

    all_e = energy_normal + energy_abnormal
    bins = np.linspace(np.percentile(all_e, 1), np.percentile(all_e, 99), 50) if all_e else 30
    ax.hist(energy_normal,   bins=bins, alpha=0.65, color=C_NORMAL,   density=True,
            label=f"Normal (n={len(energy_normal)})")
    ax.hist(energy_abnormal, bins=bins, alpha=0.65, color=C_ABNORMAL, density=True,
            label=f"Abnormal (n={len(energy_abnormal)})")

    # 标注异常低能量点
    if energy_normal:
        idx_out = detect_outliers_zscore(energy_normal, threshold=2.5)
        if len(idx_out):
            outlier_vals = [energy_normal[i] for i in idx_out]
            ax.scatter(outlier_vals, [0.01] * len(outlier_vals),
                       c=C_ANOMALY, marker="^", s=40, zorder=5,
                       label=f"低能量异常 (n={len(idx_out)})")

    _ax_style(ax, "帧平均能量分布", "能量", "密度")
    ax.legend(fontsize=8)


def plot_utt_length_vs_energy(ax, feats, utt2label):
    """散点图：utterance 长度 vs 平均能量，颜色区分类别，标出双维异常"""
    lengths, energies, colors_arr, ids = [], [], [], []

    for utt_id, mat in feats.items():
        lbl = utt2label.get(utt_id, "normal")
        lengths.append(mat.shape[0])
        energies.append(mat.mean())
        colors_arr.append(C_NORMAL if lbl == "normal" else C_ABNORMAL)
        ids.append(utt_id)

    ax.scatter(lengths, energies, c=colors_arr, s=6, alpha=0.4)

    # 双变量异常：z-score 在两个维度都偏离
    z_l = np.abs((np.array(lengths) - np.mean(lengths)) / (np.std(lengths) + 1e-9))
    z_e = np.abs((np.array(energies) - np.mean(energies)) / (np.std(energies) + 1e-9))
    anomaly_mask = (z_l > 2.5) | (z_e > 2.5)
    ax.scatter(np.array(lengths)[anomaly_mask], np.array(energies)[anomaly_mask],
               c=C_ANOMALY, s=30, marker="*", zorder=5, alpha=0.9,
               label=f"双维异常 (n={anomaly_mask.sum()})")

    n_patch = mpatches.Patch(color=C_NORMAL,   label="Normal")
    a_patch = mpatches.Patch(color=C_ABNORMAL, label="Abnormal")
    ax.legend(handles=[n_patch, a_patch,
                        mpatches.Patch(color=C_ANOMALY, label=f"异常 (n={anomaly_mask.sum()})")],
              fontsize=8)
    _ax_style(ax, "utterance 长度 vs 平均能量", "帧数", "平均能量")


