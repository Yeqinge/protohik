def main():
    ap = argparse.ArgumentParser(
        description="Kaldi dataset visualization (normal/abnormal from spk_id)")
    ap.add_argument("--data-dir",         required=True,
                    help="Kaldi data dir with utt2spk, spk2utt")
    ap.add_argument("--feats-dir",        default=None,
                    help="Feature dir with feats.scp and *.ark shards")
    ap.add_argument("--scp-name",         default="feats.scp")
    ap.add_argument("--output-dir",       default="./vis_output")
    ap.add_argument("--max-feats",        type=int, default=3000)
    ap.add_argument("--normal-keyword",   default="normal")
    ap.add_argument("--abnormal-keyword", default="abnormal")
    args = ap.parse_args()

    data_dir = Path(args.data_dir)
    out_dir  = Path(args.output_dir)
    out_dir.mkdir(parents=True, exist_ok=True)

    print(f"\n[data dir] {data_dir}")

    utt2spk_path = data_dir / "utt2spk"
    if not utt2spk_path.exists():
        print(f"[ERROR] not found: {utt2spk_path}"); sys.exit(1)

    utt2spk   = read_utt2spk(utt2spk_path)
    spk2utt   = read_spk2utt(data_dir / "spk2utt")
    utt_ids   = list(utt2spk.keys())
    utt2label = build_utt2label(utt2spk, args.normal_keyword, args.abnormal_keyword)

    n_norm = sum(1 for v in utt2label.values() if v == "normal")
    n_abnm = sum(1 for v in utt2label.values() if v == "abnormal")
    print(f"  utterances: {len(utt_ids)}  |  normal: {n_norm}  abnormal: {n_abnm}")

    feats = {}
    feats_dir = Path(args.feats_dir) if args.feats_dir else data_dir
    scp_path  = feats_dir / args.scp_name
    if scp_path.exists():
        print(f"[feats] {scp_path}")
        feats = read_feats_scp(str(scp_path), max_utts=args.max_feats)
    else:
        print(f"  [note] {scp_path} not found — feature plots will be skipped")

    print_summary(utt_ids, utt2label, spk2utt, feats)

    print("[plot] page1: class & speaker distribution ...")
    build_page1(utt_ids, utt2label, spk2utt, out_dir / "page1_speakers.png")

    if feats:
        print("[plot] page2: FBank feature analysis ...")
        build_page2(feats, utt2label, out_dir / "page2_fbank.png")
        print("[plot] page3: FBank heatmap examples ...")
        build_page3(feats, utt2label, out_dir / "page3_heatmaps.png")
        export_outliers(utt_ids, utt2label, feats, out_dir / "outliers.tsv")
    else:
        print("  [skip] pages 2 & 3 — no features loaded")

    print(f"\nDone. Output: {out_dir}/")
    print("  page1_speakers.png   class & speaker distribution")
    print("  page2_fbank.png      FBank feature analysis")
    print("  page3_heatmaps.png   FBank heatmap examples")
    print("  outliers.tsv         outlier utterance list\n")


if __name__ == "__main__":
    main()
