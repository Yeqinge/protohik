# 绘图：第一页（元数据）
# ═══════════════════════════════════════════════════════════════════════════════

def plot_label_pie(ax, utt2label):
    cnt = defaultdict(int)
    for v in utt2label.values():
        cnt[v] += 1
    labels = sorted(cnt.keys())
    sizes  = [cnt[k] for k in labels]
    colors = [LABEL_COLOR.get(k, "#aaaaaa") for k in labels]
    explode = [0.04] * len(labels)
    wedges, texts, autotexts = ax.pie(
        sizes, labels=labels, autopct="%1.1f%%", colors=colors,
        explode=explode, startangle=90,
        wedgeprops=dict(edgecolor=C_BG, linewidth=2),
        textprops=dict(color=C_TEXT, fontsize=9),
    )
    for at in autotexts:
        at.set_fontsize(9); at.set_color("#ffffff")
    total = sum(sizes)
    ax.text(0, -1.35, f"共 {total:,} 条 utterances",
            ha="center", fontsize=8.5, color=C_SUB)
    _ax_style(ax, "样本类别比例", grid=False)


def plot_dur_hist(ax, dur_n, dur_a):
    all_dur = dur_n + dur_a
    if not all_dur:
        ax.text(0.5, 0.5, "utt2dur 不存在", ha="center", va="center",
                transform=ax.transAxes, color=C_SUB)
        _ax_style(ax, "时长分布"); return

    p99 = np.percentile(all_dur, 99)
    bins = np.linspace(0, p99, 55)
    ax.hist(dur_n, bins=bins, alpha=0.65, color=C_NORMAL,
            label=f"Normal  n={len(dur_n)}", density=True)
    ax.hist(dur_a, bins=bins, alpha=0.65, color=C_ABNORMAL,
            label=f"Abnormal n={len(dur_a)}", density=True)

    if dur_n:
        mask, lo, hi = iqr_outlier_mask(dur_n, k=2.0)
        ax.axvline(lo, color=C_ANOMALY, lw=1.2, ls="--", alpha=0.85, label=f"IQR 边界 [{lo:.1f},{hi:.1f}]s")
        ax.axvline(hi, color=C_ANOMALY, lw=1.2, ls="--", alpha=0.85)

    for v, label, c in [(np.mean(dur_n), "μ_normal", C_NORMAL),
                         (np.mean(dur_a), "μ_abnormal", C_ABNORMAL)]:
        ax.axvline(v, color=c, lw=1.5, ls=":", alpha=0.9)
    ax.legend(fontsize=7.5)
    _ax_style(ax, "语音时长分布 (秒)", "时长 (s)", "密度")


def plot_dur_boxplot(ax, dur_n, dur_a):
    data   = [x for x in [dur_n, dur_a] if x]
    labels = [l for l, x in [("Normal", dur_n), ("Abnormal", dur_a)] if x]
    colors = [LABEL_COLOR[l.lower()] for l in labels]

    bp = ax.boxplot(data, patch_artist=True, notch=False,
                    whiskerprops=dict(color=C_TEXT, lw=1),
                    capprops=dict(color=C_TEXT, lw=1.5),
                    medianprops=dict(color="#f1c40f", lw=2),
                    flierprops=dict(marker="o", ms=3, linestyle="none",
                                    markerfacecolor=C_ANOMALY, alpha=0.5))
    for patch, c in zip(bp["boxes"], colors):
        patch.set_facecolor(c + "44"); patch.set_edgecolor(c)

    for i, (d, c) in enumerate(zip(data, colors), 1):
        sample = np.random.choice(d, min(400, len(d)), replace=False)
        jitter = np.random.uniform(-0.18, 0.18, len(sample))
        ax.scatter(i + jitter, sample, alpha=0.2, s=5, color=c, zorder=3)

    ax.set_xticks(range(1, len(labels) + 1))
    ax.set_xticklabels(labels, fontsize=9)
    _ax_style(ax, "时长箱线图对比", "", "时长 (s)")


def plot_dur_timeline(ax, utt_ids, durations, utt2label):
    """时序散点 + IQR 异常标注"""
    if not any(durations):
        ax.text(0.5, 0.5, "无时长数据", ha="center", va="center",
                transform=ax.transAxes, color=C_SUB)
        _ax_style(ax, "时长时序"); return

    colors_arr = [LABEL_COLOR.get(utt2label.get(u, "normal"), C_NORMAL)
                  for u in utt_ids]
    xs = np.arange(len(durations))
    ax.scatter(xs, durations, c=colors_arr, s=3, alpha=0.45, linewidths=0)

    mask, lo, hi = iqr_outlier_mask(durations, k=2.5)
    out_xs = xs[mask]
    out_ys = np.array(durations)[mask]
    if len(out_xs):
        ax.scatter(out_xs, out_ys, c=C_ANOMALY, s=28, marker="^",
                   zorder=6, label=f"IQR 异常 (n={mask.sum()})", linewidths=0)
    ax.axhline(lo, color=C_ANOMALY, lw=1, ls="--", alpha=0.6)
    ax.axhline(hi, color=C_ANOMALY, lw=1, ls="--", alpha=0.6)

    handles = legend_patches(("Normal", C_NORMAL), ("Abnormal", C_ABNORMAL))
    if len(out_xs):
        handles.append(mpatches.Patch(color=C_ANOMALY, label=f"异常点 n={mask.sum()}"))
    ax.legend(handles=handles, fontsize=7.5)
    _ax_style(ax, "语句时长时序（含异常标注）", "utterance index", "时长 (s)")


def plot_spk_utt_dist(ax, spk2utt, utt2label):
    if not spk2utt:
        ax.text(0.5, 0.5, "无 spk2utt 数据", ha="center", va="center",
                transform=ax.transAxes, color=C_SUB)
        _ax_style(ax, "说话人分布"); return

    spk_n = defaultdict(int); spk_a = defaultdict(int)
    for spk, utts in spk2utt.items():
        for u in utts:
            if utt2label.get(u, "normal") == "abnormal":
                spk_a[spk] += 1
            else:
                spk_n[spk] += 1

    spks = sorted(spk2utt.keys(), key=lambda s: -len(spk2utt[s]))[:50]
    x = np.arange(len(spks))
    nv = np.array([spk_n[s] for s in spks])
    av = np.array([spk_a[s] for s in spks])

    ax.bar(x, nv, color=C_NORMAL,   alpha=0.85, width=0.72, label="Normal")
    ax.bar(x, av, color=C_ABNORMAL, alpha=0.85, width=0.72, bottom=nv, label="Abnormal")

    totals = nv + av
    ratios = np.where(totals > 0, av / totals, 0)
    thr = ratios.mean() + 2.0 * ratios.std()
    for i, r in enumerate(ratios):
        if r > thr:
            ax.annotate("⚠", (x[i], totals[i] + 0.3), ha="center",
                        color=C_ANOMALY, fontsize=9)

    step = max(1, len(spks) // 12)
    ax.set_xticks(x[::step])
    ax.set_xticklabels([spks[i] for i in range(0, len(spks), step)],
                        rotation=35, ha="right", fontsize=6.5)
    ax.legend(fontsize=8)
    _ax_style(ax, "Top-50 说话人语句分布（⚠ 异常比例说话人）",
              "说话人", "utterance 数")


def plot_dur_cumulative(ax, dur_n, dur_a):
    """累积分布曲线"""
    for durs, label, c in [(dur_n, "Normal", C_NORMAL),
                            (dur_a, "Abnormal", C_ABNORMAL)]:
        if not durs:
            continue
        sorted_d = np.sort(durs)
        cdf = np.arange(1, len(sorted_d) + 1) / len(sorted_d)
        ax.plot(sorted_d, cdf, color=c, lw=1.8, label=f"{label} (n={len(durs)})")
    ax.axvline(2,  color="#555", lw=0.8, ls=":")
    ax.axvline(10, color="#555", lw=0.8, ls=":")
    ax.axvline(20, color="#555", lw=0.8, ls=":")
    ax.set_xlim(left=0)
    ax.legend(fontsize=8)
    _ax_style(ax, "时长累积分布 (CDF)", "时长 (s)", "累积比例")


