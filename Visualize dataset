# 统计摘要 & 异常导出
# ═══════════════════════════════════════════════════════════════════════════════

def print_summary(utt_ids, utt2label, utt2dur, spk2utt, feats):
    sep = "─" * 58
    print(f"\n{sep}")
    print("  训练集统计摘要")
    print(sep)

    cnt = defaultdict(int)
    for u in utt_ids:
        cnt[utt2label.get(u, "normal")] += 1
    print(f"  总 utterances : {len(utt_ids):,}")
    for k in sorted(cnt):
        print(f"    {k:12s}: {cnt[k]:6,}  ({cnt[k]/len(utt_ids)*100:.1f}%)")

    if utt2dur:
        durs = [utt2dur[u] for u in utt_ids if u in utt2dur]
        mask, lo, hi = iqr_outlier_mask(durs, k=2.0)
        print(f"\n  时长统计:")
        print(f"    总时长  : {sum(durs)/3600:.2f} 小时")
        print(f"    均值    : {np.mean(durs):.2f}s  中位: {np.median(durs):.2f}s")
        print(f"    [min,max]: [{min(durs):.2f}s, {max(durs):.2f}s]")
        print(f"    IQR 异常: {mask.sum()} 条  (超出 [{lo:.1f}s, {hi:.1f}s])")

    if spk2utt:
        cnts = [len(v) for v in spk2utt.values()]
        print(f"\n  说话人数 : {len(spk2utt):,}")
        print(f"    均值 utts/spk : {np.mean(cnts):.1f}")

    if feats:
        sample = next(iter(feats.values()))
        print(f"\n  已读特征   : {len(feats):,} 条")
        print(f"  FBank 维度 : {sample.shape[1]}")

    print(f"{sep}\n")


def export_outliers(utt_ids, utt2dur, utt2label, feats, out_path):
    rows = []

    # 时长异常
    if utt2dur:
        durs = [(u, utt2dur[u]) for u in utt_ids if u in utt2dur]
        if durs:
            ids_, vals = zip(*durs)
            mask, lo, hi = iqr_outlier_mask(vals, k=2.0)
            for i, m in enumerate(mask):
                if m:
                    rows.append({
                        "utt_id":   ids_[i],
                        "label":    utt2label.get(ids_[i], "normal"),
                        "duration": f"{vals[i]:.3f}",
                        "energy":   "",
                        "reason":   f"DUR_IQR  (lo={lo:.2f} hi={hi:.2f})",
                    })

    # 能量异常
    if feats:
        energies = [(uid, float(mat.mean())) for uid, mat in feats.items()]
        ids_, vals = zip(*energies)
        mask_z = zscore_outlier_mask(vals, thr=2.8)
        for i, m in enumerate(mask_z):
            if m:
                rows.append({
                    "utt_id":   ids_[i],
                    "label":    utt2label.get(ids_[i], "normal"),
                    "duration": f"{utt2dur.get(ids_[i], ''):.3f}" if ids_[i] in utt2dur else "",
                    "energy":   f"{vals[i]:.4f}",
                    "reason":   "ENERGY_ZSCORE",
                })

    if not rows:
        print("  [导出] 未检测到异常点")
        return

    with open(out_path, "w") as f:
        f.write("utt_id\tlabel\tduration\tenergy\treason\n")
        for r in rows:
            f.write(f"{r['utt_id']}\t{r['label']}\t{r['duration']}\t{r['energy']}\t{r['reason']}\n")
    print(f"  ✔ {out_path}  ({len(rows)} 条异常)")


