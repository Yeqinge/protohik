# 数据读取
# ═══════════════════════════════════════════════════════════════════════════════

def read_kv(path):
    """读取 key value 文件，返回 dict"""
    d = {}
    if not os.path.exists(path):
        return d
    with open(path) as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            parts = line.split()
            if len(parts) >= 2:
                d[parts[0]] = parts[1]
            elif len(parts) == 1:
                d[parts[0]] = ""
    return d

def read_utt2dur(path):
    """返回 {utt_id: duration_sec}"""
    d = {}
    if not os.path.exists(path):
        return d
    with open(path) as f:
        for line in f:
            parts = line.strip().split()
            if len(parts) == 2:
                d[parts[0]] = float(parts[1])
    return d

def read_spk2utt(path):
    """返回 {spk: [utt1, utt2, ...]}"""
    d = {}
    if not os.path.exists(path):
        return d
    with open(path) as f:
        for line in f:
            parts = line.strip().split()
            if parts:
                d[parts[0]] = parts[1:]
    return d

def read_label_file(path):
    """返回 {utt_id: 'normal'|'abnormal'}"""
    d = {}
    if not os.path.exists(path):
        return d
    with open(path) as f:
        for line in f:
            parts = line.strip().split()
            if len(parts) >= 2:
                d[parts[0]] = parts[1].lower()
    return d

def try_read_feats_ark(scp_path, max_utts=2000):
    """
    尝试用 kaldiio 读取 fbank 特征，返回 {utt_id: np.ndarray (T, D)}
    若 kaldiio 不可用则返回空 dict
    """
    feats = {}
    try:
        import kaldiio
        count = 0
        for utt_id, mat in kaldiio.load_scp_sequential(scp_path):
            feats[utt_id] = mat
            count += 1
            if count >= max_utts:
                break
        print(f"  [kaldiio] 读取 {len(feats)} 条特征")
    except ImportError:
        print("  [提示] 未安装 kaldiio，跳过特征读取。pip install kaldiio")
    except Exception as e:
        print(f"  [警告] 特征读取失败: {e}")
    return feats


# ═══════════════════════════════════════════════════════════════════════════════
# 异常检测
# ═══════════════════════════════════════════════════════════════════════════════

def detect_outliers_iqr(values, k=2.0):
    """IQR 方法，返回异常点的索引"""
    arr = np.array(values)
    q1, q3 = np.percentile(arr, 25), np.percentile(arr, 75)
    iqr = q3 - q1
    lo, hi = q1 - k * iqr, q3 + k * iqr
    return np.where((arr < lo) | (arr > hi))[0], lo, hi

def detect_outliers_zscore(values, threshold=3.0):
    arr = np.array(values)
    z = np.abs((arr - arr.mean()) / (arr.std() + 1e-9))
    return np.where(z > threshold)[0]


